{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "bookkeeping-emu-reporting",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "EMU-saldo & EMU-schuld reporting pipeline for Dutch decentrale overheden under Wet Houdbare Overheidsfinanciën. Adds four entities — EMUReport (concept/ingediend/herzien aangifte), EMUAdjustment (accrual→kas conversie per Wet Hof art. 3), CashFlowItem (IV3-geclassificeerde kasstroom, shared taxonomy with bookkeeping-iv3-reporting), DebtPosition (ESA2010 bruto schuld per instrument per peildatum). Declarative lifecycle, aggregations, calculations, notifications, RBAC and retention per ADR-022/ADR-031. The prior add-shillinq-emu-reporting change shipped only the esaClassifier field + EmuCalculator aggregation guard; this fragment adds the full pipeline entities. Slugs mirror the existing fragment convention (PascalCase schema key + slug)."
  },
  "components": {
    "schemas": {
      "EMUReport": {
        "slug": "EMUReport",
        "icon": "FileChartOutline",
        "version": "0.1.0",
        "title": "EMU-rapportage",
        "description": "Ingediende of in-progress EMU-aangifte voor een periode (kwartaal of jaar). Atomic versioned submission unit; carries the computed EMU-saldo, bruto EMU-schuld ultimo, BBV-aansluiting and CBS-bevestiging. Lifecycle concept → ingediend → herzien per Wet Hof art. 10. Audit-trail + 10-jaar retention per Archiefwet 1995.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "administrationId",
          "periodYear",
          "periodType",
          "status"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the rapporterende administration (gemeente/provincie/waterschap/GR).",
            "example": "adm-gemeente-1",
            "title": "Administration ID"
          },
          "reportingOrganisation": {
            "type": "object",
            "nullable": true,
            "description": "RSIN, gemeentecode, naam, soort (gemeente/provincie/waterschap/GR) of the reporting body.",
            "title": "Rapporterende Organisatie"
          },
          "periodYear": {
            "type": "integer",
            "description": "Calendar year of the period.",
            "example": 2026,
            "title": "Periode Jaar"
          },
          "periodQuarter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "nullable": true,
            "description": "Quarter 1-4; required when periodeType=kwartaal-emu-saldo.",
            "title": "Periode Kwartaal"
          },
          "periodType": {
            "type": "string",
            "enum": [
              "quarter-emu-balance",
              "year-emu-balance",
              "year-emu-debt"
            ],
            "description": "Aangifte type per Wet Hof.",
            "title": "Periode Type"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "herzien"
            ],
            "default": "draft",
            "description": "Lifecycle status per Wet Hof art. 10.",
            "title": "Status"
          },
          "submissionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp of submission to CBS.",
            "title": "Indieningsdatum"
          },
          "cbsConfirmationNumber": {
            "type": "string",
            "nullable": true,
            "description": "CBS confirmation reference returned on accepted indiening.",
            "title": "CBS Bevestigingsnummer"
          },
          "cbsTemplateVersion": {
            "type": "string",
            "default": "2026",
            "description": "CBS-enquête template version this report conforms to.",
            "title": "CBS Template Version"
          },
          "emuBalanceCalculated": {
            "type": "number",
            "nullable": true,
            "description": "Computed EMU cash saldo for the period (MonetaryAmount, EUR; negative = tekort).",
            "example": -2300000,
            "title": "Emu Saldo Berekend"
          },
          "emuBalanceBudgeted": {
            "type": "number",
            "nullable": true,
            "description": "Budgeted (begroot) EMU saldo for the period from the meerjarenraming.",
            "example": -1800000,
            "title": "Emu Saldo Begroot"
          },
          "emuBalanceDeviation": {
            "type": "number",
            "nullable": true,
            "description": "berekend − begroot (derived).",
            "example": -500000,
            "title": "Emu Saldo Afwijking"
          },
          "emuBalanceDeviationPercentage": {
            "type": "number",
            "nullable": true,
            "description": "(afwijking / abs(begroot)) × 100 (derived).",
            "example": -27.8,
            "title": "Emu Saldo Afwijking Percentage"
          },
          "emuDebtGross": {
            "type": "number",
            "nullable": true,
            "description": "Bruto nominale EMU-schuld ultimo periode (sum AF.2+AF.3+AF.4).",
            "example": 142500000,
            "title": "Emu Schuld Bruto"
          },
          "emuDebtStatutoryNorm": {
            "type": "number",
            "nullable": true,
            "description": "Individuele EMU-referentiewaarde / wettelijke norm.",
            "example": 156000000,
            "title": "Emu Schuld Wettelijke Norm"
          },
          "emuDebtCapacity": {
            "type": "number",
            "nullable": true,
            "description": "wettelijkeNorm − bruto (derived).",
            "example": 13500000,
            "title": "Emu Schuld Ruimte"
          },
          "municipalAccountingBalanceRevenueExpenses": {
            "type": "number",
            "nullable": true,
            "description": "BBV jaarrekening saldo baten/lasten used for reconciliation.",
            "example": 4200000,
            "title": "BBV Saldo Baten Lasten"
          },
          "bbvTotaleAdjustments": {
            "type": "number",
            "nullable": true,
            "description": "Sum of all EMUAdjustment.bedrag for the year (derived).",
            "example": -6500000,
            "title": "BBV Totale Adjustments"
          },
          "bbvReconciliationCheck": {
            "type": "string",
            "enum": [
              "succeeded",
              "failed",
              "non-executed"
            ],
            "default": "non-executed",
            "description": "Reconciliation outcome.",
            "title": "BBV Aansluitingscontrole"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Concerncontroller toelichting on significant deviations; auto-seeded with top-3 contributors.",
            "title": "Toelichting"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-lifecycle": {
          "field": "status",
          "initialState": "draft",
          "retention": {
            "rule": "selectielijst:5.1.4",
            "period": "P10Y",
            "description": "EMU-rapportage records retained 10 years per Archiefwet 1995 + Selectielijst Gemeenten 2020."
          },
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Auto-generated draft; concerncontroller reviews and adjusts before submission."
            },
            "submitted": {
              "label": "Ingediend",
              "description": "Submitted to CBS via SBR/Digipoort; cbsBevestigingsnummer stored."
            },
            "herzien": {
              "label": "Herzien",
              "description": "Superseded by a correction aangifte after late BBV-naverwerking."
            }
          },
          "transitions": {
            "indienen": {
              "from": "draft",
              "to": "submitted",
              "label": "Indienen bij CBS",
              "description": "Concerncontroller submits the approved concept via SBR/Digipoort; requires sign-off.",
              "requires": "OCA\\Shillinq\\Guard\\EmuSubmissionGuard::requireApproval"
            },
            "herzien": {
              "from": "submitted",
              "to": "herzien",
              "label": "Herzien",
              "description": "File a correctie-aangifte after a late GL entry in a submitted period."
            }
          }
        },
        "x-openregister-calculations": {
          "emuBalanceDeviation": {
            "description": "berekend − begroot.",
            "expr": "@self.emuSaldoBerekend - @self.emuSaldoBegroot"
          },
          "emuDebtCapacity": {
            "description": "wettelijkeNorm − bruto schuld.",
            "expr": "@self.emuSchuldWettelijkeNorm - @self.emuSchuldBruto"
          }
        },
        "x-openregister-aggregations": {
          "totaleAdjustments": {
            "description": "Sum of EMUAdjustment.bedrag (signed by richting) for this report, driving the BBV-reconciliation control.",
            "filter": {},
            "from": "EMUAdjustment",
            "metric": "sum",
            "field": "amount",
            "groupBy": [
              "reportId"
            ]
          }
        },
        "x-openregister-notifications": {
          "onConcept": {
            "trigger": {
              "type": "created"
            },
            "description": "Notify the concerncontroller when a quarterly concept-aangifte is generated.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "emu-concerncontroller"
                ]
              }
            ],
            "subject": {
              "nl": "EMU-conceptaangifte voor {{periodeJaar}} is gegenereerd en wacht op review",
              "en": "EMU draft return for {{periodeJaar}} has been generated and is awaiting review"
            }
          },
          "onIngediend": {
            "trigger": {
              "type": "transition",
              "action": "indienen"
            },
            "description": "Notify on successful CBS submission.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "emu-concerncontroller"
                ]
              }
            ],
            "subject": {
              "nl": "EMU-aangifte {{periodeJaar}} is ingediend bij het CBS",
              "en": "EMU return {{periodeJaar}} was submitted to Statistics Netherlands (CBS)"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "emu-concerncontroller": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "emu-reviewer": {
              "permissions": [
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a EMU-rapportage is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
      "EMUAdjustment": {
        "slug": "EMUAdjustment",
        "icon": "SwapVerticalBold",
        "version": "0.1.0",
        "title": "EMU-correctie",
        "description": "Individuele accrual→kas correctie gekoppeld aan een grootboekmutatie of macroregel per Wet Hof art. 3. Traceerbaar per adjustment; richting (saldo-verhogend/verlagend/neutraal) en bedrag voeden de EMUReport-aansluiting. Concerncontroller kan bedrag overschrijven met audit-trail.",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "reportId",
          "type",
          "direction",
          "amount",
          "rule"
        ],
        "properties": {
          "reportId": {
            "type": "string",
            "description": "FK to the EMUReport.",
            "example": "emu-2026-q2-gem-1742",
            "title": "Report ID"
          },
          "type": {
            "type": "string",
            "enum": [
              "elimination-depreciation",
              "elimination-provision-contribution",
              "elimination-withdrawal-reserve",
              "addition-gross-investment",
              "addition-repayment",
              "elimination-book-profit-divestment",
              "correction-transaction-moment",
              "intercompany-elimination"
            ],
            "description": "Adjustment type per Wet Hof art. 3 (8 macro-rules).",
            "title": "Type"
          },
          "direction": {
            "type": "string",
            "enum": [
              "balance-increasing",
              "balance-decreasing",
              "balance-neutral"
            ],
            "description": "Effect direction on the EMU-saldo.",
            "title": "Richting"
          },
          "amount": {
            "type": "number",
            "description": "Adjustment amount (MonetaryAmount, EUR; always non-negative — richting carries the sign).",
            "example": 1240000,
            "title": "Bedrag"
          },
          "source": {
            "type": "object",
            "nullable": true,
            "description": "Source GL reference: grootboekrekening, omschrijving, taakveld, taakveldNaam, programma.",
            "title": "Bron"
          },
          "rule": {
            "type": "string",
            "description": "Legal basis citation, e.g. 'Wet Hof art. 3 lid 2'.",
            "example": "Wet Hof art. 3 lid 2: afschrijvingen zijn geen kasuitgaven",
            "title": "Regel"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Free-text business context.",
            "title": "Toelichting"
          },
          "overridden": {
            "type": "boolean",
            "default": false,
            "description": "True when a concerncontroller manually overrode the auto-computed bedrag (audit-trail logged).",
            "title": "Overridden"
          },
          "consolidationEMU": {
            "type": "string",
            "enum": [
              "extern",
              "intern-S1313",
              "internal-entity"
            ],
            "default": "extern",
            "description": "Counterparty consolidation flag for intercompany-eliminatie.",
            "title": "Consolidatie Emu"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "emu-concerncontroller": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "emu-reviewer": {
              "permissions": [
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a EMU-correctie is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
      "CashFlowItem": {
        "slug": "CashFlowItem",
        "icon": "CashFast",
        "version": "0.1.0",
        "title": "Kasstroomregel",
        "description": "Kasstroomregel geclassificeerd naar IV3 (hoofdstuk-functie-categorie). Shared entity with bookkeeping-iv3-reporting: één geclassificeerd dataset voedt zowel de IV3-kwartaalaangifte als de EMU-aangifte. EMU filtert op kas-basis (kasOfTransactiebasis=kas).",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "reportId",
          "date",
          "amount",
          "kasOfTransactionBasis"
        ],
        "properties": {
          "reportId": {
            "type": "string",
            "description": "FK to the EMUReport.",
            "example": "emu-2026-q2-gem-1742",
            "title": "Report ID"
          },
          "date": {
            "type": "string",
            "format": "date",
            "description": "Transaction (kas) date.",
            "example": "2026-05-22",
            "title": "Datum"
          },
          "amount": {
            "type": "number",
            "description": "Cash amount (MonetaryAmount, EUR; negative = uitstroom).",
            "example": -820000,
            "title": "Bedrag"
          },
          "iv3": {
            "type": "object",
            "nullable": true,
            "description": "IV3-taxonomie classification: hoofdstuk, hoofdstukNaam, functie, functieNaam, categorie, categorieNaam.",
            "title": "Iv3"
          },
          "taskField": {
            "type": "string",
            "nullable": true,
            "description": "BBV taakveld code.",
            "example": "8.1",
            "title": "Taakveld"
          },
          "contraAccount": {
            "type": "object",
            "nullable": true,
            "description": "Counterparty: soort (leverancier/klant/begunstigde), naam, nummer (factuurnummer/IBAN).",
            "title": "Tegenrekening"
          },
          "kasOfTransactionBasis": {
            "type": "string",
            "enum": [
              "kas",
              "transactie"
            ],
            "default": "kas",
            "description": "Whether this item is on a cash or transaction basis.",
            "title": "Kas Of Transactiebasis"
          },
          "paymentMoment": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Actual cash transaction timestamp.",
            "title": "Betaalmoment"
          },
          "invoiceMoment": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Invoice date when different from cash date (drives correctie-transactiemoment).",
            "title": "Factuurmoment"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "emu-concerncontroller": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "emu-reviewer": {
              "permissions": [
                "read"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Kasstroomregel is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
      "DebtPosition": {
        "slug": "DebtPosition",
        "icon": "BankMinus",
        "version": "0.1.0",
        "title": "Schuldpositie",
        "description": "Uitstaande schuld per instrument per peildatum (kwartaal- of jaar-ultimo). Bruto nominaal bedrag classified per Eurostat ESA2010 (AF.2/AF.3/AF.4 tellen mee; AF.7 derivaten niet). Can be sourced from the schatkistbankieren daily sync or entered manually.",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "reportId",
          "referenceDate",
          "instrument",
          "outstandingDebt",
          "teltMeeInEmuDebt",
          "categoryEurostat"
        ],
        "properties": {
          "reportId": {
            "type": "string",
            "description": "FK to the EMUReport.",
            "example": "emu-2026-q2-gem-1742",
            "title": "Report ID"
          },
          "referenceDate": {
            "type": "string",
            "format": "date",
            "description": "Measurement date (kwartaal- of jaar-ultimo).",
            "example": "2026-06-30",
            "title": "Peildatum"
          },
          "instrument": {
            "type": "string",
            "enum": [
              "vaste-geldlening",
              "obligatie",
              "kasgeldlening",
              "schatkistbankieren-rekeningcourant",
              "crediteurensaldo-1j+",
              "derivaten-passief",
              "voorziening-juridisch"
            ],
            "description": "Debt instrument type.",
            "title": "Instrument"
          },
          "counterparty": {
            "type": "object",
            "nullable": true,
            "description": "Counterparty: naam, soort (sector-S122-bank / sector-S11-nfv / sector-S13-government), consolidatieEMU (extern/intern-S1313/internal-entity).",
            "title": "Tegenpartij"
          },
          "principalOriginal": {
            "type": "number",
            "nullable": true,
            "description": "Original principal (MonetaryAmount, EUR).",
            "example": 25000000,
            "title": "Hoofdsom Oorspronkelijk"
          },
          "outstandingDebt": {
            "type": "number",
            "description": "Outstanding nominal balance (MonetaryAmount, EUR).",
            "example": 18750000,
            "title": "Uitstaande Schuld"
          },
          "interestRate": {
            "type": "number",
            "nullable": true,
            "description": "Annual interest rate (%).",
            "example": 2.85,
            "title": "Rentevoet"
          },
          "rentevorm": {
            "type": "string",
            "enum": [
              "vast",
              "variabel"
            ],
            "nullable": true,
            "description": "Interest form.",
            "title": "Rentevorm"
          },
          "termYears": {
            "type": "integer",
            "nullable": true,
            "description": "Original term in years.",
            "example": 20,
            "title": "Looptijd Jaren"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Maturity date.",
            "example": "2034-12-31",
            "title": "Einddatum"
          },
          "teltMeeInEmuDebt": {
            "type": "boolean",
            "description": "ESA2010: AF.2/AF.3/AF.4 = true, AF.7 derivaten = false.",
            "example": true,
            "title": "Telt Mee In Emu Schuld"
          },
          "categoryEurostat": {
            "type": "string",
            "enum": [
              "off_2-deposits",
              "off_3-securities",
              "off_4-loans",
              "off_7-derivatives",
              "other"
            ],
            "description": "Eurostat ESA2010 financial instrument category.",
            "example": "off_4-loans",
            "title": "Categorie Eurostat"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-aggregations": {
          "brutoSchuldPerCategorie": {
            "description": "Sum of uitstaandeSchuld grouped by categorieEurostat for AF.2/AF.3/AF.4 instruments that count toward the bruto EMU-schuld.",
            "groupBy": [
              "reportId",
              "categoryEurostat"
            ],
            "filter": {
              "teltMeeInEmuDebt": true
            },
            "from": "DebtPosition",
            "metric": "sum",
            "field": "outstandingDebt"
          }
        },
        "x-openregister-notifications": {
          "onSchatkistNegatief": {
            "trigger": {
              "type": "created",
              "condition": {
                "field": "instrument",
                "operator": "equals",
                "value": "schatkistbankieren-rekeningcourant"
              }
            },
            "description": "Alert the treasury-officer when a negative schatkistbankieren position is recorded as EMU-schuld.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "treasury-officer"
                ]
              }
            ],
            "subject": {
              "nl": "Schatkistbankieren rood: negatieve positie van {{uitstaandeSchuld}} telt mee als EMU-schuld op {{peildatum}}",
              "en": "Treasury banking overdrawn: a negative position of {{uitstaandeSchuld}} counts towards EMU debt on {{peildatum}}"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "emu-concerncontroller": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "treasury-officer": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "emu-reviewer": {
              "permissions": [
                "read"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
