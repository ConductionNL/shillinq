    "change": "receivables-payouts-tab",
    "adr": "ADR-037 modular register fragment; ADR-022 apps consume OpenRegister, no own CRUD",
    "description": "ProviderPayout as designed in openspec/changes/receivables-provider-payouts/design.md (D1, Seed Data): one settlement of a payment provider (Mollie, Stripe) with its amounts and transaction lines. This fragment carries the record and its seeds for board ShDebiteurenbeheer's Uitbetalingen provider tab; the lifecycle, the unmatched notification, PaymentDevice and the posting settings follow with the rest of that change.",
    "spec": "openspec/changes/receivables-payouts-tab/specs/bookkeeping-bank-reconciliation/spec.md"
  },
  "components": {
    "schemas": {
      "ProviderPayout": {
        "slug": "ProviderPayout",
        "icon": "BankTransferIn",
        "version": "0.1.0",
        "title": "Provider payout",
        "description": "A settlement of a payment provider to the bank account: the amounts paid out and kept, and the payments in it, each matched to what it paid or still open.",
        "x-schema-org": "schema:MoneyTransfer",
        "x-spec": "openspec/changes/receivables-payouts-tab/specs/bookkeeping-bank-reconciliation/spec.md",
        "type": "object",
        "required": [
          "administrationId",
          "provider",
          "settlementReference",
          "settledAt",
          "amountNet",
          "state"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "title": "Administration ID",
            "description": "The administration whose bank account received the payout.",
            "example": "adm-gov-1"
          },
          "provider": {
            "type": "string",
            "enum": [
              "mollie",
              "stripe"
            ],
            "x-enum-labels": {
              "mollie": "Mollie",
              "stripe": "Stripe"
            },
            "title": "Provider",
            "description": "The payment provider that paid out.",
            "example": "mollie"
          },
          "settlementReference": {
            "type": "string",
            "title": "Settlement reference",
            "description": "The provider's reference of the settlement. A captured payment request names it in settlementReference.",
            "example": "st_example0001"
          },
          "settledAt": {
            "type": "string",
            "format": "date",
            "title": "Paid out on",
            "description": "The day the payout reached the bank account.",
            "example": "2026-10-07"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "title": "Currency",
            "description": "ISO 4217 currency of the amounts.",
            "example": "EUR"
          },
          "amountGross": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "title": "Gross amount",
            "description": "The sum of the payments in the payout, before refunds, chargebacks and fees.",
            "example": 4951
          },
          "amountFees": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "title": "Fees",
            "description": "What the provider kept as fees on this payout.",
            "example": 38.65
          },
          "amountRefunds": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "title": "Refunds",
            "description": "What was paid back to customers out of this payout.",
            "example": 0
          },
          "amountChargebacks": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "title": "Chargebacks",
            "description": "What customers' banks reclaimed out of this payout.",
            "example": 0
          },
          "amountNet": {
            "type": "number",
            "title": "Paid out",
            "description": "The amount that reached the bank account.",
            "example": 4912.35
          },
          "lines": {
            "type": "array",
            "title": "Lines",
            "description": "The payments, refunds and chargebacks in the payout, each matched to what it paid or still unmatched.",
            "items": {
              "type": "object",
              "properties": {
                "providerPaymentId": {
                  "type": "string",
                  "title": "Provider payment ID",
                  "example": "tr_8Kq2"
                },
                "type": {
                  "type": "string",
                  "enum": [
                    "payment",
                    "refund",
                    "chargeback"
                  ],
                  "x-enum-labels": {
                    "payment": "Payment",
                    "refund": "Refund",
                    "chargeback": "Chargeback"
                  },
                  "title": "Kind",
                  "example": "payment"
                },
                "amount": {
                  "type": "number",
                  "title": "Amount",
                  "example": 60
                },
                "fee": {
                  "type": "number",
                  "nullable": true,
                  "title": "Fees",
                  "example": 0.29
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "matched",
                    "unmatched"
                  ],
                  "x-enum-labels": {
                    "matched": "Matched",
                    "unmatched": "Unmatched"
                  },
                  "title": "State",
                  "example": "unmatched"
                },
                "matchedObjectId": {
                  "type": "string",
                  "nullable": true,
                  "title": "Matched to",
                  "description": "The payment request, deposit or invoice the line paid.",
                  "example": "pr-2026-0412"
                }
              }
            },
            "default": []
          },
          "matchedLineCount": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "title": "Matched",
            "description": "How many lines are matched to what they paid. Kept with the lines.",
            "example": 14
          },
          "unmatchedLineCount": {
            "type": "integer",
            "minimum": 0,
            "nullable": true,
            "title": "Open",
            "description": "How many lines match nothing yet and wait for someone to match them. Kept with the lines.",
            "example": 1
          },
          "state": {
            "type": "string",
            "enum": [
              "received",
              "matched",
              "booked",
              "reconciled"
            ],
            "x-enum-labels": {
              "received": "Received",
              "matched": "Matched",
              "booked": "Booked",
              "reconciled": "Reconciled"
            },
            "default": "received",
            "title": "State",
            "description": "Received from the provider, its lines matched, its amounts booked, and its bank line reconciled.",
            "example": "booked"
          },
          "bankStatementLineId": {
            "type": "string",
            "nullable": true,
            "title": "Bank statement line",
            "description": "The bank statement line the payout arrived as.",
            "example": "bsl-2026-10-07-0042"
          },
          "glTransactionId": {
            "type": "string",
            "nullable": true,
            "title": "Journal entry",
            "description": "The journal entry that booked the payout.",
            "example": "gl-2026-10-07-0108"
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Who recorded a payout, matched its lines or changed its amounts, and when."
        },
        "authorization": {
          "create": [
            "shillinq_admin",
            "shillinq_controller",
            "shillinq_bookkeeper"
          ],
          "read": [
            "shillinq_admin",
            "shillinq_controller",
            "shillinq_bookkeeper",
            "shillinq_auditor"
          ],
          "update": [
            "shillinq_admin",
            "shillinq_controller",
            "shillinq_bookkeeper"
          ],
          "delete": [
            "shillinq_admin",
            "shillinq_controller"
          ]
        }
      }
    }
  },
