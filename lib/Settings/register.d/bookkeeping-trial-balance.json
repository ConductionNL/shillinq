    "change": "bookkeeping-trial-balance",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "Tier 2 — trial balance reporting. Adds one read-only per-account period-row schema (TrialBalanceLine) capturing opening balance (carried from the prior period close), period debit/credit movements, and the computed closing balance per general-ledger account. The monolith already ships a period-snapshot TrialBalance schema (totals + isBalanced) from add-shillinq-bookkeeping-operations (REQ-FS-005); TrialBalanceLine is the complementary per-account breakdown the T2 spec (REQ-TB-001..REQ-TB-020) requires — opening/movement/closing per account, parent-account hierarchy roll-up, currency. The rows are computed by OCA\\Shillinq\\Service\\TrialBalanceService from existing GLTransaction + GLLine + Account data via the real OpenRegister ObjectService API (find/findAll); the x-openregister-aggregations block documents the equivalent declarative shape. The schema is read-only (no lifecycle, no create/update/delete from operators). Seed objects provide five worked example trial balances (SMB, ZZP, government BBV, mid-year close, post-reconciliation) per design.md."
  },
  "components": {
    "schemas": {
      "TrialBalanceLine": {
        "slug": "TrialBalanceLine",
        "icon": "ScaleBalance",
        "version": "0.1.0",
        "title": "Trial Balance Line",
        "description": "Read-only per-account, per-period trial-balance row: opening balance (prior-period close), period debit/credit movements, and the computed closing balance for one general-ledger account (REQ-TB-001). Computed on demand by TrialBalanceService from GLTransaction + GLLine + Account; never authored directly by operators (REQ-TB-007).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-trial-balance/specs.md",
        "x-openregister": {
          "readonly": true
        },
        "readonly": true,
        "type": "object",
        "required": [
          "periodId",
          "accountNumber",
          "accountType",
          "openingBalance",
          "debitMovement",
          "creditMovement",
          "closingBalance",
          "administrationId"
        ],
        "properties": {
          "periodId": {
            "type": "string",
            "description": "Fiscal period identifier this trial-balance row covers (FK to the GL period; string identifier for T1 compatibility). Single-period scope per REQ-TB-004.",
            "example": "2026-Q1",
            "title": "Period ID"
          },
          "accountNumber": {
            "type": "string",
            "description": "RGS general-ledger account code (FK to Account.accountNumber).",
            "example": "1000",
            "title": "Account Number"
          },
          "accountName": {
            "type": "string",
            "description": "Human-readable account name, inherited from Account.name (REQ-TB-006).",
            "nullable": true,
            "example": "Activa",
            "title": "Account Name"
          },
          "accountType": {
            "type": "string",
            "description": "Account classification inherited from Account.accountType (REQ-TB-006), used to total assets / liabilities / equity.",
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "revenue",
              "expenses"
            ],
            "example": "assets",
            "title": "Account Type"
          },
          "openingBalance": {
            "type": "number",
            "description": "Balance at period start, carried from the closing balance of the prior period; zero when no prior period exists (REQ-TB-002).",
            "example": 50000.0,
            "title": "Opening Balance"
          },
          "debitMovement": {
            "type": "number",
            "minimum": 0,
            "description": "Sum of GLLine debit amounts posted to this account in the period (REQ-TB-001).",
            "example": 10000.0,
            "title": "Debit Movement"
          },
          "creditMovement": {
            "type": "number",
            "minimum": 0,
            "description": "Sum of GLLine credit amounts posted to this account in the period (REQ-TB-001).",
            "example": 5000.0,
            "title": "Credit Movement"
          },
          "closingBalance": {
            "type": "number",
            "description": "Computed closing balance = openingBalance + (debitMovement - creditMovement) (REQ-TB-003).",
            "example": 55000.0,
            "title": "Closing Balance"
          },
          "currency": {
            "type": "string",
            "description": "ISO-4217 currency of the account balance, inherited from Account.currency (REQ-TB-012).",
            "default": "EUR",
            "example": "EUR",
            "title": "Currency"
          },
          "parentAccountNumber": {
            "type": "string",
            "description": "Parent account code for hierarchy roll-up, inherited from Account.parentAccountNumber (REQ-TB-005, REQ-TB-020). Null for top-level accounts.",
            "nullable": true,
            "example": null,
            "title": "Parent Account Number"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the administration this trial-balance row belongs to; reads are scoped to the requesting user's administration (REQ-TB-016, REQ-TB-017).",
            "example": "adm-1",
            "title": "Administration ID"
          }
        },
        "x-openregister-aggregations": {
          "trialBalanceByAccountPeriod": {
            "description": "Declarative shape of the per-account period roll-up TrialBalanceService computes (REQ-TB-001, REQ-TB-018). Groups GLLine by (periodId, accountNumber) within an administration, sums debit and credit movements, joins Account for name/type/parent, and derives closingBalance = openingBalance + (debitMovement - creditMovement). openingBalance is carried from the prior period's closingBalance (REQ-TB-002). When the OpenRegister aggregation engine cannot express the prior-period carry + cross-schema join, TrialBalanceService computes the same result in PHP from the real ObjectService API.",
            "join": {
              "from": "GLLine.accountNumber",
              "through": "Account",
              "on": "Account.accountNumber",
              "select": [
                "Account.name",
                "Account.accountType",
                "Account.currency",
                "Account.parentAccountNumber"
              ]
            },
            "filter": {
              "eliminationFlag": false
            },
            "groupBy": [
              "periodId",
              "GLLine.periodId",
              "GLLine.accountNumber"
            ],
            "operations": {
              "debitMovement": {
                "field": "GLLine.amount",
                "operation": "sum",
                "condition": "GLLine.side = 'debit'",
                "target": "debitMovement"
              },
              "creditMovement": {
                "field": "GLLine.amount",
                "operation": "sum",
                "condition": "GLLine.side = 'credit'",
                "target": "creditMovement"
              },
              "closingBalance": {
                "operation": "expression",
                "expression": "openingBalance + (debitMovement - creditMovement)",
                "target": "closingBalance"
              }
            },
            "from": "GLLine"
          }
        }
      }
    },
