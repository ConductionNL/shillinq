      "VerklaringDraft": {
        "slug": "VerklaringDraft",
        "icon": "FileCertificateOutline",
        "version": "0.1.0",
        "title": "Controleverklaring",
        "description": "Aggregated findings + mechanically-derived proposedOpinion (REQ-007) on the four-point BADO scale. Opinion derivation mirrors BadoControleprotocolService::deriveOpinion. Sign-off carries the auditor identity + AFM-vergunningsnummer. draft → signed → published; cannot sign until all findings are agreed/resolved and all in-scope SiSa-regelingen have a SiSaAssurance child (REQ-008).",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "protocol",
          "proposedOpinion",
          "opinionRationale",
          "status"
        ],
        "properties": {
          "protocol": {
            "type": "string",
            "description": "FK to the parent Controleprotocol.",
            "title": "Protocol"
          },
          "aggregatedFindings": {
            "type": "object",
            "nullable": true,
            "description": "Findings rolled up by topic with counts by severity (computed).",
            "title": "Aggregated Findings"
          },
          "proposedOpinion": {
            "type": "string",
            "enum": [
              "goedkeurend",
              "met-beperking",
              "oordeelonthouding",
              "afkeurend"
            ],
            "description": "Opinion derived from the BADO decision tree (REQ-007).",
            "title": "Proposed Opinion"
          },
          "opinionRationale": {
            "type": "string",
            "description": "Explanation of the opinion, citing BADO criteria.",
            "title": "Opinion Rationale"
          },
          "opinionOverride": {
            "type": "boolean",
            "default": false,
            "description": "True when the auditor manually overrode the derived opinion; triggers escalation.",
            "title": "Opinion Override"
          },
          "signOff": {
            "type": "object",
            "nullable": true,
            "description": "Auditor sign-off block.",
            "properties": {
              "auditor": {
                "type": "string",
                "title": "Auditor",
                "description": "The auditor."
              },
              "afmPermitNumber": {
                "type": "string",
                "title": "Afm Vergunningsnummer",
                "description": "The afm vergunningsnummer."
              },
              "date": {
                "type": "string",
                "format": "date",
                "title": "Datum",
                "description": "The date and time for datum."
              },
              "place": {
                "type": "string",
                "title": "Plaats",
                "description": "The date and time for plaats."
              }
            },
            "title": "Sign Off"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "signed",
              "published"
            ],
            "default": "draft",
            "description": "Verklaring lifecycle.",
            "title": "Status"
          }
        },
        "x-openregister-lifecycle": {
          "field": "status",
          "initialState": "draft",
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Opinion derived; awaiting sign-off."
            },
            "signed": {
              "label": "Ondertekend",
              "description": "Signed by the AFM-vergund accountant; emits audit.verklaring.signed."
            },
            "published": {
              "label": "Gepubliceerd",
              "description": "Bound to the published jaarrekening PDF/A."
            }
          },
          "transitions": {
            "sign": {
              "from": "draft",
              "to": "signed",
              "label": "Ondertekenen",
              "description": "Auditor signs; requires all findings agreed/resolved + all SiSa-regelingen covered (REQ-008).",
              "requires": "OCA\\Shillinq\\Service\\BadoControleprotocolService::canSignVerklaring"
            },
            "publish": {
              "from": "signed",
              "to": "published",
              "label": "Publiceren",
              "description": "Bind to the published jaarrekening."
            }
          }
        },
        "x-openregister-events": {
          "audit.verklaring.signed": {
            "trigger": "lifecycle.sign",
            "description": "REQ-009: emitted on sign so jaarrekening-publication can unblock.",
            "payload": {
              "protocol_id": "@self.protocol",
              "opinion": "@self.proposedOpinion"
            }
          }
        },
        "x-openregister-calculations": {
          "proposedOpinion": {
            "description": "REQ-007 BADO decision tree (NV COS 700-serie). Mirrors BadoControleprotocolCalculator::deriveOpinion — first match wins: pervasive scope limitation → oordeelonthouding; materieel findings across the majority of topics → afkeurend; any materieel finding → met-beperking; otherwise → goedkeurend. The conditional cross-topic aggregation is not yet expressible declaratively, so the calculator is the engine-side fallback (ADR-031).",
            "expression": "IF scopeLimitation THEN oordeelonthouding ELSE IF materieelTopics*2 > topicCount THEN afkeurend ELSE IF materieelTopics > 0 THEN met-beperking ELSE goedkeurend",
            "inputs": {
              "scopeLimitation": "#/properties/opinionOverride",
              "findings": "AuditFinding.severity"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "externe-accountant": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "concerncontroller": {
              "permissions": [
                "read"
              ]
            },
            "interne-audit": {
              "permissions": [
                "read"
              ]
            },
            "toezichthouder": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Controleverklaring is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
