    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "bookkeeping-btw-oss-eu",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "Tier 2 — Union One-Stop-Shop (OSS) cross-border EU VAT compliance per Council Directive 2006/112/EC Articles 358a-369x + Council Implementing Regulation (EU) 282/2011. Declares five new schemas (OssRegistration, EuVatRate, OssThresholdCounter, OssReturn, OssPayment), additively extends the Invoice schema (owned by bookings-deposit-to-invoice) with an ossContext sub-object via key-union merge (ADR-037 deepMergeConfig), and seeds the EuVatRate table from the EU Commission TEDB v3 plus example OSS registrations and a worked quarterly return. The OSS pipeline runs alongside (not inside) the domestic BTW pipeline (VatReturn): OSS turnover (8xxx Omzet OSS {country}) and OSS VAT-payable (1xxx BTW af te dragen OSS {country}) are booked to dedicated per-country grootboekrekeningen that are excluded from the regular BTW-aangifte rubrieken 3a/3b/4a/4b (OssLedgerGuard::assertNoOssAccountsOnBtwReturn). Destination-country VAT-rate resolution, threshold monitoring, quarterly aangifte generation, XSD/CSV formatting and payment reconciliation are the ADR-031 exception-path services in lib/Service (OssRateResolver, OssReturnGenerator, OssReturnFormatter, OssPaymentReconciliation) + lib/Guard (OssThresholdGuard, OssLedgerGuard) which use the real OpenRegister ObjectService API (find/findAll). B2B intra-community supplies are explicitly excluded and route to the reverse-charge / ICP path (IcpStatement)."
  },
  "components": {
    "schemas": {
      "OssRegistration": {
        "slug": "OssRegistration",
        "icon": "EarthArrowRight",
        "version": "0.1.0",
        "title": "OSS-registratie",
        "description": "Seller-side enrolment in the Union One-Stop-Shop scheme (REQ-OSS-012). Captures the Belastingdienst-issued OSS-identifier, the effective date, the home member state (always NL for Shillinq tenants), the destination countries actively sold into, the registration status, and the 3-year voluntary lock-in (Article 369a Directive 2006/112/EC, REQ-OSS-009).",
        "x-schema-org": "schema:GovernmentService",
        "x-spec": "openspec/changes/bookkeeping-btw-oss-eu/specs/bookkeeping-btw-oss-eu/spec.md",
        "type": "object",
        "required": [
          "administrationId",
          "ossIdentifier",
          "effectiveDate",
          "homeMemberState",
          "registrationStatus"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the administration this registration belongs to; reads are scoped per administration (REQ-OSS-002).",
            "example": "adm-mkb-1",
            "title": "Administration ID"
          },
          "ossIdentifier": {
            "type": "string",
            "description": "Belastingdienst-issued OSS identifier (REQ-OSS-012).",
            "example": "NL123456789B01",
            "title": "OSS Identifier"
          },
          "effectiveDate": {
            "type": "string",
            "format": "date",
            "description": "Date the registration became effective.",
            "example": "2026-07-01",
            "title": "Effective Date"
          },
          "homeMemberState": {
            "type": "string",
            "default": "NL",
            "description": "Member state of identification — always NL for Shillinq tenants.",
            "example": "NL",
            "title": "Home Member State"
          },
          "destinationCountries": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ISO 3166-1 alpha-2 codes of member states actively sold into (REQ-OSS-012).",
            "example": [
              "DE",
              "FR",
              "IT"
            ],
            "title": "Destination Countries"
          },
          "registrationStatus": {
            "type": "string",
            "enum": [
              "pending",
              "active",
              "voluntaryBelowThreshold",
              "deregistered",
              "excluded"
            ],
            "default": "pending",
            "description": "Current status (REQ-OSS-012). voluntaryBelowThreshold is the Article 369a opt-in below EUR 10,000.",
            "title": "Registration Status"
          },
          "voluntaryBelowThreshold": {
            "type": "boolean",
            "default": false,
            "description": "True when the seller opted in before crossing EUR 10,000 (REQ-OSS-009).",
            "title": "Voluntary Below Threshold"
          },
          "lockInPeriodEndDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "End of the 3-year voluntary lock-in (Article 369a paragraph 3, REQ-OSS-009). Disable is blocked before this date.",
            "example": "2028-12-31",
            "title": "Lock In Period End Date"
          },
          "deregistrationDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Effective date of deregistration; invoices on/after this date are no longer OSS-eligible and the threshold counter resets (REQ-OSS-012).",
            "title": "Deregistration Date"
          }
        },
        "x-openregister-lifecycle": {
          "field": "registrationStatus",
          "initialState": "pending",
          "retention": {
            "rule": "bewaarplicht",
            "period": "P10Y",
            "description": "OSS records retained 10 years (bewaarplicht)."
          },
          "states": {
            "pending": {
              "label": "In aanvraag",
              "description": "Registration requested at the Belastingdienst; awaiting OSS-identifier."
            },
            "active": {
              "label": "Actief",
              "description": "Active registration; qualifying B2C-to-EU sales feed the OSS return."
            },
            "voluntaryBelowThreshold": {
              "label": "Vrijwillig (onder drempel)",
              "description": "Article 369a voluntary opt-in below EUR 10,000; bound for the current + following two calendar years."
            },
            "deregistered": {
              "label": "Uitgeschreven",
              "description": "Voluntarily deregistered; effective from deregistrationDate."
            },
            "excluded": {
              "label": "Uitgesloten",
              "description": "Excluded by the tax authority."
            }
          },
          "transitions": {
            "activate": {
              "from": "pending",
              "to": "active",
              "label": "Activeren",
              "description": "OSS-identifier received; registration becomes active."
            },
            "optInVoluntary": {
              "from": "pending",
              "to": "voluntaryBelowThreshold",
              "label": "Vrijwillig aanmelden",
              "description": "Opt in below threshold (Article 369a); sets lockInPeriodEndDate.",
              "requires": "OCA\\Shillinq\\Guard\\OssThresholdGuard::canEnableVoluntary"
            },
            "deregister": {
              "from": "active",
              "to": "deregistered",
              "label": "Uitschrijven",
              "description": "Voluntary deregistration; blocked for voluntary registrations before lockInPeriodEndDate (REQ-OSS-009).",
              "requires": "OCA\\Shillinq\\Guard\\OssThresholdGuard::canDeregister"
            },
            "exclude": {
              "from": "active",
              "to": "excluded",
              "label": "Uitsluiten",
              "description": "Tax authority excludes the seller."
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
      "EuVatRate": {
        "slug": "EuVatRate",
        "icon": "Percent",
        "version": "0.1.0",
        "title": "EU BTW-tarief (TEDB)",
        "description": "Per-country, per-period EU VAT rate mirroring the European Commission Taxes in Europe Database (TEDB) v3 (REQ-OSS-001, REQ-OSS-011). Seeded on install and refreshed periodically; manual edits are forbidden (readonly) because applying a hand-typed rate would defeat the audit-trail purpose. The OssRateResolver service resolves the rate effective on the invoice date by (countryCode, rateCategory).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-btw-oss-eu/specs/bookkeeping-btw-oss-eu/spec.md",
        "x-openregister": {
          "readonly": true
        },
        "readonly": true,
        "type": "object",
        "required": [
          "countryCode",
          "rateCategory",
          "ratePercentage",
          "validFrom"
        ],
        "properties": {
          "countryCode": {
            "type": "string",
            "description": "ISO 3166-1 alpha-2 destination member state (REQ-OSS-001).",
            "example": "DE",
            "title": "Country Code"
          },
          "rateCategory": {
            "type": "string",
            "enum": [
              "standard",
              "reduced1",
              "reduced2",
              "superReduced",
              "parking",
              "zero"
            ],
            "description": "VAT rate category (REQ-OSS-001).",
            "example": "standard",
            "title": "Rate Category"
          },
          "ratePercentage": {
            "type": "number",
            "minimum": 0,
            "description": "VAT rate as a percentage (REQ-OSS-001).",
            "example": 19.0,
            "title": "Rate Percentage"
          },
          "validFrom": {
            "type": "string",
            "format": "date",
            "description": "First date this rate is in force (REQ-OSS-001, REQ-OSS-007).",
            "example": "2024-01-01",
            "title": "Valid From"
          },
          "validUntil": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Last date in force; null = still in effect (REQ-OSS-007).",
            "title": "Valid Until"
          },
          "cnCpaCode": {
            "type": "string",
            "nullable": true,
            "description": "CN/CPA code range where a reduced rate applies.",
            "title": "Cn Cpa Code"
          },
          "tedbSource": {
            "type": "string",
            "nullable": true,
            "description": "TEDB version / refresh date for traceability (REQ-OSS-011).",
            "example": "TEDB-v3-2026-01-01",
            "title": "Tedb Source"
          },
          "administrationId": {
            "type": "string",
            "nullable": true,
            "description": "Optional FK to an administration for per-admin TEDB variants; null = shared catalogue.",
            "title": "Administration ID"
          }
        },
        "x-openregister-aggregations": {
          "rateByCountryCategoryDate": {
            "description": "Declarative shape of the rate resolution OssRateResolver performs (REQ-OSS-001): select the EuVatRate row for (countryCode, rateCategory) whose validFrom <= invoiceDate and (validUntil is null or validUntil >= invoiceDate). When the OR aggregation engine cannot express the validity-window selection, OssRateResolver computes it in PHP from the real ObjectService API.",
            "source": "EuVatRate",
            "groupBy": [
              "countryCode",
              "rateCategory"
            ],
            "filter": {
              "countryCode": "@param.countryCode",
              "rateCategory": "@param.rateCategory"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": [
                "read"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
      "OssThresholdCounter": {
        "slug": "OssThresholdCounter",
        "icon": "Gauge",
        "version": "0.1.0",
        "title": "OSS-drempelteller",
        "description": "Per-tenant running calendar-year sum of B2C-to-EU turnover, excluding NL domestic and excluding B2B intra-community supplies (REQ-OSS-002). A derived view recomputed from the journal whenever an invoice is booked, credited or voided — never authored directly by operators (readonly). The OssThresholdGuard evaluates the EUR 10,000 threshold against this counter.",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-btw-oss-eu/specs/bookkeeping-btw-oss-eu/spec.md",
        "x-openregister": {
          "readonly": true
        },
        "readonly": true,
        "type": "object",
        "required": [
          "administrationId",
          "calendarYear",
          "totalB2cEuTurnover"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the administration (REQ-OSS-002).",
            "example": "adm-mkb-1",
            "title": "Administration ID"
          },
          "calendarYear": {
            "type": "integer",
            "description": "Calendar year being tracked.",
            "example": 2026,
            "title": "Calendar Year"
          },
          "totalB2cEuTurnover": {
            "type": "number",
            "minimum": 0,
            "description": "Running sum of B2C turnover to other EU member states in the year (REQ-OSS-002).",
            "example": 9200.0,
            "title": "Total B2C Eu Turnover"
          },
          "byQuarter": {
            "type": "object",
            "nullable": true,
            "description": "Breakdown by quarter, e.g. {\"2026-Q1\": 2500, \"2026-Q2\": 1800}.",
            "additionalProperties": {
              "type": "number"
            },
            "title": "By Quarter"
          },
          "byCountry": {
            "type": "object",
            "nullable": true,
            "description": "Breakdown by destination country, e.g. {\"DE\": 3200, \"FR\": 1100}.",
            "additionalProperties": {
              "type": "number"
            },
            "title": "By Country"
          },
          "thresholdBreachedDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Date EUR 10,000 was crossed, if applicable (REQ-OSS-002).",
            "title": "Threshold Breached Date"
          }
        },
        "x-openregister-aggregations": {
          "b2cEuTurnoverByYear": {
            "description": "Declarative shape of the counter OssThresholdGuard computes (REQ-OSS-002): sum Invoice.netAmount for invoices whose ossContext.ossEligible is true within the calendar year, excluding cancelled invoices, credit notes and B2B reverse-charge supplies. Grouped by destination country and quarter for the breakdown. The PHP guard is the ADR-031 fallback for the cross-period, conditional sum.",
            "groupBy": [
              "administrationId",
              "ossContext.destinationCountry"
            ],
            "filter": {
              "ossContext.ossEligible": true
            },
            "metrics": [
              {
                "metric": "sum",
                "field": "netAmount",
                "as": "netAmount"
              }
            ],
            "from": "Invoice"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": [
                "read"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
      "OssReturn": {
