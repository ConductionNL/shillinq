    "change": "extracurricular-fee-to-shillinq",
    "adr": "ADR-037 modular register fragment; ADR-048 semantic reference; ADR-107 shillinq books; decision D19 (school contributions are shillinq invoices)",
    "description": "A school contribution (ouderbijdrage, overblijfbijdrage, schoolreisje, a club fee) is an ordinary ARInvoice with no order behind it, raised in bulk by ContributionRaiseService from a chargeable definition another app owns. This fragment adds the nullable ARInvoice.contribution group that names the kind, the voluntary flag, the chargeable, the child and the raise batch, plus demo rows. The file sorts after every other ARInvoice fragment, so its version is the merged one: the import only updates a schema whose version rises, and the merged version was 0.6.0. No required list here, because deepMergeConfig concatenates required lists across fragments."
  },
  "components": {
    "schemas": {
      "ARInvoice": {
        "version": "0.14.0",
        "properties": {
          "contribution": {
            "type": "object",
            "nullable": true,
            "description": "Set when the invoice is a school contribution raised in bulk from a chargeable another app owns. Empty on every other invoice.",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "parental-contribution",
                  "lunch-supervision",
                  "school-trip",
                  "activity",
                  "other"
                ],
                "x-enum-labels": {
                  "parental-contribution": "Parental contribution",
                  "lunch-supervision": "Lunch supervision",
                  "school-trip": "School trip",
                  "activity": "Activity",
                  "other": "Other"
                },
                "description": "What the contribution is for: the parental contribution, lunch supervision, a school trip, an activity, or something else.",
                "example": "parental-contribution",
                "title": "Kind"
              },
              "voluntary": {
                "type": "boolean",
                "default": false,
                "description": "True under the Wet vrijwillige ouderbijdrage. The invoice then says the child takes part either way, and dunning sends one reminder at most.",
                "example": true,
                "title": "Voluntary"
              },
              "chargeable": {
                "type": "object",
                "description": "Semantic reference to the definition in the owning app, such as a learniq fee item or a portaliq activity.",
                "properties": {
                  "app": {
                    "type": "string",
                    "description": "The app that owns the referenced object, for example learniq. It describes the reference and never makes two references differ.",
                    "example": "learniq",
                    "title": "App"
                  },
                  "type": {
                    "type": "string",
                    "description": "The semantic type of the referenced object, for example `case`.",
                    "example": "fee-item",
                    "title": "Type"
                  },
                  "register": {
                    "type": "string",
                    "description": "The register slug holding the object.",
                    "example": "learniq",
                    "title": "Register"
                  },
                  "schema": {
                    "type": "string",
                    "description": "The schema slug of the object.",
                    "example": "FeeItem",
                    "title": "Schema"
                  },
                  "id": {
                    "type": "string",
                    "description": "The object's identifier inside that register and schema.",
                    "example": "00000000-0000-0000-0000-000000000000",
                    "title": "Id"
                  }
                },
                "title": "Chargeable"
              },
              "beneficiary": {
                "type": "object",
                "description": "Who the contribution is for, such as the child.",
                "properties": {
                  "type": {
                    "type": "string",
                    "description": "The semantic type of the referenced object, for example `case`.",
                    "example": "learner",
                    "title": "Type"
                  },
                  "register": {
                    "type": "string",
                    "description": "The register slug holding the object.",
                    "example": "learniq",
                    "title": "Register"
                  },
                  "schema": {
                    "type": "string",
                    "description": "The schema slug of the object.",
                    "example": "LearnerProfile",
                    "title": "Schema"
                  },
                  "id": {
                    "type": "string",
                    "description": "The object's identifier inside that register and schema.",
                    "example": "00000000-0000-0000-0000-000000000001",
                    "title": "Id"
                  }
                },
                "title": "Beneficiary"
              },
              "raiseBatchId": {
                "type": "string",
                "description": "The bulk raise that wrote this record, so one batch can be found and checked together.",
                "example": "ctb-20261001-1a2b3c4d",
                "title": "Raise batch"
              }
            },
            "title": "School contribution"
          }
        }
      }
    },
