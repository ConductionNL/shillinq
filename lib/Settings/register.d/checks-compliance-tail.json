{
    "x-shillinq-fragment": "checks-compliance-tail",
    "components": {
        "schemas": {
            "ARInvoice": {
                "version": "0.10.0",
                "properties": {
                    "marginScheme": {"type": "boolean", "nullable": true, "description": "Whether this invoice is supplied under the VAT margin scheme for second-hand goods, works of art, collectors' items and antiques (VAT Directive arts. 312-325); enables the art. 315 margin-taxable-amount and art. 322 no-separate-VAT checks."},
                    "marginPurchasePrice": {"type": "number", "nullable": true, "description": "Purchase price of the margin-scheme goods (VAT Directive art. 312); subtracted from the selling price to derive the taxable margin (art. 315)."},
                    "marginSellingPrice": {"type": "number", "nullable": true, "description": "Selling price of the margin-scheme goods (VAT Directive art. 312); the taxable margin is this less the purchase price (art. 315)."},
                    "marginTaxableAmount": {"type": "number", "nullable": true, "description": "Stated taxable amount under the margin scheme (VAT Directive art. 315); must reconcile to marginSellingPrice - marginPurchasePrice."}
                }
            },
            "SaftFile": {
                "version": "0.1.0",
                "slug": "SaftFile",
                "title": "SAF-T File (compliance)",
                "type": "object",
                "description": "A generated OECD SAF-T (Standard Audit File for Tax) 2.0 export, modelled at the structural-group level so its mandatory/conditional groups (Header, GeneralLedgerAccounts, Customers/Suppliers, TaxTable, GeneralLedgerEntries, SourceDocuments) and XSD validity can be machine-checked. Distinct from the SaftExportProfile configuration object.",
                "properties": {
                    "administrationId": {"type": "string", "nullable": true, "description": "The administration / legal entity the SAF-T export belongs to."},
                    "fileVersion": {"type": "string", "nullable": true, "description": "The SAF-T schema/file version the export was produced against (e.g. '2.0')."},
                    "auditFileCountry": {"type": "string", "nullable": true, "description": "The country whose national SAF-T schema the file conforms to (ISO 3166-1 alpha-2)."},
                    "xsdValid": {"type": "boolean", "nullable": true, "description": "True when the export is a valid XML document conforming to the applicable national SAF-T XSD schema version (SAF-T xml-schema-validity)."},
                    "header": {
                        "type": "object",
                        "nullable": true,
                        "description": "SAF-T Header group: company identification, fiscal/selection period, currency, taxonomy/schema version and producing-software details.",
                        "properties": {
                            "companyName": {"type": "string", "description": "Registered name of the company."},
                            "companyId": {"type": "string", "description": "Company registration / tax identifier."},
                            "taxRegistrationNbr": {"type": "string", "description": "VAT / tax registration number."},
                            "currencyCode": {"type": "string", "description": "Default currency of the accounts (ISO 4217)."},
                            "fiscalYear": {"type": "string", "description": "The fiscal year the file covers."},
                            "startDate": {"type": "string", "format": "date", "description": "Start of the selection period."},
                            "endDate": {"type": "string", "format": "date", "description": "End of the selection period."},
                            "taxonomyVersion": {"type": "string", "description": "Taxonomy / schema version of the export."},
                            "softwareId": {"type": "string", "description": "Identifier of the producing software."},
                            "softwareVersion": {"type": "string", "description": "Version of the producing software."}
                        }
                    },
                    "generalLedgerAccounts": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T MasterFiles/GeneralLedgerAccounts: each ledger account with its id, description, type and opening/closing balances.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "accountId": {"type": "string", "description": "Ledger account number."},
                                "description": {"type": "string", "description": "Account description."},
                                "accountType": {"type": "string", "description": "Account type (asset/liability/equity/income/expense)."},
                                "openingBalance": {"type": "number", "description": "Opening balance of the account."},
                                "closingBalance": {"type": "number", "description": "Closing balance of the account."}
                            }
                        }
                    },
                    "customers": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T MasterFiles/Customers: each customer with identification, VAT registration, address and balances.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "customerId": {"type": "string", "description": "Customer identifier."},
                                "name": {"type": "string", "description": "Customer name."},
                                "vatNumber": {"type": "string", "description": "Customer VAT registration number."},
                                "address": {"type": "string", "description": "Customer address."},
                                "openingBalance": {"type": "number", "description": "Opening account balance."},
                                "closingBalance": {"type": "number", "description": "Closing account balance."}
                            }
                        }
                    },
                    "suppliers": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T MasterFiles/Suppliers: each supplier with identification, VAT registration, address and balances.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "supplierId": {"type": "string", "description": "Supplier identifier."},
                                "name": {"type": "string", "description": "Supplier name."},
                                "vatNumber": {"type": "string", "description": "Supplier VAT registration number."},
                                "address": {"type": "string", "description": "Supplier address."},
                                "openingBalance": {"type": "number", "description": "Opening account balance."},
                                "closingBalance": {"type": "number", "description": "Closing account balance."}
                            }
                        }
                    },
                    "taxTable": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T MasterFiles/TaxTable: the tax (VAT) codes, rates and descriptions referenced by the entries.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "taxCode": {"type": "string", "description": "Tax (VAT) code."},
                                "taxPercentage": {"type": "number", "description": "Tax rate percentage."},
                                "description": {"type": "string", "description": "Tax code description."}
                            }
                        }
                    },
                    "glEntries": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T GeneralLedgerEntries: journals and transactions, each transaction carrying lines with account, date, debit/credit amount and document reference.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "journalId": {"type": "string", "description": "Journal the transaction belongs to."},
                                "transactionId": {"type": "string", "description": "Transaction identifier."},
                                "lines": {
                                    "type": "array",
                                    "description": "Transaction lines.",
                                    "items": {
                                        "type": "object",
                                        "properties": {
                                            "accountId": {"type": "string", "description": "Ledger account number of the line."},
                                            "postingDate": {"type": "string", "format": "date", "description": "Posting date of the line."},
                                            "debitAmount": {"type": "number", "description": "Debit amount of the line."},
                                            "creditAmount": {"type": "number", "description": "Credit amount of the line."},
                                            "documentReference": {"type": "string", "description": "Reference to the source document."}
                                        }
                                    }
                                }
                            }
                        }
                    },
                    "sourceDocuments": {
                        "type": "array",
                        "nullable": true,
                        "description": "SAF-T SourceDocuments: sales/purchase invoices, payments and movement-of-goods records linking source documents to ledger entries.",
                        "items": {
                            "type": "object",
                            "properties": {
                                "documentType": {"type": "string", "description": "Source-document type (e.g. sales-invoice, purchase-invoice, payment)."},
                                "documentReference": {"type": "string", "description": "Source-document reference number."},
                                "glTransactionId": {"type": "string", "description": "The general-ledger transaction the document links to."},
                                "date": {"type": "string", "format": "date", "description": "Document date."},
                                "totalAmount": {"type": "number", "description": "Total document amount."}
                            }
                        }
                    }
                }
            }
        }
    }
}
