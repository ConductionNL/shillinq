      "SchatkistPosition": {
        "slug": "SchatkistPosition",
        "icon": "BankOutline",
        "version": "0.1.0",
        "title": "Schatkist-positie",
        "description": "Daily aggregated Treasury banking position per administration (REQ-SBK-003). Not a parallel ledger (REQ-SBK-011): position is aggregated from GL postings on accounts flagged isSchatkistAccount (REQ-SBK-004) and compared against the drempelbedrag (REQ-SBK-008).",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "administrationId",
          "businessDate"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the gemeente administration.",
            "example": "adm-gemeente-1",
            "title": "Administration ID"
          },
          "businessDate": {
            "type": "string",
            "format": "date",
            "description": "Business day of the position.",
            "example": "2026-06-03",
            "title": "Business Date"
          },
          "position": {
            "type": "number",
            "description": "Aggregated end-of-day position from flagged accounts (derived, REQ-SBK-004).",
            "example": 1250000,
            "title": "Position"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217, default EUR.",
            "title": "Currency"
          },
          "thresholdAmountApplies": {
            "type": "boolean",
            "default": false,
            "description": "Whether the drempelbedrag applies for this administration (REQ-SBK-006).",
            "title": "Drempelbedrag Applies"
          },
          "thresholdAmountAmount": {
            "type": "number",
            "nullable": true,
            "description": "Threshold amount from schatkist-thresholds seed (e.g. 0.75% of begroting).",
            "example": 1500000,
            "title": "Drempelbedrag Amount"
          },
          "aboveThreshold": {
            "type": "boolean",
            "default": false,
            "description": "True when position > drempelbedragAmount (REQ-SBK-008).",
            "title": "Above Threshold"
          }
        },
        "x-openregister-aggregations": {
          "position": {
            "description": "Sum of GLLine net postings on accounts where isSchatkistAccount=true for the business day (REQ-SBK-004).",
            "filter": {
              "isTreasuryAccount": true,
              "postingDate": "@self.businessDate"
            },
            "metrics": [
              {
                "metric": "sum",
                "field": "amount",
                "condition": {
                  "side": "debit"
                },
                "as": "debit"
              },
              {
                "metric": "sum",
                "field": "amount",
                "condition": {
                  "side": "credit"
                },
                "as": "credit"
              }
            ],
            "from": "GLLine"
          }
        },
        "x-openregister-notifications": {
          "onAboveThreshold": {
            "trigger": {
              "type": "updated",
              "condition": {
                "field": "aboveThreshold",
                "operator": "equals",
                "value": true
              }
            },
            "description": "Alert the treasury-officer when the daily position exceeds the drempelbedrag (REQ-SBK-008).",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "treasury-officer"
                ]
              }
            ],
            "subject": {
              "nl": "Schatkist-drempel overschreden: positie {{position}} EUR op {{businessDate}}",
              "en": "Treasury banking threshold exceeded: position {{position}} EUR on {{businessDate}}"
            }
          }
        },
        "x-openregister-widgets": {
          "schatkistPosition": {
            "id": "schatkist-position",
            "title": "Schatkist-positie",
            "description": "Daily Treasury position vs drempelbedrag for gemeente administrations.",
            "type": "chart",
            "dataSource": {
              "mode": "statistics",
              "register": "shillinq",
              "schema": "SchatkistPosition"
            },
            "visibility": {
              "field": "administrationType",
              "in": [
                "municipality"
              ]
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "treasury-officer": {
              "permissions": [
                "read"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
