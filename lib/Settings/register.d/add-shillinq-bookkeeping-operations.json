{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "add-shillinq-bookkeeping-operations",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "Tier 3 — NL compliance core: VAT/BTW filing, BBV account mapping, BCF compensation, ZZP deductions, schatkistbankieren, subsidie-verantwoording. Sibling schemas (KorRegime, Iv3Export, Project, RetentionRule, UrenRegistratie, RateCard, WipBalance) already live in the monolith from prior changes; this fragment adds only the missing schemas and extends Account/BbvAccountMapping additively."
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "isTreasuryAccount": {
            "type": "boolean",
            "default": false,
            "description": "REQ-SBK-002: flags this account as a Treasury (schatkist) account so SchatkistPosition aggregates its postings. Additive extension merged onto the T1 Account schema via ADR-037 deep-merge.",
            "title": "Is Schatkist Account"
          }
        }
      },
      "VatReturn": {
        "slug": "VatReturn",
        "icon": "FileDocumentOutline",
        "version": "0.1.0",
        "title": "BTW-aangifte",
        "description": "Periodic VAT return (BTW-aangifte) per administration and period. Tracks the draft → submitted → accepted → corrected lifecycle (REQ-VBTW-005), aggregates GL postings by VAT rate into rubrieken (REQ-VBTW-004), and submits via the digipoort-sbr OpenConnector source (REQ-VBTW-010). ADR-022 audit/approval, ADR-031 declarative lifecycle.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "administrationId",
          "periodType",
          "periodYear",
          "state"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the administration owning this return.",
            "example": "adm-gemeente-1",
            "title": "Administration ID"
          },
          "periodType": {
            "type": "string",
            "enum": [
              "month",
              "quarter",
              "year"
            ],
            "description": "Filing cadence per Wet OB 1968.",
            "example": "quarter",
            "title": "Period Type"
          },
          "periodYear": {
            "type": "integer",
            "description": "Calendar year of the period.",
            "example": 2026,
            "title": "Period Year"
          },
          "periodMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "nullable": true,
            "description": "Month 1-12; required when periodType=month (REQ-VBTW-002).",
            "title": "Period Month"
          },
          "periodQuarter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "nullable": true,
            "description": "Quarter 1-4; required when periodType=quarter (REQ-VBTW-002).",
            "title": "Period Quarter"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "accepted",
              "corrected"
            ],
            "default": "draft",
            "description": "Lifecycle state per REQ-VBTW-005.",
            "title": "State"
          },
          "amount": {
            "type": "number",
            "description": "Total VAT liability (MonetaryAmount). Derived from rubrieken.",
            "example": 4250.5,
            "title": "Amount"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency, default EUR.",
            "title": "Currency"
          },
          "approvalThreshold": {
            "type": "number",
            "nullable": true,
            "description": "Operator-configurable liability above which submission needs approval (REQ-VBTW-006).",
            "title": "Approval Threshold"
          },
          "submittedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp of SBR/Digipoort submission.",
            "title": "Submitted At"
          },
          "acceptedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp of Digipoort acknowledgement.",
            "title": "Accepted At"
          },
          "attachmentUri": {
            "type": "string",
            "nullable": true,
            "description": "docudesk reference to the aangifte PDF.",
            "title": "Attachment URI"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Operator free text.",
            "title": "Notes"
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {
            "rule": "selectielijst:5.1.2",
            "period": "P7Y",
            "description": "BTW records retained 7 years per AWR art. 52 + Selectielijst Gemeenten 2020."
          },
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Return is being prepared; rubrieken aggregated from GL."
            },
            "submitted": {
              "label": "Ingediend",
              "description": "Submitted to the Belastingdienst via Digipoort/SBR. Awaiting acknowledgement."
            },
            "accepted": {
              "label": "Geaccepteerd",
              "description": "Belastingdienst acknowledged receipt. Terminal unless a suppletie correction is filed."
            },
            "corrected": {
              "label": "Gecorrigeerd",
              "description": "Superseded by a suppletie-aangifte (VatCorrection)."
            }
          },
          "transitions": {
            "submit": {
              "from": "draft",
              "to": "submitted",
              "label": "Indienen via Digipoort",
              "description": "Operator submits the return; requires approval above approvalThreshold (REQ-VBTW-006).",
              "requires": "OCA\\Shillinq\\Guard\\VatSubmissionGuard::requireApproval"
            },
            "accept": {
              "from": "submitted",
              "to": "accepted",
              "label": "Acceptatie",
              "description": "Digipoort acknowledgement received (triggered by OpenConnector digipoort-sbr callback)."
            },
            "correctAfter": {
              "from": "accepted",
              "to": "corrected",
              "label": "Suppletie",
              "description": "Operator files a suppletie-aangifte correcting an accepted return."
            },
            "correctEarly": {
              "from": "draft",
              "to": "corrected",
              "label": "Vroege correctie",
              "description": "Operator corrects the return before submission."
            }
          }
        },
        "x-openregister-aggregations": {
          "rubrieken": {
            "description": "VAT buckets summed per rate (21%, 9%, 0%, verlegd/reverse-charge) over GL postings in the return period per REQ-VBTW-004 and REQ-VBTW-009.",
            "source": "GLLine",
            "groupBy": [
              "vatRate",
              "reverseCharge"
            ],
            "filter": {
              "periodYear": "@self.periodYear"
            },
            "sum": [
              "debit",
              "credit"
            ]
          }
        },
        "x-openregister-notifications": {
          "onSubmitted": {
            "trigger": {
              "type": "transition",
              "action": "submit"
            },
            "description": "Notify the vat-administrator when a return is submitted.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "vat-administrator"
                ]
              }
            ],
            "subject": {
              "nl": "BTW-aangifte voor {{periodYear}} is ingediend via Digipoort",
              "en": "VAT return for {{periodYear}} was submitted through Digipoort"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
      "IcpStatement": {
        "slug": "IcpStatement",
        "icon": "EarthArrowRight",
        "version": "0.1.0",
        "title": "ICP-opgaaf",
        "description": "Intra-community supplies declaration (opgaaf intracommunautaire prestaties) per REQ-VBTW-007. Tracks draft → submitted → accepted lifecycle and aggregates ICP transactions for the period.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "administrationId",
          "periodType",
          "periodYear",
          "state"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the administration.",
            "example": "adm-mkb-1",
            "title": "Administration ID"
          },
          "periodType": {
            "type": "string",
            "enum": [
              "month",
              "quarter",
              "year"
            ],
            "description": "Filing cadence.",
            "title": "Period Type"
          },
          "periodYear": {
            "type": "integer",
            "description": "Calendar year.",
            "example": 2026,
            "title": "Period Year"
          },
          "periodMonth": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12,
            "nullable": true,
            "description": "Month 1-12 if periodType=month.",
            "title": "Period Month"
          },
          "periodQuarter": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "nullable": true,
            "description": "Quarter 1-4 if periodType=quarter.",
            "title": "Period Quarter"
          },
          "state": {
            "type": "string",
            "enum": [
              "draft",
              "submitted",
              "accepted"
            ],
            "default": "draft",
            "description": "Lifecycle state.",
            "title": "State"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217, default EUR.",
            "title": "Currency"
          },
          "notes": {
            "type": "string",
            "nullable": true,
            "description": "Operator free text.",
            "title": "Notes"
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {
            "rule": "selectielijst:5.1.2",
            "period": "P7Y",
            "description": "ICP records retained 7 years per AWR art. 52."
          },
          "states": {
            "draft": {
              "label": "Concept",
              "description": "ICP-opgaaf being prepared."
            },
            "submitted": {
              "label": "Ingediend",
              "description": "Submitted to the Belastingdienst."
            },
            "accepted": {
              "label": "Geaccepteerd",
              "description": "Acknowledged by the Belastingdienst."
            }
          },
          "transitions": {
            "submit": {
              "from": "draft",
              "to": "submitted",
              "label": "Indienen",
              "description": "Operator submits the ICP-opgaaf."
            },
            "accept": {
              "from": "submitted",
              "to": "accepted",
              "label": "Acceptatie",
              "description": "Acknowledgement received."
            }
          }
        },
        "x-openregister-aggregations": {
          "icpTransactions": {
            "description": "Intra-community supply lines aggregated per counterparty VAT number for the period (REQ-VBTW-007).",
            "source": "GLLine",
            "groupBy": [
              "counterpartyVatNumber"
            ],
            "filter": {
              "icp": true,
              "periodYear": "@self.periodYear"
            },
            "sum": [
              "credit"
            ]
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
      },
      "VatCorrection": {
