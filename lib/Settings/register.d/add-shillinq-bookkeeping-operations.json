{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "add-shillinq-bookkeeping-operations",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "Tier 3 — NL compliance core: VAT/BTW filing, BBV account mapping, BCF compensation, ZZP deductions, schatkistbankieren, subsidie-verantwoording. Sibling schemas (KorRegime, Iv3Export, Project, RetentionRule, UrenRegistratie, RateCard, WipBalance) already live in the monolith from prior changes; this fragment adds only the missing schemas and extends Account/BbvAccountMapping additively."
  },
  "components": {
    "schemas": {
      "Account": {
        "properties": {
          "isSchatkistAccount": {"type": "boolean", "default": false, "description": "REQ-SBK-002: flags this account as a Treasury (schatkist) account so SchatkistPosition aggregates its postings. Additive extension merged onto the T1 Account schema via ADR-037 deep-merge."}
        }
      },
      "VatReturn": {
        "slug": "VatReturn",
        "icon": "FileDocumentOutline",
        "version": "0.1.0",
        "title": "BTW-aangifte",
        "description": "Periodic VAT return (BTW-aangifte) per administration and period. Tracks the draft → submitted → accepted → corrected lifecycle (REQ-VBTW-005), aggregates GL postings by VAT rate into rubrieken (REQ-VBTW-004), and submits via the digipoort-sbr OpenConnector source (REQ-VBTW-010). ADR-022 audit/approval, ADR-031 declarative lifecycle.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": ["administrationId", "periodType", "periodYear", "state"],
        "properties": {
          "administrationId": {"type": "string", "description": "FK to the administration owning this return.", "example": "adm-gemeente-1"},
          "periodType": {"type": "string", "enum": ["month", "quarter", "year"], "description": "Filing cadence per Wet OB 1968.", "example": "quarter"},
          "periodYear": {"type": "integer", "description": "Calendar year of the period.", "example": 2026},
          "periodMonth": {"type": "integer", "minimum": 1, "maximum": 12, "nullable": true, "description": "Month 1-12; required when periodType=month (REQ-VBTW-002)."},
          "periodQuarter": {"type": "integer", "minimum": 1, "maximum": 4, "nullable": true, "description": "Quarter 1-4; required when periodType=quarter (REQ-VBTW-002)."},
          "state": {"type": "string", "enum": ["draft", "submitted", "accepted", "corrected"], "default": "draft", "description": "Lifecycle state per REQ-VBTW-005."},
          "amount": {"type": "number", "description": "Total VAT liability (MonetaryAmount). Derived from rubrieken.", "example": 4250.5},
          "currency": {"type": "string", "default": "EUR", "description": "ISO 4217 currency, default EUR."},
          "approvalThreshold": {"type": "number", "nullable": true, "description": "Operator-configurable liability above which submission needs approval (REQ-VBTW-006)."},
          "submittedAt": {"type": "string", "format": "date-time", "nullable": true, "description": "Timestamp of SBR/Digipoort submission."},
          "acceptedAt": {"type": "string", "format": "date-time", "nullable": true, "description": "Timestamp of Digipoort acknowledgement."},
          "attachmentUri": {"type": "string", "nullable": true, "description": "docudesk reference to the aangifte PDF."},
          "notes": {"type": "string", "nullable": true, "description": "Operator free text."}
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {"rule": "selectielijst:5.1.2", "period": "P7Y", "description": "BTW records retained 7 years per AWR art. 52 + Selectielijst Gemeenten 2020."},
          "states": {
            "draft": {"label": "Concept", "description": "Return is being prepared; rubrieken aggregated from GL."},
            "submitted": {"label": "Ingediend", "description": "Submitted to the Belastingdienst via Digipoort/SBR. Awaiting acknowledgement."},
            "accepted": {"label": "Geaccepteerd", "description": "Belastingdienst acknowledged receipt. Terminal unless a suppletie correction is filed."},
            "corrected": {"label": "Gecorrigeerd", "description": "Superseded by a suppletie-aangifte (VatCorrection)."}
          },
          "transitions": {
            "submit": {"from": "draft", "to": "submitted", "label": "Indienen via Digipoort", "description": "Operator submits the return; requires approval above approvalThreshold (REQ-VBTW-006).", "requires": "OCA\\Shillinq\\Guard\\VatSubmissionGuard::requireApproval"},
            "accept": {"from": "submitted", "to": "accepted", "label": "Acceptatie", "description": "Digipoort acknowledgement received (triggered by OpenConnector digipoort-sbr callback)."},
            "correctAfter": {"from": "accepted", "to": "corrected", "label": "Suppletie", "description": "Operator files a suppletie-aangifte correcting an accepted return."},
            "correctEarly": {"from": "draft", "to": "corrected", "label": "Vroege correctie", "description": "Operator corrects the return before submission."}
          }
        },
        "x-openregister-aggregations": {
          "rubrieken": {
            "description": "VAT buckets summed per rate (21%, 9%, 0%, verlegd/reverse-charge) over GL postings in the return period per REQ-VBTW-004 and REQ-VBTW-009.",
            "source": "GLLine",
            "groupBy": ["vatRate", "reverseCharge"],
            "filter": {"administrationId": "@self.administrationId", "periodYear": "@self.periodYear"},
            "sum": ["debit", "credit"]
          }
        },
        "x-openregister-notifications": {
          "onSubmitted": {"trigger": "lifecycle.submit", "description": "Notify the vat-administrator when a return is submitted.", "recipients": {"role": "vat-administrator", "scope": "@self.administrationId"}, "title": "BTW-aangifte ingediend", "message": "BTW-aangifte voor @self.periodYear is ingediend via Digipoort."}
        },
        "x-openregister-rbac": {"roles": {"vat-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "IcpStatement": {
        "slug": "IcpStatement",
        "icon": "EarthArrowRight",
        "version": "0.1.0",
        "title": "ICP-opgaaf",
        "description": "Intra-community supplies declaration (opgaaf intracommunautaire prestaties) per REQ-VBTW-007. Tracks draft → submitted → accepted lifecycle and aggregates ICP transactions for the period.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": ["administrationId", "periodType", "periodYear", "state"],
        "properties": {
          "administrationId": {"type": "string", "description": "FK to the administration.", "example": "adm-mkb-1"},
          "periodType": {"type": "string", "enum": ["month", "quarter", "year"], "description": "Filing cadence."},
          "periodYear": {"type": "integer", "description": "Calendar year.", "example": 2026},
          "periodMonth": {"type": "integer", "minimum": 1, "maximum": 12, "nullable": true, "description": "Month 1-12 if periodType=month."},
          "periodQuarter": {"type": "integer", "minimum": 1, "maximum": 4, "nullable": true, "description": "Quarter 1-4 if periodType=quarter."},
          "state": {"type": "string", "enum": ["draft", "submitted", "accepted"], "default": "draft", "description": "Lifecycle state."},
          "currency": {"type": "string", "default": "EUR", "description": "ISO 4217, default EUR."},
          "notes": {"type": "string", "nullable": true, "description": "Operator free text."}
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {"rule": "selectielijst:5.1.2", "period": "P7Y", "description": "ICP records retained 7 years per AWR art. 52."},
          "states": {
            "draft": {"label": "Concept", "description": "ICP-opgaaf being prepared."},
            "submitted": {"label": "Ingediend", "description": "Submitted to the Belastingdienst."},
            "accepted": {"label": "Geaccepteerd", "description": "Acknowledged by the Belastingdienst."}
          },
          "transitions": {
            "submit": {"from": "draft", "to": "submitted", "label": "Indienen", "description": "Operator submits the ICP-opgaaf."},
            "accept": {"from": "submitted", "to": "accepted", "label": "Acceptatie", "description": "Acknowledgement received."}
          }
        },
        "x-openregister-aggregations": {
          "icpTransactions": {"description": "Intra-community supply lines aggregated per counterparty VAT number for the period (REQ-VBTW-007).", "source": "GLLine", "groupBy": ["counterpartyVatNumber"], "filter": {"administrationId": "@self.administrationId", "icp": true, "periodYear": "@self.periodYear"}, "sum": ["credit"]}
        },
        "x-openregister-rbac": {"roles": {"vat-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "VatCorrection": {
        "slug": "VatCorrection",
        "icon": "FileDocumentEditOutline",
        "version": "0.1.0",
        "title": "BTW-correctie (suppletie)",
        "description": "VAT correction submission (suppletie-aangifte) per REQ-VBTW-008. References the original VatReturn and carries an adjustment amount with a correction reason.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": ["administrationId", "periodType", "periodYear", "state", "correctionReason"],
        "properties": {
          "administrationId": {"type": "string", "description": "FK to the administration.", "example": "adm-mkb-1"},
          "periodType": {"type": "string", "enum": ["month", "quarter", "year"], "description": "Cadence of the corrected period."},
          "periodYear": {"type": "integer", "description": "Calendar year corrected.", "example": 2026},
          "periodMonth": {"type": "integer", "minimum": 1, "maximum": 12, "nullable": true, "description": "Month if applicable."},
          "periodQuarter": {"type": "integer", "minimum": 1, "maximum": 4, "nullable": true, "description": "Quarter if applicable."},
          "correctionReason": {"type": "string", "enum": ["underreporting", "overreporting", "calculation-error", "late-discovery"], "description": "Reason for the suppletie (REQ-VBTW-008)."},
          "originalReturnId": {"type": "string", "nullable": true, "description": "FK to the VatReturn being corrected."},
          "adjustmentAmount": {"type": "number", "description": "Net correction amount (MonetaryAmount; positive = additional liability).", "example": 320.0},
          "currency": {"type": "string", "default": "EUR", "description": "ISO 4217, default EUR."},
          "state": {"type": "string", "enum": ["draft", "submitted", "accepted"], "default": "draft", "description": "Lifecycle state."},
          "notes": {"type": "string", "nullable": true, "description": "Operator free text."}
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {"rule": "selectielijst:5.1.2", "period": "P7Y", "description": "Suppletie records retained 7 years per AWR art. 52."},
          "states": {
            "draft": {"label": "Concept", "description": "Suppletie being prepared."},
            "submitted": {"label": "Ingediend", "description": "Suppletie submitted to the Belastingdienst."},
            "accepted": {"label": "Geaccepteerd", "description": "Suppletie acknowledged."}
          },
          "transitions": {
            "submit": {"from": "draft", "to": "submitted", "label": "Indienen", "description": "Operator submits the suppletie."},
            "accept": {"from": "submitted", "to": "accepted", "label": "Acceptatie", "description": "Acknowledgement received."}
          }
        },
        "x-openregister-rbac": {"roles": {"vat-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "VatTariff": {
        "slug": "VatTariff",
        "icon": "PercentOutline",
        "version": "0.1.0",
        "title": "BTW-tarief",
        "description": "VAT rate definition (REQ-VBTW-003). Seeded from btw-tariffs-2026.json with the current statutory rates (21%, 9%, 0%, vrijgesteld, verlegd) and RGS account hints per Wet OB 1968.",
        "x-schema-org": "schema:DefinedTerm",
        "type": "object",
        "required": ["code", "ratePercentage"],
        "properties": {
          "code": {"type": "string", "description": "Tariff code (e.g. high, low, zero, exempt, reverse-charge).", "example": "high"},
          "label": {"type": "string", "description": "Human-readable label.", "example": "Hoog tarief"},
          "ratePercentage": {"type": "number", "description": "Statutory percentage (e.g. 21, 9, 0).", "example": 21},
          "rgsAccountHint": {"type": "string", "nullable": true, "description": "Suggested RGS account for postings at this rate.", "example": "WBeBoB"},
          "reverseCharge": {"type": "boolean", "default": false, "description": "True for verleggingsregeling rates (REQ-VBTW-009)."},
          "effectiveFrom": {"type": "string", "format": "date", "nullable": true, "description": "First date this rate is statutory."},
          "effectiveTo": {"type": "string", "format": "date", "nullable": true, "description": "Last date this rate is statutory (null = current)."},
          "legalBasis": {"type": "string", "nullable": true, "description": "Citation, e.g. Wet OB 1968 art. 9."}
        },
        "x-openregister-rbac": {"roles": {"vat-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "BbvAccountMapping": {
        "slug": "BbvAccountMapping",
        "icon": "TableArrowRight",
        "version": "0.1.0",
        "title": "BBV-toewijzing",
        "description": "Maps an RGS account to a BBV taakveld/programma/paragraaf for municipal administrations (REQ-BBV-002). Operator-overrideable per administration; default seeded from rgs-bbv.json. Carries bcfCompensable + compensablePercentage driving BCF claim aggregation (REQ-BCF-003/005) and iv3Bucket driving IV3 export (REQ-BBV-008).",
        "x-schema-org": "schema:PropertyValue",
        "type": "object",
        "required": ["administrationId", "accountNumber", "taakveld"],
        "properties": {
          "administrationId": {"type": "string", "description": "FK to the gemeente/provincie/waterschap administration.", "example": "adm-gemeente-1"},
          "accountNumber": {"type": "string", "description": "FK to Account.accountNumber (T1).", "example": "4250"},
          "taakveld": {"type": "string", "description": "BBV taakveld code per bbv-taakvelden-2024.json seed.", "example": "0.1"},
          "programmaCode": {"type": "string", "nullable": true, "description": "Operator-defined programma code.", "example": "1000"},
          "paragraafCode": {"type": "string", "nullable": true, "description": "Optional paragraaf code.", "example": "1001"},
          "bcfCompensable": {"type": "boolean", "default": false, "description": "True if postings on this account are BCF-compensable (REQ-BCF-003)."},
          "compensablePercentage": {"type": "integer", "minimum": 0, "maximum": 100, "default": 0, "description": "Percentage of VAT recoverable from the Compensatiefonds (REQ-BCF-005)."},
          "iv3Bucket": {"type": "string", "nullable": true, "description": "CBS IV3-bestand bucket name (REQ-BBV-008).", "example": "2.1"},
          "autorisatieniveau": {"type": "string", "enum": ["I", "II", "III"], "nullable": true, "description": "BBV authorization level."}
        },
        "x-openregister-constraints": {"unique": [["administrationId", "accountNumber"]]},
        "x-openregister-aggregations": {
          "byTaakveld": {"description": "GL postings grouped by taakveld for programma roll-up reporting (REQ-BBV-007).", "source": "GLLine", "groupBy": ["taakveld"], "filter": {"administrationId": "@self.administrationId"}, "sum": ["debit", "credit"]}
        },
        "x-openregister-rbac": {"roles": {"bbv-controller": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "BbvTaakveld": {
        "slug": "BbvTaakveld",
        "icon": "FormatListBulletedType",
        "version": "0.1.0",
        "title": "BBV-taakveld",
        "description": "Canonical BBV taakveld catalogue entry per Besluit BBV bijlage IV (REQ-BBV-004). Seeded from bbv-taakvelden-2024.json.",
        "x-schema-org": "schema:DefinedTerm",
        "type": "object",
        "required": ["code", "description"],
        "properties": {
          "code": {"type": "string", "description": "Taakveld code.", "example": "0.1"},
          "description": {"type": "string", "description": "Taakveld name.", "example": "Bestuur"},
          "programmaFocus": {"type": "string", "nullable": true, "description": "Hint linking the taakveld to a typical programma."},
          "bbvVersion": {"type": "string", "nullable": true, "description": "BBV catalogue version this entry belongs to.", "example": "2024"}
        },
        "x-openregister-rbac": {"roles": {"bbv-controller": {"permissions": ["read"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "BcfClaim": {
        "slug": "BcfClaim",
        "icon": "CashRefund",
        "version": "0.1.0",
        "title": "BCF-claim",
        "description": "BTW-Compensatiefonds claim per quarter for municipalities (REQ-BCF-001). Aggregates compensable VAT across BbvAccountMapping entries (REQ-BCF-004), tracks draft → submitted → accepted → settled lifecycle, and submits via the digikoppeling-bcf OpenConnector source (REQ-BCF-007).",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": ["administrationId", "periodYear", "periodQuarter", "state", "claimNumber"],
        "properties": {
          "administrationId": {"type": "string", "description": "FK to the gemeente administration.", "example": "adm-gemeente-1"},
          "periodYear": {"type": "integer", "description": "Claim calendar year.", "example": 2026},
          "periodQuarter": {"type": "integer", "minimum": 1, "maximum": 4, "description": "Claim quarter."},
          "claimNumber": {"type": "string", "description": "Unique claim identifier (REQ-BCF-002).", "example": "BCF-2026-Q1-0001"},
          "state": {"type": "string", "enum": ["draft", "submitted", "accepted", "settled"], "default": "draft", "description": "Lifecycle state (REQ-BCF-006)."},
          "totalClaimAmount": {"type": "number", "description": "Sum of compensable VAT (derived, REQ-BCF-004).", "example": 18250.0},
          "currency": {"type": "string", "default": "EUR", "description": "ISO 4217, default EUR."},
          "approvalThreshold": {"type": "number", "nullable": true, "description": "Operator-configurable amount above which submission needs approval (REQ-BCF-009)."},
          "claimDate": {"type": "string", "format": "date", "nullable": true, "description": "When the claim was prepared."},
          "submittedDate": {"type": "string", "format": "date", "nullable": true, "description": "When submitted via DigiKoppeling."},
          "settlementDate": {"type": "string", "format": "date", "nullable": true, "description": "When funds were received."},
          "attachmentUri": {"type": "string", "nullable": true, "description": "docudesk reference to the claim PDF."},
          "notes": {"type": "string", "nullable": true, "description": "Operator free text."}
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "retention": {"rule": "selectielijst:5.1.4", "period": "P10Y", "description": "BCF verantwoording records retained 10 years per Archiefwet 1995 + Selectielijst Gemeenten 2020."},
          "states": {
            "draft": {"label": "Concept", "description": "Claim being prepared; totalClaimAmount aggregated from compensable accounts."},
            "submitted": {"label": "Ingediend", "description": "Submitted to the Compensatiefonds via DigiKoppeling."},
            "accepted": {"label": "Geaccepteerd", "description": "Fonds acknowledged receipt."},
            "settled": {"label": "Afgewikkeld", "description": "Compensation payment received."}
          },
          "transitions": {
            "submit": {"from": "draft", "to": "submitted", "label": "Indienen via DigiKoppeling", "description": "Operator submits the claim; requires approval above approvalThreshold (REQ-BCF-009).", "requires": "OCA\\Shillinq\\Guard\\BcfSubmissionGuard::requireApproval"},
            "accept": {"from": "submitted", "to": "accepted", "label": "Acceptatie", "description": "Fonds acknowledgement received."},
            "settle": {"from": "accepted", "to": "settled", "label": "Afwikkelen", "description": "Compensation payment received."}
          }
        },
        "x-openregister-aggregations": {
          "compensableVatByAccount": {"description": "Sum of GLLine.amount × BbvAccountMapping.compensablePercentage for compensable accounts in the claim quarter (REQ-BCF-004).", "source": "GLLine", "groupBy": ["accountNumber"], "filter": {"administrationId": "@self.administrationId", "periodYear": "@self.periodYear", "periodQuarter": "@self.periodQuarter", "bcfCompensable": true}, "sum": ["amount"]}
        },
        "x-openregister-notifications": {
          "onSubmitted": {"trigger": "lifecycle.submit", "description": "Notify the bcf-administrator when a claim is submitted.", "recipients": {"role": "bcf-administrator", "scope": "@self.administrationId"}, "title": "BCF-claim ingediend", "message": "BCF-claim @self.claimNumber is ingediend bij het Compensatiefonds."}
        },
        "x-openregister-rbac": {"roles": {"bcf-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "ZzpDeduction": {
        "slug": "ZzpDeduction",
        "icon": "AccountCashOutline",
        "version": "0.1.0",
        "title": "ZZP-aftrek",
        "description": "ZZP tax deduction eligibility per freelancer per year (REQ-ZZP-004). Derives ytdQualifyingHours from UrenRegistratie (REQ-ZZP-003) and computes zelfstandigenaftrek + startersaftrek + MKB-winstvrijstelling from the zzp-deduction-amounts seed (REQ-ZZP-006).",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": ["personId", "administrationId", "year"],
        "properties": {
          "personId": {"type": "string", "description": "FK to the freelancer (Nextcloud user / contact).", "example": "user-priya"},
          "administrationId": {"type": "string", "description": "FK to the administration.", "example": "adm-zzp-1"},
          "year": {"type": "integer", "description": "Tax year.", "example": 2026},
          "ytdQualifyingHours": {"type": "number", "description": "YTD hours excluding excluded categories (derived, REQ-ZZP-003). Do not set directly.", "example": 1200},
          "qualifies1225": {"type": "boolean", "default": false, "description": "True when ytdQualifyingHours ≥ 1225 (REQ-ZZP-004)."},
          "qualifiesStarters": {"type": "boolean", "default": false, "description": "True for the first 2 years (800-hour threshold)."},
          "zelfstandigenaftrek": {"type": "number", "default": 0, "description": "Self-employed deduction (MonetaryAmount, from seed)."},
          "startersaftrek": {"type": "number", "default": 0, "description": "Starters deduction (MonetaryAmount, if qualifiesStarters)."},
          "mkbWinstvrijstelling": {"type": "number", "default": 0, "description": "MKB profit exemption (MonetaryAmount, from seed)."},
          "totalAllowableDeduction": {"type": "number", "description": "Sum of allowable deductions (derived, REQ-ZZP-006).", "example": 6900},
          "currency": {"type": "string", "default": "EUR", "description": "ISO 4217, default EUR."}
        },
        "x-openregister-calculations": {
          "ytdQualifyingHours": {"description": "Sum of UrenRegistratie.hours where category != excluded for the year, per personId (REQ-ZZP-003). ADR-031 exception: if OR cannot span fiscal periods, OCA\\Shillinq\\Guard\\UrencriteriumGuard::currentYtdHours provides the fallback.", "expr": "sum(UrenRegistratie.hours where category != 'excluded' and personId == @self.personId and year(workDate) == @self.year)", "guard": "OCA\\Shillinq\\Guard\\UrencriteriumGuard::currentYtdHours"},
          "totalAllowableDeduction": {"description": "zelfstandigenaftrek + (startersaftrek if qualifiesStarters) + mkbWinstvrijstelling (REQ-ZZP-006).", "expr": "@self.zelfstandigenaftrek + (@self.qualifiesStarters ? @self.startersaftrek : 0) + @self.mkbWinstvrijstelling"}
        },
        "x-openregister-rbac": {"roles": {"zzp-administrator": {"permissions": ["create", "read", "update"]}, "bookkeeper": {"permissions": ["read"]}, "auditor": {"permissions": ["read"]}}}
      },
      "IbAangifteExport": {
        "slug": "IbAangifteExport",
        "icon": "FileExportOutline",
        "version": "0.1.0",
        "title": "IB-aangifte-export",
        "description": "Inkomstenbelastingaangifte export for a freelancer (REQ-ZZP-007). Prepares the income/deduction/taxable-income fields for the Dutch income tax return and references a generated PDF via docudesk.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": ["personId", "year"],
        "properties": {
          "personId": {"type": "string", "description": "FK to the freelancer.", "example": "user-priya"},
          "year": {"type": "integer", "description": "Tax year exported.", "example": 2026},
          "exportDate": {"type": "string", "format": "date", "nullable": true, "description": "When the export was prepared."},
          "totalIncome": {"type": "number", "description": "Total income from GL revenue aggregation (MonetaryAmount).", "example": 65000},
