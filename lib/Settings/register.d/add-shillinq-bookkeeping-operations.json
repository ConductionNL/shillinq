      "ZzpDeduction": {
        "slug": "ZzpDeduction",
        "icon": "AccountCashOutline",
        "version": "0.1.0",
        "title": "ZZP-aftrek",
        "description": "ZZP tax deduction eligibility per freelancer per year (REQ-ZZP-004). Derives ytdQualifyingHours from UrenRegistratie (REQ-ZZP-003) and computes zelfstandigenaftrek + startersaftrek + MKB-winstvrijstelling from the zzp-deduction-amounts seed (REQ-ZZP-006).",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "personId",
          "administrationId",
          "year"
        ],
        "properties": {
          "personId": {
            "type": "string",
            "description": "FK to the freelancer (Nextcloud user / contact).",
            "example": "user-priya",
            "title": "Person ID"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the administration.",
            "example": "adm-zzp-1",
            "title": "Administration ID"
          },
          "year": {
            "type": "integer",
            "description": "Tax year.",
            "example": 2026,
            "title": "Year"
          },
          "ytdQualifyingHours": {
            "type": "number",
            "description": "YTD hours excluding excluded categories (derived, REQ-ZZP-003). Do not set directly.",
            "example": 1200,
            "title": "Ytd Qualifying Hours"
          },
          "qualifies1225": {
            "type": "boolean",
            "default": false,
            "description": "True when ytdQualifyingHours ≥ 1225 (REQ-ZZP-004).",
            "title": "Qualifies1225"
          },
          "qualifiesStarters": {
            "type": "boolean",
            "default": false,
            "description": "True for the first 2 years (800-hour threshold).",
            "title": "Qualifies Starters"
          },
          "selfEmployedDeduction": {
            "type": "number",
            "default": 0,
            "description": "Self-employed deduction (MonetaryAmount, from seed).",
            "title": "Zelfstandigenaftrek"
          },
          "starterDeduction": {
            "type": "number",
            "default": 0,
            "description": "Starters deduction (MonetaryAmount, if qualifiesStarters).",
            "title": "Startersaftrek"
          },
          "mkbProfitExemption": {
            "type": "number",
            "default": 0,
            "description": "MKB profit exemption (MonetaryAmount, from seed).",
            "title": "Mkb Winstvrijstelling"
          },
          "totalAllowableDeduction": {
            "type": "number",
            "description": "Sum of allowable deductions (derived, REQ-ZZP-006).",
            "example": 6900,
            "title": "Total Allowable Deduction"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-calculations": {
          "ytdQualifyingHours": {
            "description": "Sum of UrenRegistratie.hours where category != excluded for the year, per personId (REQ-ZZP-003). ADR-031 exception: if OR cannot span fiscal periods, OCA\\Shillinq\\Guard\\UrencriteriumGuard::currentYtdHours provides the fallback.",
            "expr": "sum(UrenRegistratie.hours where category != 'excluded' and personId == @self.personId and year(workDate) == @self.year)",
            "guard": "OCA\\Shillinq\\Guard\\UrencriteriumGuard::currentYtdHours"
          },
          "totalAllowableDeduction": {
            "description": "zelfstandigenaftrek + (startersaftrek if qualifiesStarters) + mkbWinstvrijstelling (REQ-ZZP-006).",
            "expr": "@self.zelfstandigenaftrek + (@self.qualifiesStarters ? @self.startersaftrek : 0) + @self.mkbWinstvrijstelling"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "zzp-administrator": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "bookkeeper": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        }
