      "BcfClaim": {
        "slug": "BcfClaim",
        "icon": "CashRefund",
        "version": "0.1.0",
        "title": "BCF-claim",
        "description": "BTW-Compensatiefonds claim per quarter for municipalities (REQ-BCF-001). Aggregates compensable VAT across BbvAccountMapping entries (REQ-BCF-004), tracks draft → submitted → accepted → settled lifecycle, and submits via the digikoppeling-bcf OpenConnector source (REQ-BCF-007).",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "administrationId",
