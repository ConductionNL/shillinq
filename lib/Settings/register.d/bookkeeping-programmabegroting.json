            "title": "Effectief Vanaf"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "determined"
            ],
            "default": "draft",
            "description": "Lifecycle status. REQ-009.",
            "example": "draft",
            "title": "Status"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the administration. REQ-009.",
            "example": "adm-gov-1",
            "title": "Administration ID"
          }
        },
        "x-openregister-lifecycle": {
          "field": "status",
          "initialState": "draft",
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Wijziging is being prepared; mutaties have no effect on the begroting stand yet."
            },
            "determined": {
              "label": "Vastgesteld",
              "description": "Adopted by raadsbesluit; the mutaties now stack onto the begroting stand."
            }
          },
          "transitions": {
            "vaststellen": {
              "from": "draft",
              "to": "determined",
              "label": "Vaststellen",
              "description": "Raad approves the wijziging; requires the raadsbesluit FK set (REQ-009).",
              "requires": "OCA\\Shillinq\\Lifecycle\\BegrotingswijzigingGuard::canVaststellen"
            }
          }
        }
      }
