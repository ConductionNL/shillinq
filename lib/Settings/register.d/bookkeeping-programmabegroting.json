              }
            ],
            "title": "Mutaties"
          },
          "councilResolution": {
            "type": "string",
            "nullable": true,
            "description": "FK to raadsbesluit (required before vastgesteld). REQ-009.",
            "example": null,
            "title": "Raadsbesluit"
          },
          "determinationDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Date the raad approved the wijziging. REQ-009.",
            "example": null,
            "title": "Vaststellings Datum"
          },
          "effectiveFrom": {
            "type": "string",
            "format": "date",
            "description": "Effective date of the change (may be retroactive). REQ-009.",
