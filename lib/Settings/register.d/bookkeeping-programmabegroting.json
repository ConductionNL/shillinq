    "change": "bookkeeping-programmabegroting",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "Tier 2 — BBV programmabegroting & meerjarenraming. Adds ten registers (Programmabegroting, Programma, Taakveld, Indicator, Investering, Reserve, Voorziening, Paragraaf, Meerjarenraming, Begrotingswijziging) that operationalise the complete Dutch municipal/provincial/waterschap begrotingsproces (opstellen → behandeling → vaststelling → wijzigingen → exports) per the Besluit begroting en verantwoording. The Programmabegroting carries a declarative x-openregister-lifecycle (draft → in-behandeling → vastgesteld → superseded) whose behandel- and vaststellings-transitions are gated by OCA\\Shillinq\\Lifecycle\\ProgrammabegrotingGuard (ADR-031 exception path: cross-schema paragraaf/meerjarenraming aggregation is not yet expressible in the declarative requires clause). The Begrotingswijziging carries a draft → vastgesteld lifecycle gated by OCA\\Shillinq\\Lifecycle\\BegrotingswijzigingGuard (raadsbesluit FK required). Computations (sluitend-criterium struktureel/reëel flags, toezichtRegime, Programma roll-up from child Taakvelden, Investering kapitaallastenschedule, Begrotingswijziging delta stacking, iv3/EMU/JSON exports) are pure integer-cent PHP calculators in OCA\\Shillinq\\Service, tested in isolation; the x-openregister-aggregations blocks document the equivalent declarative shape. Seed objects provide a worked gemeente example (Programmabegroting 2027 with two Programma's, their Taakvelden, paragrafen, meerjarenraming and one begrotingswijziging) per design.md."
  },
  "components": {
    "schemas": {
      "Programmabegroting": {
        "slug": "Programmabegroting",
        "icon": "FileDocumentOutline",
        "version": "0.1.0",
        "title": "Programmabegroting",
        "description": "BBV master budget authorisation document adopted annually by the raad / staten / algemeen bestuur (REQ-001). Carries the begrotingsjaar, organisationType, the unified draft → in-behandeling → vastgesteld → superseded lifecycle, and the computed sluitendStructureel / sluitendReëel / toezichtRegime flags set on vaststelling.",
        "x-schema-org": "schema:Plan",
        "x-spec": "openspec/changes/bookkeeping-programmabegroting/specs/bookkeeping-programmabegroting/spec.md",
        "type": "object",
        "required": [
          "version",
          "organisationId",
          "organisationType",
          "budgetYear",
          "meerjarenHorizon",
          "status",
          "structurallyBalanced",
          "sluitendReëel",
          "administrationId"
        ],
        "properties": {
          "version": {
            "type": "integer",
            "minimum": 1,
            "default": 1,
            "description": "Begroting version number (1 for initial vaststelling, incremented per major herziening). REQ-001.",
            "title": "Version"
          },
          "organisationId": {
            "type": "string",
            "description": "FK to the gemeente / provincie / waterschap this begroting belongs to. REQ-001.",
            "example": "gemeente-1",
            "title": "Organisation ID"
          },
          "organisationType": {
            "type": "string",
            "enum": [
              "municipality",
              "province",
              "waterAuthority"
            ],
            "description": "Organisation type determining the financieel toezichthouder. REQ-001.",
            "example": "municipality",
            "title": "Organisation Type"
          },
          "budgetYear": {
            "type": "integer",
            "minimum": 2000,
            "description": "Fiscal year the begroting covers (e.g. 2027). REQ-001.",
            "example": 2027,
            "title": "Begrotingsjaar"
          },
          "meerjarenHorizon": {
            "type": "integer",
            "minimum": 1,
            "default": 4,
            "description": "Number of meerjarenraming jaren T+1.T+N (default 4). REQ-001.",
            "example": 4,
            "title": "Meerjaren Horizon"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "in-behandeling",
              "determined",
              "superseded"
            ],
            "default": "draft",
            "description": "Lifecycle status (REQ-011). Set by x-openregister-lifecycle.",
            "example": "draft",
            "title": "Status"
          },
          "determinationDecision": {
            "type": "string",
            "nullable": true,
            "description": "FK to the raadsbesluit / statenbesluit / AB-besluit for audit traceability (required before vastgesteld). REQ-001 / REQ-011.",
            "example": "raadsbesluit-2026-114",
            "title": "Vaststellings Besluit"
          },
          "determinationDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Date the raad adopted the begroting. REQ-001.",
            "example": "2026-11-09",
            "title": "Vaststellings Datum"
          },
          "structurallyBalanced": {
            "type": "boolean",
            "default": false,
            "description": "Computed flag: recurring lasten ≤ recurring baten for all jaren T+1.T+4 (REQ-008 / REQ-011). Set by SluitendCalculator on vaststelling.",
            "example": true,
            "title": "Sluitend Structureel"
          },
          "sluitendReëel": {
            "type": "boolean",
            "default": false,
            "description": "Computed flag: saldoReëel ≥ 0 (after nominale-ontwikkeling correction) for all jaren T+1.T+4 (REQ-008 / REQ-011). Set by SluitendCalculator on vaststelling.",
            "example": true,
            "title": "Sluitend Reëel"
          },
          "supervisionRegime": {
            "type": "string",
            "enum": [
              "repressief",
              "preventief",
              "artikel-12"
            ],
            "nullable": true,
            "description": "Computed supervision regime (REQ-011, design D5): repressief only when both sluitend-flags hold and the 4-year history shows no sustained tekort.",
            "example": "repressief",
            "title": "Toezicht Regime"
          },
          "nominalDevelopment": {
            "type": "number",
            "nullable": true,
            "default": 2.0,
            "description": "Loon- en prijsindexatie percentage used to correct reëel-sluitend (user-configured annually per administration; default 2% per IPO). REQ-001 / design D7.",
            "example": 2.0,
            "title": "Nominale Ontwikkeling"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the administration; reads are scoped to the requesting user's administration (REQ-001).",
            "example": "adm-gov-1",
            "title": "Administration ID"
          }
        },
        "x-openregister-lifecycle": {
          "field": "status",
          "initialState": "draft",
          "retention": {
            "rule": "selectielijst:bbv-begroting",
            "period": "P10Y",
            "description": "Begrotingsstukken retained 10 years per Selectielijst Gemeenten 2020 (categorie begroting & verantwoording)."
          },
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Begroting is being prepared; programma's, taakvelden, paragrafen and meerjarenraming are authored. The seven paragrafen are auto-created on first draft."
            },
            "in-behandeling": {
              "label": "In behandeling",
              "description": "Begroting submitted to the raad for behandeling; sluitend-criterium is being evaluated."
            },
            "determined": {
              "label": "Vastgesteld",
              "description": "Adopted by raadsbesluit. Immutable — mutaties only via vastgestelde Begrotingswijzigingen."
            },
            "superseded": {
              "label": "Vervangen",
              "description": "Superseded by a newer begroting for the same begrotingsjaar (audit trail retained)."
            }
          },
          "transitions": {
            "behandelen": {
              "from": "draft",
              "to": "in-behandeling",
              "label": "In behandeling nemen",
              "description": "Operator submits the draft to the raad; requires all seven paragrafen created and nominaleOntwikkeling set (REQ-007 / REQ-011 / design D7).",
              "requires": "OCA\\Shillinq\\Lifecycle\\ProgrammabegrotingGuard::canBehandelen"
            },
            "vaststellen": {
              "from": "in-behandeling",
              "to": "determined",
              "label": "Vaststellen",
              "description": "Raad adopts the begroting; requires every paragraaf narrative non-empty and the raadsbesluit FK set. On success SluitendCalculator computes the sluitend-flags and toezichtRegime (REQ-008 / REQ-011).",
              "requires": "OCA\\Shillinq\\Lifecycle\\ProgrammabegrotingGuard::canVaststellen"
            },
            "vervangen": {
              "from": "determined",
              "to": "superseded",
              "label": "Vervangen",
              "description": "A newer begroting for the same begrotingsjaar is adopted; the prior begroting is marked superseded (REQ-011)."
            }
          }
        },
        "x-openregister-aggregations": {
          "sluitendByBegroting": {
            "description": "Declarative shape of the sluitend-criterium SluitendCalculator computes (REQ-008, REQ-011). Walks the Meerjarenraming records for jaren T+1.T+4 of this begroting and sets sluitendStructureel = (every jaar has lastenStructureel ≤ batenStructureel) and sluitendReëel = (every jaar has saldoReëel ≥ 0 after nominaleOntwikkeling correction). When the aggregation engine cannot express the per-year all-quantifier with the cross-schema nominale correction, SluitendCalculator computes the same result in PHP from the real ObjectService API.",
            "filter": {},
            "from": "Meerjarenraming",
            "groupBy": [
              "budgetId"
            ],
            "metrics": [
              {
                "metric": "all",
                "as": "sluitendStructureel"
              },
              {
                "metric": "all",
                "as": "sluitendReëel"
              }
            ]
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Programmabegroting is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
      "Programma": {
        "slug": "Programma",
        "icon": "ViewDashboardOutline",
        "version": "0.1.0",
        "title": "Programma",
        "description": "Locally-chosen political budget structure (REQ-002). batenTotaal / lastenTotaal / saldoVoorMutaties / saldoNaMutaties are roll-up sums computed by ProgrammaAggregator from the child Taakvelden (no rounding drift, design D1).",
        "x-schema-org": "schema:Plan",
        "x-spec": "openspec/changes/bookkeeping-programmabegroting/specs/bookkeeping-programmabegroting/spec.md",
        "type": "object",
        "required": [
          "budgetId",
          "number",
          "name",
          "revenueTotal",
          "expensesTotal",
          "balanceBeforeMovements",
          "balanceAfterMovements",
          "administrationId"
        ],
        "properties": {
          "budgetId": {
            "type": "string",
            "description": "FK to Programmabegroting. REQ-002.",
            "example": "pb-gem-2027",
            "title": "Begroting ID"
          },
          "number": {
            "type": "string",
            "description": "Sequential program number (e.g. \"1\", \"2\"). REQ-002.",
            "example": "1",
            "title": "Nummer"
          },
          "name": {
            "type": "string",
            "description": "Program name (e.g. \"Veiligheid & Handhaving\"). REQ-002.",
            "example": "Veiligheid & Handhaving",
            "title": "Naam"
          },
          "portfolioHolder": {
            "type": "string",
            "nullable": true,
            "description": "Assigned wethouder / gedeputeerde responsible. REQ-002.",
            "example": "Wethouder Veiligheid",
            "title": "Portefeuillehouder"
          },
          "doelstellingen": {
            "type": "string",
            "nullable": true,
            "description": "Rich-text narrative of program objectives and outcomes. REQ-002.",
            "example": "Handhaving van openbare orde en veiligheid in de gemeente.",
            "title": "Doelstellingen"
          },
          "revenueTotal": {
            "type": "number",
            "description": "Aggregated Σ(child Taakveld.baten) — computed by ProgrammaAggregator (REQ-002).",
            "example": 250000.0,
            "title": "Baten Totaal"
          },
          "expensesTotal": {
            "type": "number",
            "description": "Aggregated Σ(child Taakveld.lasten) — computed (REQ-002).",
            "example": 2500000.0,
            "title": "Lasten Totaal"
          },
          "balanceBeforeMovements": {
            "type": "number",
            "description": "batenTotaal - lastenTotaal — computed (REQ-002).",
            "example": -2250000.0,
            "title": "Saldo Voor Mutaties"
          },
          "movementsReserves": {
            "type": "number",
            "nullable": true,
            "default": 0,
            "description": "Reserve mutations (positive = toevoeging, negative = onttrekking). REQ-002.",
            "example": 0.0,
            "title": "Mutaties Reserves"
          },
          "balanceAfterMovements": {
            "type": "number",
            "description": "saldoVoorMutaties + mutatiesReserves — computed (REQ-002).",
            "example": -2250000.0,
            "title": "Saldo Na Mutaties"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the administration. REQ-002.",
            "example": "adm-gov-1",
            "title": "Administration ID"
          }
        },
        "x-openregister-aggregations": {
          "programmaRollup": {
            "description": "Declarative shape of the Programma roll-up ProgrammaAggregator computes (REQ-002, design D1). Sums child Taakveld.baten and Taakveld.lasten (in integer cents to avoid drift), derives saldoVoorMutaties = batenTotaal - lastenTotaal and saldoNaMutaties = saldoVoorMutaties + mutatiesReserves.",
            "filter": {},
            "operations": {
              "revenueTotal": {
                "field": "Taakveld.baten",
                "operation": "sum",
                "target": "revenueTotal"
              },
              "expensesTotal": {
                "field": "Taakveld.lasten",
                "operation": "sum",
                "target": "expensesTotal"
              },
              "balanceBeforeMovements": {
                "operation": "expression",
                "expression": "batenTotaal - lastenTotaal",
                "target": "balanceBeforeMovements"
              },
              "balanceAfterMovements": {
                "operation": "expression",
                "expression": "saldoVoorMutaties + mutatiesReserves",
                "target": "balanceAfterMovements"
              }
            },
            "from": "Taakveld",
            "groupBy": [
              "programmeId"
            ]
          }
        }
      },
