          },
          "description": {
            "type": "string",
            "description": "Description of the change. REQ-009.",
            "example": "Extra middelen handhaving evenementen",
            "title": "Omschrijving"
          },
          "movements": {
            "type": "array",
            "description": "Delta rows: per-programma per-taakveld {taakveldCode, baten_delta, lasten_delta}. REQ-009.",
