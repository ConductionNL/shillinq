{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "shillinq-notifications",
		"adr": "ADR-037 modular register fragment + ADR-022 OR notification engine + ADR-031 declarative business logic — never edit shillinq_register.json",
		"description": "kind: config — overlays x-openregister-notifications rules onto the chained financial schemas now that they live on development. AR/AP rules attach to ARInvoice (in the monolith) and PurchaseOrder (declared by bookkeeping-purchase-order-3way-01-schemas-and-registers). APInvoice + PaymentRun rules were already published with the AP-core schemas. All subjects bilingual nl/en and metadata-only (invoice/PO number + dueDate). Recipients use object-acl/groups for AR/AP and the PurchaseOrder.requester uid field for PO. NOTE: the proposal referred to PurchaseOrder.status but the schema's actual lifecycle field is statusCode — rule targets statusCode to match the live schema."
	},
	"components": {
		"ARInvoice": {
			"x-openregister-notifications": {
				"overdue": {
					"trigger": {
						"type": "scheduled",
						"intervalSec": 86400,
						"filter": {
							"all": [
								{
									"field": "state",
									"operator": "notIn",
									"values": ["paid", "written-off", "voided"]
								},
								{
									"field": "dueDate",
									"operator": "before",
									"value": "now"
								}
							]
						}
					},
					"enabled": true,
					"channels": [
						"nc-notification"
					],
					"recipients": [
						{
							"kind": "object-acl",
							"permission": "manage"
						},
						{
							"kind": "groups",
							"groups": [
								"shillinq-finance"
							]
						}
					],
					"subject": {
						"nl": "AR-factuur over de vervaldatum: {{invoiceNumber}} (verviel op {{dueDate}})",
						"en": "AR invoice overdue: {{invoiceNumber}} (was due {{dueDate}})"
					}
				},
				"paid": {
					"trigger": {
						"type": "updated",
						"condition": {
							"field": "state",
							"operator": "equals",
							"value": "paid"
						}
					},
					"enabled": true,
					"channels": [
						"nc-notification"
					],
					"recipients": [
						{
							"kind": "object-acl",
							"permission": "manage"
						}
					],
					"subject": {
						"nl": "AR-factuur betaald: {{invoiceNumber}}",
						"en": "AR invoice paid: {{invoiceNumber}}"
					}
				}
			}
		},
		"schemas": {
			"PurchaseOrder": {
				"x-openregister-notifications": {
					"submitted": {
						"trigger": {
							"type": "created"
						},
						"enabled": true,
						"channels": [
							"nc-notification"
						],
						"recipients": [
							{
								"kind": "field",
								"field": "requester"
							},
							{
								"kind": "groups",
								"groups": [
									"shillinq-procurement"
								]
							}
						],
						"subject": {
							"nl": "Inkooporder ingediend: {{poNumber}}",
							"en": "Purchase order submitted: {{poNumber}}"
						}
					},
					"approved": {
						"trigger": {
							"type": "updated",
							"condition": {
								"field": "statusCode",
								"operator": "equals",
								"value": "approved"
							}
						},
						"enabled": true,
						"channels": [
							"nc-notification"
						],
						"recipients": [
							{
								"kind": "field",
								"field": "requester"
							}
						],
						"subject": {
							"nl": "Inkooporder goedgekeurd: {{poNumber}}",
							"en": "Purchase order approved: {{poNumber}}"
						}
					}
				}
			}
		}
	}
}
