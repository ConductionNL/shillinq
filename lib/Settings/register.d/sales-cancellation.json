    "frequency": "monthly",
    "interval": 1,
    "startDate": "2025-10-01",
    "invoiceDay": 1,
    "issueMode": "draft-for-review",
    "paymentTermsDays": 14,
    "currency": "EUR",
    "administrationId": "adm-sportschool-de-kracht",
    "status": "ended",
    "cancellationReasonCode": "switched-provider",
    "cancellationReasonText": "We trainen voortaan bij een partner van onze huisarts",
    "cancellation": {
     "reasonCode": "switched-provider",
     "reasonText": "We trainen voortaan bij een partner van onze huisarts",
     "cancelledBy": "customer",
     "requestedAt": "2026-09-12T09:30:00+02:00",
     "effectiveDate": "2026-09-30"
    },
    "cancellationQuarter": "2026-Q3",
    "cancellationMonthlyAmount": 49.0,
    "deliveryChannel": "email"
   },
   {
    "@self": {
     "register": "shillinq",
     "schema": "RecurringInvoiceProfile",
     "slug": "rip-kracht-personal-training"
    },
    "name": "Personal training 10 lessen",
    "customerReference": "contact-kracht-member-pt",
    "lines": [
     {
      "description": "Personal training {month} {year}",
      "quantity": 1,
