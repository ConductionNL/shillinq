    "change": "sales-billable-rate-per-hour",
    "adr": "ADR-037 modular register fragment: never edit shillinq_register.json or other fragments.",
    "description": "Gives ProjectAssignment a billing role (the role tier of REQ-RATE-005) and the administration it belongs to, and points rateCardId at the RateCardTemplate the Rate cards page edits (REQ-BRPH-001, REQ-BRPH-004). Seeds the Renovatie Kade 12 example of design.md: rate card Standaard 2026 and the assignments of Alice, Bram and Chris."
  },
  "info": {
    "version": "0.1.0-sales-billable-rate-per-hour"
  },
  "components": {
    "schemas": {
      "ProjectAssignment": {
        "version": "0.2.0",
        "properties": {
          "rateCardId": {
            "type": "string",
            "description": "The RateCardTemplate (its templateId or id) that prices this person's hours on the project. The billable rate of each hour is resolved from the version of this card effective on the hour's date.",
            "example": "RCT-2026-STD",
            "title": "Rate card"
          },
          "recognisedRate": {
            "type": "number",
            "minimum": 0,
            "description": "The rate this assignment resolves to today, filled by the billable rate resolver and refreshed when the assignment or its rate card version changes. A display snapshot: an invoice line takes its rate from the hour's own resolution, never from this value.",
            "example": 120,
            "title": "Current rate"
          },
          "billingRoleId": {
            "type": "string",
            "nullable": true,
            "title": "Billing role",
            "description": "The role this person bills at on the project: the entityId of a role-tier RateSchedule on the rate card. Empty when the person has no role rate.",
            "example": "role-senior"
          },
          "administrationId": {
            "type": "string",
            "title": "Administration",
            "description": "The administration this assignment belongs to. Only rate cards of the same administration price its hours.",
            "example": "adm-1"
          }
        }
      }
    }
  },
