    "change": "sales-billable-rate-per-hour",
    "adr": "ADR-037 modular register fragment: never edit shillinq_register.json or other fragments.",
    "description": "Gives ProjectAssignment a billing role (the role tier of REQ-RATE-005) and the administration it belongs to, and points rateCardId at the RateCardTemplate the Rate cards page edits (REQ-BRPH-001, REQ-BRPH-004). Seeds the Renovatie Kade 12 example of design.md: rate card Standaard 2026 and the assignments of Alice, Bram and Chris."
  },
  "info": {
    "version": "0.1.0-sales-billable-rate-per-hour"
  },
  "components": {
    "schemas": {
      "ProjectAssignment": {
        "version": "0.2.0",
        "properties": {
          "rateCardId": {
            "type": "string",
            "description": "The rate card that prices this person's hours on the project. Each hour gets the rate of the card's version in effect on its date.",
            "example": "RCT-2026-STD",
            "title": "Rate card"
          },
          "recognisedRate": {
            "type": "number",
            "minimum": 0,
            "description": "The rate this assignment bills at today, refreshed when the assignment or its rate card changes. An invoice uses the rate of each hour itself, not this value.",
            "example": 120,
            "title": "Current rate"
          },
          "billingRoleId": {
            "type": "string",
            "nullable": true,
            "title": "Billing role",
            "description": "The role this person bills at on the project, as named in the role rates of the rate card. Leave empty when the person has no role rate.",
            "example": "role-senior"
          },
          "administrationId": {
            "type": "string",
            "title": "Administration",
            "description": "The administration this assignment belongs to. Only rate cards of the same administration price its hours.",
            "example": "adm-1"
          }
        }
      }
    }
  },
