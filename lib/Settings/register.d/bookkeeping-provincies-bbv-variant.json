{
  "components": {
    "schemas": {
      "GLLine": {
        "properties": {
          "programmeStructure": {
            "type": "string",
            "description": "BBV provincie programma-indeling this GL line is allocated to (REQ-BBL-001). One of the seven canonical provincie programmes per the BBV-provincies handleiding. Null until the line is mapped via the Budget-to-Programme Linker. Distinct from the BBVProgramma.programmaStructure discriminator (taakveld/kostentoedeling); on provincie administrations the seven values below are the canonical programme codes.",
            "enum": [
              "ruimte",
              "mobiliteit",
              "water",
              "milieu",
              "cultuur",
              "economie",
              "bestuur"
            ],
            "nullable": true,
            "example": "mobiliteit",
            "title": "Programma Structure"
          },
          "programmeAssignedAt": {
            "type": "string",
            "format": "date",
            "description": "Effective date on which programmaStructure was assigned via the Budget-to-Programme Linker or a manual detail edit (REQ-BBL-001/003). Null when unmapped.",
            "nullable": true,
            "example": "2026-05-21",
            "title": "Programma Assigned At"
          }
        },
        "x-openregister-lifecycle": {
          "preconditions": {
            "save": "OCA\\Shillinq\\Guard\\ProgrammaLinkGuard::validateOnSave"
          }
        },
        "x-openregister-aggregations": {
          "programmeBudgetVsActuals": {
            "description": "Spend and commitment roll-up per BBV provincie programme, consumed by the BBV Compliance Dashboard (REQ-BBC-001). Groups posted/committed GL lines by programmaStructure and fiscalYearId so the dashboard can compute Spent, Committed and Remaining against the matching Budget records. Lines with a null programmaStructure are excluded (unmapped).",
            "filter": {
              "programmeStructure": {
                "operator": "isNotNull"
              }
            },
            "groupBy": [
              "programmeStructure",
              "fiscalYearId"
            ],
            "metrics": [
              {
                "metric": "sum",
                "field": "amount",
                "condition": {
                  "side": "debit"
                },
                "as": "spent"
              },
              {
                "metric": "sum",
                "field": "amount",
                "condition": {
                  "side": "credit"
                },
                "as": "credited"
              },
              {
                "metric": "expression",
                "expression": "spent - credited",
                "as": "netSpent"
              }
            ]
          }
        }
      },
      "BbvProgrammeBudget": {
        "slug": "BbvProgrammeBudget",
        "icon": "CashMultiple",
        "version": "0.1.0",
        "title": "BBV Programme Budget",
        "description": "A BBV programme budget for a Dutch provincie administration (REQ-BBC-001). Each budget allocates a fiscal-year amount to exactly one of the seven canonical BBV provincie programmes. The BBV Compliance Dashboard aggregates Spent and Committed GL lines (matched on GLLine.programmaStructure + fiscalYear) against the budget Total to derive Remaining and the traffic-light status. Provincie-scoped; gemeente/waterschap administrations use taakveld/kostentoedeling mappings instead.",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-provincies-bbv-variant/spec.md",
        "type": "object",
        "required": [
          "budgetName",
          "totalAmount",
          "programmeStructure",
          "status",
          "fiscalYear",
          "administrationId"
        ],
        "properties": {
          "budgetName": {
            "type": "string",
            "description": "Human-readable budget name or identifier.",
            "example": "Mobiliteit operationeel 2026",
            "title": "Budget Name"
          },
          "totalAmount": {
            "type": "number",
            "minimum": 0,
            "description": "Total budgeted amount in EUR for the programme + fiscal year (REQ-BBC-001).",
            "example": 500000,
            "title": "Total Amount"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code; provincie budgets are EUR.",
            "default": "EUR",
            "example": "EUR",
            "title": "Currency"
          },
          "programmeStructure": {
            "type": "string",
            "description": "The canonical BBV provincie programme this budget allocates to (REQ-BBC-001). Locked to the seven legislated programmes; provinces with local variations map to this taxonomy (design D3).",
            "enum": [
              "ruimte",
              "mobiliteit",
              "water",
              "milieu",
              "cultuur",
              "economie",
              "bestuur"
            ],
            "example": "mobiliteit",
            "title": "Programma Structure"
          },
          "status": {
            "type": "string",
            "description": "Budget approval status used by the dashboard Budget-status filter (REQ-BBC-002).",
            "enum": [
              "approved",
              "provisional",
              "amended"
            ],
            "default": "provisional",
            "example": "approved",
            "title": "Status"
          },
          "fiscalYear": {
            "type": "integer",
            "description": "Fiscal year this budget applies to (REQ-BBC-002).",
            "example": 2026,
            "title": "Fiscal Year"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Date on which the budget becomes effective.",
            "nullable": true,
            "example": "2026-01-01",
            "title": "Start Date"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Date on which the budget expires.",
            "nullable": true,
            "example": "2026-12-31",
            "title": "End Date"
          },
          "description": {
            "type": "string",
            "description": "Optional purpose or scope description for the budget.",
            "nullable": true,
            "title": "Description"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the provincie Administration owning this budget.",
            "example": "adm-provincie-noord-holland",
            "title": "Administration ID"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "bookkeeping-approver": {
              "permissions": [
                "read",
                "update"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Budget is written to OpenRegister's immutable audit trail with actor and timestamp (REQ-AT-001)."
        }
      }
    }
  },
