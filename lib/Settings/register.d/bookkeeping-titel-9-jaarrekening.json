		"change": "bookkeeping-titel-9-jaarrekening",
		"spec": "openspec/changes/bookkeeping-titel-9-jaarrekening/specs/bookkeeping-titel-9-jaarrekening/spec.md",
		"description": "ADR-037 register fragment declaring the Titel 9 Boek 2 BW jaarrekening (annual financial statement) data model: AnnualReport, BalanceSheet, IncomeStatement, CashFlowStatement, Note, DirectorReport and ReviewWorkflow. Schema-declared per ADR-031 (lifecycle/RBAC/relations as metadata, no parallel service classes per ADR-022). The exact rubriek codes per art. 2:373 & 2:377 BW are stored as data; GL-to-rubriek mapping is configuration (lib/Settings/seeds/).",
		"imported": "2026-06-05T00:00:00Z"
	},
	"components": {
		"schemas": {
			"AnnualReport": {
				"slug": "AnnualReport",
				"icon": "FileDocumentOutline",
				"version": "0.1.0",
				"title": "Annual Report",
				"description": "Titel 9 Boek 2 BW jaarrekening root record for one administration and one boekjaar (REQ-T9-001, REQ-T9-010). Carries the computed groottecategorie with its onderbouwing, the rapportagegrondslag, valuta, and the concept -> opgemaakt -> in-review -> vastgesteld -> gedeponeerd lifecycle with its wettelijke termijnen. The constituent documents (BalanceSheet, IncomeStatement, CashFlowStatement, Note, DirectorReport) reference this record by reportId. Groottecategorie is computed, not operator-selectable (design D1); the report becomes an immutable snapshot at opmaak (design D2). No AnnualReportService PHP class; generation is templated per ADR-022/ADR-031.",
				"x-schema-org": "schema:Report",
				"x-spec": "openspec/changes/bookkeeping-titel-9-jaarrekening/specs/bookkeeping-titel-9-jaarrekening/spec.md",
				"type": "object",
				"x-openregister-unique": [
					[
						"administrationId",
						"boekjaarEind"
					]
				],
				"required": [
					"administrationId",
					"boekjaarStart",
					"boekjaarEind",
					"groottecategorie",
					"rapportageGrondslag",
					"valuta",
					"status"
				],
				"properties": {
					"administrationId": {
						"type": "string",
						"description": "FK to the Administration owning this jaarrekening.",
						"example": "adm-001"
					},
					"boekjaarStart": {
						"type": "string",
						"format": "date",
						"description": "First day of the boekjaar covered by this jaarrekening.",
						"example": "2025-01-01"
					},
					"boekjaarEind": {
						"type": "string",
						"format": "date",
						"description": "Last day (balansdatum) of the boekjaar. Drives all wettelijke termijnen per art. 2:391 BW (REQ-T9-010).",
						"example": "2025-12-31"
					},
					"groottecategorie": {
						"type": "string",
						"enum": [
							"micro",
							"klein",
							"middelgroot",
							"groot"
						],
						"description": "Computed size category per art. 2:395a-398 BW two-of-three criterion over two consecutive boekjaren (REQ-T9-001). Computed, not operator-selectable (design D1); operator override requires groottecategorieOnderbouwing.override with motivatie.",
						"example": "micro"
					},
					"groottecategorieOnderbouwing": {
						"type": "object",
						"nullable": true,
						"description": "Supporting numerics behind the groottecategorie classification (REQ-T9-001). Holds the two-of-three criterion values per boekjaar plus the matched-criteria count.",
						"properties": {
							"balansTotaal": {
								"type": "number",
								"description": "Balanstotaal (balance sheet total) used in classification."
							},
							"nettoOmzet": {
								"type": "number",
								"description": "Netto-omzet (net revenue) used in classification."
							},
							"gemiddeldAantalWerknemers": {
								"type": "number",
								"description": "Gemiddeld aantal werknemers (average number of employees)."
							},
							"criteriaMatched": {
								"type": "integer",
								"minimum": 0,
								"maximum": 3,
								"description": "Number of the three criteria that fall within the category band."
							},
							"years": {
								"type": "array",
								"items": {
									"type": "string"
								},
								"description": "The two consecutive boekjaren evaluated."
							},
							"override": {
								"type": "boolean",
								"default": false,
								"description": "True when an operator overrode the computed category (design D1)."
							},
							"overrideMotivatie": {
								"type": "string",
								"nullable": true,
								"description": "Required justification when override is true."
							}
						}
					},
					"rapportageGrondslag": {
						"type": "string",
						"enum": [
							"RJ-commercieel",
							"RJ-fiscaal",
							"IFRS-EU"
						],
						"default": "RJ-commercieel",
						"description": "Reporting basis (waarderingsgrondslag). RJ-commercieel is the Titel 9 default.",
						"example": "RJ-commercieel"
					},
					"valuta": {
						"type": "string",
						"description": "ISO-4217 presentation currency of the jaarrekening.",
						"default": "EUR",
						"example": "EUR"
					},
					"status": {
						"type": "string",
						"enum": [
							"concept",
							"opgemaakt",
							"in-review",
							"vastgesteld",
							"gedeponeerd"
						],
						"default": "concept",
						"description": "Lifecycle status (REQ-T9-010). concept: real-time, editable; opgemaakt: bestuur-signed immutable snapshot; in-review: under accountant review (bestuur read-only); vastgesteld: AV-approved, frozen; gedeponeerd: filed at KVK.",
						"example": "concept"
					},
					"opmaakDatum": {
						"type": "string",
						"format": "date",
						"nullable": true,
						"description": "Date the bestuur marked Opgemaakt (snapshot taken). Wettelijke termijn: 5 months after boekjaarEind, extendable to 10 (REQ-T9-010)."
					},
					"vaststellingDatum": {
						"type": "string",
						"format": "date",
						"nullable": true,
						"description": "Date the AV vaststelde the jaarrekening. Within 2 months after opmaak (REQ-T9-010)."
					},
					"depositeringDatum": {
						"type": "string",
						"format": "date",
						"nullable": true,
						"description": "Date the jaarrekening was deponed at KVK. Within 8 days after vaststelling; absolute deadline 12 months after boekjaarEind (REQ-T9-010)."
					},
					"snapshotHash": {
						"type": "string",
						"nullable": true,
						"description": "Cryptographic hash of the immutable snapshot taken at opmaak (REQ-T9-010, design D2). Set by the opmaak action."
					},
					"accountantsverklaringVereist": {
						"type": "boolean",
						"default": false,
						"description": "True when an accountantsverklaring is wettelijk verplicht (middelgroot+; REQ-T9-007/REQ-T9-009)."
					},
					"accountantsverklaringStatus": {
						"type": "string",
						"enum": [
							"niet-vereist",
							"in-afwachting",
							"goedkeurend",
							"met-beperking",
							"afkeurend",
							"oordeelonthouding",
							"samenstelling",
							"beoordeling"
						],
						"default": "niet-vereist",
						"description": "Status/type of the accountantsverklaring (NV-COS 700/4410/2400) per REQ-T9-007."
					},
					"kasstroomoverzichtVereist": {
						"type": "boolean",
						"default": false,
						"description": "True for middelgroot+ where a kasstroomoverzicht is verplicht (REQ-T9-005/REQ-T9-009)."
					},
					"bestuursverslagVereist": {
						"type": "boolean",
						"default": false,
						"description": "True for middelgroot+ where a bestuursverslag is verplicht (REQ-T9-006/REQ-T9-009)."
					},
					"bestuurLeden": {
						"type": "array",
						"description": "Names of the bestuursleden who sign the opmaak (REQ-T9-010).",
						"items": {
							"type": "string"
						}
					},
					"aandeelhoudersJSONB": {
						"type": "object",
						"nullable": true,
						"description": "Shareholder structure snapshot relevant to disclosure (free-form per administration)."
					}
				},
				"x-openregister-lifecycle": {
					"field": "status",
					"initialState": "concept",
					"states": {
						"concept": {
							"label": "Concept",
							"description": "Earliest form; balans/V&W recalculate as the GL changes (REQ-T9-010). Editable."
						},
						"opgemaakt": {
							"label": "Opgemaakt door bestuur",
							"description": "Bestuur-signed; an immutable snapshot is taken and all figures freeze (design D2)."
						},
						"in-review": {
							"label": "In review (accountant)",
							"description": "Under accountant review. Bestuur source data is read-only until the review is cancelled (REQ-T9-007)."
						},
						"vastgesteld": {
							"label": "Vastgesteld door AV",
							"description": "Approved by the algemene vergadering; final snapshot frozen; deponering activated (REQ-T9-010)."
						},
						"gedeponeerd": {
							"label": "Gedeponeerd bij KVK",
							"description": "Filed at KVK via SBR-XBRL; immutable final state (REQ-T9-008)."
						}
					},
					"transitions": {
						"opmaken": {
							"from": "concept",
							"to": "opgemaakt",
							"label": "Opmaken door bestuur",
							"description": "Bestuur signs the concept; an immutable snapshot is created (REQ-T9-010, design D2). Requires the balans to balance (activa = passiva).",
							"requires": "OCA\\Shillinq\\Lifecycle\\AnnualReportGuard::canOpmaken"
						},
						"naarReview": {
							"from": "opgemaakt",
							"to": "in-review",
							"label": "Indienen voor accountantscontrole",
							"description": "Submit the opgemaakte jaarrekening to the accountant. Bestuur source data becomes read-only (REQ-T9-007)."
						},
						"reviewAnnuleren": {
							"from": "in-review",
							"to": "opgemaakt",
							"label": "Review annuleren",
							"description": "Cancel the review to re-open bestuur editing (REQ-T9-007). The accountant change-log is retained."
						},
						"vaststellenZonderReview": {
							"from": "opgemaakt",
							"to": "vastgesteld",
							"label": "Vaststellen door AV",
							"description": "AV approves directly where no accountantsverklaring is verplicht (klein/micro; REQ-T9-007/REQ-T9-009).",
							"requires": "OCA\\Shillinq\\Lifecycle\\AnnualReportGuard::canVaststellen"
						},
						"vaststellen": {
							"from": "in-review",
							"to": "vastgesteld",
							"label": "Vaststellen na review",
							"description": "AV approves after accountant sign-off; an accountantsverklaring MUST be attached for middelgroot+ (REQ-T9-007/REQ-T9-010).",
							"requires": "OCA\\Shillinq\\Lifecycle\\AnnualReportGuard::canVaststellen"
						},
						"deponeren": {
							"from": "vastgesteld",
							"to": "gedeponeerd",
							"label": "Deponeren bij KVK",
							"description": "Hand the final AnnualReport snapshot to bookkeeping-sbr-xbrl-reporting for SBR-XBRL conversion and Digipoort submission (REQ-T9-008).",
							"actions": [
								{
									"trigger": "x-openregister-lifecycle-action",
									"action": "emit-cloud-event",
									"description": "Emit a CloudEvent consumed by bookkeeping-sbr-xbrl-reporting to convert the snapshot to SBR-XBRL and submit via Digipoort (REQ-T9-008). Cross-module integration point; no PHP orchestration here (ADR-022).",
									"actionParameters": {
										"eventType": "nl.shillinq.jaarrekening.gedeponeerd",
										"snapshotField": "snapshotHash"
									}
								}
							]
						}
					}
				},
