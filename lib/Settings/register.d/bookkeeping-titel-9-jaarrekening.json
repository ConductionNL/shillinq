							]
						}
					}
				}
			},
			"BalanceSheet": {
				"slug": "BalanceSheet",
				"icon": "ScaleBalance",
				"version": "0.1.0",
				"title": "Balance Sheet",
				"description": "Balans conforming to art. 2:373 BW (REQ-T9-002). Activa split into vaste activa (B.I immaterieel, B.II materieel, B.III financieel) and vlottende activa (C.I voorraden, C.II vorderingen, C.III effecten, C.IV liquide middelen); passiva split into A eigen vermogen, B voorzieningen, C langlopende schulden, D kortlopende schulden. Each rubriek carries huidigJaar, vorigJaar (comparatief) and footnote references. GL-to-rubriek mapping is configuration (lib/Settings/seeds/balans-rubriek-mapping.json), not code (design D3).",
				"x-schema-org": "schema:MonetaryAmount",
				"x-spec": "openspec/changes/bookkeeping-titel-9-jaarrekening/specs/bookkeeping-titel-9-jaarrekening/spec.md",
				"type": "object",
				"required": [
					"reportId",
					"balansDate",
					"currency",
					"status",
					"rubrieken"
				],
				"properties": {
					"reportId": {
						"type": "string",
						"description": "FK to the parent AnnualReport (REQ-T9-002).",
						"example": "annual-report-adm-001-2025"
					},
					"balansDate": {
						"type": "string",
						"format": "date",
						"description": "Balansdatum (= boekjaarEind).",
						"example": "2025-12-31"
					},
					"totalActiva": {
						"type": "number",
						"nullable": true,
						"description": "Computed total assets. MUST equal totalPassiva (balans balances)."
					},
					"totalPassiva": {
						"type": "number",
						"nullable": true,
						"description": "Computed total liabilities + equity. MUST equal totalActiva."
					},
					"currency": {
						"type": "string",
						"default": "EUR",
						"description": "ISO-4217 currency.",
						"example": "EUR"
					},
					"status": {
						"type": "string",
						"enum": [
							"draft",
							"final"
						],
						"default": "draft",
						"description": "draft while the parent AnnualReport is concept; final once opgemaakt (design D2)."
					},
					"rubrieken": {
						"type": "array",
						"description": "Wettelijke rubriek lines per art. 2:373 BW. Rubriek codes are first-class data (design D3).",
						"items": {
							"type": "object",
							"required": [
								"rubrieckCode",
								"rubrieckLabel",
								"huidigJaar"
							],
							"properties": {
								"rubrieckCode": {
									"type": "string",
									"description": "Wettelijke rubriek code per art. 2:373 BW (e.g. B.I, B.II, C.II, A, D).",
									"example": "B.II"
								},
								"rubrieckLabel": {
									"type": "string",
									"description": "Human-readable rubriek label.",
									"example": "Materiële vaste activa"
								},
								"zijde": {
									"type": "string",
									"enum": [
										"activa",
										"passiva"
									],
									"description": "Which side of the balans this rubriek belongs to."
								},
								"huidigJaar": {
									"type": "number",
									"description": "Current-year amount."
								},
								"vorigJaar": {
									"type": "number",
									"nullable": true,
									"description": "Prior-year comparatief amount (REQ-T9-002)."
								},
								"notes": {
									"type": "array",
									"items": {
										"type": "string"
									},
									"description": "FK references to linked Note records (toelichting)."
								}
							}
						}
					}
				},
