{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "bookkeeping-ifrs-16-lease",
		"adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
		"description": "Tier 4-specialized — IFRS 16 Leases. Adds five new schemas (LeaseContract master register, LeasePaymentSchedule derived amortization rows, LeaseReassessmentEvent modification/remeasurement log, LeaseDisclosureTable period-end snapshot, LeasePortfolioExemption policy elections) per design.md D1–D5. RoU asset and lease-liability recognition, period interest/principal split and straight-line depreciation are computed by OCA\\Shillinq\\Service\\LeaseAmortizationCalculator + LeasePaymentScheduleService + LeaseRecognitionService via the real OpenRegister ObjectService API (find/findAll/saveObject); disclosure aggregation by LeaseDisclosureService. LeaseContract carries an x-openregister-lifecycle state machine (draft→active→modified→terminated/expired, REQ-LC-004); LeasePaymentSchedule and LeaseReassessmentEvent are read-only / immutable-once-posted. A contact/lessor counterparty is a Nextcloud-synced contact (ADR-022) referenced by FK, never a new person schema; source documents reference docudesk via FK URIs. Seed objects provide worked examples (vehicle lease, real-estate lease, short-term-exempt copier, derived schedule rows, a disclosure table and an exemption policy) per design.md."
	},
	"components": {
		"schemas": {
			"LeaseContract": {
				"slug": "LeaseContract",
				"icon": "FileSign",
				"version": "0.1.0",
				"title": "Lease Contract",
				"description": "IFRS 16 lease-contract master record (REQ-LC-001, REQ-LC-002): one row per lease with lessor counterparty, asset class, term, payments, IBR, classification and a declarative draft→active→modified→terminated/expired lifecycle (REQ-LC-004).",
				"x-schema-org": "schema:Order",
				"x-spec": "openspec/changes/bookkeeping-ifrs-16-lease/specs/bookkeeping-lease-contracts/spec.md",
				"x-openregister-lifecycle": {
					"property": "status",
					"initial": "draft",
					"states": ["draft", "active", "modified", "terminated", "expired"],
					"transitions": [
						{
							"from": "draft",
							"to": "active",
							"trigger": "operator",
							"guard": "OCA\\Shillinq\\Lifecycle\\LeaseContractGuard::guardActivation"
						},
						{ "from": "active", "to": "modified", "trigger": "operator" },
						{ "from": "active", "to": "terminated", "trigger": "operator" },
						{ "from": "active", "to": "expired", "trigger": "system" },
						{ "from": "modified", "to": "active", "trigger": "operator" },
						{ "from": "modified", "to": "terminated", "trigger": "operator" }
					]
				},
				"type": "object",
				"required": [
					"leaseNumber",
					"counterparty",
					"description",
					"assetClass",
					"commencementDate",
					"endDate",
					"nonCancellableTermMonths",
					"paymentFrequency",
					"paymentTiming",
					"basePaymentAmount",
					"paymentCurrency",
					"ibrPercent",
					"ibrDerivationMethod",
					"classification",
					"status",
					"administrationId"
				],
				"properties": {
					"leaseNumber": {
						"type": "string",
						"description": "Sequential lease identifier per organisation (REQ-LC-002).",
						"example": "VH-2024-001"
					},
					"counterparty": {
						"type": "string",
						"description": "Lessor counterparty — FK to the Nextcloud-synced contact / organisations register (ADR-022); never a new person schema (REQ-LC-002).",
						"example": "contact:lease-hire-bv"
					},
					"description": {
						"type": "string",
						"description": "Human-readable lease description (REQ-LC-002).",
						"example": "Company car lease – Mercedes E-class, 3yr + 2yr extension"
					},
					"assetClass": {
						"type": "string",
						"description": "Underlying asset class for disclosure aggregation and CSRD E1 filtering (REQ-LC-002).",
						"enum": ["vehicle", "real-estate", "IT-hardware", "machinery", "other"],
						"example": "vehicle"
					},
					"commencementDate": {
						"type": "string",
						"format": "date",
						"description": "Lease commencement date (REQ-LC-002).",
						"example": "2024-01-15"
					},
					"endDate": {
						"type": "string",
						"format": "date",
						"description": "Scheduled non-cancellable term end date (REQ-LC-002).",
						"example": "2027-01-14"
					},
					"nonCancellableTermMonths": {
						"type": "integer",
						"minimum": 1,
						"description": "Non-cancellable term in whole months (REQ-LC-002).",
						"example": 36
					},
					"extensionOptions": {
						"type": "array",
						"description": "Extension options; months reasonably-certain to be exercised extend the schedule (REQ-LC-002, REQ-LA-002).",
						"items": {
							"type": "object",
							"properties": {
								"months": { "type": "integer" },
								"exerciseLikelihood": {
									"type": "string",
									"enum": ["reasonably-certain", "possible", "unlikely"]
								},
								"exerciseByDate": { "type": "string", "format": "date" }
							}
						}
					},
					"paymentFrequency": {
						"type": "string",
						"enum": ["monthly", "quarterly", "annual", "irregular"],
						"description": "Contractual payment cadence (REQ-LC-002).",
						"example": "monthly"
					},
					"paymentTiming": {
						"type": "string",
						"enum": ["in-advance", "in-arrears"],
						"description": "Whether each payment falls at period start (annuity-due) or end (REQ-LC-002).",
						"example": "in-arrears"
					},
					"basePaymentAmount": {
						"type": "number",
						"minimum": 0,
						"description": "Contractual payment amount per period before indexation (REQ-LC-002).",
						"example": 425.0
					},
					"paymentCurrency": {
						"type": "string",
						"description": "ISO 4217 payment currency (REQ-LC-002, REQ-LA-004).",
						"example": "EUR"
					},
					"indexationClause": {
						"type": "string",
						"enum": ["none", "fixed-percent", "CPI", "sector-index"],
						"description": "Indexation clause type (REQ-LC-002).",
						"nullable": true,
						"example": "fixed-percent"
					},
					"indexationRateOrSource": {
						"type": "string",
						"description": "Fixed percent (e.g. '2.0') or index reference (e.g. 'Dutch CPI') (REQ-LC-002).",
						"nullable": true,
						"example": "2.0"
					},
					"initialDirectCosts": {
						"type": "number",
						"minimum": 0,
						"description": "Initial direct costs added to the opening RoU asset (REQ-LA-001).",
						"nullable": true,
						"example": 150.0
					},
					"leaseIncentivesReceived": {
						"type": "number",
						"minimum": 0,
						"description": "Lease incentives deducted from the opening RoU asset (REQ-LA-001).",
						"nullable": true,
						"example": 0.0
					},
					"prepaidRentBalance": {
						"type": "number",
						"minimum": 0,
						"description": "Prepaid rent that reduces the opening RoU asset (REQ-LA-006).",
						"nullable": true,
						"example": 0.0
					},
					"accruedRentBalance": {
						"type": "number",
						"minimum": 0,
						"description": "Accrued rent that increases the opening RoU asset (REQ-LA-006).",
						"nullable": true,
						"example": 0.0
					},
					"restorationObligation": {
						"type": "object",
						"description": "Estimated restoration / make-good obligation discounted into the opening RoU asset (REQ-LA-005).",
						"nullable": true,
						"properties": {
							"estimatedCost": { "type": "number" },
							"discountRate": { "type": "number" }
						}
					},
					"ibrPercent": {
						"type": "number",
						"minimum": 0,
						"description": "Incremental borrowing rate at commencement, annual % (REQ-LC-002).",
						"example": 4.25
					},
					"ibrDerivationMethod": {
						"type": "string",
						"enum": ["group-policy", "yield-curve", "weighted-average", "external-quote", "N/A"],
						"description": "How the IBR was derived (REQ-LC-002).",
						"example": "group-policy"
					},
					"ibrSourceDocument": {
						"type": "string",
						"description": "FK URI to the docudesk document evidencing the IBR (REQ-LC-005).",
						"nullable": true,
						"example": "docudesk:document:ibr-matrix-2024-q1"
					},
					"classification": {
						"type": "string",
						"enum": ["IFRS16-capitalised", "short-term-exempt", "low-value-exempt", "operating-pre-IFRS16"],
						"description": "IFRS 16 classification (REQ-LC-002, REQ-LC-003).",
						"example": "IFRS16-capitalised"
					},
					"classificationRationale": {
						"type": "string",
						"description": "Audit rationale (checklist + free text) from the classification wizard (REQ-LC-003).",
						"nullable": true,
						"example": "Non-cancellable term 36m; not short-term; asset value > threshold; capitalised."
					},
					"status": {
						"type": "string",
						"enum": ["draft", "active", "modified", "terminated", "expired"],
						"description": "Lifecycle state (REQ-LC-004).",
						"example": "active"
					},
					"administrationId": {
						"type": "string",
						"description": "Administration / tenant scope (multitenancy, ADR-005 IDOR safety).",
						"example": "adm-smb-1"
					}
				}
			},
			"LeasePaymentSchedule": {
				"slug": "LeasePaymentSchedule",
				"icon": "TableClock",
				"version": "0.1.0",
				"title": "Lease Payment Schedule",
				"description": "Derived per-period amortization row (REQ-LA-002): opening/closing lease liability, interest accrual, principal portion, and straight-line RoU depreciation. Generated by LeasePaymentScheduleService when a lease activates; read-only / immutable until a reassessment regenerates future periods.",
				"x-schema-org": "schema:MonetaryAmount",
				"x-spec": "openspec/changes/bookkeeping-ifrs-16-lease/specs/bookkeeping-lease-accounting/spec.md",
				"x-openregister": { "readonly": true },
				"readonly": true,
				"type": "object",
				"required": [
					"leaseContract",
					"periodSequence",
					"openingLeaseLiability",
					"interestAccrued",
					"paymentPrincipalPortion",
					"closingLeaseLiability",
					"depreciationCharge",
					"administrationId"
				],
				"properties": {
					"leaseContract": {
						"type": "string",
						"description": "FK to the parent LeaseContract (REQ-LA-002).",
						"example": "lease-vh-2024-001"
					},
					"periodSequence": {
						"type": "integer",
						"minimum": 1,
						"description": "1-based payment period index (REQ-LA-002).",
						"example": 1
					},
					"periodStart": { "type": "string", "format": "date", "nullable": true },
					"periodEnd": { "type": "string", "format": "date", "nullable": true },
					"paymentDueDate": { "type": "string", "format": "date", "nullable": true },
					"contractualPaymentAmount": { "type": "number", "nullable": true },
					"paymentCurrency": { "type": "string", "nullable": true, "example": "EUR" },
					"fxRate": {
						"type": "number",
						"nullable": true,
						"description": "FX rate to functional currency for non-functional-currency leases (REQ-LA-004; full revaluation deferred to Phase 2)."
					},
					"openingLeaseLiability": { "type": "number", "example": 34300.0 },
					"interestAccrued": { "type": "number", "example": 114.33 },
					"paymentAppliedTotal": { "type": "number", "nullable": true, "example": 1000.0 },
					"paymentInterestPortion": { "type": "number", "nullable": true, "example": 114.33 },
					"paymentPrincipalPortion": { "type": "number", "example": 885.67 },
					"closingLeaseLiability": { "type": "number", "example": 33414.33 },
					"openingRouAsset": { "type": "number", "nullable": true, "example": 34300.0 },
					"depreciationCharge": { "type": "number", "example": 952.78 },
					"closingRouAsset": { "type": "number", "nullable": true, "example": 33347.22 },
					"postedToGl": {
						"type": "string",
						"nullable": true,
						"description": "FK to the GLTransaction once posted (ADR-022); null until period-close posting."
					},
					"administrationId": { "type": "string", "example": "adm-smb-1" }
				}
			},
			"LeaseReassessmentEvent": {
				"slug": "LeaseReassessmentEvent",
				"icon": "FileDocumentEditOutline",
				"version": "0.1.0",
				"title": "Lease Reassessment Event",
				"description": "First-class IFRS 16 modification / remeasurement record (REQ-LR-001, design.md D4): event type, before/after snapshots, IBR reset, liability/RoU adjustment, approver sign-off and GL posting FK. Immutable once posted; corrections are new events.",
				"x-schema-org": "schema:Action",
				"x-spec": "openspec/changes/bookkeeping-ifrs-16-lease/specs/bookkeeping-lease-reassessment/spec.md",
				"type": "object",
				"required": [
					"reassessmentNumber",
					"leaseContract",
					"eventDate",
					"eventType",
					"administrationId"
				],
				"properties": {
					"reassessmentNumber": { "type": "string", "example": "VH-2024-001-R1" },
					"leaseContract": { "type": "string", "example": "lease-vh-2024-001" },
					"eventDate": { "type": "string", "format": "date", "example": "2026-03-01" },
					"eventType": {
						"type": "string",
						"enum": [
							"indexation-remeasurement",
							"extension-option-reassessment",
							"termination-option-reassessment",
							"payment-modification",
							"scope-modification",
							"term-modification",
							"IBR-reset",
							"impairment",
							"abandonment",
							"partial-termination",
							"full-termination"
						],
						"example": "indexation-remeasurement"
					},
					"triggerDescription": { "type": "string", "nullable": true },
					"oldContractSnapshot": { "type": "object", "nullable": true },
					"newContractSnapshot": { "type": "object", "nullable": true },
					"remeasurementApproach": {
						"type": "string",
						"enum": ["catch-up-adjustment", "prospective", "separate-lease"],
						"nullable": true,
						"description": "IFRS 16.44 remeasurement approach (REQ-LR-003)."
					},
					"revisedIbrPercent": { "type": "number", "nullable": true },
					"revisedIbrRationale": { "type": "string", "nullable": true },
					"preEventLeaseLiability": { "type": "number", "nullable": true },
					"postEventLeaseLiability": { "type": "number", "nullable": true },
					"rouAssetAdjustment": {
						"type": "number",
						"nullable": true,
						"description": "RoU asset adjustment; events > EUR 100K route to decidesk approval (REQ-LR-005)."
					},
					"plImpact": { "type": "number", "nullable": true },
					"supportingDocuments": {
						"type": "array",
						"items": { "type": "string" },
						"description": "FK URIs to docudesk supporting documents (ADR-022)."
					},
					"approver": { "type": "string", "nullable": true },
					"approvalStatus": {
						"type": "string",
						"enum": ["pending", "approved", "rejected", "not-required"],
						"nullable": true,
						"example": "approved"
					},
					"approvalDate": { "type": "string", "format": "date", "nullable": true },
					"postedToGl": { "type": "string", "nullable": true },
					"administrationId": { "type": "string", "example": "adm-smb-1" }
				}
			},
			"LeaseDisclosureTable": {
				"slug": "LeaseDisclosureTable",
				"icon": "TableLarge",
				"version": "0.1.0",
				"title": "IFRS 16 Disclosure Table",
				"description": "Period-end disclosure snapshot (REQ-LD-001, design.md D5): RoU additions/depreciation/disposals and closing balance by asset class, current/non-current lease liability, maturity analysis buckets, weighted-average IBR per class, and the expense breakdown (interest, short-term, low-value, variable). Materialised at period close so prior-period restatements do not retroactively change a published disclosure.",
				"x-schema-org": "schema:Report",
				"x-spec": "openspec/changes/bookkeeping-ifrs-16-lease/specs/bookkeeping-lease-disclosures/spec.md",
				"type": "object",
				"required": [
					"fiscalPeriod",
					"totalLeaseLiabilityCurrent",
					"totalLeaseLiabilityNoncurrent",
					"administrationId"
				],
				"properties": {
					"fiscalPeriod": { "type": "string", "example": "2026" },
					"totalRouAssetByClass": { "type": "object", "nullable": true },
					"totalRouAdditionsInPeriod": { "type": "number", "nullable": true },
					"totalRouDepreciationInPeriod": { "type": "number", "nullable": true },
					"totalRouDisposalsInPeriod": { "type": "number", "nullable": true },
					"closingRouByClass": { "type": "object", "nullable": true },
					"totalLeaseLiabilityCurrent": { "type": "number", "example": 11500.0 },
					"totalLeaseLiabilityNoncurrent": { "type": "number", "example": 22300.0 },
					"maturityAnalysis": {
						"type": "object",
						"nullable": true,
						"description": "Undiscounted liability by maturity bucket (REQ-LD-001).",
						"properties": {
							"lt1y": { "type": "number" },
							"y1to2": { "type": "number" },
							"y2to3": { "type": "number" },
							"y3to4": { "type": "number" },
							"y4to5": { "type": "number" },
							"gt5y": { "type": "number" }
						}
					},
					"weightedAverageIbrByClass": { "type": "object", "nullable": true },
					"totalInterestExpense": { "type": "number", "nullable": true },
					"totalShortTermLeaseExpense": { "type": "number", "nullable": true },
					"totalLowValueLeaseExpense": { "type": "number", "nullable": true },
					"totalVariableLeaseExpense": { "type": "number", "nullable": true },
					"qualitativeNarrative": { "type": "string", "nullable": true },
					"generatedAt": { "type": "string", "nullable": true },
					"materializedAtPeriodClose": { "type": "boolean", "nullable": true, "example": true },
					"administrationId": { "type": "string", "example": "adm-smb-1" }
				}
			},
			"LeasePortfolioExemption": {
				"slug": "LeasePortfolioExemption",
				"icon": "ShieldCheckOutline",
				"version": "0.1.0",
				"title": "Lease Portfolio Exemption Policy",
				"description": "Short-term (IFRS 16.5) and low-value (IFRS 16.6) exemption policy elections by asset class (REQ-LE-001). One effective-dated policy record per administration; superseded-by self-FK keeps the policy history.",
				"x-schema-org": "schema:Action",
				"x-spec": "openspec/changes/bookkeeping-ifrs-16-lease/specs/bookkeeping-lease-exemptions/spec.md",
				"type": "object",
				"required": [
					"policyEffectiveDate",
					"lowValueThreshold",
					"administrationId"
				],
				"properties": {
					"policyEffectiveDate": { "type": "string", "format": "date", "example": "2026-01-01" },
					"shortTermByClass": {
						"type": "object",
						"description": "Short-term exemption elected (true/false) per asset class (REQ-LE-001).",
						"nullable": true
					},
					"lowValueThreshold": {
						"type": "number",
						"minimum": 0,
						"description": "Low-value threshold in functional currency (~USD 5,000 equivalent) (REQ-LE-002).",
						"example": 5000.0
					},
					"lowValueByClass": { "type": "object", "nullable": true },
					"policyApprover": { "type": "string", "nullable": true },
					"policyDocument": { "type": "string", "nullable": true },
					"supersededBy": { "type": "string", "nullable": true },
					"administrationId": { "type": "string", "example": "adm-smb-1" }
				}
			}
		},
