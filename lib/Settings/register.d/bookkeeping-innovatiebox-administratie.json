      "NexusCalculation": {
        "slug": "NexusCalculation",
        "icon": "Sigma",
        "version": "0.1.0",
        "title": "Nexus Calculation",
        "description": "OECD BEPS Action 5 modified-nexus calculation per asset per fiscal year (REQ-IBA-002). nexusbreuk = min(1; 1.3 x (eigen + uitbesteed_derden) / totaal). Immutable after creation (audit-trail enforced).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-innovatiebox-administratie/specs/bookkeeping-innovatiebox-administratie/spec.md#req-iba-002",
        "x-openregister": {
          "immutable": true
        },
        "type": "object",
        "required": [
          "qualifying_asset_id",
          "boekjaar",
          "eigen_rd_kosten",
          "rd_kosten_uitbesteed_derden",
          "rd_kosten_uitbesteed_verbonden",
          "totale_rd_kosten",
          "uplift_factor",
          "nexusbreuk_toegepast",
          "administrationId"
        ],
        "properties": {
          "qualifying_asset_id": {
            "type": "string",
            "description": "FK to QualifyingAsset.",
            "example": "qa-2024-001",
            "title": "Qualifying Asset ID"
          },
          "boekjaar": {
            "type": "integer",
            "example": 2024,
            "title": "Boekjaar",
            "description": "The numeric value for boekjaar."
          },
          "eigen_rd_kosten": {
            "type": "number",
            "minimum": 0,
            "example": 480000.0,
            "title": "Eigen Rd Kosten",
            "description": "The numeric value for eigen rd kosten."
          },
          "rd_kosten_uitbesteed_derden": {
            "type": "number",
            "minimum": 0,
            "description": "R&D outsourced to unrelated third parties (counts in the teller).",
            "example": 120000.0,
            "title": "Rd Kosten Uitbesteed Derden"
          },
          "rd_kosten_uitbesteed_verbonden": {
            "type": "number",
            "minimum": 0,
            "description": "R&D outsourced to related entities per art. 10a Vpb (noemer only, never in teller).",
            "example": 80000.0,
            "title": "Rd Kosten Uitbesteed Verbonden"
          },
          "totale_rd_kosten": {
            "type": "number",
            "minimum": 0,
            "example": 680000.0,
            "title": "Totale Rd Kosten",
            "description": "The totale rd kosten as a numeric value."
          },
          "uplift_factor": {
            "type": "number",
            "description": "Fixed 1.3 per OECD BEPS Action 5.",
            "default": 1.3,
            "example": 1.3,
            "title": "Uplift Factor"
          },
          "nexus_teller_voor_uplift": {
            "type": "number",
            "description": "eigen_rd_kosten + rd_kosten_uitbesteed_derden.",
            "example": 600000.0,
            "title": "Nexus Teller Voor Uplift"
          },
          "nexus_teller_na_uplift": {
            "type": "number",
            "description": "min(uplift_factor x teller_voor_uplift, totale_rd_kosten).",
            "example": 680000.0,
            "title": "Nexus Teller Na Uplift"
          },
          "nexus_noemer": {
            "type": "number",
            "example": 680000.0,
            "title": "Nexus Noemer",
            "description": "The numeric value for nexus noemer."
          },
          "nexusbreuk_ongecapt": {
            "type": "number",
            "example": 1.0,
            "title": "Nexusbreuk Ongecapt",
            "description": "The numeric value for nexusbreuk ongecapt."
          },
          "nexusbreuk_toegepast": {
            "type": "number",
            "description": "min(nexusbreuk_ongecapt, 1.0), capped at 100%.",
            "example": 1.0,
            "title": "Nexusbreuk Toegepast"
          },
          "berekend_op": {
            "type": "string",
            "format": "date-time",
            "title": "Berekend Op",
            "description": "The berekend op."
          },
          "berekend_door": {
            "type": "string",
            "nullable": true,
            "title": "Berekend Door",
            "description": "The berekend door."
          },
          "administrationId": {
            "type": "string",
            "example": "adm-mkb-1",
            "title": "Administration ID",
            "description": "The date and time for administration id."
          }
        },
        "x-openregister-aggregations": {
          "nexusByAssetYear": {
            "description": "Declarative shape of the modified-nexus roll-up NexusCalculationService computes (REQ-IBA-002). Groups R&D cost by (qualifying_asset_id, boekjaar), derives teller_voor_uplift = eigen + uitbesteed_derden, teller_na_uplift = min(1.3 x teller_voor_uplift, totaal), and nexusbreuk_toegepast = min(teller_na_uplift / totaal, 1.0).",
            "source": "NexusCalculation",
            "groupBy": [
              "NexusCalculation.qualifying_asset_id",
              "NexusCalculation.boekjaar"
            ],
            "operations": {
              "nexusbreuk_toegepast": {
                "operation": "expression",
                "expression": "min(min(1.3 * (eigen_rd_kosten + rd_kosten_uitbesteed_derden), totale_rd_kosten) / totale_rd_kosten, 1.0)",
                "target": "nexusbreuk_toegepast"
              }
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Nexus Calculation is written to OpenRegister's immutable audit trail with actor and timestamp (REQ-AT-001)."
        }
      },
      "IBProfitAttribution": {
        "slug": "IBProfitAttribution",
        "icon": "ChartPie",
        "version": "0.1.0",
        "title": "IB Profit Attribution",
        "description": "Per-asset winsttoerekening per fiscal year using one of three methods: per_asset_afpelmethode, forfaitair_25pct (25% capped at EUR 25k, no nexus), cost_plus (REQ-IBA-003). Exactly one record per (qualifying_asset_id, boekjaar).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-innovatiebox-administratie/specs/bookkeeping-innovatiebox-administratie/spec.md#req-iba-003",
        "type": "object",
        "required": [
          "qualifying_asset_id",
          "boekjaar",
          "methode",
          "bruto_opbrengst_activum",
          "kwalificerende_winst_voor_nexus",
          "nexus_calculation_id",
          "nexusbreuk_toegepast",
          "kwalificerende_winst_na_nexus",
          "effectief_tarief",
          "vpb_op_innovatiedeel",
          "voordeel_innovatiebox",
          "administrationId"
        ],
        "properties": {
          "qualifying_asset_id": {
            "type": "string",
            "example": "qa-2024-001",
            "title": "Qualifying Asset ID",
            "description": "The identifier of the associated qualifying asset."
          },
          "boekjaar": {
            "type": "integer",
            "example": 2024,
            "title": "Boekjaar",
            "description": "The numeric value for boekjaar."
          },
          "methode": {
            "type": "string",
            "enum": [
              "per_asset_afpelmethode",
              "forfaitair_25pct",
              "cost_plus"
            ],
            "example": "per_asset_afpelmethode",
            "title": "Methode",
            "description": "The methode."
          },
          "bruto_opbrengst_activum": {
            "type": "number",
            "minimum": 0,
            "example": 2400000.0,
            "title": "Bruto Opbrengst Activum",
            "description": "The numeric value for bruto opbrengst activum."
          },
          "directe_kosten_activum": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 850000.0,
            "title": "Directe Kosten Activum",
            "description": "The numeric value for directe kosten activum."
          },
          "routine_marketing_winst": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 180000.0,
            "title": "Routine Marketing Winst",
            "description": "The numeric value for routine marketing winst."
          },
          "routine_distributie_winst": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 90000.0,
            "title": "Routine Distributie Winst",
            "description": "The numeric value for routine distributie winst."
          },
          "routine_productie_winst": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 480000.0,
            "title": "Routine Productie Winst",
            "description": "The numeric value for routine productie winst."
          },
          "kwalificerende_winst_voor_nexus": {
            "type": "number",
            "description": "bruto_opbrengst - directe_kosten - sum(routines).",
            "example": 800000.0,
            "title": "Kwalificerende Winst Voor Nexus"
          },
          "nexus_calculation_id": {
            "type": "string",
            "example": "nx-2024-001",
            "title": "Nexus Calculation ID",
            "description": "The date and time for nexus calculation id."
          },
          "nexusbreuk_toegepast": {
            "type": "number",
            "example": 1.0,
            "title": "Nexusbreuk Toegepast",
            "description": "The numeric value for nexusbreuk toegepast."
          },
          "kwalificerende_winst_na_nexus": {
            "type": "number",
            "description": "kwalificerende_winst_voor_nexus x nexusbreuk_toegepast (afpelmethode); min(0.25 x profit, 25000) for forfaitair.",
            "example": 800000.0,
            "title": "Kwalificerende Winst Na Nexus"
          },
          "effectief_tarief": {
            "type": "number",
            "description": "Innovatiebox tariff 0.09 (Wet Vpb art. 12b 2026, REQ-IBA-010).",
            "default": 0.09,
            "example": 0.09,
            "title": "Effectief Tarief"
          },
          "vpb_op_innovatiedeel": {
            "type": "number",
            "description": "kwalificerende_winst_na_nexus x effectief_tarief.",
            "example": 72000.0,
            "title": "VpB Op Innovatiedeel"
          },
          "vpb_zonder_innovatiebox": {
            "type": "number",
            "description": "kwalificerende_winst_voor_nexus x 0.258 (standard rate, for comparison).",
            "example": 206400.0,
            "title": "VpB Zonder Innovatiebox"
          },
          "voordeel_innovatiebox": {
            "type": "number",
            "description": "vpb_zonder_innovatiebox - vpb_op_innovatiedeel.",
            "example": 134400.0,
            "title": "Voordeel Innovatiebox"
          },
          "drempel_2024": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Drempel 2024",
            "description": "The numeric value for drempel 2024."
          },
          "drempel_resterend": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Drempel Resterend",
            "description": "The numeric value for drempel resterend."
          },
          "vso_locked": {
            "type": "boolean",
            "description": "True once the fiscal year is signed off in a VSO; record becomes read-only (REQ-IBA-008).",
            "default": false,
            "title": "Vso Locked"
          },
          "forfaitair_cap_applied": {
            "type": "boolean",
            "description": "True when the forfaitair_25pct election hit the EUR 25k annual cap (art. 12bg). Drives the ForfaitairCap.applied audit event (REQ-IBA-008).",
            "default": false,
            "title": "Forfaitair Cap Applied"
          },
          "administrationId": {
            "type": "string",
            "example": "adm-mkb-1",
            "title": "Administration ID",
            "description": "The date and time for administration id."
          }
        },
        "x-openregister-aggregations": {
          "innovatieboxAdministratie": {
            "description": "Per-asset Vpb innovatiebox roll-up (REQ-IBA-006). For each valid QualifyingAsset, joins IBProfitAttribution + NexusCalculation + CarryForwardLoss for the boekjaar and emits naam, kwalificerende_winst_voor_nexus, nexusbreuk_toegepast, kwalificerende_winst_na_nexus, effectief_tarief, vpb_op_innovatiedeel. The grand total contributes to Vpb-aangifte regel 23. InnovatieboxAggregationService computes this in PHP from the real ObjectService API.",
            "source": "IBProfitAttribution",
            "join": {
              "from": "IBProfitAttribution.qualifying_asset_id",
              "through": "QualifyingAsset",
              "on": "QualifyingAsset.id",
              "select": [
                "QualifyingAsset.naam",
                "QualifyingAsset.status"
              ]
            },
            "filter": {
              "boekjaar": "@self.boekjaar",
              "administrationId": "@self.administrationId"
            },
            "groupBy": [
              "IBProfitAttribution.qualifying_asset_id"
            ],
            "operations": {
              "vpb_op_innovatiedeel": {
                "field": "IBProfitAttribution.kwalificerende_winst_na_nexus",
                "operation": "sum",
                "target": "vpb_op_innovatiedeel"
              }
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a IB Profit Attribution is written to OpenRegister's immutable audit trail with actor and timestamp (REQ-AT-001)."
        }
      },
