      "NexusCalculation": {
        "slug": "NexusCalculation",
        "icon": "Sigma",
        "version": "0.1.0",
        "title": "Nexus Calculation",
        "description": "OECD BEPS Action 5 modified-nexus calculation per asset per fiscal year. nexusbreuk = min(1; 1.3 x (eigen + uitbesteed_derden) / totaal). Immutable after creation (audit-trail enforced).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-innovatiebox-administratie/specs/bookkeeping-innovatiebox-administratie/spec.md#req-iba-002",
        "x-openregister": {
          "immutable": true
        },
        "type": "object",
        "required": [
          "qualifying_asset_id",
          "financialYear",
          "own_rd_cost",
          "rd_cost_outsourced_third_parties",
          "rd_cost_outsourced_affiliated",
          "total_rd_cost",
          "uplift_factor",
          "nexus_fraction_applied",
          "administrationId"
        ],
        "properties": {
          "qualifying_asset_id": {
            "type": "string",
            "description": "FK to QualifyingAsset.",
            "example": "qa-2024-001",
            "title": "Qualifying Asset ID"
          },
          "financialYear": {
            "type": "integer",
            "example": 2024,
            "title": "Boekjaar",
            "description": "The numeric value for boekjaar."
          },
          "own_rd_cost": {
            "type": "number",
            "minimum": 0,
            "example": 480000.0,
            "title": "Eigen Rd Kosten",
            "description": "The numeric value for eigen rd kosten."
          },
          "rd_cost_outsourced_third_parties": {
            "type": "number",
            "minimum": 0,
            "description": "R&D outsourced to unrelated third parties (counts in the teller).",
            "example": 120000.0,
            "title": "Rd Kosten Uitbesteed Derden"
          },
          "rd_cost_outsourced_affiliated": {
            "type": "number",
            "minimum": 0,
            "description": "R&D outsourced to related entities per art. 10a Vpb (noemer only, never in teller).",
            "example": 80000.0,
            "title": "Rd Kosten Uitbesteed Verbonden"
          },
          "total_rd_cost": {
            "type": "number",
            "minimum": 0,
            "example": 680000.0,
            "title": "Totale Rd Kosten",
            "description": "The totale rd kosten as a numeric value."
          },
          "uplift_factor": {
            "type": "number",
            "description": "Fixed 1.3 per OECD BEPS Action 5.",
            "default": 1.3,
            "example": 1.3,
            "title": "Uplift Factor"
          },
          "nexus_teller_for_uplift": {
            "type": "number",
            "description": "eigen_rd_kosten + rd_kosten_uitbesteed_derden.",
            "example": 600000.0,
            "title": "Nexus Teller Voor Uplift"
          },
          "nexus_teller_after_uplift": {
            "type": "number",
            "description": "min(uplift_factor x teller_voor_uplift, totale_rd_kosten).",
            "example": 680000.0,
            "title": "Nexus Teller Na Uplift"
          },
          "nexus_denominator": {
            "type": "number",
            "example": 680000.0,
            "title": "Nexus Noemer",
            "description": "The numeric value for nexus noemer."
          },
          "nexusbreuk_ongecapt": {
            "type": "number",
            "example": 1.0,
            "title": "Nexusbreuk Ongecapt",
            "description": "The numeric value for nexusbreuk ongecapt."
          },
          "nexus_fraction_applied": {
            "type": "number",
            "description": "min(nexusbreuk_ongecapt, 1.0), capped at 100%.",
            "example": 1.0,
            "title": "Nexusbreuk Toegepast"
          },
          "calculated_on": {
            "type": "string",
            "format": "date-time",
            "title": "Berekend Op",
            "description": "The berekend op."
          },
          "calculated_by": {
            "type": "string",
            "nullable": true,
            "title": "Berekend Door",
            "description": "The berekend door."
          },
          "administrationId": {
            "type": "string",
            "example": "adm-mkb-1",
            "title": "Administration ID",
            "description": "The date and time for administration id."
          }
        },
        "x-openregister-aggregations": {
          "nexusByAssetYear": {
            "description": "Declarative shape of the modified-nexus roll-up NexusCalculationService computes. Groups R&D cost by (qualifying_asset_id, boekjaar), derives teller_voor_uplift = eigen + uitbesteed_derden, teller_na_uplift = min(1.3 x teller_voor_uplift, totaal), and nexusbreuk_toegepast = min(teller_na_uplift / totaal, 1.0).",
            "source": "NexusCalculation",
            "groupBy": [
              "NexusCalculation.qualifying_asset_id",
              "NexusCalculation.financialYear"
            ],
            "operations": {
              "nexus_fraction_applied": {
                "operation": "expression",
                "expression": "min(min(1.3 * (eigen_rd_kosten + rd_kosten_uitbesteed_derden), totale_rd_kosten) / totale_rd_kosten, 1.0)",
                "target": "nexus_fraction_applied"
              }
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a Nexus Calculation is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
      "IBProfitAttribution": {
        "slug": "IBProfitAttribution",
