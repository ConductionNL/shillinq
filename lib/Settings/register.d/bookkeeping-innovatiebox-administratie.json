        "version": "0.1.0",
        "title": "IB Profit Attribution",
        "description": "Per-asset winsttoerekening per fiscal year using one of three methods: per_asset_afpelmethode, forfaitair_25pct (25% capped at EUR 25k, no nexus), cost_plus. Exactly one record per (qualifying_asset_id, boekjaar).",
        "x-schema-org": "schema:MonetaryAmount",
        "x-spec": "openspec/changes/bookkeeping-innovatiebox-administratie/specs/bookkeeping-innovatiebox-administratie/spec.md#req-iba-003",
        "type": "object",
        "required": [
          "qualifying_asset_id",
          "financialYear",
          "method",
          "gross_revenue_asset",
          "qualifying_profit_for_nexus",
          "nexus_calculation_id",
          "nexus_fraction_applied",
          "qualifying_profit_after_nexus",
          "effective_rate",
          "vpb_on_innovation_share",
          "benefit_innovation_box",
          "administrationId"
        ],
        "properties": {
          "qualifying_asset_id": {
            "type": "string",
            "example": "qa-2024-001",
            "title": "Qualifying Asset ID",
            "description": "The identifier of the associated qualifying asset."
          },
          "financialYear": {
            "type": "integer",
            "example": 2024,
            "title": "Boekjaar",
            "description": "The numeric value for boekjaar."
          },
          "method": {
            "type": "string",
            "enum": [
              "per_asset_afpelmethode",
              "flat_rate_25pct",
              "cost_plus"
            ],
            "example": "per_asset_afpelmethode",
            "title": "Methode",
            "description": "The methode."
          },
          "gross_revenue_asset": {
            "type": "number",
            "minimum": 0,
            "example": 2400000.0,
            "title": "Bruto Opbrengst Activum",
            "description": "The numeric value for bruto opbrengst activum."
          },
          "direct_cost_asset": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 850000.0,
            "title": "Directe Kosten Activum",
            "description": "The numeric value for directe kosten activum."
          },
          "routine_marketing_profit": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 180000.0,
            "title": "Routine Marketing Winst",
            "description": "The numeric value for routine marketing winst."
          },
          "routine_distribution_profit": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 90000.0,
            "title": "Routine Distributie Winst",
            "description": "The numeric value for routine distributie winst."
          },
          "routine_production_profit": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "example": 480000.0,
            "title": "Routine Productie Winst",
            "description": "The numeric value for routine productie winst."
          },
          "qualifying_profit_for_nexus": {
            "type": "number",
            "description": "bruto_opbrengst - directe_kosten - sum(routines).",
            "example": 800000.0,
            "title": "Kwalificerende Winst Voor Nexus"
          },
          "nexus_calculation_id": {
            "type": "string",
            "example": "nx-2024-001",
            "title": "Nexus Calculation ID",
            "description": "The date and time for nexus calculation id."
          },
          "nexus_fraction_applied": {
            "type": "number",
            "example": 1.0,
            "title": "Nexusbreuk Toegepast",
            "description": "The numeric value for nexusbreuk toegepast."
          },
          "qualifying_profit_after_nexus": {
            "type": "number",
            "description": "kwalificerende_winst_voor_nexus x nexusbreuk_toegepast (afpelmethode); min(0.25 x profit, 25000) for forfaitair.",
            "example": 800000.0,
            "title": "Kwalificerende Winst Na Nexus"
          },
          "effective_rate": {
            "type": "number",
            "description": "Innovatiebox tariff 0.09 (Wet Vpb art. 12b 2026).",
            "default": 0.09,
            "example": 0.09,
            "title": "Effectief Tarief"
          },
          "vpb_on_innovation_share": {
            "type": "number",
            "description": "kwalificerende_winst_na_nexus x effectief_tarief.",
            "example": 72000.0,
            "title": "VpB Op Innovatiedeel"
          },
          "vpb_without_innovation_box": {
            "type": "number",
            "description": "kwalificerende_winst_voor_nexus x 0.258 (standard rate, for comparison).",
            "example": 206400.0,
            "title": "VpB Zonder Innovatiebox"
          },
          "benefit_innovation_box": {
            "type": "number",
            "description": "vpb_zonder_innovatiebox - vpb_op_innovatiedeel.",
            "example": 134400.0,
            "title": "Voordeel Innovatiebox"
          },
          "threshold_2024": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Drempel 2024",
            "description": "The numeric value for drempel 2024."
          },
          "threshold_remaining": {
            "type": "number",
            "minimum": 0,
            "default": 0,
            "title": "Drempel Resterend",
            "description": "The numeric value for drempel resterend."
          },
          "vso_locked": {
            "type": "boolean",
            "description": "True once the fiscal year is signed off in a VSO; record becomes read-only.",
            "default": false,
            "title": "Vso Locked"
          },
          "flat_rate_cap_applied": {
            "type": "boolean",
            "description": "True when the forfaitair_25pct election hit the EUR 25k annual cap (art. 12bg). Drives the ForfaitairCap.applied audit event.",
            "default": false,
            "title": "Forfaitair Cap Applied"
          },
          "administrationId": {
            "type": "string",
            "example": "adm-mkb-1",
            "title": "Administration ID",
            "description": "The date and time for administration id."
          }
        },
        "x-openregister-aggregations": {
          "innovatieboxAdministratie": {
            "description": "Per-asset Vpb innovatiebox roll-up. For each valid QualifyingAsset, joins IBProfitAttribution + NexusCalculation + CarryForwardLoss for the boekjaar and emits naam, kwalificerende_winst_voor_nexus, nexusbreuk_toegepast, kwalificerende_winst_na_nexus, effectief_tarief, vpb_op_innovatiedeel. The grand total contributes to Vpb-aangifte regel 23. InnovatieboxAggregationService computes this in PHP from the real ObjectService API.",
            "join": {
              "from": "IBProfitAttribution.qualifying_asset_id",
              "through": "QualifyingAsset",
              "on": "QualifyingAsset.id",
              "select": [
                "QualifyingAsset.name",
                "QualifyingAsset.status"
              ]
            },
            "filter": {},
            "groupBy": [
              "financialYear",
              "IBProfitAttribution.qualifying_asset_id"
            ],
            "from": "IBProfitAttribution",
            "metrics": [
              {
                "metric": "sum",
                "field": "qualifying_profit_after_nexus",
                "as": "vpb_on_innovation_share"
              }
            ]
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true,
          "description": "Every create, update and delete of a IB Profit Attribution is written to OpenRegister's immutable audit trail with actor and timestamp."
        }
      },
