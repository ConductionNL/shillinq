{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "bookkeeping-cbs-bestanden-extended",
    "adr": "ADR-037 modular register fragment — never edit shillinq_register.json",
    "description": "CBS bestanden (Statistics Netherlands statistical reporting) extended pipeline beyond the mandatory IV3-bestand. Adds two entities: CBSSubmission (header tracking submission metadata, lifecycle draft → validated → submitted → accepted/rejected per) and CBSLine (aggregated financial line items per CBS classification, computed from GL transactions per). Declarative lifecycle, RBAC and retention per ADR-022/ADR-031. The prior add-shillinq-cbs-bestanden-extended change shipped only the proposal/design/spec authoring; this fragment is the executable schema + seed-data delivery."
  },
  "components": {
    "schemas": {
      "CBSSubmission": {
        "slug": "CBSSubmission",
        "icon": "FileChartCheckOutline",
        "version": "0.1.0",
        "title": "CBS-aangifte",
        "description": "Complete CBS statistical submission package for a reporting period. Header for the IV3-extended report, linking organization metadata, reporting period, lifecycle state, and generated IV3 file. Audit-trail + 10-year retention per Archiefwet 1995.",
        "x-schema-org": "schema:GovernmentService",
        "type": "object",
        "required": [
          "submissionNumber",
          "reportingPeriodStartDate",
          "reportingPeriodEndDate",
          "organizationLegalName",
          "kvkNumber",
          "taxIdentificationNumber",
          "administrationId",
          "status"
        ],
        "properties": {
          "submissionNumber": {
            "type": "string",
            "description": "Unique submission identifier (e.g., CBS-2025-001).",
            "example": "CBS-2025-001",
            "title": "Submission Number"
          },
          "reportingPeriodStartDate": {
            "type": "string",
            "format": "date",
            "description": "First day of the reporting period (usually 1 Jan).",
            "example": "2025-01-01",
            "title": "Reporting Period Start Date"
          },
          "reportingPeriodEndDate": {
            "type": "string",
            "format": "date",
            "description": "Last day of the reporting period (usually 31 Dec).",
            "example": "2025-12-31",
            "title": "Reporting Period End Date"
          },
          "organizationLegalName": {
            "type": "string",
            "description": "Legal name of the reporting organization.",
            "example": "Gemeente Amsterdam",
            "title": "Organization Legal Name"
          },
          "kvkNumber": {
            "type": "string",
            "pattern": "^[0-9]{8}$",
            "description": "Dutch Chamber of Commerce registration number (8 digits).",
            "example": "34365416",
            "title": "KvK Number"
          },
          "taxIdentificationNumber": {
            "type": "string",
            "pattern": "^NL[0-9]{10}B[0-9]{2}$",
            "description": "Dutch VAT/BTW identification number.",
            "example": "NL814022818B01",
            "title": "Tax Identification Number"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the reporting Administration.",
            "example": "adm-001",
            "title": "Administration ID"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "validated",
              "submitted",
              "accepted",
              "rejected"
            ],
            "default": "draft",
            "description": "Lifecycle state.",
            "title": "Status"
          },
          "submissionDate": {
            "type": "string",
            "format": "date-time",
            "nullable": true,
            "description": "Timestamp when submission was sent to CBS.",
            "title": "Submission Date"
          },
          "iv3FileUri": {
            "type": "string",
            "nullable": true,
            "description": "OpenRegister file reference to the generated IV3 JSON package.",
            "title": "Iv3File URI"
          },
          "iv3Checksum": {
            "type": "string",
            "nullable": true,
            "description": "SHA-256 checksum of the generated IV3 file content.",
            "title": "Iv3Checksum"
          },
          "validationErrors": {
            "type": "array",
            "nullable": true,
            "description": "Recorded validation errors that blocked the validate transition.",
            "items": {
              "type": "string"
            },
            "title": "Validation Errors"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Optional notes or memo on this submission.",
            "title": "Description"
          },
          "currency": {
            "type": "string",
            "default": "EUR",
            "description": "ISO 4217 currency code, default EUR.",
            "title": "Currency"
          }
        },
        "x-openregister-lifecycle": {
          "field": "status",
          "initialState": "draft",
          "retention": {
            "rule": "selectielijst:5.1.4",
            "period": "P10Y",
            "description": "CBS submission records retained 10 years per Archiefwet 1995."
          },
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Submission created, CBSLines computed, IV3 file not yet validated."
            },
            "validated": {
              "label": "Gevalideerd",
              "description": "Structural validation passed; IV3 file attached; ready for CBS submission."
            },
            "submitted": {
              "label": "Ingediend",
              "description": "Operator has submitted the package to the CBS portal."
            },
            "accepted": {
              "label": "Geaccepteerd",
              "description": "CBS has accepted the submission (manual operator update or webhook)."
            },
            "rejected": {
              "label": "Afgewezen",
              "description": "CBS has rejected the submission; correction submission required."
            }
          },
          "transitions": {
            "validate": {
              "from": "draft",
              "to": "validated",
              "label": "Valideren",
              "description": "Run structural + balancing validation, attach IV3 file."
            },
            "submit": {
              "from": "validated",
              "to": "submitted",
              "label": "Indienen",
              "description": "Record submission timestamp and downstream delivery."
            },
            "accept": {
              "from": "submitted",
              "to": "accepted",
              "label": "Accepteren",
              "description": "Record CBS acceptance."
            },
            "reject": {
              "from": "submitted",
              "to": "rejected",
              "label": "Afwijzen",
              "description": "Record CBS rejection reason."
            }
          }
        },
        "x-openregister-aggregations": {
          "totalAggregatedAmount": {
            "description": "Sum of CBSLine.aggregatedAmount for this submission, used by validation to compare against GL totals.",
            "filter": {},
            "from": "CBSLine",
            "metric": "sum",
            "field": "aggregatedAmount",
            "groupBy": [
              "cbsSubmissionId"
            ]
          }
        },
        "x-openregister-notifications": {
          "onValidated": {
            "trigger": {
              "type": "transition",
              "action": "validate"
            },
            "description": "Notify the finance manager when a CBS submission passes validation.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "finance-manager"
                ]
              }
            ],
            "subject": {
              "nl": "CBS-levering {{submissionNumber}} is gevalideerd en gereed voor verzending naar het CBS",
              "en": "CBS submission {{submissionNumber}} has been validated and is ready for delivery to CBS"
            }
          },
          "onRejected": {
            "trigger": {
              "type": "transition",
              "action": "reject"
            },
            "description": "Notify the finance manager when CBS rejects a submission.",
            "enabled": true,
            "channels": [
              "nc-notification"
            ],
            "recipients": [
              {
                "kind": "object-acl",
                "permission": "manage"
              },
              {
                "kind": "groups",
                "groups": [
                  "finance-manager"
                ]
              }
            ],
            "subject": {
              "nl": "CBS-levering {{submissionNumber}} is afgewezen door het CBS; een correctielevering is vereist",
              "en": "CBS submission {{submissionNumber}} was rejected by CBS; a correction submission is required"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "finance-manager": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "accountant": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read",
                "validate"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true
        }
      },
      "CBSLine": {
        "slug": "CBSLine",
        "icon": "TableRow",
        "version": "0.1.0",
        "title": "CBS-regel",
        "description": "Aggregated financial line item within a CBS submission. Each line sums GL transactions whose account number falls within the configured range, classified by CBS line code (Revenue, OperatingCosts, Depreciation, Interest, Taxes, OtherIncome, OtherExpenses).",
        "x-schema-org": "schema:MonetaryAmount",
        "type": "object",
        "required": [
          "cbsSubmissionId",
          "cbsLineClassification",
          "cbsLineNumber",
          "accountRangeStart",
          "accountRangeEnd",
          "aggregatedAmount",
          "currency"
        ],
        "properties": {
          "cbsSubmissionId": {
            "type": "string",
            "format": "uuid",
            "$ref": "CBSSubmission",
            "description": "FK to CBSSubmission.",
            "example": "cbs-sub-2025-org-001",
            "title": "CBS Submission ID"
          },
          "cbsLineClassification": {
            "type": "string",
            "enum": [
              "Revenue",
              "OperatingCosts",
              "Depreciation",
              "Interest",
              "Taxes",
              "OtherIncome",
              "OtherExpenses"
            ],
            "description": "CBS line category from IV3 format.",
            "title": "CBS Line Classification"
          },
          "cbsLineNumber": {
            "type": "string",
            "description": "Official CBS line number in IV3 format (e.g., 1000, 2000).",
            "example": "1000",
            "title": "CBS Line Number"
          },
          "accountRangeStart": {
            "type": "string",
            "description": "GL account code range start.",
            "example": "4000",
            "title": "Account Range Start"
          },
          "accountRangeEnd": {
            "type": "string",
            "description": "GL account code range end.",
            "example": "4999",
            "title": "Account Range End"
          },
          "aggregatedAmount": {
            "type": "number",
            "description": "Sum of GL line amounts for this range (MonetaryAmount, integer-cent EUR).",
            "example": 125000000,
            "title": "Aggregated Amount"
          },
          "glLineCount": {
            "type": "integer",
            "nullable": true,
            "description": "Number of GL lines aggregated into this CBSLine (auditing aid).",
            "example": 142,
            "title": "GL Line Count"
          },
          "currency": {
            "type": "string",
            "pattern": "^[A-Z]{3}$",
            "default": "EUR",
            "description": "ISO 4217 currency code.",
            "title": "Currency"
          },
          "description": {
            "type": "string",
            "nullable": true,
            "description": "Notes on the aggregation logic or variance.",
            "title": "Description"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "finance-manager": {
              "permissions": [
                "create",
                "read",
                "update"
              ]
            },
            "accountant": {
              "permissions": [
                "read"
              ]
            },
            "auditor": {
              "permissions": [
                "read"
              ]
            }
          }
        },
        "x-openregister-audit-trail": {
          "enabled": true
        }
      }
    }
  },
  "objects": [
