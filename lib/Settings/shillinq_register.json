      "WipBalance": {
        "slug": "WipBalance",
        "icon": "ChartLineVariant",
        "version": "0.1.0",
        "title": "WIP-saldo",
        "description": "Period-end work-in-progress snapshot per project, generated by an OR ScheduledWorkflow on T2 period close (REQ-CPA-008).",
        "type": "object",
        "x-schema-org": "schema:MonetaryAmount",
        "required": [
          "projectId",
          "periodId",
          "recognisedRevenue",
          "billedRevenue",
          "wipBalance",
          "costsIncurredToDate",
          "createdAt"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "description": "FK to the snapshotted Project.id.",
            "example": "proj-1"
          },
          "periodId": {
            "type": "string",
            "description": "FK to the FiscalPeriod for which this snapshot was taken.",
            "example": "fp-2026-Q1"
          },
