      "AllocationRule": {
        "slug": "AllocationRule",
        "icon": "ArrowSplitVertical",
        "version": "0.1.0",
        "title": "Allocation Rule",
        "description": "A cost-allocation rule that spreads overhead and shared costs across cost objects using a named driver. Execution is schema-declared per ADR-031: per-posting rules fire as an x-openregister-lifecycle action on GLTransaction.post; monthly/period-close rules fire via OR ScheduledWorkflow. No PHP AllocationService.allocate() runs the rule.",
        "type": "object",
        "x-schema-org": "schema:Thing",
        "required": [
          "name",
          "sourceAccountPattern",
          "driver",
          "targets",
          "targetDimension",
          "cadence",
          "lifecycleState",
          "administrationId"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Operator-readable rule name.",
            "example": "Overhead by headcount"
          },
          "sourceAccountPattern": {
            "type": "string",
            "description": "Glob or range pattern that matches source accounts (e.g. '1000-1099', '4*').",
            "example": "8000-8099"
          },
          "driver": {
            "type": "string",
            "description": "Algorithm used to split the source amount across targets.",
            "enum": [
              "fixed-percentage",
              "fixed-amount",
              "volume",
              "headcount"
            ],
            "example": "fixed-percentage"
          },
          "targets": {
            "type": "array",
            "description": "At least 2 target dimension codes with split specification. For fixed-percentage, percentages MUST sum to 100.",
            "minItems": 2,
            "items": {
              "type": "object",
              "required": ["code"],
              "properties": {
                "code": {
                  "type": "string",
                  "description": "Code of the target CostCenter / KostenDrager / Project."
                },
                "percentage": {
                  "type": "number",
                  "description": "Allocation percentage (required when driver is fixed-percentage).",
                  "minimum": 0,
                  "maximum": 100
                },
                "amount": {
                  "type": "number",
                  "description": "Fixed allocation amount (used when driver is fixed-amount).",
                  "minimum": 0
                },
                "source": {
                  "type": "string",
                  "description": "Source metric reference for volume or headcount drivers."
                }
              }
            }
          },
          "targetDimension": {
            "type": "string",
            "description": "Identifies which dimension register the targets[].code values refer to.",
            "enum": [
              "cost-center",
              "kosten-drager",
              "project"
            ],
            "example": "cost-center"
          },
          "cadence": {
            "type": "string",
            "description": "When the rule fires. per-posting: lifecycle action on GLTransaction.post; monthly/period-close: OR ScheduledWorkflow.",
            "enum": [
              "per-posting",
              "monthly",
              "period-close"
            ],
            "example": "monthly"
          },
          "lifecycleState": {
            "type": "string",
            "description": "Current lifecycle state. Rules ship in paused state and require operator activation.",
            "enum": [
              "active",
              "paused",
              "archived"
            ],
            "example": "paused",
            "default": "paused"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this rule.",
            "example": "adm-1"
          },
          "description": {
            "type": "string",
            "description": "Operator-authored description of the rule.",
            "nullable": true
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "paused",
          "states": {
            "active": {
              "label": "Active",
              "description": "Rule is evaluated on its declared cadence."
            },
            "paused": {
              "label": "Paused",
              "description": "Rule exists but is not evaluated. Default state for seeded example rules."
            },
            "archived": {
              "label": "Archived",
              "description": "Retired rule; retained for historical reference only."
            }
          },
          "preconditions": {
            "save": "OCA\\Shillinq\\Guard\\AllocationRuleGuard::requireFixedPercentageSum"
          },
          "actions": {
            "onGLTransactionPost": {
              "trigger": "GLTransaction.post",
              "condition": "cadence === 'per-posting' && lifecycleState === 'active'",
              "description": "When a GLTransaction is posted and an active per-posting rule matches the source account pattern, emit additional balanced GLLine rows distributing the source amount per the targets. The cross-line balance constraint from T1 GLTransaction.post is reused — the split must keep the transaction balanced."
            }
          },
          "transitions": {
            "activate": {
              "from": "paused",
              "to": "active",
              "label": "Activate rule",
              "description": "Start evaluating this rule on its declared cadence."
            },
            "pause": {
              "from": "active",
              "to": "paused",
              "label": "Pause rule",
              "description": "Suspend evaluation without archiving."
            },
            "archiveFromActive": {
              "from": "active",
              "to": "archived",
              "label": "Archive rule"
            },
            "archiveFromPaused": {
              "from": "paused",
              "to": "archived",
              "label": "Archive rule"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        }
      },
      "GLLine": {
        "slug": "GLLine",
        "icon": "TableRowOutline",
        "version": "0.1.1",
        "title": "GL Line",
        "description": "An individual debit or credit line within a GLTransaction. T1 base fields declared here; this entry is additively patched by the bookkeeping-cost-centers-dimensions (T4) capability to add dimension references per REQ-CC-003.",
        "type": "object",
        "x-schema-org": "schema:AccountingEntry",
        "required": [
          "transactionId",
          "lineNumber",
          "accountNumber",
          "side",
          "amount",
          "currency",
          "periodId",
          "administrationId"
        ],
        "properties": {
