      "CostCenter": {
        "slug": "CostCenter",
        "icon": "DomainOutline",
        "version": "0.1.0",
        "title": "Cost Center",
        "description": "An analytical dimension representing a department, function, or other cost-bearing unit within an administration. Supports hierarchical navigation via self-relation.",
        "type": "object",
        "x-schema-org": "schema:Organization",
        "x-openregister-purpose": "dimension",
        "required": [
          "code",
          "name",
          "lifecycleState",
          "administrationId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "description": "Operator-assigned unique reference code within the administration (e.g. KC-100).",
            "example": "KC-100"
          },
          "name": {
            "type": "string",
            "description": "Human-readable name of the cost center.",
            "example": "Sales"
          },
          "parentCode": {
            "type": "string",
            "description": "FK to parent CostCenter.code for hierarchical navigation.",
            "example": "KC-000",
            "nullable": true
          },
          "responsibleUser": {
            "type": "string",
            "description": "Nextcloud user id of the cost-center owner.",
            "example": "jan.janssen",
            "nullable": true
          },
          "lifecycleState": {
            "type": "string",
            "description": "Current lifecycle state of the cost center.",
            "enum": [
              "active",
              "blocked",
              "archived"
            ],
            "example": "active",
            "default": "active"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this cost center.",
            "example": "adm-1"
          },
          "description": {
            "type": "string",
            "description": "Operator-authored free-text description.",
            "nullable": true
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "active",
          "states": {
            "active": {
              "label": "Active",
              "description": "Fully usable for new GL postings."
            },
            "blocked": {
              "label": "Blocked",
              "description": "Readable but not selectable for new GL lines."
            },
            "archived": {
              "label": "Archived",
              "description": "Historical only; no new postings."
            }
          },
          "transitions": {
            "block": {
              "from": "active",
              "to": "blocked",
              "label": "Block",
              "description": "Prevent new postings against this cost center."
            },
            "unblock": {
              "from": "blocked",
              "to": "active",
              "label": "Unblock",
              "description": "Re-enable new postings."
            },
            "archiveFromActive": {
              "from": "active",
              "to": "archived",
              "label": "Archive",
              "description": "Move to historical archive."
            },
            "archiveFromBlocked": {
              "from": "blocked",
              "to": "archived",
              "label": "Archive",
              "description": "Move to historical archive from blocked state."
            }
          }
        },
        "x-openregister-relations": {
          "parentCostCenter": {
            "localField": "parentCode",
            "relatedSchema": "CostCenter",
            "relatedField": "code",
            "cardinality": "many-to-one",
            "description": "Self-relation enabling hierarchical cost-center navigation."
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        }
