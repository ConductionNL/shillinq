          },
          "amount": {
            "type": "number",
            "description": "Non-negative monetary amount for this line.",
            "minimum": 0,
            "example": 1000.00
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "minLength": 3,
            "maxLength": 3,
            "example": "EUR"
          },
          "periodId": {
            "type": "string",
            "description": "FK to the FiscalYear period this line belongs to."
          },
          "subLedgerType": {
            "type": "string",
            "description": "Sub-ledger classification (e.g. AP, AR, asset).",
            "nullable": true
          },
          "subLedgerRef": {
            "type": "string",
            "description": "FK to the sub-ledger record (e.g. invoice id).",
            "nullable": true
          },
          "costCenter": {
            "type": "string",
            "description": "Backwards-compatible alias for costCenterCode. FK to CostCenter.code.",
            "nullable": true
          },
          "description": {
            "type": "string",
            "description": "Line-level narrative description.",
            "nullable": true
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this line.",
            "example": "adm-1"
          },
          "costCenterCode": {
            "type": "string",
            "description": "FK to CostCenter.code. Optional dimension reference per REQ-CC-003.",
            "nullable": true
          },
          "kostenDragerCode": {
            "type": "string",
            "description": "FK to KostenDrager.code. Optional dimension reference per REQ-CC-003.",
            "nullable": true
          },
          "projectCode": {
            "type": "string",
            "description": "FK to Project.code. Optional dimension reference per REQ-CC-003. Also the join key for WBSO time-per-project aggregations (REQ-CC-007).",
            "nullable": true
          },
          "dimensions": {
            "type": "object",
            "description": "Free-form key→value map for custom analytical dimensions. Each key MUST match a registered custom dimension register (declared with x-openregister-purpose: dimension); each value MUST resolve to an existing record's code field in that register. Validated via OR relations engine per REQ-CC-003.",
            "additionalProperties": {
              "type": "string"
            },
            "nullable": true
          }
        },
        "x-openregister-relations": {
          "costCenterRelation": {
            "localField": "costCenterCode",
            "relatedSchema": "CostCenter",
            "relatedField": "code",
            "cardinality": "many-to-one",
            "description": "FK to the CostCenter dimension."
          },
          "kostenDragerRelation": {
            "localField": "kostenDragerCode",
            "relatedSchema": "KostenDrager",
            "relatedField": "code",
            "cardinality": "many-to-one",
            "description": "FK to the KostenDrager dimension."
          },
          "projectRelation": {
            "localField": "projectCode",
            "relatedSchema": "Project",
            "relatedField": "code",
            "cardinality": "many-to-one",
            "description": "FK to the Project dimension."
          }
        },
        "x-openregister-aggregations": {
          "segmentPnlByCostCenter": {
            "field": "amount",
            "operation": "sum",
            "description": "Segment P&L roll-up by cost center per REQ-CC-005. Keyed by (fiscalYearId, accountNumber, costCenterCode). Consumed by launchpad widgets via runtime GraphQL and by CostCenter detail pages.",
            "groupBy": ["periodId", "accountNumber", "costCenterCode"]
          },
          "segmentPnlByKostenDrager": {
            "field": "amount",
            "operation": "sum",
            "description": "Segment P&L roll-up by kostendrager per REQ-CC-005.",
