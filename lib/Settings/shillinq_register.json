      "ARInvoice": {
        "slug": "ARInvoice",
        "icon": "FileDocumentArrowLeftOutline",
        "version": "0.1.0",
        "title": "AR Invoice",
        "description": "An outgoing customer invoice (verkoopfactuur) with a draft→issued→paid/overdue/disputed/written-off lifecycle (REQ-AR-003/004). Carries forward the original Shillinq invoicing scope.",
        "type": "object",
        "x-schema-org": "schema:Invoice",
        "x-openregister-audit": true,
        "x-openregister-attachment-roles": {
          "sourceDocumentUri": {
            "role": "invoice",
            "mimeTypes": ["application/pdf", "application/vnd.oasis.opendocument.text", "image/jpeg", "image/png"]
          }
        },
        "required": [
          "invoiceNumber",
          "customerId",
          "administrationId",
          "invoiceDate",
          "dueDate",
          "grossAmount",
          "netAmount",
          "currency",
          "periodId",
          "lifecycleState"
        ],
        "properties": {
          "invoiceNumber": {"type": "string", "description": "Sequential invoice number.", "example": "2026-0042"},
          "customerId": {"type": "string", "description": "FK to CustomerMaster.customerId."},
          "administrationId": {"type": "string", "description": "FK to the owning Administration."},
          "invoiceDate": {"type": "string", "format": "date", "description": "Date the invoice was issued."},
          "dueDate": {"type": "string", "format": "date", "description": "Payment due date."},
          "grossAmount": {"type": "number", "description": "Total amount including VAT."},
          "vatAmount": {"type": "number", "description": "VAT portion.", "nullable": true},
          "netAmount": {"type": "number", "description": "Net amount excluding VAT."},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3, "default": "EUR"},
          "periodId": {"type": "string", "description": "FK to FiscalPeriod.periodId."},
          "lifecycleState": {"type": "string", "enum": ["draft", "issued", "paid", "overdue", "disputed", "written-off"], "default": "draft"},
          "glTransactionId": {"type": "string", "description": "UUID of the materialised GLTransaction on issue.", "nullable": true},
          "sourceDocumentUri": {
            "type": "string",
            "description": "Docudesk FK URI (PDF invoice).",
            "pattern": "^docudesk://[^/]+/.+/.+$",
            "nullable": true
          },
          "matchedBankLineId": {"type": "string", "description": "FK to BankStatementLine.lineId once payment is matched.", "nullable": true},
          "ublRef": {"type": "string", "description": "UBL 2.1 document reference (declared for T4 Peppol BIS 3.0 outbound).", "nullable": true},
          "isOverdue": {
            "type": "boolean",
            "description": "Calculated: dueDate < now and not paid (REQ-AR-004). Consumed by OR scheduled workflow for the issued→overdue auto-transition.",
            "default": false,
            "x-openregister-calculations": {
              "operation": "date-overdue",
              "source": "dueDate",
              "description": "True when dueDate has passed and the invoice is not paid. Pure derivation per ADR-031."
            }
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "draft",
          "states": {
            "draft": {"label": "Draft", "description": "Captured, not yet issued."},
            "issued": {"label": "Issued", "description": "Issued; materialised a balanced GLTransaction."},
            "paid": {"label": "Paid", "description": "Payment matched from bank-rec."},
            "overdue": {"label": "Overdue", "description": "Due date passed without payment."},
            "disputed": {"label": "Disputed", "description": "Customer raised a dispute."},
            "written-off": {"label": "Written Off", "description": "Bad debt written off with a compensating GLTransaction."}
          },
          "preconditions": {
            "create": "OCA\\Shillinq\\Lifecycle\\OpenBalanceGuard::customerNotBlocked"
          },
          "transitions": {
            "issue": {
              "from": "draft",
              "to": "issued",
              "label": "Issue invoice",
              "description": "Credit-limit check (REQ-AR-006); materialises a balanced GLTransaction; writes glTransactionId.",
              "requires": "OCA\\Shillinq\\Lifecycle\\OpenBalanceGuard::withinCreditLimit"
            },
            "payFromIssued": {"from": "issued", "to": "paid", "label": "Mark paid", "description": "Payment matched from bank-rec; sets matchedBankLineId; posts payment GLTransaction."},
            "overdue": {"from": "issued", "to": "overdue", "label": "Mark overdue", "description": "Due date passed; driven by isOverdue calculated field + OR scheduled workflow."},
            "payFromOverdue": {"from": "overdue", "to": "paid", "label": "Mark paid"},
            "disputeFromIssued": {"from": "issued", "to": "disputed", "label": "Mark disputed"},
            "disputeFromOverdue": {"from": "overdue", "to": "disputed", "label": "Mark disputed"},
            "resolveDispute": {"from": "disputed", "to": "issued", "label": "Resolve dispute"},
            "writeOffFromIssued": {"from": "issued", "to": "written-off", "label": "Write off", "description": "Posts a compensating GLTransaction (debit bad-debt, credit AR control).", "roles": ["period-closer", "ar-controller"]},
            "writeOffFromOverdue": {"from": "overdue", "to": "written-off", "label": "Write off", "roles": ["period-closer", "ar-controller"]}
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {"permissions": ["create", "read", "update"]},
            "ar-controller": {"permissions": ["read", "update"]},
            "auditor": {"permissions": ["read"]}
          }
        },
        "x-openregister-aggregations": {
          "arAging": {
            "description": "AR aging grouping outstanding ARInvoice records by (customerId, agingBucket) computed from dueDate (REQ-AR-008). Excludes paid/written-off.",
            "groupBy": ["customerId", "agingBucket"],
            "field": "grossAmount",
            "operation": "sum",
            "filters": {"lifecycleState": {"notIn": ["paid", "written-off"]}},
            "buckets": {
              "source": "dueDate",
              "ranges": [
                {"key": "0-30", "maxDaysOverdue": 30},
                {"key": "31-60", "minDaysOverdue": 31, "maxDaysOverdue": 60},
                {"key": "61-90", "minDaysOverdue": 61, "maxDaysOverdue": 90},
                {"key": "90+", "minDaysOverdue": 91}
              ]
            }
          },
          "outstandingByCustomer": {
            "description": "Outstanding AR balance per customer for the credit-limit check (REQ-AR-006). Sum of grossAmount for non-paid, non-written-off invoices.",
            "groupBy": ["customerId"],
            "field": "grossAmount",
            "operation": "sum",
            "filters": {"lifecycleState": {"notIn": ["paid", "written-off"]}}
          }
        }
      },
