{
  "openapi": "3.0.0",
  "info": {
    "title": "Shillinq Register",
    "description": "Register containing all schemas for the Shillinq application.",
    "version": "0.3.0"
  },
  "x-openregister": {
    "type": "application",
    "app": "shillinq",
    "openregister": "^v0.2.10",
    "description": "Shillinq — open-source business administration suite for Dutch SMB, ZZP, and government."
  },
  "paths": {},
  "components": {
    "schemas": {
      "example": {
        "slug": "example",
        "icon": "FileDocumentOutline",
        "version": "0.1.0",
        "title": "Example",
        "description": "Example schema — replace with your app's actual schemas.",
        "type": "object",
        "required": [
          "title"
        ],
        "properties": {
          "title": {
            "type": "string",
            "description": "The title of the example object",
            "example": "My example"
          },
          "description": {
            "type": "string",
            "description": "An optional description",
            "example": "This is an example"
          }
        }
      },
      "Account": {
        "slug": "Account",
        "icon": "LedgerOutline",
        "version": "0.2.0",
        "title": "Account",
        "description": "A hierarchical chart-of-accounts entry conforming to the RGS (Referentie Grootboek Schema) standard for Dutch bookkeeping.",
        "type": "object",
        "x-schema-org": "schema:DefinedTerm",
        "x-openregister-audit": true,
        "required": [
          "accountNumber",
          "name",
          "accountType",
          "currency",
          "administrationId",
          "lifecycleState"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "RGS-style account code (e.g. '1000', '4100'). Unique within an administration.",
            "example": "1000"
          },
          "name": {
            "type": "string",
            "description": "Human-readable account name.",
            "example": "Liquide middelen"
          },
          "accountType": {
            "type": "string",
            "description": "Top-level balance-sheet or income-statement classification.",
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "revenue",
              "expenses"
            ],
            "example": "assets"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code for this account's base currency.",
            "minLength": 3,
            "maxLength": 3,
            "example": "EUR",
            "default": "EUR"
          },
          "parentAccountNumber": {
            "type": "string",
            "description": "FK to the parent Account.accountNumber for hierarchy navigation.",
            "example": "1000",
            "nullable": true
          },
          "isClosingAccount": {
            "type": "boolean",
            "description": "Designates this as the administration's single closing account for period-end equity absorption.",
            "default": false
          },
          "isSuspenseAccount": {
            "type": "boolean",
            "description": "Designates this account as the bank-reconciliation suspense (tussenrekening) for unmatched statement lines per REQ-BR-007.",
            "default": false
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this account. Scopes uniqueness of accountNumber.",
            "example": "adm-1"
          },
          "lifecycleState": {
            "type": "string",
            "description": "Current lifecycle state of the account.",
            "enum": [
              "active",
              "blocked",
              "archived"
            ],
            "example": "active",
            "default": "active"
          },
          "description": {
            "type": "string",
            "description": "Operator-authored free-text description of the account.",
            "nullable": true
          },
          "vatApplicable": {
            "type": "boolean",
            "description": "Whether VAT/BTW applies to transactions posted to this account.",
            "default": false
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "active",
          "states": {
            "active": {
              "label": "Active",
              "description": "Fully usable for new GL postings."
            },
            "blocked": {
              "label": "Blocked",
              "description": "Readable and referenceable by existing postings, but rejected as the target of new GL lines."
            },
            "archived": {
              "label": "Archived",
              "description": "Historical only — no new postings, no edits; remains queryable."
            }
          },
          "preconditions": {
            "save": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireSingleClosingAccount"
          },
          "transitions": {
            "block": {
              "from": "active",
              "to": "blocked",
              "label": "Block account",
              "description": "Prevent new postings against this account."
            },
            "unblock": {
              "from": "blocked",
              "to": "active",
              "label": "Unblock account",
              "description": "Re-enable new postings against this account."
            },
            "archiveFromActive": {
              "from": "active",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            },
            "archiveFromBlocked": {
              "from": "blocked",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive from blocked state. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            }
          }
        },
        "x-openregister-relations": {
          "parentAccount": {
            "localField": "parentAccountNumber",
            "relatedSchema": "Account",
            "relatedField": "accountNumber",
            "cardinality": "many-to-one",
            "description": "Self-relation enabling hierarchical chart-of-accounts navigation."
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        },
        "x-openregister-aggregations": {
          "countByType": {
            "field": "accountType",
            "operation": "count",
            "description": "Number of accounts per accountType.",
            "groupBy": "accountType"
          },
          "countByLifecycle": {
            "field": "lifecycleState",
            "operation": "count",
            "description": "Number of accounts per lifecycleState.",
            "groupBy": "lifecycleState"
          }
        }
      },
      "FiscalPeriod": {
        "slug": "FiscalPeriod",
        "icon": "CalendarRange",
        "version": "0.1.0",
        "title": "Fiscal Period",
        "description": "A monthly or quarterly fiscal period with an open/closing/closed/audit-locked lifecycle. Promotes T1's GLLine.periodId stub to a managed register (REQ-PC-001).",
        "type": "object",
        "x-schema-org": "schema:DatedMoneySpecification",
        "x-openregister-audit": true,
        "required": [
          "periodId",
          "name",
          "startDate",
          "endDate",
          "fiscalYear",
          "administrationId",
          "state"
        ],
        "properties": {
          "periodId": {
            "type": "string",
            "description": "Unique period code (e.g. '2026-01', '2026-Q1').",
            "example": "2026-01"
          },
          "name": {
            "type": "string",
            "description": "Human-readable label.",
            "example": "Januari 2026"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "First day of the period."
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "description": "Last day of the period."
          },
          "fiscalYear": {
            "type": "string",
            "description": "Fiscal year this period belongs to.",
            "example": "2026"
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the owning Administration."
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state of the period.",
            "enum": ["open", "closing", "closed", "audit-locked"],
            "default": "open"
          },
          "closedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when state transitioned to closed.",
            "nullable": true
          },
          "closedBy": {
            "type": "string",
            "description": "UUID of user who closed the period.",
            "nullable": true
          },
          "auditLockedAt": {
            "type": "string",
            "format": "date-time",
            "description": "Timestamp when state transitioned to audit-locked.",
            "nullable": true
          },
          "auditLockedBy": {
            "type": "string",
            "description": "UUID of auditor who locked the period.",
            "nullable": true
          },
          "closeReason": {
            "type": "string",
            "description": "Operator-provided reason for closing.",
            "nullable": true
          },
          "reopenedHistory": {
            "type": "array",
            "description": "Array of {reopenedAt, reopenedBy, reason} objects tracking each reopen (REQ-PC-006).",
            "items": {
              "type": "object",
              "properties": {
                "reopenedAt": {"type": "string", "format": "date-time"},
                "reopenedBy": {"type": "string"},
                "reason": {"type": "string"}
              }
            },
            "default": []
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "open",
          "states": {
            "open": {"label": "Open", "description": "Period accepts new postings."},
            "closing": {"label": "Closing", "description": "Trial balance verified; close in progress."},
            "closed": {"label": "Closed", "description": "No new postings; reversible by elevated role."},
            "audit-locked": {"label": "Audit Locked", "description": "Terminal — auditor sign-off, irreversible."}
          },
          "transitions": {
            "startClose": {
              "from": "open",
              "to": "closing",
              "label": "Start Close",
              "description": "Begin period close; trial-balance debit=credit invariant must verify (REQ-TB-003).",
              "requires": "OCA\\Shillinq\\Lifecycle\\PeriodCloseGuard::trialBalanceVerifies"
            },
            "confirmClose": {
              "from": "closing",
              "to": "closed",
              "label": "Confirm Close",
              "description": "Confirm close; all open AP/AR invoices in the period must be settled or explicitly acknowledged.",
              "requires": "OCA\\Shillinq\\Lifecycle\\PeriodCloseGuard::openItemsSettled"
            },
            "reopen": {
              "from": "closed",
              "to": "open",
              "label": "Reopen",
              "description": "Reopen a closed period. Requires the elevated period-closer role and an audited reason.",
              "roles": ["period-closer"],
              "requires": "OCA\\Shillinq\\Lifecycle\\PeriodCloseGuard::recordReopen"
            },
            "auditLock": {
              "from": "closed",
              "to": "audit-locked",
              "label": "Audit Lock",
              "description": "Irreversibly lock the period after auditor sign-off.",
              "roles": ["auditor"]
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {"permissions": ["create", "read", "update"]},
            "period-closer": {"permissions": ["read", "update"]},
            "auditor": {"permissions": ["read", "update"]}
          }
        }
      },
      "VendorMaster": {
        "slug": "VendorMaster",
        "icon": "TruckOutline",
        "version": "0.1.0",
        "title": "Vendor",
        "description": "Vendor (crediteur) master record carrying remittance and payment-terms data for accounts payable (REQ-AP-002).",
        "type": "object",
        "x-schema-org": "schema:Organization",
        "x-openregister-audit": true,
        "required": [
          "vendorId",
          "legalName",
          "iban",
          "email",
          "administrationId",
          "lifecycleState"
        ],
        "properties": {
          "vendorId": {"type": "string", "description": "Internal vendor code.", "example": "CRD-0001"},
          "legalName": {"type": "string", "description": "Official registered business name."},
          "tradeName": {"type": "string", "description": "Trade name if different.", "nullable": true},
          "kvkNumber": {"type": "string", "description": "Dutch KvK registration number.", "nullable": true},
          "vatID": {"type": "string", "description": "Dutch VAT number (BTW-nummer).", "nullable": true},
          "iban": {"type": "string", "description": "Vendor's SEPA bank account IBAN."},
          "bic": {"type": "string", "description": "BIC/SWIFT code.", "nullable": true},
          "email": {"type": "string", "format": "email", "description": "Contact email for remittance advice."},
          "paymentTermsDays": {"type": "integer", "description": "Default payment terms (days net).", "default": 30},
          "defaultGlAccount": {"type": "string", "description": "FK to Account.accountNumber for default AP posting.", "nullable": true},
          "administrationId": {"type": "string", "description": "FK to the owning Administration."},
          "lifecycleState": {"type": "string", "enum": ["active", "blocked", "archived"], "default": "active"},
          "taxRegistrationCountry": {"type": "string", "description": "ISO 3166-1 alpha-2 country code for cross-border VAT.", "nullable": true}
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "active",
          "states": {
            "active": {"label": "Active", "description": "Available for new AP invoices."},
            "blocked": {"label": "Blocked", "description": "New invoices rejected at creation."},
            "archived": {"label": "Archived", "description": "Historical reference only."}
          },
          "transitions": {
            "block": {"from": "active", "to": "blocked", "label": "Block vendor"},
            "unblock": {"from": "blocked", "to": "active", "label": "Unblock vendor"},
            "archiveFromActive": {"from": "active", "to": "archived", "label": "Archive vendor", "requires": "OCA\\Shillinq\\Lifecycle\\OpenBalanceGuard::vendorBalanceZero"},
            "archiveFromBlocked": {"from": "blocked", "to": "archived", "label": "Archive vendor", "requires": "OCA\\Shillinq\\Lifecycle\\OpenBalanceGuard::vendorBalanceZero"}
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {"permissions": ["create", "read", "update"]},
            "ap-approver": {"permissions": ["read"]},
            "auditor": {"permissions": ["read"]}
          }
        }
      },
      "APInvoice": {
        "slug": "APInvoice",
        "icon": "FileDocumentArrowRightOutline",
        "version": "0.1.0",
        "title": "AP Invoice",
        "description": "An incoming vendor invoice (inkoopfactuur) with a draft→received→matched→approved→posted→paid lifecycle (REQ-AP-003/004).",
        "type": "object",
        "x-schema-org": "schema:Invoice",
        "x-openregister-audit": true,
        "x-openregister-attachment-roles": {
          "sourceDocumentUri": {
            "role": "invoice",
            "mimeTypes": ["application/pdf", "application/vnd.oasis.opendocument.text", "image/jpeg", "image/png"]
          }
        },
        "required": [
          "vendorInvoiceRef",
          "vendorId",
          "administrationId",
          "invoiceDate",
          "dueDate",
          "grossAmount",
          "netAmount",
          "currency",
          "periodId",
          "lifecycleState"
        ],
        "properties": {
          "vendorInvoiceRef": {"type": "string", "description": "Vendor's own invoice number."},
          "vendorId": {"type": "string", "description": "FK to VendorMaster.vendorId."},
          "administrationId": {"type": "string", "description": "FK to the owning Administration."},
          "invoiceDate": {"type": "string", "format": "date", "description": "Date the vendor invoice was issued."},
          "dueDate": {"type": "string", "format": "date", "description": "Payment due date per vendor's payment terms."},
          "grossAmount": {"type": "number", "description": "Total amount including VAT in EUR."},
          "vatAmount": {"type": "number", "description": "VAT portion.", "nullable": true},
          "netAmount": {"type": "number", "description": "Net amount excluding VAT."},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3, "default": "EUR"},
          "periodId": {"type": "string", "description": "FK to FiscalPeriod.periodId (posting period)."},
          "lifecycleState": {"type": "string", "enum": ["draft", "received", "matched", "approved", "posted", "paid", "voided"], "default": "draft"},
          "poRef": {"type": "string", "description": "FK to future PO register (declared for T4 3-way match).", "nullable": true},
          "grRef": {"type": "string", "description": "FK to future GR register (declared for T4 3-way match).", "nullable": true},
          "glTransactionId": {"type": "string", "description": "UUID of the materialised GLTransaction on posting.", "nullable": true},
          "paymentRunId": {"type": "string", "description": "FK to PaymentRun.runId once included in a payment run.", "nullable": true},
          "sourceDocumentUri": {
            "type": "string",
            "description": "Docudesk FK URI per bookkeeping-document-attachment-integration.",
            "pattern": "^docudesk://[^/]+/.+/.+$",
            "nullable": true
          },
          "idealPaymentLink": {
            "type": "string",
            "description": "Calculated iDEAL payment link for this invoice (REQ-AP-007).",
            "nullable": true,
            "x-openregister-calculations": {
              "operation": "template",
              "template": "https://ideal.example/pay?iban={{vendorId.iban}}&amount={{grossAmount}}&ref={{vendorInvoiceRef}}",
              "description": "iDEAL payment link composed from vendor IBAN and invoice amount. Pure data→string transformation per ADR-031."
            }
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "draft",
          "states": {
            "draft": {"label": "Draft", "description": "Captured, not yet recorded as received."},
            "received": {"label": "Received", "description": "Receipt recorded."},
            "matched": {"label": "Matched", "description": "2-way or 3-way match passed."},
            "approved": {"label": "Approved", "description": "Approval workflow completed."},
            "posted": {"label": "Posted", "description": "Materialised a balanced GLTransaction."},
            "paid": {"label": "Paid", "description": "Settled by a payment run."},
            "voided": {"label": "Voided", "description": "Discarded or reversed."}
          },
          "preconditions": {
            "create": "OCA\\Shillinq\\Lifecycle\\OpenBalanceGuard::vendorNotBlocked"
          },
          "transitions": {
            "receive": {"from": "draft", "to": "received", "label": "Record receipt"},
            "match": {
              "from": "received",
              "to": "matched",
              "label": "Match invoice",
              "description": "Conditional 3-way match (PO+GR) or 2-way fallback per REQ-AP-006.",
              "requires": "OCA\\Shillinq\\Lifecycle\\ThreeWayMatchGuard::matches"
            },
            "approve": {
              "from": "matched",
              "to": "approved",
              "label": "Approve",
              "description": "Consumes OR approval-workflow per REQ-AP-005.",
              "requires": "openregister:approval-workflow"
            },
            "post": {"from": "approved", "to": "posted", "label": "Post to GL", "description": "Materialises a balanced GLTransaction; writes glTransactionId."},
            "settle": {"from": "posted", "to": "paid", "label": "Mark paid", "description": "Payment run settles; writes paymentRunId."},
            "voidFromPosted": {"from": "posted", "to": "voided", "label": "Void", "description": "Posts a compensating reversing GLTransaction."},
            "voidFromDraft": {"from": "draft", "to": "voided", "label": "Discard draft", "description": "No GL impact."}
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {"permissions": ["create", "read", "update"]},
            "ap-approver": {"permissions": ["read", "update"]},
            "auditor": {"permissions": ["read"]}
          }
        },
        "x-openregister-aggregations": {
          "apAging": {
            "description": "AP aging grouping outstanding APInvoice records by (vendorId, agingBucket) computed from dueDate (REQ-AP-009). Excludes paid/voided.",
            "groupBy": ["vendorId", "agingBucket"],
            "field": "grossAmount",
            "operation": "sum",
            "filters": {"lifecycleState": {"notIn": ["paid", "voided"]}},
            "buckets": {
              "source": "dueDate",
              "ranges": [
                {"key": "0-30", "maxDaysOverdue": 30},
                {"key": "31-60", "minDaysOverdue": 31, "maxDaysOverdue": 60},
                {"key": "61-90", "minDaysOverdue": 61, "maxDaysOverdue": 90},
                {"key": "90+", "minDaysOverdue": 91}
              ]
            }
          }
        }
      },
      "PaymentRun": {
        "slug": "PaymentRun",
        "icon": "BankTransferOut",
        "version": "0.1.0",
        "title": "Payment Run",
        "description": "A batch of selected AP invoices paid together; emits SEPA pain.001 XML as a calculated field (REQ-AP-007).",
        "type": "object",
        "x-schema-org": "schema:MoneyTransfer",
        "x-openregister-audit": true,
        "required": [
          "runId",
          "administrationId",
          "runDate",
          "totalAmount",
          "currency",
          "selectedInvoiceIds",
          "lifecycleState"
        ],
        "properties": {
          "runId": {"type": "string", "description": "Unique payment run code.", "example": "PAY-2026-001"},
          "administrationId": {"type": "string", "description": "FK to the owning Administration."},
          "runDate": {"type": "string", "format": "date", "description": "Intended value date for bank processing."},
          "totalAmount": {"type": "number", "description": "Sum of selected invoice amounts."},
          "currency": {"type": "string", "minLength": 3, "maxLength": 3, "default": "EUR"},
          "selectedInvoiceIds": {"type": "array", "items": {"type": "string"}, "description": "Array of APInvoice UUIDs included in this run."},
          "sepaXml": {
            "type": "string",
            "description": "Calculated SEPA pain.001.001.03 XML composing the credit transfers (REQ-AP-007).",
            "nullable": true,
            "x-openregister-calculations": {
              "operation": "sepa-pain001",
              "version": "pain.001.001.03",
              "source": "selectedInvoiceIds",
              "description": "Composes SEPA pain.001 credit-transfer XML from the selected invoices' vendor IBAN, amount, and remittance data. Pure data→string transformation per ADR-031 — no PHP SepaPaymentService."
            }
          },
          "lifecycleState": {"type": "string", "enum": ["draft", "approved", "exported", "settled"], "default": "draft"}
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "draft",
          "states": {
            "draft": {"label": "Draft", "description": "Invoices being selected."},
            "approved": {"label": "Approved", "description": "Run approved for export."},
            "exported": {"label": "Exported", "description": "SEPA XML downloaded for the bank portal."},
            "settled": {"label": "Settled", "description": "Bank confirmed; invoices marked paid."}
          },
          "transitions": {
            "approve": {"from": "draft", "to": "approved", "label": "Approve run"},
            "export": {"from": "approved", "to": "exported", "label": "Export SEPA XML"},
            "settle": {"from": "exported", "to": "settled", "label": "Mark settled"}
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "treasurer": {"permissions": ["create", "read", "update"]},
            "bookkeeper": {"permissions": ["read"]},
            "auditor": {"permissions": ["read"]}
          }
        }
      },
      "CustomerMaster": {
        "slug": "CustomerMaster",
        "icon": "AccountTieOutline",
        "version": "0.1.0",
        "title": "Customer",
        "description": "Customer (debiteur) master carrying credit-limit and dunning-policy data for accounts receivable (REQ-AR-002).",
        "type": "object",
        "x-schema-org": "schema:Organization",
        "x-openregister-audit": true,
        "required": [
          "customerId",
          "legalName",
          "email",
          "administrationId",
          "lifecycleState"
        ],
        "properties": {
          "customerId": {"type": "string", "description": "Internal customer code.", "example": "DEB-0001"},
          "legalName": {"type": "string", "description": "Official registered business name."},
          "tradeName": {"type": "string", "description": "Trade name if different.", "nullable": true},
          "kvkNumber": {"type": "string", "description": "Dutch KvK registration number.", "nullable": true},
          "vatID": {"type": "string", "description": "Dutch VAT number (BTW-nummer).", "nullable": true},
          "email": {"type": "string", "format": "email", "description": "Contact email for invoice delivery."},
          "telephone": {"type": "string", "description": "Contact telephone.", "nullable": true},
          "iban": {"type": "string", "description": "Customer's IBAN for SEPA direct debit.", "nullable": true},
          "creditLimit": {"type": "number", "description": "Maximum outstanding AR balance allowed (EUR).", "nullable": true},
          "dunningPolicyRef": {"type": "string", "description": "FK to OR dunning-policy record.", "nullable": true},
          "defaultGlAccount": {"type": "string", "description": "FK to Account.accountNumber for default AR posting.", "nullable": true},
          "administrationId": {"type": "string", "description": "FK to the owning Administration."},
          "lifecycleState": {"type": "string", "enum": ["active", "blocked", "archived"], "default": "active"},
