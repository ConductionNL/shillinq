      "Account": {
        "slug": "Account",
        "icon": "LedgerOutline",
        "version": "0.1.0",
        "title": "Account",
        "description": "A hierarchical chart-of-accounts entry conforming to the RGS (Referentie Grootboek Schema) standard for Dutch bookkeeping.",
        "type": "object",
        "x-schema-org": "schema:DefinedTerm",
        "required": [
          "accountNumber",
          "name",
          "accountType",
          "currency",
          "administrationId",
          "lifecycleState"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "RGS-style account code (e.g. '1000', '4100'). Unique within an administration.",
            "example": "1000"
          },
          "name": {
            "type": "string",
            "description": "Human-readable account name.",
            "example": "Liquide middelen"
          },
          "accountType": {
            "type": "string",
            "description": "Top-level balance-sheet or income-statement classification.",
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "revenue",
              "expenses"
            ],
            "example": "assets"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code for this account's base currency.",
            "minLength": 3,
            "maxLength": 3,
            "example": "EUR",
            "default": "EUR"
          },
          "parentAccountNumber": {
            "type": "string",
            "description": "FK to the parent Account.accountNumber for hierarchy navigation.",
            "example": "1000",
            "nullable": true
          },
          "isClosingAccount": {
            "type": "boolean",
            "description": "Designates this as the administration's single closing account for period-end equity absorption.",
            "default": false
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this account. Scopes uniqueness of accountNumber.",
            "example": "adm-1"
          },
          "lifecycleState": {
            "type": "string",
            "description": "Current lifecycle state of the account.",
            "enum": [
              "active",
              "blocked",
              "archived"
            ],
            "example": "active",
            "default": "active"
          },
          "description": {
            "type": "string",
            "description": "Operator-authored free-text description of the account.",
            "nullable": true
          },
          "vatApplicable": {
            "type": "boolean",
            "description": "Whether VAT/BTW applies to transactions posted to this account.",
            "default": false
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "active",
          "states": {
            "active": {
              "label": "Active",
              "description": "Fully usable for new GL postings."
            },
            "blocked": {
              "label": "Blocked",
              "description": "Readable and referenceable by existing postings, but rejected as the target of new GL lines."
            },
            "archived": {
              "label": "Archived",
              "description": "Historical only — no new postings, no edits; remains queryable."
            }
          },
          "preconditions": {
            "save": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireSingleClosingAccount"
          },
          "transitions": {
            "block": {
              "from": "active",
              "to": "blocked",
              "label": "Block account",
              "description": "Prevent new postings against this account."
            },
            "unblock": {
              "from": "blocked",
              "to": "active",
              "label": "Unblock account",
              "description": "Re-enable new postings against this account."
            },
            "archiveFromActive": {
              "from": "active",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            },
            "archiveFromBlocked": {
              "from": "blocked",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive from blocked state. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            }
          }
        },
        "x-openregister-relations": {
          "parentAccount": {
            "localField": "parentAccountNumber",
            "relatedSchema": "Account",
            "relatedField": "accountNumber",
            "cardinality": "many-to-one",
            "description": "Self-relation enabling hierarchical chart-of-accounts navigation."
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        },
        "x-openregister-aggregations": {
          "countByType": {
            "field": "accountType",
            "operation": "count",
            "description": "Number of accounts per accountType.",
            "groupBy": "accountType"
          },
          "countByLifecycle": {
            "field": "lifecycleState",
            "operation": "count",
            "description": "Number of accounts per lifecycleState.",
            "groupBy": "lifecycleState"
          }
        },
        "x-shillinq-extensions": {
          "isSchatkistAccount": {
            "type": "boolean",
            "description": "REQ-SBK-002: marks this account as a Treasury (schatkistbankieren) account so its postings are aggregated into the daily SchatkistPosition. Default false; non-government administrations leave it false.",
            "default": false
          }
        },
        "x-openregister-lifecycle-retention": {
          "rule": "selectielijst:5.1.1",
          "description": "REQ-ARC-005: Account masterdata retained indefinitely per Selectielijst Gemeenten 2020 §5.1.1 (keep_indefinite). Enforcement is OR's per ADR-022."
        }
      },
      "VatReturn": {
        "slug": "VatReturn",
        "icon": "ReceiptTextOutline",
        "version": "0.1.0",
        "title": "VAT Return (BTW-aangifte)",
        "description": "A periodic VAT return (BTW-aangifte) per Wet OB 1968. REQ-VBTW-001/002. Lifecycle draft → submitted → accepted → corrected. SBR/Digipoort submission consumes the digipoort-sbr OpenConnector source per ADR-019/ADR-022.",
        "type": "object",
        "x-schema-org": "schema:Invoice",
        "required": [
          "administrationId",
          "periodType",
          "periodYear",
          "state",
          "currency"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this return.",
            "example": "adm-1"
          },
          "periodType": {
            "type": "string",
            "description": "Filing cadence.",
            "enum": ["month", "quarter", "year"],
            "example": "quarter"
          },
          "periodYear": {
            "type": "integer",
            "description": "Calendar year of the return period.",
            "example": 2026
          },
          "periodMonth": {
            "type": "integer",
            "description": "Month 1-12, required when periodType=month.",
            "minimum": 1,
            "maximum": 12,
            "nullable": true,
            "example": 1
          },
          "periodQuarter": {
            "type": "integer",
            "description": "Quarter 1-4, required when periodType=quarter.",
            "minimum": 1,
            "maximum": 4,
            "nullable": true,
            "example": 1
          },
          "state": {
            "type": "string",
            "description": "Lifecycle state of the VAT return.",
            "enum": ["draft", "submitted", "accepted", "corrected"],
            "default": "draft",
            "example": "draft"
          },
          "amount": {
            "type": "number",
            "description": "Server-authoritative total VAT liability (MonetaryAmount). Derived from the rubrieken aggregation; never trusted from the client.",
            "example": 1234.56
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code.",
            "minLength": 3,
            "maxLength": 3,
            "default": "EUR",
            "example": "EUR"
          },
          "notes": {
            "type": "string",
            "description": "Optional free-text notes.",
            "nullable": true
          },
          "attachmentUri": {
            "type": "string",
            "description": "REQ-ARC: docudesk reference to the rendered aangifte PDF.",
            "nullable": true
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "draft",
          "states": {
            "draft": {
              "label": "Concept",
              "description": "Editable draft, not yet filed."
            },
            "submitted": {
              "label": "Ingediend",
              "description": "Filed via Digipoort; awaiting acceptance."
            },
            "accepted": {
              "label": "Geaccepteerd",
              "description": "Belastingdienst acknowledged receipt."
            },
            "corrected": {
              "label": "Gecorrigeerd",
              "description": "Superseded by a suppletie-aangifte."
            }
          },
          "transitions": {
            "submit": {
              "from": "draft",
              "to": "submitted",
              "label": "Indienen via Digipoort",
              "description": "REQ-VBTW-005/006/010: file the return. Requires approval above the operator threshold; triggers the digipoort-sbr submission workflow.",
              "requires": {
                "approval-workflow": {
                  "threshold-field": "amount",
                  "description": "REQ-VBTW-006: approval gate when liability exceeds an operator-configurable threshold (ADR-022 approval abstraction)."
                }
              }
            },
            "acknowledge": {
              "from": "submitted",
              "to": "accepted",
              "label": "Bevestigen",
              "description": "REQ-VBTW-005: external ACK received."
            },
            "correctFromAccepted": {
              "from": "accepted",
              "to": "corrected",
              "label": "Suppletie indienen",
              "description": "REQ-VBTW-005: operator files a suppletie-aangifte."
            },
            "correctFromDraft": {
              "from": "draft",
              "to": "corrected",
              "label": "Vroege correctie",
              "description": "REQ-VBTW-005: early correction before submission."
            }
          }
        },
        "x-openregister-aggregations": {
          "rubrieken": {
            "description": "REQ-VBTW-004: VAT buckets grouped by rate (21%, 9%, 0%, reverse-charge) over GL postings in the return period, summing debit/credit per rate. Server-authoritative — drives the amount field.",
            "source": "GLLine",
            "groupBy": "vatRate",
            "operation": "sum",
            "field": "amount",
            "filters": {
              "administrationId": "@self.administrationId",
              "periodYear": "@self.periodYear"
            }
          },
          "reverseChargeBucket": {
            "description": "REQ-VBTW-009: reverse-charge (verleggingsregeling) postings aggregated separately per Wet OB 1968.",
            "source": "GLLine",
            "operation": "sum",
            "field": "amount",
            "filters": {
              "administrationId": "@self.administrationId",
              "reverseCharge": true
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        },
        "x-openregister-lifecycle-retention": {
          "rule": "selectielijst:5.1.2",
          "description": "REQ-ARC-003/005: 7-year financial-record retention, disposition archive. Enforced by OR."
        }
      },
