            "type": "string",
            "description": "FK to the parent GLTransaction id."
          },
          "lineNumber": {
            "type": "integer",
            "description": "Sequence number of this line within the transaction.",
            "minimum": 1
          },
          "accountNumber": {
            "type": "string",
            "description": "FK to Account.accountNumber.",
