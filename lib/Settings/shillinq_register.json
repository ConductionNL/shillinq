            "filters": {
              "administrationId": "@self.administrationId",
              "icp": true
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "vat-administrator": { "permissions": ["create", "read", "update"] },
            "auditor": { "permissions": ["read"] }
          }
        },
        "x-openregister-lifecycle-retention": {
          "rule": "selectielijst:5.1.2",
          "description": "REQ-ARC: 7-year financial-record retention."
        }
      },
