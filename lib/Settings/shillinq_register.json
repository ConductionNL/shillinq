      "Account": {
        "slug": "Account",
        "icon": "LedgerOutline",
        "version": "0.1.0",
        "title": "Account",
        "description": "A hierarchical chart-of-accounts entry conforming to the RGS (Referentie Grootboek Schema) standard for Dutch bookkeeping.",
        "type": "object",
        "x-schema-org": "schema:DefinedTerm",
        "required": [
          "accountNumber",
          "name",
          "accountType",
          "currency",
          "administrationId",
          "lifecycleState"
        ],
        "properties": {
          "accountNumber": {
            "type": "string",
            "description": "RGS-style account code (e.g. '1000', '4100'). Unique within an administration.",
            "example": "1000"
          },
          "name": {
            "type": "string",
            "description": "Human-readable account name.",
            "example": "Liquide middelen"
          },
          "accountType": {
            "type": "string",
            "description": "Top-level balance-sheet or income-statement classification.",
            "enum": [
              "assets",
              "liabilities",
              "equity",
              "revenue",
              "expenses"
            ],
            "example": "assets"
          },
          "currency": {
            "type": "string",
            "description": "ISO 4217 currency code for this account's base currency.",
            "minLength": 3,
            "maxLength": 3,
            "example": "EUR",
            "default": "EUR"
          },
          "parentAccountNumber": {
            "type": "string",
            "description": "FK to the parent Account.accountNumber for hierarchy navigation.",
            "example": "1000",
            "nullable": true
          },
          "isClosingAccount": {
            "type": "boolean",
            "description": "Designates this as the administration's single closing account for period-end equity absorption.",
            "default": false
          },
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this account. Scopes uniqueness of accountNumber.",
            "example": "adm-1"
          },
          "lifecycleState": {
            "type": "string",
            "description": "Current lifecycle state of the account.",
            "enum": [
              "active",
              "blocked",
              "archived"
            ],
            "example": "active",
            "default": "active"
          },
          "description": {
            "type": "string",
            "description": "Operator-authored free-text description of the account.",
            "nullable": true
          },
          "vatApplicable": {
            "type": "boolean",
            "description": "Whether VAT/BTW applies to transactions posted to this account.",
            "default": false
          }
        },
        "x-openregister-lifecycle": {
          "field": "lifecycleState",
          "initialState": "active",
          "states": {
            "active": {
              "label": "Active",
              "description": "Fully usable for new GL postings."
            },
            "blocked": {
              "label": "Blocked",
              "description": "Readable and referenceable by existing postings, but rejected as the target of new GL lines."
            },
            "archived": {
              "label": "Archived",
              "description": "Historical only — no new postings, no edits; remains queryable."
            }
          },
          "preconditions": {
            "save": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireSingleClosingAccount"
          },
          "transitions": {
            "block": {
              "from": "active",
              "to": "blocked",
              "label": "Block account",
              "description": "Prevent new postings against this account."
            },
            "unblock": {
              "from": "blocked",
              "to": "active",
              "label": "Unblock account",
              "description": "Re-enable new postings against this account."
            },
            "archiveFromActive": {
              "from": "active",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            },
            "archiveFromBlocked": {
              "from": "blocked",
              "to": "archived",
              "label": "Archive account",
              "description": "Move to historical archive from blocked state. Requires zero open balance.",
              "requires": "OCA\\Shillinq\\Guard\\AccountBalanceGuard::requireZeroBalance"
            }
          }
        },
        "x-openregister-relations": {
          "parentAccount": {
            "localField": "parentAccountNumber",
            "relatedSchema": "Account",
            "relatedField": "accountNumber",
            "cardinality": "many-to-one",
            "description": "Self-relation enabling hierarchical chart-of-accounts navigation."
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "bookkeeper": {
              "permissions": ["create", "read", "update"]
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        },
        "x-openregister-aggregations": {
          "countByType": {
            "field": "accountType",
            "operation": "count",
            "description": "Number of accounts per accountType.",
            "groupBy": "accountType"
          },
          "countByLifecycle": {
            "field": "lifecycleState",
            "operation": "count",
            "description": "Number of accounts per lifecycleState.",
            "groupBy": "lifecycleState"
          }
        }
      },
      "Project": {
        "slug": "Project",
        "icon": "FolderOpenOutline",
        "version": "0.1.0",
        "title": "Project",
        "description": "Consultancy project with RJ 270 / IFRS 15 percentage-of-completion revenue recognition. Lifecycle offerte → active → on-hold → closed → archived.",
        "type": "object",
        "x-schema-org": "schema:Project",
        "required": [
          "administrationId",
          "projectNumber",
          "name",
          "customerId",
          "state",
          "totalContractValue",
          "totalEstimatedCosts",
          "recognitionMethod",
          "recognitionStage",
          "currency"
        ],
        "properties": {
          "administrationId": {
            "type": "string",
            "description": "FK to the Administration owning this project.",
            "example": "adm-1"
          },
          "projectNumber": {
            "type": "string",
            "description": "Unique project identifier per administration (e.g. PRJ-2026-001).",
            "example": "PRJ-2026-001"
          },
          "name": {
            "type": "string",
            "description": "Human-readable project name.",
            "example": "OR-rollout client X"
          },
          "customerId": {
            "type": "string",
            "description": "FK to the customer contact record.",
            "example": "cust-1"
          },
          "state": {
            "type": "string",
            "description": "Current lifecycle state of the project.",
            "enum": [
              "offerte",
              "active",
              "on-hold",
              "closed",
              "archived"
            ],
            "example": "active",
            "default": "offerte"
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Project activation date.",
            "example": "2026-01-15"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Target project close date.",
            "example": "2026-12-31"
          },
          "totalContractValue": {
            "type": "number",
            "minimum": 0,
            "description": "Total contracted revenue in project currency (operator-set).",
            "example": 100000
          },
          "totalEstimatedCosts": {
            "type": "number",
            "minimum": 0,
            "description": "Total estimated costs (operator-set; revised over project life; revision triggers audit-trail entry).",
            "example": 70000
          },
          "costsIncurredToDate": {
            "type": "number",
            "minimum": 0,
            "readOnly": true,
            "description": "Derived from GL via x-openregister-aggregations: sum of GLLine amounts on expense accounts tagged to this project (REQ-CPA-006).",
            "example": 35000
          },
          "recognisedRevenue": {
            "type": "number",
            "minimum": 0,
            "readOnly": true,
            "description": "Derived via x-openregister-calculations: RJ 270 / IFRS 15 percentage-of-completion formula (REQ-CPA-007).",
            "example": 50000
          },
          "billedRevenue": {
            "type": "number",
            "minimum": 0,
            "readOnly": true,
            "description": "Derived from invoices (T2 AR) referencing this project via subLedgerRef.",
            "example": 40000
          },
          "wipBalance": {
            "type": "number",
            "readOnly": true,
            "description": "Derived: recognisedRevenue - billedRevenue (REQ-CPA-008).",
            "example": 10000
          },
          "recognitionMethod": {
            "type": "string",
            "description": "Revenue recognition method per RJ 270 / IFRS 15.",
            "enum": [
              "percentage-of-completion-cost-to-cost",
              "percentage-of-completion-output",
              "completed-contract"
            ],
            "example": "percentage-of-completion-cost-to-cost"
          },
          "recognitionStage": {
            "type": "string",
            "description": "Current RJ 270 completion stage (from rj-270-stages.json seed).",
            "enum": [
              "initiation",
              "execution",
              "closeout",
              "complete"
            ],
            "example": "execution"
          },
          "percentageComplete": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "nullable": true,
            "description": "Operator-supplied completion percentage for output-based recognition method.",
            "example": 50
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3,
            "description": "ISO 4217 project currency.",
            "example": "EUR",
            "default": "EUR"
          },
          "closureJustification": {
            "type": "string",
            "nullable": true,
            "description": "Operator justification when closing a project with non-zero WIP balance."
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "offerte",
          "retention": {
            "rule": "selectielijst:5.1.2",
            "years": 7,
            "description": "Financial records — 7 years per Selectielijst 5.1.2 (REQ-CPA-014)."
          },
          "states": {
            "offerte": {
              "label": "Offerte",
              "description": "Project is at quotation stage; no GL postings yet."
            },
            "active": {
              "label": "Actief",
              "description": "Project is in execution; GL postings and hour logging are permitted."
            },
            "on-hold": {
              "label": "On hold",
              "description": "Project is paused; no new GL postings; reason required."
            },
            "closed": {
              "label": "Afgesloten",
              "description": "Project is complete; final WIP snapshot and recognition adjustment triggered."
            },
            "archived": {
              "label": "Gearchiveerd",
              "description": "Historical only; remains queryable per 7-year retention rule."
            }
          },
          "transitions": {
            "activate": {
              "from": "offerte",
              "to": "active",
              "label": "Activeer project",
              "description": "Move project from quotation to active execution. startDate must be set.",
              "requires": "OCA\\Shillinq\\Guard\\ProjectActivationGuard::requireStartDate"
            },
            "putOnHold": {
              "from": "active",
              "to": "on-hold",
              "label": "Zet on hold",
              "description": "Pause project; closureJustification (reason) field must be set.",
              "requires": "OCA\\Shillinq\\Guard\\ProjectTransitionGuard::requireReason"
            },
            "reactivate": {
              "from": "on-hold",
              "to": "active",
              "label": "Heractiveer project",
              "description": "Resume project from on-hold state."
            },
            "close": {
              "from": "active",
              "to": "closed",
              "label": "Sluit project",
              "description": "Close project; triggers final WIP snapshot + recognition adjustment. Open WIP balance surfaces warning requiring operator justification.",
              "requires": "OCA\\Shillinq\\Guard\\ProjectCloseGuard::requireWipJustificationOrZero"
            },
            "archive": {
              "from": "closed",
              "to": "archived",
              "label": "Archiveer project",
              "description": "Move closed project to archive (typically 12 months post-close)."
            }
          }
        },
        "x-openregister-aggregations": {
          "costsIncurredToDate": {
            "description": "Sum of GL expense-account postings tagged to this project via GLLine.subLedgerRef (REQ-CPA-006).",
            "operation": "sum",
            "field": "amount",
            "source": {
              "register": "@register",
              "schema": "GLLine"
            },
            "filter": {
              "subLedgerType": "project",
              "subLedgerRef": "@self.id",
              "account.accountType": "expenses"
            }
          },
          "billedRevenue": {
            "description": "Sum of invoice lines referencing this project via T2 AR sub-ledger.",
            "operation": "sum",
            "field": "amount",
            "source": {
              "register": "@register",
              "schema": "GLLine"
            },
            "filter": {
              "subLedgerType": "project",
              "subLedgerRef": "@self.id",
              "account.accountType": "revenue"
            }
          },
          "profitAndLoss": {
            "description": "Project P&L: recognised revenue minus costs incurred to date (REQ-CPA-010).",
            "operation": "derived",
            "fields": {
              "recognisedRevenue": "@self.recognisedRevenue",
              "costsIncurredToDate": "@self.costsIncurredToDate",
              "grossMargin": {
                "formula": "@self.recognisedRevenue - @self.costsIncurredToDate"
              },
              "grossMarginPercentage": {
                "formula": "@self.recognisedRevenue > 0 ? ((@self.recognisedRevenue - @self.costsIncurredToDate) / @self.recognisedRevenue * 100) : 0"
              }
            }
          }
        },
        "x-openregister-calculations": {
          "recognisedRevenue": {
            "description": "RJ 270 / IFRS 15 percentage-of-completion recognised revenue (REQ-CPA-007). Clamped to [0, totalContractValue].",
            "type": "number",
            "conditions": [
              {
                "when": {
                  "recognitionMethod": "completed-contract",
                  "state": { "not": "closed" }
                },
                "value": 0,
                "description": "completed-contract: recognise nothing until state=closed."
              },
              {
                "when": {
                  "recognitionMethod": "completed-contract",
                  "state": "closed"
                },
                "formula": "@self.totalContractValue",
                "description": "completed-contract: recognise full contract value on close."
              },
              {
                "when": {
                  "recognitionMethod": "percentage-of-completion-output"
                },
                "formula": "@self.totalContractValue * (@self.percentageComplete / 100)",
                "description": "output-based: operator-supplied percentageComplete drives recognition."
              }
            ],
            "default": {
              "formula": "@self.totalEstimatedCosts > 0 ? max(0, @self.totalContractValue * (@self.costsIncurredToDate / @self.totalEstimatedCosts)) : 0",
              "description": "cost-to-cost (default): totalContractValue × (costsIncurredToDate / totalEstimatedCosts), clamped ≥ 0."
            }
          },
          "wipBalance": {
            "description": "Work-in-progress balance: recognised revenue minus billed revenue (REQ-CPA-008).",
            "type": "number",
            "formula": "@self.recognisedRevenue - @self.billedRevenue"
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "project-administrator": {
              "permissions": ["create", "read", "update", "delete"],
              "description": "Full project management access; visibility predicate: administrationType ∈ {mkb, zzp}."
            },
            "bookkeeper": {
              "permissions": ["read", "update"],
              "description": "Read and update project financial fields."
            },
            "auditor": {
              "permissions": ["read"]
            }
          }
        }
      },
      "ProjectAssignment": {
        "slug": "ProjectAssignment",
        "icon": "AccountArrowRightOutline",
        "version": "0.1.0",
        "title": "Projectopdracht",
        "description": "Assignment of a person to a project with rate-card reference and utilisation tracking (REQ-CPA-004).",
        "type": "object",
        "x-schema-org": "schema:JobPosting",
        "required": [
          "projectId",
          "personId",
          "rateCardId",
          "recognisedRate",
          "startDate",
          "state"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "description": "FK to the parent Project.id.",
            "example": "proj-1"
          },
          "personId": {
            "type": "string",
            "description": "FK to the assigned person (Nextcloud user or OR Person record).",
            "example": "user-1"
          },
          "rateCardId": {
            "type": "string",
            "description": "FK to the RateCard effective at assignment time.",
            "example": "rc-1"
          },
          "recognisedRate": {
            "type": "number",
            "minimum": 0,
            "description": "Snapshot of RateCard.hourlyRate at assignment time per RJ 270 §3.2.4. Immutable after creation.",
            "example": 180
          },
          "estimatedHours": {
            "type": "number",
            "minimum": 0,
            "nullable": true,
            "description": "Operator estimate of hours this person will spend on this project.",
            "example": 200
          },
          "startDate": {
            "type": "string",
            "format": "date",
            "description": "Assignment start date.",
            "example": "2026-01-15"
          },
          "endDate": {
            "type": "string",
            "format": "date",
            "nullable": true,
            "description": "Assignment end date.",
            "example": "2026-12-31"
          },
          "state": {
            "type": "string",
            "description": "Assignment lifecycle state.",
            "enum": [
              "planned",
              "active",
              "completed"
            ],
            "example": "active",
            "default": "planned"
          },
          "capacityHoursPerWeek": {
            "type": "number",
            "minimum": 0,
            "description": "Operator-set weekly capacity hours for utilisation calculation. Default 40 per Wet IB (36-hour workweek; operator override allowed).",
            "example": 40,
            "default": 40
          },
          "utilization": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "readOnly": true,
            "description": "Derived: billableHoursThisPeriod / capacityHoursThisPeriod (REQ-CPA-011).",
            "example": 0.75
          }
        },
        "x-openregister-lifecycle": {
          "field": "state",
          "initialState": "planned",
          "retention": {
            "rule": "selectielijst:5.1.2",
            "years": 7
          },
          "states": {
            "planned": {
              "label": "Gepland",
              "description": "Assignment is planned; BillableHour records may not yet reference it."
            },
            "active": {
              "label": "Actief",
              "description": "Assignment is active; BillableHour records may reference projectId + personId."
            },
            "completed": {
              "label": "Afgerond",
              "description": "Assignment is complete."
            }
          },
          "transitions": {
            "activate": {
              "from": "planned",
              "to": "active",
              "label": "Activeer opdracht",
              "description": "Activate the assignment; hour logging becomes available."
            },
            "complete": {
              "from": "active",
              "to": "completed",
              "label": "Sluit opdracht",
              "description": "Mark assignment as completed."
            }
          }
        },
        "x-openregister-calculations": {
          "utilization": {
            "description": "Billable hours this period divided by capacity hours this period per person (REQ-CPA-011).",
            "type": "number",
            "formula": "@self.capacityHoursThisPeriod > 0 ? (@self.billableHoursThisPeriod / @self.capacityHoursThisPeriod) : 0",
            "note": "billableHoursThisPeriod is aggregated from UrenRegistratie records for this assignment in the current FiscalPeriod; capacityHoursThisPeriod = capacityHoursPerWeek × workingWeeksInPeriod."
          }
        },
        "x-openregister-widgets": {
          "utilisatieWidget": {
            "title": "Utilisatie",
            "description": "Per-person utilisation for the current period with green/yellow/red bands (REQ-CPA-013).",
            "type": "utilisation-chart",
            "dataSource": {
              "register": "@register",
              "schema": "ProjectAssignment",
              "calculation": "utilization"
            },
            "bands": [
              { "min": 0.8, "color": "success", "label": "Hoog (>80%)" },
              { "min": 0.5, "color": "warning", "label": "Gemiddeld (50-80%)" },
              { "min": 0, "color": "error", "label": "Laag (<50%)" }
            ],
            "visibilityPredicate": {
              "administrationType": ["mkb", "zzp"],
              "role": "project-administrator"
            }
          }
        },
        "x-openregister-rbac": {
          "roles": {
            "project-administrator": {
              "permissions": ["create", "read", "update", "delete"]
            },
            "bookkeeper": {
              "permissions": ["read"]
            }
          }
        }
      },
