  "templates": [
    {
      "templateId": "vpb-aangifte-innovatiebox-sectie",
      "title": "Vpb-aangifte — Innovatiebox sectie",
      "description": "Sectie voor de innovatiebox in de Vpb-aangifte voorbereiding. Rendert de gekozen route (forfaitair of afpelmethode), de van toepassing zijnde tarieven, en de innovatie-toegerekende winst per belastingjaar.",
      "register": "shillinq",
      "schema": "InnovatieboxElection",
      "aggregation": "innovatieboxAdministratie",
      "sections": [
        {
          "sectionId": "innovatiebox-route",
          "title": "Innovatiebox route ({{fiscalYear}})",
          "fields": [
            {
              "key": "route",
              "label": "Gekozen route",
              "type": "string"
            },
            {
              "key": "applicableTariff",
              "label": "Toepasselijk tarief",
              "type": "percentage"
            },
            {
              "key": "fiscalYear",
              "label": "Belastingjaar",
              "type": "integer"
            }
          ]
        },
        {
          "sectionId": "innovatiebox-forfaitair",
          "title": "Forfaitaire berekening",
          "condition": "route == 'forfaitair'",
          "fields": [
            {
              "key": "operatingProfit",
              "label": "Belastbare winst",
              "type": "currency"
            },
            {
              "key": "forfaitairPercentage",
              "label": "Forfaitair percentage",
              "type": "percentage"
            },
            {
              "key": "forfaitairCapBedrag",
              "label": "Plafond innovatie-toegerekende winst",
              "type": "currency"
            },
            {
              "key": "innovatieboxProfit",
              "label": "Innovatie-toegerekende winst (min(25% x winst, plafond))",
              "type": "currency"
            },
            {
              "key": "capApplied",
              "label": "Plafond van toepassing",
              "type": "boolean"
            }
          ]
        },
        {
          "sectionId": "innovatiebox-afpelmethode",
          "title": "Afpelmethode — per IP-activum",
          "condition": "route == 'afpelmethode'",
          "sourceSchema": "IPAssetValuation",
          "joinField": "administrationId",
          "columns": [
            {
              "key": "assetNaam",
              "label": "IP-activum"
            },
            {
              "key": "assetType",
              "label": "Activumtype"
            },
            {
              "key": "valuationBedrag",
              "label": "Gekapitaliseerde waarde (EUR)",
              "type": "currency"
            },
            {
              "key": "applicableTariff",
              "label": "Toepasselijk tarief",
              "type": "percentage"
            },
            {
              "key": "vpbImpact",
              "label": "Vpb-impact (EUR)",
              "type": "currency"
            }
          ],
          "totals": [
            {
              "label": "Totale innovatiebox-grondslag",
              "field": "vpbImpact",
              "operation": "sum"
            }
          ]
        }
      ],
      "footer": "Gegenereerd vanuit de Shillinq innovatiebox-administratie aggregatie (REQ-IBA-003, REQ-IBA-005). Bronnen: Wet Vpb art. 12b/12bg."
    },
    {
      "templateId": "rd-subsidie-horizon-periodic-report",
      "title": "EU Horizon — Periodic Report",
      "description": "EU Horizon Periodic Report layout per EC Grant Agreement. Groups approved kostenposten per Horizon kostencategorie (personnel/subcontracting/other-direct/indirect-25-percent) and periodId. Sourced from the Subsidie voortgangsrapportage aggregation. Per REQ-RDS-003.",
      "register": "shillinq",
      "schema": "Subsidie",
      "aggregation": "voortgangsrapportage",
      "condition": "subsidieRegeling == 'eu-horizon'",
      "sections": [
        {
          "sectionId": "horizon-header",
          "title": "EU Horizon Periodic Report — {{regelingNaam}}",
          "fields": [
            {
              "key": "subsidieNumber",
              "label": "Grant reference",
              "type": "string"
            },
            {
              "key": "counterpartyName",
              "label": "Granting authority",
              "type": "string"
            },
            {
              "key": "regelingNaam",
              "label": "Programme",
              "type": "string"
            }
          ]
        },
        {
          "sectionId": "horizon-kosten-per-periode",
          "title": "Eligible costs per category and period",
          "columns": [
            {
              "key": "kostencategorie",
              "label": "Cost category"
            },
            {
              "key": "periodId",
              "label": "Period"
            },
            {
              "key": "totalAmount",
              "label": "Total (EUR)",
              "type": "currency"
            }
          ],
          "totals": [
            {
              "label": "Total direct costs",
              "field": "totalAmount",
              "condition": "kostencategorie != 'indirect-25-percent'",
              "operation": "sum"
            },
            {
              "label": "Indirect costs (25% flat rate)",
              "field": "totalAmount",
              "condition": "kostencategorie == 'indirect-25-percent'",
              "operation": "sum"
            }
          ]
        },
        {
          "sectionId": "horizon-budget-bewaking",
          "title": "Budget monitoring",
          "fields": [
            {
              "key": "horizonDirectCosts",
              "label": "Direct costs (base for 25% indirect)",
              "type": "currency"
            },
            {
              "key": "horizonIndirect25MaxBedrag",
              "label": "Indirect-25% maximum",
              "type": "currency"
            },
            {
              "key": "horizonIndirect25UsageBedrag",
              "label": "Indirect-25% used",
              "type": "currency"
            },
            {
              "key": "horizonIndirect25UsagePercent",
              "label": "Indirect-25% usage",
              "type": "percentage"
            },
            {
              "key": "horizonIndirect25Warning",
              "label": "Warning (>=90%)",
              "type": "boolean"
            }
          ]
        }
      ],
      "footer": "Gegenereerd vanuit Shillinq R&D Subsidies — EU Horizon voortgangsrapportage (REQ-RDS-003)."
    },
