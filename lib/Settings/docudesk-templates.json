{
  "_spdx": {
    "SPDX-FileCopyrightText": "2026 Conduction B.V.",
    "SPDX-License-Identifier": "EUPL-1.2"
  },
  "_meta": {
    "description": "Docudesk template registry for Shillinq. Templates are registered here and rendered by the docudesk integration (ADR-022).",
    "idempotency": "templateId"
  },
  "templates": [
    {
      "templateId": "vpb-aangifte-innovatiebox-sectie",
      "title": "Vpb-aangifte — Innovatiebox sectie",
      "description": "Sectie voor de innovatiebox in de Vpb-aangifte voorbereiding. Rendert de gekozen route (forfaitair of afpelmethode), de van toepassing zijnde tarieven, en de innovatie-toegerekende winst per belastingjaar.",
      "register": "shillinq",
      "schema": "InnovatieboxElection",
      "aggregation": "innovatieboxAdministratie",
      "sections": [
        {
          "sectionId": "innovatiebox-route",
          "title": "Innovatiebox route ({{fiscalYear}})",
          "fields": [
            {"key": "route", "label": "Gekozen route", "type": "string"},
            {"key": "applicableTariff", "label": "Toepasselijk tarief", "type": "percentage"},
            {"key": "fiscalYear", "label": "Belastingjaar", "type": "integer"}
          ]
        },
        {
          "sectionId": "innovatiebox-forfaitair",
          "title": "Forfaitaire berekening",
          "condition": "route == 'forfaitair'",
          "fields": [
            {"key": "operatingProfit", "label": "Belastbare winst", "type": "currency"},
            {"key": "forfaitairPercentage", "label": "Forfaitair percentage", "type": "percentage"},
            {"key": "forfaitairCapBedrag", "label": "Plafond innovatie-toegerekende winst", "type": "currency"},
            {"key": "innovatieboxProfit", "label": "Innovatie-toegerekende winst (min(25% x winst, plafond))", "type": "currency"},
            {"key": "capApplied", "label": "Plafond van toepassing", "type": "boolean"}
          ]
        },
        {
          "sectionId": "innovatiebox-afpelmethode",
          "title": "Afpelmethode — per IP-activum",
          "condition": "route == 'afpelmethode'",
          "sourceSchema": "IPAssetValuation",
          "joinField": "administrationId",
          "columns": [
            {"key": "assetNaam", "label": "IP-activum"},
            {"key": "assetType", "label": "Activumtype"},
            {"key": "valuationBedrag", "label": "Gekapitaliseerde waarde (EUR)", "type": "currency"},
            {"key": "applicableTariff", "label": "Toepasselijk tarief", "type": "percentage"},
            {"key": "vpbImpact", "label": "Vpb-impact (EUR)", "type": "currency"}
          ],
          "totals": [
            {"label": "Totale innovatiebox-grondslag", "field": "vpbImpact", "operation": "sum"}
          ]
        }
      ],
      "footer": "Gegenereerd vanuit de Shillinq innovatiebox-administratie aggregatie (REQ-IBA-003, REQ-IBA-005). Bronnen: Wet Vpb art. 12b/12bg."
    },
    {
      "templateId": "vpb-aangifte-voorbereiding",
      "title": "Vpb-aangifte voorbereiding",
      "description": "Voorbereiding van de vennootschapsbelasting aangifte voor een ondernemingsactiviteit. Populatie vanuit de VpbBalansFiltered aggregatie (REQ-VPB-004). De feitelijke aangifte-transmissie rijdt op het T4-base bookkeeping-sbr-xbrl-reporting SBR-eindpunt (ADR-019) — geen nieuwe SBR-client.",
      "register": "shillinq",
      "schema": "VpbBalansLink",
      "aggregation": "vpbBalansFiltered",
      "sbrBinding": {
        "endpoint": "bookkeeping-sbr-xbrl-reporting",
        "entryPoint": "belastingdienst-vpb",
        "xsdReference": "vpb-aangifte-{{ fiscalYear }}.xsd",
        "note": "XSD-versie wordt per fiscaal jaar bepaald. Meerdere templateversies kunnen naast elkaar bestaan per Risk 1 in design.md."
      },
      "sections": [
        {
          "sectionId": "vpb-administratie-kop",
          "title": "Vpb-administratie — {{administrationId}} / {{fiscalYear}}",
          "fields": [
            {"key": "administrationId", "label": "Administratie", "type": "string"},
            {"key": "fiscalYear", "label": "Belastingjaar", "type": "integer"},
            {"key": "costCenterId", "label": "Ondernemingsactiviteit (kostenplaats)", "type": "string"},
            {"key": "vpbPligtigVanaf", "label": "Vpb-pligtig vanaf", "type": "date"}
          ]
        },
        {
          "sectionId": "vpb-balans",
          "title": "Vpb-balans",
          "fields": [
            {"key": "totalActiva", "label": "Activa (EUR)", "type": "currency"},
            {"key": "totalPassiva", "label": "Passiva (EUR)", "type": "currency"},
            {"key": "totalResultaat", "label": "Resultaat (EUR)", "type": "currency"}
          ]
        },
        {
          "sectionId": "vpb-balans-accounts",
          "title": "Vpb-pligtige rekeningen",
          "sourceSchema": "GLLine",
          "joinField": "accountNumber",
          "filterField": "accountNumbers",
          "columns": [
            {"key": "accountNumber", "label": "Rekeningnummer"},
            {"key": "accountName", "label": "Rekeningnaam"},
            {"key": "debit", "label": "Debet (EUR)", "type": "currency"},
            {"key": "credit", "label": "Credit (EUR)", "type": "currency"},
            {"key": "saldo", "label": "Saldo (EUR)", "type": "currency"}
          ],
          "totals": [
            {"label": "Totaal activa", "field": "debit", "operation": "sum", "condition": "accountType IN ('assets')"},
            {"label": "Totaal passiva", "field": "credit", "operation": "sum", "condition": "accountType IN ('liabilities', 'equity')"},
            {"label": "Netto resultaat", "field": "saldo", "operation": "sum", "condition": "accountType IN ('revenue', 'expenses')"}
          ]
        }
      ],
      "footer": "Gegenereerd vanuit de Shillinq VpbBalansFiltered aggregatie (REQ-VPB-003, REQ-VPB-004). Bron: Wet modernisering Vpb-plicht (2016). Aangifte-transmissie via T4-base SBR-XBRL eindpunt."
    }
  ]
}
