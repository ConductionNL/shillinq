    {
      "templateId": "rd-subsidie-horizon-audit-pack",
      "title": "EU Horizon — Audit Certificate Pack",
      "description": "EU Horizon Audit Certificate pack assembling OR audit-trail-immutable + kostendossier + S&O-uren-staten URI refs per personnel kostenpost. Per REQ-RDS-004.",
      "register": "shillinq",
      "schema": "Subsidie",
      "aggregation": "voortgangsrapportage",
      "condition": "subsidieRegeling == 'eu-horizon'",
      "auditSource": "audit-trail-immutable",
      "sections": [
        {
          "sectionId": "horizon-audit-header",
          "title": "EU Horizon Audit Certificate — {{subsidieNumber}}",
          "fields": [
            {
              "key": "subsidieNumber",
              "label": "Grant reference",
              "type": "string"
            },
            {
              "key": "regelingNaam",
              "label": "Programme",
              "type": "string"
            },
            {
              "key": "counterpartyName",
              "label": "Granting authority",
              "type": "string"
            },
            {
              "key": "vaststellingDate",
              "label": "Settlement date",
              "type": "date"
            }
          ]
        },
        {
          "sectionId": "horizon-audit-personnel-timesheets",
          "title": "Personnel costs — timesheet evidence",
          "filter": {
            "kostencategorie": "personnel"
          },
          "columns": [
            {
              "key": "description",
              "label": "Employee / role"
            },
            {
              "key": "periodId",
              "label": "Period"
            },
            {
              "key": "amount",
              "label": "Amount (EUR)",
              "type": "currency"
            },
            {
              "key": "soUrenStaatUri",
              "label": "S&O-uren-staat URI",
              "type": "uri"
            }
          ]
        },
        {
          "sectionId": "horizon-audit-trail",
          "title": "Audit trail (immutable)",
          "auditTrail": true
        },
        {
          "sectionId": "horizon-audit-kostendossier",
          "title": "Kostendossier — alle goedgekeurde kostenposten",
          "filter": {
            "state": "approved"
          },
          "columns": [
            {
              "key": "kostencategorie",
              "label": "Kostencategorie"
            },
            {
              "key": "periodId",
              "label": "Periode"
            },
            {
              "key": "amount",
              "label": "Bedrag (EUR)",
              "type": "currency"
            },
            {
              "key": "attachmentUri",
              "label": "Bijlage URI",
              "type": "uri"
            }
          ],
          "totals": [
            {
              "label": "Totaal subsidiabele kosten",
              "field": "amount",
              "operation": "sum"
            }
          ]
        }
      ],
      "footer": "Gegenereerd vanuit Shillinq R&D Subsidies — EU Horizon Audit Certificate Pack (REQ-RDS-004). S&O-uren-staten URI-refs afkomstig uit Shillinq WBSO-administratie."
    },
