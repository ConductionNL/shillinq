{
	"templates": [
		{
			"templateId": "RETAIL_APPAREL_TEMPLATE",
			"name": "Retail apparel products",
			"description": "SKU format: {category_code}-{manufacturer_abbrev}-{size}-{color_code}",
			"pattern": "{category}-{manufacturer}-{size}-{color}",
			"rules": [
				{
					"field": "category",
					"type": "mapping",
					"mapping": {
						"Apparel": "AP",
						"Footwear": "FW",
						"Accessories": "AC"
					}
				},
				{
					"field": "manufacturer",
					"type": "mapping",
					"mapping": {
						"Nike": "NK",
						"Adidas": "AD",
						"Puma": "PM",
						"Levi's": "LV"
					}
				},
				{
					"field": "size",
					"type": "passthrough"
				},
				{
					"field": "color",
					"type": "hex_first_3_chars",
					"mapping": {
						"Black": "000",
						"White": "FFF",
						"Red": "F00",
						"Green": "0F0",
						"Blue": "00F"
					}
				}
			]
		},
		{
			"templateId": "PET_FOOD_TEMPLATE",
			"name": "Pet food products",
			"description": "SKU format: {category_prefix}-{species_code}-{formula_type}-{size_code}",
			"pattern": "{category}-{species}-{formula}-{size}",
			"rules": [
				{
					"field": "category",
					"type": "mapping",
					"mapping": {
						"Dry Food": "DV",
						"Wet Food": "WF",
						"Treats": "TR"
					}
				},
				{
					"field": "species",
					"type": "mapping",
					"mapping": {
						"Cat": "KAT",
						"Dog": "HON",
						"Rabbit": "KNJ"
					}
				},
				{
					"field": "formula",
					"type": "mapping",
					"mapping": {
						"Senior": "SENIOR",
						"Adult": "ADULT",
						"Kitten": "KITTEN"
					}
				},
				{
					"field": "size",
					"type": "mapping",
					"mapping": {
						"2kg": "2KG",
						"5kg": "5KG",
						"10kg": "10KG"
					}
				}
			]
		},
		{
			"templateId": "SUPPLEMENT_TEMPLATE",
			"name": "Dietary supplements",
			"description": "SKU format: {ingredient_code}-{dose}-{unit_abbrev}-{form_code}",
			"pattern": "{ingredient}-{dose}-{unit}-{form}",
			"rules": [
				{
					"field": "ingredient",
					"type": "mapping",
					"mapping": {
						"Vitamin C": "VIT-C",
						"Vitamin D": "VIT-D",
						"Omega-3": "OMG3"
					}
				},
				{
					"field": "dose",
					"type": "passthrough"
				},
				{
					"field": "unit",
					"type": "mapping",
					"mapping": {
						"mg": "MG",
						"ug": "UG",
						"IU": "IU"
					}
				},
				{
					"field": "form",
					"type": "mapping",
					"mapping": {
						"Capsule": "CAP",
						"Tablet": "TAB",
						"Liquid": "LIQ"
					}
				}
			]
		}
	]
}
