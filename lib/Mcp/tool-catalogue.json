                },
                "closeReason": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 2000,
                    "description": "Why the period is reopened."
                }
            },
            "required": [
                "administrationId",
                "periodId"
            ]
        }
    },
    {
        "id": "shillinq.vat_return.create",
        "name": "Create a VAT return",
        "description": "Create a draft VAT return for an administration for a past or current quarter, month or year, with its lines derived from the bookings. Use it when the user asks to prepare a VAT return; it files nothing. A future period is refused. Submit the draft later with shillinq.vat_return.submit.",
        "scope": "create",
        "reach": "user",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the return is for."
                },
                "period": {
                    "type": "string",
                    "enum": [
                        "quarter",
                        "month",
                        "year"
                    ],
                    "description": "The kind of period."
                },
                "periodYear": {
                    "type": "integer",
                    "minimum": 2020,
                    "maximum": 2099,
                    "description": "The fiscal year."
                },
                "periodNumber": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 12,
                    "description": "The quarter (1-4), month (1-12) or 1 for a year."
                },
                "regime": {
                    "type": "string",
                    "enum": [
                        "standard",
                        "kor",
                        "reverse-charge"
                    ],
                    "description": "The VAT regime."
                }
            },
            "required": [
                "administrationId",
                "period",
                "periodYear",
                "periodNumber",
                "regime"
            ]
        }
    },
    {
        "id": "shillinq.vat_return.rebase",
        "name": "Rebase a VAT return to draft",
        "description": "Move a submitted VAT return of an administration back to draft and derive its lines again from the current bookings, as the signed-in user. Use it when the user asks to correct a submitted return before it is filed. The service refuses a return that is not submitted.",
