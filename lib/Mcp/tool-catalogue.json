                "invoiceId"
            ]
        }
    },
    {
        "id": "shillinq.dunning.pause",
        "name": "Pause dunning on an invoice",
        "description": "Pause the dunning of a sales invoice, as the signed-in user, because it is disputed, under a payment plan or for another reason. Use it when the user says a customer disputes an invoice or agreed a payment plan; no reminder is sent while the pause stands. Lift it with shillinq.dunning.resume.",
        "scope": "update",
        "reach": "user",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the invoice belongs to."
                },
                "invoiceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The sales invoice; find it with shillinq.ARInvoice.search."
                },
                "reason": {
                    "type": "string",
                    "enum": [
                        "DISPUTED",
                        "PAYMENT_PLAN",
                        "OTHER"
                    ],
                    "description": "Why dunning is paused."
                },
                "details": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 2000,
                    "description": "What the customer said or agreed."
                }
            },
            "required": [
                "administrationId",
                "invoiceId",
                "reason"
            ]
        }
    },
    {
        "id": "shillinq.dunning.resume",
        "name": "Lift a dunning pause",
        "description": "Lift a dunning pause of an administration: resolve it (the dispute is settled, optionally with a partial settlement) or let it expire, so dunning continues. Use it when the user says the dispute or payment plan is over. Find the pause with the invoice it was set on.",
        "scope": "update",
        "reach": "user",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the pause belongs to."
                },
                "pauseId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The dunning pause."
                },
                "resolution": {
                    "type": "string",
                    "enum": [
                        "resolve",
                        "expire"
                    ],
                    "description": "Resolve the pause, or let it expire; defaults to resolve."
                },
                "partialSettlement": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "description": "The amount settled, when the dispute ended in a partial settlement."
                }
            },
            "required": [
                "administrationId",
                "pauseId"
            ]
        }
    },
    {
        "id": "shillinq.dunning.write_off",
        "name": "Write off an uncollectable invoice",
        "description": "Write off the principal of an uncollectable sales invoice and record the art. 29 OB VAT reclaim, as the signed-in user. Use it only when the user explicitly asks to write that invoice off; it books into the ledger and the VAT return and binds the administration.",
        "scope": "update",
        "reach": "instance",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the invoice belongs to."
                },
                "invoiceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The sales invoice; find it with shillinq.ARInvoice.search."
                },
                "principalDepreciated": {
                    "type": "number",
                    "minimum": 0,
                    "description": "The principal written off, more than zero."
                },
                "art29OBDeclaration": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "The art. 29 OB statement on why the claim is uncollectable."
                },
                "vatAmount": {
                    "type": [
                        "number",
                        "null"
                    ],
                    "minimum": 0,
                    "description": "The VAT reclaimed; derived from the invoice when empty."
                },
                "vatTaxReturnPeriod": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[0-9]{4}-(Q[1-4]|[0-9]{2})$",
                    "description": "The VAT period the reclaim lands in, e.g. 2026-Q3; the next one when empty."
                },
                "evidenceRef": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 500,
                    "description": "A reference to the evidence, such as a bankruptcy notice."
                }
            },
            "required": [
                "administrationId",
                "invoiceId",
                "principalDepreciated",
                "art29OBDeclaration"
            ]
        }
    },
    {
        "id": "shillinq.requisition.create",
        "name": "Create a purchase requisition",
        "description": "Create a draft purchase requisition in an administration, as the signed-in requester, with what is needed, why, by when and on which budget programme, line by line. Use it when the user asks to request a purchase; nothing is ordered. Submit it for approval with shillinq.requisition.submit.",
        "scope": "create",
        "reach": "user",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the requisition belongs to."
                },
                "programme": {
                    "type": "string",
                    "maxLength": 200,
                    "description": "The budget programme it is charged to."
                },
                "financialYear": {
                    "type": "integer",
                    "minimum": 2000,
                    "maximum": 2099,
                    "description": "The financial year."
                },
                "neededByDate": {
                    "type": "string",
                    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                    "description": "When it is needed, as YYYY-MM-DD."
                },
                "justification": {
                    "type": "string",
                    "maxLength": 2000,
                    "description": "Why it is needed."
                },
                "kind": {
                    "type": "string",
                    "maxLength": 100,
                    "description": "The kind of purchase, such as goods or services."
                },
                "preferredSupplierId": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "A preferred supplier, if any."
                },
                "lines": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 100,
                    "description": "What is requested, one line per item.",
                    "items": {
                        "type": "object",
                        "properties": {
                            "description": {
                                "type": "string",
                                "maxLength": 500,
                                "description": "What the line is for."
                            },
                            "glAccountSuggestion": {
                                "type": "string",
                                "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                                "description": "The ledger account it is likely booked on."
                            },
                            "quantity": {
                                "type": "number",
                                "minimum": 0,
                                "description": "How many, more than zero."
                            },
                            "unitPrice": {
                                "type": "number",
                                "minimum": 0,
                                "description": "The price per unit, excluding VAT."
                            }
                        },
                        "required": [
                            "description",
                            "glAccountSuggestion",
                            "quantity",
                            "unitPrice"
                        ]
                    }
                }
            },
            "required": [
                "administrationId",
                "programme",
                "financialYear",
                "neededByDate",
                "justification",
                "kind",
                "lines"
            ]
        }
    },
