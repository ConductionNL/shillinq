[
    {
        "id": "shillinq.purchase_order.decide",
        "name": "Decide on a purchase order",
        "description": "Approve, reject or delegate a purchase order that waits for your approval, as the signed-in approver. Use it when the user asks to approve or reject a specific purchase order; find the order first with shillinq.PurchaseOrder.search. The decision binds the administration and is recorded in the approval chain; it cannot be taken back with this tool.",
        "scope": "update",
        "reach": "instance",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the order belongs to."
                },
                "purchaseOrderId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The purchase order."
                },
                "decision": {
                    "type": "string",
                    "enum": [
                        "approved",
                        "rejected",
                        "delegated"
                    ],
                    "description": "The decision."
                },
                "comment": {
                    "type": [
                        "string",
                        "null"
                    ],
                    "maxLength": 2000,
                    "description": "An optional comment for the approval chain."
                }
            },
            "required": [
                "administrationId",
                "purchaseOrderId",
                "decision"
            ]
        }
    },
    {
