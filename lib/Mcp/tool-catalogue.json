                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the return belongs to."
                },
                "returnId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The VAT return; find it with shillinq.VatReturn.search."
                }
            },
            "required": [
                "administrationId",
                "returnId"
            ]
        }
    },
    {
