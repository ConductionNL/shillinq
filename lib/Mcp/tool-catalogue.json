                "administrationId",
                "periodId"
            ]
        }
    },
    {
        "id": "shillinq.period_close.reopen",
        "name": "Reopen a closed period",
        "description": "Reopen a closed accounting period of an administration, as the signed-in user, recording why. Use it only when the user explicitly asks to reopen a closed period to correct it; the reason is kept with the period. The service refuses a period that is locked for audit.",
        "scope": "update",
        "reach": "instance",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
