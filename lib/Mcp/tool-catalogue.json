        "readOnlyHint": true,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the invoice belongs to."
                },
                "invoiceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The sales invoice; find it with shillinq.ARInvoice.search."
                },
                "customerId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The customer of the invoice."
                }
            },
            "required": [
                "administrationId",
                "invoiceId",
                "customerId"
            ]
        }
    },
    {
        "id": "shillinq.dunning.execute_run",
        "name": "Send the next dunning reminder",
        "description": "Run the next stage of the dunning ladder for an overdue sales invoice: compose the reminder and send it to the customer through its channel. Use it only when the user explicitly asks to send a reminder for that invoice; the letter leaves the instance. A paused invoice is refused.",
        "scope": "update",
        "reach": "external",
        "readOnlyHint": false,
        "destructiveHint": false,
        "inputSchema": {
            "type": "object",
            "properties": {
                "administrationId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The administration the invoice belongs to."
                },
                "invoiceId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The sales invoice; find it with shillinq.ARInvoice.search."
                },
                "ladderId": {
                    "type": "string",
                    "pattern": "^[A-Za-z0-9_.\\-]{1,64}$",
                    "description": "The dunning ladder to follow; empty for the configured one."
                },
                "stageNr": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10,
                    "description": "The stage of the ladder to run; defaults to the first."
