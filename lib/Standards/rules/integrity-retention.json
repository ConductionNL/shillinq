      "domain": "ledger-integrity",
      "jurisdiction": "global",
      "framework": "gaap-principles",
      "source": "Completeness & timeliness principle",
      "statement": "All transactions of a period shall be recorded completely and in the period to which they relate, without omission or backdating.",
