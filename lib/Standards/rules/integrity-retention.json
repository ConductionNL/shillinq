{
  "domain": "ledger-integrity",
  "version": "2026-06",
  "rules": [
    {
      "id": "nl-awr52-general-7y",
      "domain": "retention",
      "jurisdiction": "NL",
      "framework": "awr",
      "source": "art. 52 lid 4 AWR",
      "statement": "A taxpayer running a business shall retain its accounting administration, books, records and data carriers for at least 7 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002320/2024-01-01#HoofdstukVIII_Afdeling2_Artikel52"
    },
    {
      "id": "nl-awr52-realestate-10y",
      "domain": "retention",
      "jurisdiction": "NL",
      "framework": "awr",
      "source": "art. 52 AWR / art. 34a Wet OB",
      "statement": "Data concerning immovable property and rights to immovable property shall be retained for 10 years because of the VAT revision (herzieningstermijn) period.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/zakelijk/btw/administratie_bijhouden/administratie_bewaren/"
    },
    {
      "id": "nl-bw2-10-administratieplicht",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "bw",
      "source": "art. 2:10 BW",
      "statement": "The board of a legal person shall keep an administration of the entity's financial position and everything concerning its activities such that its rights and obligations can be known at any time.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0003045/2024-01-01#Boek2_Titeldeel1_Artikel10"
    },
    {
      "id": "nl-bw2-10-retain-7y",
      "domain": "retention",
      "jurisdiction": "NL",
      "framework": "bw",
      "source": "art. 2:10 lid 3 BW",
      "statement": "The books, records and data carriers of a legal person's administration shall be retained for 7 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0003045/2024-01-01#Boek2_Titeldeel1_Artikel10"
    },
    {
      "id": "nl-bw2-394-balance-permanent",
      "domain": "retention",
      "jurisdiction": "NL",
      "framework": "bw",
      "source": "art. 2:10 lid 1 BW",
      "statement": "The opening balance sheet and the annual accounts shall be kept on a durable carrier and remain retrievable for the full administration retention period.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0003045/2024-01-01#Boek2_Titeldeel1_Artikel10"
    },
    {
      "id": "nl-administratie-true-fair",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "bw",
      "source": "art. 2:362 BW",
      "statement": "The annual accounts shall give, in accordance with sound business practice, a true and fair view of the entity's assets, liabilities and result.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0003045/2024-01-01"
    },
    {
      "id": "nl-bewaarplicht-accessible-form",
      "domain": "retention",
      "jurisdiction": "NL",
      "framework": "awr",
      "source": "art. 52 lid 5-6 AWR",
      "statement": "Electronically retained administration shall remain readable and reproducible within a reasonable time throughout the retention period.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002320/2024-01-01#HoofdstukVIII_Afdeling2_Artikel52"
    },

    {
      "id": "de-ao147-3-books-8y",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§147 Abs. 3 AO",
      "statement": "Books, inventories, opening balance sheets, annual financial statements, management reports and the accounting records (Buchungsbelege) shall be retained for 8 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__147.html"
    },
    {
      "id": "de-ao147-belege-8y-beg4",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§147 Abs. 3 AO (BEG IV)",
      "statement": "The retention period for accounting vouchers (Buchungsbelege) was reduced from 10 to 8 years by the Fourth Bureaucracy Relief Act for documents whose period had not yet expired.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__147.html"
    },
    {
      "id": "de-ao147-commercial-letters-6y",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§147 Abs. 3 AO",
      "statement": "Received and sent commercial and business letters and other documents relevant to taxation shall be retained for 6 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__147.html"
    },
    {
      "id": "de-hgb257-4-books-8y",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "hgb",
      "source": "§257 Abs. 4 HGB",
      "statement": "Trading books, inventories, opening balance sheets, annual accounts and the accounting vouchers shall be retained for 8 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/hgb/__257.html"
    },
    {
      "id": "de-hgb257-letters-6y",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "hgb",
      "source": "§257 Abs. 4 HGB",
      "statement": "Received commercial letters and reproductions of sent commercial letters shall be retained for 6 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/hgb/__257.html"
    },
    {
      "id": "de-ustg14b-invoice-8y",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§14b Abs. 1 UStG",
      "statement": "VAT invoices shall be retained for 8 years, aligned with the BEG IV reduction of the general accounting retention period.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/ustg_1980/__14b.html"
    },
    {
      "id": "de-beg4-banks-insurers-deferred",
      "domain": "retention",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "BEG IV, §147 AO transitional",
      "statement": "For banks, insurers and securities institutions the reduced 8-year retention period takes effect one year later than for other businesses. (verify)",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.bdo.de/en-gb/insights/updates/tax-legal/fourth-bureaucracy-relief-act"
    },
    {
      "id": "de-hgb238-orderly-bookkeeping",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "hgb",
      "source": "§238 HGB",
      "statement": "Every merchant shall keep books recording its commercial transactions and the situation of its assets in accordance with the principles of orderly bookkeeping (Grundsätze ordnungsmäßiger Buchführung).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/hgb/__238.html"
    },
    {
      "id": "de-hgb239-3-no-undetectable-change",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "hgb",
      "source": "§239 Abs. 3 HGB",
      "statement": "An entry or record shall not be altered in such a way that its original content is no longer ascertainable, and it must not be unclear whether a change was made originally or later.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/hgb/__239.html"
    },
    {
      "id": "de-hgb239-2-timely-orderly",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "hgb",
      "source": "§239 Abs. 2 HGB",
      "statement": "Entries in the books shall be made completely, correctly, in a timely manner and in orderly fashion.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/hgb/__239.html"
    },
    {
      "id": "de-ao146-1-timely-complete",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§146 Abs. 1 AO",
      "statement": "Bookings and other required records shall be made completely, correctly, in good time and in an orderly manner; cash transactions shall be recorded daily.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__146.html"
    },
    {
      "id": "de-ao146-4-no-unrecorded-change",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "ao",
      "source": "§146 Abs. 4 AO",
      "statement": "A booking or record shall not be changed so that its original content is no longer determinable, including in electronic records.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__146.html"
    },
    {
      "id": "de-gobd-nachvollziehbarkeit",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Nachvollziehbarkeit",
      "statement": "Bookkeeping shall be traceable and verifiable so that an expert third party can obtain an overview of the transactions and the entity's situation within reasonable time (progressive and retrograde audit trail).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-vollstaendigkeit",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Vollständigkeit",
      "statement": "All business transactions of the period shall be recorded completely, without gaps and without omission.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-richtigkeit",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Richtigkeit",
      "statement": "Recorded transactions shall correspond accurately to the actual facts and be posted to the correct accounts.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-zeitgerechte-buchungen",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Zeitgerechte Buchungen",
      "statement": "There shall be a close temporal connection between a transaction and its recording; non-cash transactions should generally be captured within ten days.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-ordnung",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Ordnung",
      "statement": "Records shall be kept in a clear, systematic and orderly way so that transactions are identifiable and chronologically and materially organised.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-unveraenderbarkeit",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Unveränderbarkeit",
      "statement": "Once recorded, data shall not be altered or deleted without trace; any correction must keep the original content readable and be documented (audit trail).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-belegfunktion",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Belegfunktion",
      "statement": "No entry without a document: every booking shall be traceable to a source document (Beleg) that substantiates it.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-verfahrensdokumentation",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "GoBD (BMF) — Verfahrensdokumentation",
      "statement": "The taxpayer shall maintain a procedural documentation describing how records are created, captured, processed, stored and secured.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://www.bundesfinanzministerium.de/Content/DE/Downloads/BMF_Schreiben/Weitere_Steuerthemen/Abgabenordnung/2019-11-28-GoBD.html"
    },
    {
      "id": "de-gobd-datenzugriff-z3",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "gobd",
      "source": "§147 Abs. 6 AO / GoBD Datenzugriff",
      "statement": "Tax-relevant data shall be available for tax-authority data access (Z1/Z2/Z3) and exportable in a machine-evaluable format on request.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/ao_1977/__147.html"
    },

    {
      "id": "fr-comm-l123-12-bookkeeping",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "code-commerce",
      "source": "art. L123-12 Code de commerce",
      "statement": "Every trader shall record the movements affecting the assets of the business chronologically and prepare annual accounts at the close of the financial year.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000019290718/"
    },
    {
      "id": "fr-comm-l123-22-10y",
      "domain": "retention",
      "jurisdiction": "FR",
      "framework": "code-commerce",
      "source": "art. L123-22 Code de commerce",
      "statement": "Accounting records and supporting documents (livres et pièces justificatives) shall be retained for 10 years.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000006219327/"
    },
    {
      "id": "fr-comm-l123-22-no-blank-no-gap",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "code-commerce",
      "source": "art. L123-22 Code de commerce",
      "statement": "Accounting documents shall be kept without blanks or alterations of any kind.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000006219327/"
    },
    {
      "id": "fr-lpf-l102b-6y",
      "domain": "retention",
      "jurisdiction": "FR",
      "framework": "lpf",
      "source": "art. L102 B LPF",
      "statement": "Books, registers, documents and records subject to the tax authority's right of communication and audit shall be kept for 6 years from the date of the last entry or operation.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000048763280/"
    },
    {
      "id": "fr-fec-mandatory-export",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "fec",
      "source": "art. L47 A-I LPF",
      "statement": "A taxpayer keeping computerised accounts shall, on a tax audit, hand over the accounting entries file (Fichier des Écritures Comptables, FEC) in dematerialised form.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027518252/"
    },
    {
      "id": "fr-fec-18-fields",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "fec",
      "source": "art. A47 A-1 LPF (annexe)",
      "statement": "The FEC shall contain the 18 prescribed fields per entry (journal code/label, entry number, date, account, reference and date of the supporting document, label, debit, credit, lettering, validation date, etc.).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027805954/"
    },
    {
      "id": "fr-fec-format",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "fec",
      "source": "art. A47 A-1 LPF (annexe)",
      "statement": "The FEC shall be a flat text or XML file, tab- or pipe-delimited, encoded per the standard, named SIREN+'FEC'+closing date (YYYYMMDD).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027805954/"
    },
    {
      "id": "fr-fec-validated-entries",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "fec",
      "source": "art. A47 A-1 LPF",
      "statement": "Entries in the FEC shall be definitively validated (closed) and carry a validation date, so they can no longer be modified or deleted.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000027805954/"
    },
    {
      "id": "fr-pcg-chronological-irreversible",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "pcg",
      "source": "PCG (ANC) art. 911-3 / 921",
      "statement": "Accounting entries shall be recorded chronologically and, once validated, made irreversible so that no entry can be deleted or modified.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.anc.gouv.fr/files/live/sites/anc/files/contributed/ANC/1_Normes_fran%C3%A7aises/Reglements/Recueils/PCG_Janvier2025/PCG2025.pdf"
    },
    {
      "id": "fr-nf525-certified-software",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "nf525",
      "source": "art. 286-I-3° bis CGI (loi anti-fraude TVA)",
      "statement": "A taxable person recording customer payments via accounting or cash software shall use software certified (e.g. NF525) or attested as guaranteeing inalterability, security, conservation and archiving of the data.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033817810/"
    },
    {
      "id": "fr-nf525-inalterability",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "nf525",
      "source": "NF525 / BOI-TVA-DECLA-30-10-30",
      "statement": "Certified cash software shall guarantee inalterability of recorded sales data: originating entries cannot be modified or deleted, only corrected by an offsetting entry.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://bofip.impots.gouv.fr/bofip/11026-PGP.html"
    },
    {
      "id": "fr-nf525-secured-archive",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "nf525",
      "source": "NF525 / art. 286 CGI",
      "statement": "Certified cash software shall produce periodic (daily, monthly, annual) closing totals (grand total perpétuel) that are secured and archived as an unbroken sequence.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://bofip.impots.gouv.fr/bofip/11026-PGP.html"
    },

    {
      "id": "be-wvv-3-65-10y",
      "domain": "retention",
      "jurisdiction": "BE",
      "framework": "code-economique",
      "source": "art. 3:65 WVV / art. III.86 WER",
      "statement": "Undertakings shall retain their books and supporting documents for 7 years under accounting law; for tax purposes a 10-year retention period applies following the 2023 extension of the tax statute of limitations. (verify)",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://financien.belgium.be/nl/ondernemingen/vennootschapsbelasting/boekhouding"
    },
    {
      "id": "be-wer-double-entry",
      "domain": "ledger-integrity",
      "jurisdiction": "BE",
      "framework": "code-economique",
      "source": "art. III.83-III.84 WER",
      "statement": "Undertakings shall keep double-entry accounts adapted to the nature and scope of their activities, recording all transactions without delay, faithfully and completely, in date order.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ejustice.just.fgov.be/eli/wet/2013/02/28/2013A11134/justel"
    },
    {
      "id": "be-wer-no-blank-no-alteration",
      "domain": "ledger-integrity",
      "jurisdiction": "BE",
      "framework": "code-economique",
      "source": "art. III.85 WER",
      "statement": "Accounts shall be kept without blanks or omissions; in case of correction the original entry shall remain legible.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ejustice.just.fgov.be/eli/wet/2013/02/28/2013A11134/justel"
    },
    {
      "id": "be-vat-invoice-10y",
      "domain": "retention",
      "jurisdiction": "BE",
