    {
      "id": "gl-double-entry-balanced",
      "domain": "ledger-integrity",
      "jurisdiction": "global",
      "framework": "gaap-principles",
      "source": "Double-entry bookkeeping principle",
      "statement": "Every transaction shall be recorded with equal total debits and credits so that the ledger remains in balance.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/conceptual-framework/"
    },
    {
      "id": "gl-trial-balance-reconciles",
      "domain": "ledger-integrity",
      "jurisdiction": "global",
      "framework": "gaap-principles",
      "source": "Trial-balance integrity",
      "statement": "The sum of all account balances in the general ledger shall reconcile to zero (debits equal credits) at any reporting date.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ifrs.org/issued-standards/list-of-standards/conceptual-framework/"
