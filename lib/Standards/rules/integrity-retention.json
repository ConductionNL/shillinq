      "domain": "ledger-integrity",
      "jurisdiction": "global",
      "framework": "gaap-principles",
      "source": "Immutability / no-deletion principle",
      "statement": "A posted (closed) journal entry shall not be deleted or edited in place; corrections shall be made by an offsetting reversal entry preserving the original.",
