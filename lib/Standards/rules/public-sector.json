{
  "domain": "recognition",
  "version": "2026-06",
  "rules": [
    {
      "id": "ipsas-1-21-complete-set",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-1",
      "source": "IPSAS 1.21",
      "statement": "A complete set of financial statements comprises a statement of financial position, statement of financial performance, statement of changes in net assets/equity, cash flow statement, a budget comparison where applicable, and notes.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-1-presentation-financial-statements"
    },
    {
      "id": "ipsas-1-27-fair-presentation",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-1",
      "source": "IPSAS 1.27",
      "statement": "Financial statements shall present fairly the financial position, performance and cash flows through faithful representation of the effects of transactions and events.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-1-presentation-financial-statements"
    },
    {
      "id": "ipsas-1-38-going-concern",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-1",
      "source": "IPSAS 1.38",
      "statement": "Those responsible for preparation shall assess the entity's ability to continue as a going concern when preparing the financial statements.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-1-presentation-financial-statements"
    },
    {
      "id": "ipsas-1-63-accrual-basis",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-1",
      "source": "IPSAS 1.28 (verify)",
      "statement": "An entity shall prepare its financial statements, except for cash flow information, using the accrual basis of accounting.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-1-presentation-financial-statements"
    },
    {
      "id": "ipsas-2-18-classify-activities",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-2",
      "source": "IPSAS 2.18",
      "statement": "The cash flow statement shall report cash flows during the period classified by operating, investing and financing activities.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2001-07-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-2-cash-flow-statements"
    },
    {
      "id": "ipsas-2-27-direct-or-indirect",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-2",
      "source": "IPSAS 2.27",
      "statement": "Operating cash flows shall be reported using either the direct method or the indirect method.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2001-07-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-2-cash-flow-statements"
    },
    {
      "id": "ipsas-12-15-lower-cost-nrv",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-12",
      "source": "IPSAS 12.15",
      "statement": "Inventories shall be measured at the lower of cost and net realizable value, except for inventories acquired through a non-exchange transaction or held for distribution.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-12-inventories"
    },
    {
      "id": "ipsas-12-17-distribution-replacement-cost",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-12",
      "source": "IPSAS 12.17",
      "statement": "Inventories held for distribution at no charge or a nominal charge shall be measured at the lower of cost and current replacement cost.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-12-inventories"
    },
    {
      "id": "ipsas-12-35-cost-formula",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-12",
      "source": "IPSAS 12.35",
      "statement": "Cost shall be assigned using the first-in first-out or weighted average cost formula, applied consistently to inventories of a similar nature and use.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2008-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-12-inventories"
    },
    {
      "id": "ipsas-19-22-provision-recognition",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-19",
      "source": "IPSAS 19.22",
      "statement": "A provision shall be recognized only when a present obligation from a past event exists, an outflow of resources is probable, and a reliable estimate can be made.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-19-provisions-contingent-liabilities-and-contingent-assets"
    },
    {
      "id": "ipsas-19-35-no-contingent-liability",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-19",
      "source": "IPSAS 19.35",
      "statement": "An entity shall not recognize a contingent liability.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-19-provisions-contingent-liabilities-and-contingent-assets"
    },
    {
      "id": "ipsas-19-100-disclose-contingent",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-19",
      "source": "IPSAS 19.100",
      "statement": "Disclose each class of contingent liability unless the possibility of an outflow of resources is remote.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-19-provisions-contingent-liabilities-and-contingent-assets"
    },
    {
      "id": "ipsas-21-26-assess-indicators",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-21",
      "source": "IPSAS 21.26",
      "statement": "At each reporting date assess whether there is any indication that a non-cash-generating asset may be impaired and, if so, estimate its recoverable service amount.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2006-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-21-impairment-non-cash-generating-assets"
    },
    {
      "id": "ipsas-21-52-recognise-impairment",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-21",
      "source": "IPSAS 21.52",
      "statement": "Where the recoverable service amount is less than the carrying amount, reduce the carrying amount to the recoverable service amount and recognize the difference as an impairment loss.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2006-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-21-impairment-non-cash-generating-assets"
    },
    {
      "id": "ipsas-21-54-loss-in-surplus-deficit",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-21",
      "source": "IPSAS 21.54",
      "statement": "An impairment loss on a non-cash-generating asset shall be recognized immediately in surplus or deficit unless the asset is carried at a revalued amount.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2006-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-21-impairment-non-cash-generating-assets"
    },
    {
      "id": "ipsas-23-31-asset-recognition",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-23",
      "source": "IPSAS 23.31",
      "statement": "Recognize an asset from a non-exchange transaction when an inflow of future economic benefits or service potential is probable and its fair value is reliably measurable.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2008-06-30",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-23-revenue-non-exchange-transactions-taxes-and-transfers"
    },
    {
      "id": "ipsas-23-44-condition-creates-liability",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-23",
      "source": "IPSAS 23.44",
      "statement": "An inflow of resources from a non-exchange transaction is recognized as revenue except to the extent a present obligation (condition) is recognized as a liability and released to revenue as the condition is satisfied.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2008-06-30",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-23-revenue-non-exchange-transactions-taxes-and-transfers"
    },
    {
      "id": "ipsas-23-59-tax-on-taxable-event",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-23",
      "source": "IPSAS 23.59",
      "statement": "Recognize an asset in respect of taxes when the taxable event occurs and the asset recognition criteria are met.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2008-06-30",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-23-revenue-non-exchange-transactions-taxes-and-transfers"
    },
    {
      "id": "ipsas-23-superseded-by-47",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-23",
      "source": "IPSAS 47.204",
      "statement": "IPSAS 23 is superseded by IPSAS 47 for annual financial statements covering periods beginning on or after 1 January 2026.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "ipsas-24-14-budget-comparison",
      "domain": "reporting",
      "jurisdiction": "global",
      "framework": "ipsas-24",
      "source": "IPSAS 24.14",
      "statement": "Present a comparison of the original and final budget amounts with actual amounts on a comparable basis, and disclose an explanation of material differences.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2009-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-24-presentation-budget-information-financial-statements"
    },
    {
      "id": "ipsas-24-21-separate-statement",
      "domain": "presentation",
      "jurisdiction": "global",
      "framework": "ipsas-24",
      "source": "IPSAS 24.21",
      "statement": "Present the budget-to-actual comparison either in the primary statements where on a comparable basis, or otherwise in a separate Statement of Comparison of Budget and Actual Amounts.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2009-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-24-presentation-budget-information-financial-statements"
    },
    {
      "id": "ipsas-24-47-reconcile-actuals",
      "domain": "reporting",
      "jurisdiction": "global",
      "framework": "ipsas-24",
      "source": "IPSAS 24.47",
      "statement": "Where budget and financial statements are not on a comparable basis, reconcile actual amounts to the financial statements identifying basis, timing and entity differences.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2009-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-24-presentation-budget-information-financial-statements"
    },
    {
      "id": "ipsas-32-09-recognise-asset",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-32",
      "source": "IPSAS 32.9 (verify)",
      "statement": "A grantor shall recognize a service concession asset when it controls or regulates the services provided, the recipients and the price, and controls any significant residual interest.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2014-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-32-service-concession-arrangements-grantor"
    },
    {
      "id": "ipsas-32-14-recognise-liability",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-32",
      "source": "IPSAS 32.14 (verify)",
      "statement": "On recognition of a service concession asset the grantor shall recognize a liability initially measured at the same amount, adjusted for any other consideration.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2014-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-32-service-concession-arrangements-grantor"
    },
    {
      "id": "ipsas-35-20-control-three-elements",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-35",
      "source": "IPSAS 35.20",
      "statement": "An entity controls another entity only when it has power, exposure or rights to variable benefits, and the ability to use its power to affect the nature or amount of those benefits.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2017-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-35-consolidated-financial-statements-1"
    },
    {
      "id": "ipsas-35-38-uniform-policies",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-35",
      "source": "IPSAS 35.38",
      "statement": "Consolidated financial statements shall be prepared using uniform accounting policies for like transactions and events in similar circumstances.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2017-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-35-consolidated-financial-statements-1"
    },
    {
      "id": "ipsas-35-40-eliminate-intragroup",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-35",
      "source": "IPSAS 35.40",
      "statement": "Consolidation eliminates the carrying amount of the controlling entity's investment in each controlled entity and all intragroup balances and transactions.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2017-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-35-consolidated-financial-statements-1"
    },
    {
      "id": "ipsas-39-11-short-term-benefits",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-39",
      "source": "IPSAS 39.11",
      "statement": "Recognize the undiscounted amount of short-term employee benefits expected to be paid as a liability and an expense when the employee renders the related service.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-39-employee-benefits-2"
    },
    {
      "id": "ipsas-39-65-net-defined-benefit",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-39",
      "source": "IPSAS 39.65",
      "statement": "Recognize the net defined benefit liability or asset as the present value of the defined benefit obligation less the fair value of plan assets, subject to the asset ceiling.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-39-employee-benefits-2"
    },
    {
      "id": "ipsas-39-122-cost-components",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-39",
      "source": "IPSAS 39.122",
      "statement": "Recognize service cost and net interest on the net defined benefit liability in surplus or deficit, and remeasurements in net assets/equity.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2018-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-39-employee-benefits-2"
    },
    {
      "id": "ipsas-41-10-recognise-on-becoming-party",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-41",
      "source": "IPSAS 41.10",
      "statement": "Recognize a financial asset or financial liability when, and only when, the entity becomes party to the contractual provisions of the instrument.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-41-financial-instruments"
    },
    {
      "id": "ipsas-41-40-amortised-cost",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-41",
      "source": "IPSAS 41.40",
      "statement": "Measure a financial asset at amortized cost if it is held within a hold-to-collect management model and its cash flows are solely payments of principal and interest.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-41-financial-instruments"
    },
    {
      "id": "ipsas-41-73-expected-credit-losses",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-41",
      "source": "IPSAS 41.73",
      "statement": "Recognize a loss allowance for expected credit losses on financial assets measured at amortized cost or fair value through net assets/equity, lease receivables, and loan commitments.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-41-financial-instruments"
    },
    {
      "id": "ipsas-43-23-right-of-use-model",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-43",
      "source": "IPSAS 43.23",
      "statement": "At the commencement date a lessee shall recognize a right-of-use asset and a lease liability.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-43-leases"
    },
    {
      "id": "ipsas-43-27-lease-liability-pv",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-43",
      "source": "IPSAS 43.27",
      "statement": "Measure the lease liability at the present value of unpaid lease payments discounted at the rate implicit in the lease or the lessee's incremental borrowing rate.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-43-leases"
    },
    {
      "id": "ipsas-43-06-short-term-exemption",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-43",
      "source": "IPSAS 43.6 (verify)",
      "statement": "A lessee may elect not to apply the right-of-use model to short-term leases or leases of low-value assets, recognizing payments on a systematic basis instead.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-43-leases"
    },
    {
      "id": "ipsas-45-06-recognition-criteria",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-45",
      "source": "IPSAS 45.6",
      "statement": "Recognize an item of property, plant and equipment as an asset only if future economic benefits or service potential are probable and its cost or current value is reliably measurable.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-45-property-plant-and-equipment"
    },
    {
      "id": "ipsas-45-24-class-model-choice",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-45",
      "source": "IPSAS 45.24",
      "statement": "Apply either the historical cost model or the current value model to an entire class of property, plant and equipment.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-45-property-plant-and-equipment"
    },
    {
      "id": "ipsas-45-supersedes-17",
      "domain": "measurement",
      "jurisdiction": "global",
      "framework": "ipsas-45",
      "source": "IPSAS 45.89 (verify)",
      "statement": "IPSAS 45 supersedes IPSAS 17 Property, Plant and Equipment for periods beginning on or after 1 January 2025.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2025-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-45-property-plant-and-equipment"
    },
    {
      "id": "ipsas-47-194-effective-date",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-47",
      "source": "IPSAS 47.194",
      "statement": "IPSAS 47 applies to annual financial statements covering periods beginning on or after 1 January 2026, with earlier application permitted.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "ipsas-47-88-binding-arrangement-model",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-47",
      "source": "IPSAS 47.88",
      "statement": "Under the binding arrangement model, recognize revenue when (or as) the entity satisfies a compliance obligation by using resources in the specified manner.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "ipsas-47-26-without-binding-arrangement",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-47",
      "source": "IPSAS 47.26",
      "statement": "Under the model without a binding arrangement, recognize an associated obligation as a liability when it is a present obligation to transfer resources, and recognize revenue to the extent not deferred by that liability.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "ipsas-47-36-taxes-on-taxable-event",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-47",
      "source": "IPSAS 47.36",
      "statement": "Recognize a tax asset when the taxable event occurs and the asset recognition criteria are met.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "ipsas-47-11-enforceable-arrangement",
      "domain": "recognition",
      "jurisdiction": "global",
      "framework": "ipsas-47",
      "source": "IPSAS 47.11",
      "statement": "A binding arrangement must be enforceable through legal or equivalent means in order to select the binding-arrangement revenue model.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.ipsasb.org/publications/ipsas-47-revenue"
    },
    {
      "id": "gasb-34-dual-reporting-model",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "State and local governments shall present both government-wide financial statements and fund financial statements.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-govwide-economic-resources",
      "domain": "measurement",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "Government-wide statements shall use the economic resources measurement focus and the full accrual basis of accounting, reporting governmental and business-type activities in separate columns.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-mda-required-rsi",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "Management's Discussion and Analysis (MD&A) is required supplementary information that shall precede the basic financial statements.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-capitalise-depreciate",
      "domain": "measurement",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "Capital assets, including infrastructure, shall be capitalized at historical cost and depreciated over their useful lives in the government-wide statements.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-modified-accrual-govfunds",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34 / GASB Codification 1600",
      "statement": "Governmental funds shall use the current financial resources measurement focus and modified accrual basis, recognizing revenues when measurable and available and expenditures when the related fund liability is incurred.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-available-period-policy",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB Codification 1600.106",
      "statement": "Revenue is available if collectible within the current period or soon enough thereafter to pay current-period liabilities; the availability period is a disclosed policy choice (commonly 60 days; 60 days is required for property taxes).",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-modified-approach-infrastructure",
      "domain": "measurement",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "Eligible infrastructure assets need not be depreciated under the modified approach if the government maintains an asset management system, assesses condition at least every three years, and preserves them at an established condition level.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-34-major-fund-criteria",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 34",
      "statement": "A fund is a major fund when an element is at least 10 percent of its fund category total and at least 5 percent of the combined governmental and enterprise total; the general fund is always major.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2002-06-15",
      "sourceUrl": "https://gasb.org/page/ShowPdf?path=GASBS+34.pdf"
    },
    {
      "id": "gasb-54-five-classifications",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 54",
      "statement": "Governmental fund balance shall be reported in a hierarchy of five classifications: nonspendable, restricted, committed, assigned, and unassigned.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2010-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-54.html&isStaticPage=true"
    },
    {
      "id": "gasb-54-nonspendable",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 54",
      "statement": "Nonspendable fund balance comprises amounts not in spendable form (such as inventory or prepaids) or legally or contractually required to be maintained intact.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2010-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-54.html&isStaticPage=true"
    },
    {
      "id": "gasb-54-constraint-hierarchy",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 54",
      "statement": "Restricted balance reflects externally imposed constraints, committed balance reflects constraints set by the highest decision-making authority through formal action, assigned reflects intended use, and unassigned is the residual in the general fund.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2010-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-54.html&isStaticPage=true"
    },
    {
      "id": "gasb-84-fiduciary-criteria",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 84",
      "statement": "Identify fiduciary activities based on whether the government controls the assets and the existence of a fiduciary relationship with the beneficiaries.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2018-12-15",
      "sourceUrl": "https://gasb.org/page/document?pdf=gasbs84.pdf&title=GASB+Statement+No.+84%2C+Fiduciary+Activities"
    },
    {
      "id": "gasb-84-four-fund-types",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 84",
      "statement": "Report fiduciary activities in four fund types: pension and other employee benefit trust funds, investment trust funds, private-purpose trust funds, and custodial funds.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2018-12-15",
      "sourceUrl": "https://gasb.org/page/document?pdf=gasbs84.pdf&title=GASB+Statement+No.+84%2C+Fiduciary+Activities"
    },
    {
      "id": "gasb-87-single-lease-model",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 87",
      "statement": "Apply a single lease model treating leases as financings of the right to use an underlying asset, eliminating the operating versus capital lease distinction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2019-12-15",
      "sourceUrl": "https://gasb.org/page/PageContent?pageId=/standards-guidance/pronouncements/status-of-statement-no-87.html&isStaticPage=true"
    },
    {
      "id": "gasb-87-lessee-recognition",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 87",
      "statement": "A lessee shall recognize a lease liability at the present value of payments and an intangible right-of-use lease asset at commencement of the lease term.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2019-12-15",
      "sourceUrl": "https://gasb.org/page/PageContent?pageId=/standards-guidance/pronouncements/status-of-statement-no-87.html&isStaticPage=true"
    },
    {
      "id": "gasb-87-short-term-exception",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 87",
      "statement": "Leases with a maximum possible term of 12 months or less are excluded from lease recognition and are recognized as outflows or inflows of resources.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2019-12-15",
      "sourceUrl": "https://gasb.org/page/PageContent?pageId=/standards-guidance/pronouncements/status-of-statement-no-87.html&isStaticPage=true"
    },
    {
      "id": "gasb-96-sbita-recognition",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 96",
      "statement": "At commencement of the subscription term recognize a subscription liability at the present value of payments and a right-to-use subscription asset as an intangible capital asset for SBITAs.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2022-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-96.html&isStaticPage=true"
    },
    {
      "id": "gasb-96-capitalisation-stages",
      "domain": "measurement",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 96",
      "statement": "Apply three-stage cost guidance for SBITAs: expense preliminary project stage costs, capitalize initial implementation stage costs, and expense operation stage costs unless they add capacity or efficiency.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2022-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-96.html&isStaticPage=true"
    },
    {
      "id": "gasb-96-short-term-exception",
      "domain": "recognition",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 96",
      "statement": "SBITAs with a maximum possible term of 12 months or less are excluded from subscription asset and liability recognition.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2022-06-15",
      "sourceUrl": "https://gasb.org/page/pronouncement?pageId=/standards-and-guidance/pronouncements/status-statement-no-96.html&isStaticPage=true"
    },
    {
      "id": "gasb-103-budgetary-comparison-rsi",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 103",
      "statement": "Budgetary comparison information shall be presented as required supplementary information with separate variance columns and notes explaining significant variances.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2025-06-15",
      "sourceUrl": "https://storage.gasb.org/GASBS%20103.pdf"
    },
    {
      "id": "gasb-103-unusual-infrequent-items",
      "domain": "presentation",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 103",
      "statement": "Replace extraordinary and special items with unusual or infrequent items, presented as the last flow of resources before the net change in resource flows with disclosure.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2025-06-15",
      "sourceUrl": "https://storage.gasb.org/GASBS%20103.pdf"
    },
    {
      "id": "gasb-103-mda-reorganised",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "gasb",
      "source": "GASB 103",
      "statement": "MD&A is reorganized into five categories and must explain the reasons for changes, with budgetary analysis removed from MD&A.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2025-06-15",
      "sourceUrl": "https://storage.gasb.org/GASBS%20103.pdf"
    },
    {
      "id": "bbv-art2-baten-lasten",
      "domain": "recognition",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 2",
      "statement": "Provinces and municipalities shall account on an accrual basis (baten-lastenstelsel), recognizing the revenues and expenses of the budget year regardless of whether they lead to receipts or payments in that year.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art7-begroting-structure",
      "domain": "presentation",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 7",
      "statement": "The budget consists of a policy budget (programme plan plus paragraphs) and a financial budget (overview of revenues and expenses plus the financial position).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art8-programmaplan",
      "domain": "presentation",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 8",
      "statement": "The programme plan shall set out the programmes to be realized, the overview of general cover funds (algemene dekkingsmiddelen), overhead costs, corporate income tax charge, and the amount for unforeseen expenditure.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art9-mandatory-paragraphs",
      "domain": "presentation",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 9",
      "statement": "The budget and accounts shall include the mandatory paragraphs: local levies, resilience capacity, maintenance of capital goods, financing, operational management, related parties, and land policy.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art10-lokale-heffingen",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 10",
      "statement": "The local levies paragraph shall include estimated revenues, levy policy, an overview of levies, an indication of local tax burden, and the remission (kwijtschelding) policy.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art11-weerstandsvermogen",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 11",
      "statement": "The resilience and risk management paragraph shall set out the relationship between resilience capacity and risks, the risk inventory, policy, and the prescribed financial ratios (kengetallen).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art12-onderhoud-kapitaalgoederen",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 12",
      "statement": "The maintenance of capital goods paragraph shall address roads, sewerage, water, green spaces, and buildings.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art13-financiering",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 13",
      "statement": "The financing (treasury) paragraph shall set out policy intentions for risk management, interest charges, the interest result, interest allocation, and the financing requirement.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art14-bedrijfsvoering",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 14",
      "statement": "The operational management paragraph shall set out the state of affairs, policy intentions, and measures regarding financial lawfulness (rechtmatigheid).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art15-verbonden-partijen",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 15",
      "statement": "The related parties paragraph shall include the vision and policy intentions and a list of related parties subdivided into joint arrangements, companies, foundations, and others.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art16-grondbeleid",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 16",
      "statement": "The land policy paragraph shall include the vision, the manner of execution, a forecast of land development results, the basis for profit-taking, and the reserve policy.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art24-jaarstukken",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 24",
      "statement": "The annual accounts (jaarstukken) consist of the annual report (programme accountability plus paragraphs) and the financial statements (overview of revenues and expenses, balance sheet, lawfulness statement, and auditor's report).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art25-programmaverantwoording",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 25",
      "statement": "Programme accountability shall report the realization of programmes, the degree of objective achievement measured by policy indicators, and the realized revenues and expenses.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art28-emu-saldo",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 19/22 (verify)",
      "statement": "The financial budget shall include an estimate of the EMU balance (EMU-saldo) for the budget year and surrounding years.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art58b-rechtmatigheidsverantwoording",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 58b",
      "statement": "The executive board shall include a lawfulness statement (rechtmatigheidsverantwoording) accounting for the financial lawfulness of revenues, expenses, and balance-sheet movements against the budget and statutory rules.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art44-voorzieningen",
      "domain": "recognition",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 44 (verify)",
      "statement": "Provisions (voorzieningen) shall be formed for obligations and losses of uncertain size, quantifiable risks, and costs to be evened out over future years.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art59-activeren",
      "domain": "recognition",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 59",
      "statement": "Tangible and intangible fixed assets that meet the activation criteria shall be capitalized (geactiveerd) on the balance sheet.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art62-verkrijgingsprijs",
      "domain": "measurement",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 62",
      "statement": "Assets shall be valued at acquisition or production cost (verkrijgings- of vervaardigingsprijs).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art63-vorderingen",
      "domain": "measurement",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 63 (verify)",
      "statement": "Loans and receivables shall be valued at nominal value, less a provision for impairment where necessary.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art64-afschrijving",
      "domain": "measurement",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 64",
      "statement": "Fixed assets with a limited useful life shall be depreciated systematically over their estimated useful life.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art65-waardevermindering",
      "domain": "measurement",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 65",
      "statement": "Participating interests, inventories, and fixed assets shall be written down for durable diminutions in value (duurzame waardeverminderingen).",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-art71-informatie-voor-derden",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV art. 71 (verify)",
      "statement": "Provinces and municipalities shall provide financial information to third parties (Informatie voor Derden / IV3) in the prescribed form, including data submitted to Statistics Netherlands (CBS).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2004-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    },
    {
      "id": "bbv-taakvelden-overview",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "bbv",
      "source": "BBV ministerial regeling taakvelden (verify)",
      "statement": "The budget and accounts shall include a mandatory overview of estimated revenues and expenses per task field (taakveld) to enable inter-municipal comparison.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2017-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0014606"
    }
  ]
}
