{
  "domain": "ledger-integrity",
  "version": "2026-06",
  "rules": [
    {
      "id": "eu-cash-limit-10000",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 80",
      "statement": "Persons trading in goods or providing services shall not accept or make a cash payment exceeding EUR 10,000 (or equivalent) for a single transaction or for linked transactions where at least one party acts in a professional capacity.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-cash-limit-member-state-lower",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 80(2)",
      "statement": "Member States may maintain or adopt national cash-payment limits below the EUR 10,000 ceiling, and obliged entities shall apply the stricter applicable national limit.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-cash-limit-private-exemption",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 80",
      "statement": "The EUR 10,000 cash-payment limit shall not apply to payments between natural persons who are not acting in a professional capacity. (verify)",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-cash-large-occasional-cdd",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 19",
      "statement": "Obliged entities shall apply customer due diligence to occasional transactions carried out in cash of EUR 3,000 or more, whether in a single operation or in linked operations. (verify)",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "fr-cash-limit-1000",
      "domain": "ledger-integrity",
      "jurisdiction": "FR",
      "framework": "fr-cmf",
      "source": "Code monétaire et financier art. L112-6 / D112-3",
      "statement": "A debtor fiscally domiciled in France or acting as a professional shall not settle a debt above EUR 1,000 in cash (EUR 15,000 for non-resident private individuals).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.legifrance.gouv.fr/codes/article_lc/LEGIARTI000033516152"
    },
    {
      "id": "it-cash-limit-5000",
      "domain": "ledger-integrity",
      "jurisdiction": "IT",
      "framework": "it-dlgs231",
      "source": "D.Lgs. 231/2007 art. 49",
      "statement": "Transfers of cash between different parties for an amount of EUR 5,000 or more are prohibited and must be routed through a regulated intermediary.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2023-01-01",
      "sourceUrl": "https://www.gazzettaufficiale.it/eli/id/2007/12/14/007G0246/sg"
    },
    {
      "id": "es-cash-limit-1000",
      "domain": "ledger-integrity",
      "jurisdiction": "ES",
      "framework": "es-ley11-2021",
      "source": "Ley 11/2021 art. 18 (mod. Ley 7/2012)",
      "statement": "Payments in cash of EUR 1,000 or more are prohibited where at least one party acts as a business or professional (EUR 10,000 for non-resident private individuals).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2021-07-11",
      "sourceUrl": "https://www.boe.es/eli/es/l/2021/07/09/11"
    },
    {
      "id": "nl-cash-no-general-limit",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "nl-wwft",
      "source": "Wwft art. 16 / art. 23a",
      "statement": "The Netherlands has no general statutory cash-payment ceiling, but traders in goods must report cash transactions of EUR 10,000 or more as unusual transactions to FIU-Nederland. (verify)",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0024282"
    },
    {
      "id": "de-cash-dealer-cdd-10000",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "de-gwg",
      "source": "GwG § 10 Abs. 6a",
      "statement": "Traders in goods must perform customer due diligence when accepting or paying out cash of EUR 10,000 or more, including in linked (fragmented) transactions.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/gwg_2017/__10.html"
    },
    {
      "id": "de-precious-metals-cash-2000",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "de-gwg",
      "source": "GwG § 10 Abs. 6a Nr. 1",
      "statement": "Dealers in precious metals must perform customer due diligence on cash transactions of EUR 2,000 or more.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/gwg_2017/__10.html"
    },
    {
      "id": "us-form8300-cash",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-irc",
      "source": "26 U.S.C. 6050I / IRS Form 8300",
      "statement": "A person engaged in a trade or business who receives more than USD 10,000 in cash in one transaction or in related transactions must file Form 8300.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.irs.gov/businesses/small-businesses-self-employed/form-8300-and-reporting-cash-payments-of-over-10000"
    },
    {
      "id": "us-form8300-15-day-filing",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-irc",
      "source": "IRS Form 8300 instructions / 26 U.S.C. 6050I",
      "statement": "Form 8300 must be filed by the 15th day after the date the reportable cash payment was received.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.irs.gov/instructions/i8300"
    },
    {
      "id": "us-form8300-related-transactions",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-irc",
      "source": "26 U.S.C. 6050I",
      "statement": "Multiple cash payments that aggregate to more than USD 10,000 within a 12-month period from the same payer must be treated as related and reported on Form 8300.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.irs.gov/businesses/small-businesses-self-employed/irs-form-8300-reference-guide"
    },
    {
      "id": "us-form8300-payer-statement",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-irc",
      "source": "26 U.S.C. 6050I(e) / IRS Form 8300",
      "statement": "A business that files Form 8300 must furnish a written statement to each person named on the form by 31 January of the year following the transaction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.irs.gov/businesses/small-businesses-self-employed/irs-form-8300-reference-guide"
    },
    {
      "id": "us-form8300-retention-5yr",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-irc",
      "source": "IRS Form 8300 instructions",
      "statement": "A copy of each filed Form 8300 must be retained for five years from the date of filing.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.irs.gov/instructions/i8300"
    },
    {
      "id": "us-ctr-10000",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.311",
      "statement": "A financial institution must file a Currency Transaction Report (CTR) for each transaction in currency of more than USD 10,000 by, through, or to the institution.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-C/section-1010.311"
    },
    {
      "id": "us-ctr-aggregate-same-day",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.313",
      "statement": "Multiple currency transactions by or on behalf of the same person totalling more than USD 10,000 in one business day must be aggregated and treated as a single reportable transaction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-C/section-1010.313"
    },
    {
      "id": "us-ctr-15-day-efile",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.306",
      "statement": "A CTR must be filed electronically through the FinCEN BSA E-Filing System within 15 calendar days of the reportable transaction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-C/section-1010.306"
    },
    {
      "id": "us-no-structuring",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 U.S.C. 5324",
      "statement": "Structuring transactions to evade the CTR or Form 8300 reporting thresholds is prohibited.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.govinfo.gov/app/details/USCODE-2022-title31/USCODE-2022-title31-subtitleIV-chap53-subchapII-sec5324"
    },
    {
      "id": "us-sar-suspicious",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1020.320",
      "statement": "A bank must file a Suspicious Activity Report (SAR) for transactions of USD 5,000 or more that it knows, suspects, or has reason to suspect involve illicit funds, evasion of the BSA, or no apparent lawful purpose.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1020/subpart-C/section-1020.320"
    },
    {
      "id": "us-sar-30-day-filing",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1020.320(b)(3)",
      "statement": "A SAR must be filed no later than 30 calendar days after the date of initial detection of facts that may constitute a basis for filing.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1020/subpart-C/section-1020.320"
    },
    {
      "id": "us-sar-confidentiality",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1020.320(e)",
      "statement": "The existence and content of a filed SAR must be kept confidential and not disclosed to the subject of the report.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1020/subpart-C/section-1020.320"
    },
    {
      "id": "us-bsa-recordkeeping-5yr",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.430(d)",
      "statement": "Records required to be kept under the Bank Secrecy Act must be retained for a period of five years.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-D/section-1010.430"
    },
    {
      "id": "us-cdd-rule",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.230",
      "statement": "Covered financial institutions must identify and verify the beneficial owners of legal entity customers when an account is opened (the CDD Rule).",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2018-05-11",
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-B/section-1010.230"
    },
    {
      "id": "us-cip-program",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1020.220",
      "statement": "A bank must maintain a written Customer Identification Program to verify the identity of each customer opening an account.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1020/subpart-B/section-1020.220"
    },
    {
      "id": "us-ofac-sanctions-screening",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-ofac",
      "source": "31 CFR 501 / 50 U.S.C. 1701 (IEEPA)",
      "statement": "Transactions must be screened against the OFAC Specially Designated Nationals (SDN) list, and blocked or rejected transactions involving sanctioned parties must be reported to OFAC.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://ofac.treasury.gov/sanctions-programs-and-country-information"
    },
    {
      "id": "us-cmir-10000",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.340",
      "statement": "Physical transport of currency or monetary instruments exceeding USD 10,000 into or out of the United States must be reported on a CMIR (FinCEN Form 105).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-C/section-1010.340"
    },
    {
      "id": "us-fbar-foreign-accounts",
      "domain": "reporting",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1010.350 / FinCEN Form 114",
      "statement": "A US person with a financial interest in or signature authority over foreign financial accounts exceeding USD 10,000 in aggregate at any time during the year must file an FBAR.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1010/subpart-C/section-1010.350"
    },
    {
      "id": "us-msb-registration",
      "domain": "ledger-integrity",
      "jurisdiction": "US",
      "framework": "us-bsa",
      "source": "31 CFR 1022.380",
      "statement": "A money services business must register with FinCEN and maintain a list of its agents.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.ecfr.gov/current/title-31/subtitle-B/chapter-X/part-1022/subpart-D/section-1022.380"
    },
    {
      "id": "eu-amlr-cdd",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 20",
      "statement": "Obliged entities shall apply customer due diligence comprising identification and verification of the customer and beneficial owner, assessment of the business relationship, and ongoing monitoring.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-cdd-occasional-15000",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 19",
      "statement": "Customer due diligence shall be applied to occasional transactions amounting to EUR 15,000 or more, whether carried out in a single operation or in linked operations. (verify)",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-edd-high-risk",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 34",
      "statement": "Enhanced due diligence shall be applied to business relationships and transactions presenting a higher money-laundering or terrorist-financing risk, including those involving high-risk third countries.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-pep-edd",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 42",
      "statement": "Obliged entities shall apply enhanced due diligence measures to politically exposed persons, their family members, and known close associates, including senior-management approval and source-of-funds checks.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-ubo-identification",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 51",
      "statement": "Obliged entities shall identify the beneficial owner(s) of a legal entity and take reasonable measures to verify their identity before establishing a business relationship.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-ubo-25-percent",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 53",
      "statement": "A beneficial owner of a corporate entity is any natural person holding, directly or indirectly, 25% or more of the ownership interest or voting rights, or otherwise exercising control.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-transaction-monitoring",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 20(1)(d)",
      "statement": "Obliged entities shall conduct ongoing monitoring of the business relationship, including scrutiny of transactions to ensure consistency with the customer's risk profile and known activity.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-str-reporting",
      "domain": "reporting",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 69",
      "statement": "Obliged entities shall report suspicions of money laundering or terrorist financing to the national Financial Intelligence Unit (FIU) without delay.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-record-keeping-5yr",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 77",
      "statement": "Obliged entities shall retain customer due diligence records and transaction records for five years after the end of the business relationship or the date of an occasional transaction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-risk-assessment",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 10",
      "statement": "Obliged entities shall carry out and document a business-wide risk assessment to identify and assess their money-laundering and terrorist-financing risks.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-internal-policies",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 9",
      "statement": "Obliged entities shall put in place internal policies, controls, and procedures proportionate to their nature and size to mitigate identified money-laundering risks.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amlr-targeted-sanctions-screening",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amlr",
      "source": "Reg (EU) 2024/1624 art. 20(1)(c)",
      "statement": "Obliged entities shall verify whether the customer or beneficial owner is subject to targeted financial sanctions before establishing a business relationship or carrying out a transaction.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/reg/2024/1624/oj"
    },
    {
      "id": "eu-amld6-ubo-register",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amld6",
      "source": "Dir (EU) 2024/1640 art. 10",
      "statement": "Member States shall ensure that beneficial-ownership information of corporate and legal entities is held in a central register accessible to competent authorities, FIUs, and obliged entities.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/dir/2024/1640/oj"
    },
    {
      "id": "eu-amld6-ubo-register-consult",
      "domain": "ledger-integrity",
      "jurisdiction": "EU",
      "framework": "eu-amld6",
      "source": "Dir (EU) 2024/1640 art. 12",
      "statement": "Obliged entities shall consult the central beneficial-ownership register as part of customer due diligence but shall not rely on it as the sole source of verification.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": "2027-07-10",
      "sourceUrl": "https://eur-lex.europa.eu/eli/dir/2024/1640/oj"
    },
    {
      "id": "eu-amld6-ubo-discrepancy",
      "domain": "reporting",
      "jurisdiction": "EU",
      "framework": "eu-amld6",
      "source": "Dir (EU) 2024/1640 art. 24",
      "statement": "Obliged entities shall report discrepancies between the beneficial-ownership information they hold and that recorded in the central register.",
