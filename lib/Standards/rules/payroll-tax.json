{
  "domain": "tax",
  "version": "2026-06",
  "rules": [
    {
      "id": "nl-loonheffingen-inhouding",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 27",
      "statement": "An employer (inhoudingsplichtige) shall withhold loonheffingen (loonbelasting plus premie volksverzekeringen) from wages at each payment and remit the amount to the Belastingdienst.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-loonheffingen-volksverzekeringen",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wfsv / Wet LB 1964 art. 27b",
      "statement": "Premie volksverzekeringen (AOW, Anw, Wlz) shall be levied together with loonbelasting in one combined loonheffing on wages up to the first-bracket ceiling.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0019057"
    },
    {
      "id": "nl-werknemersverzekeringen-werkgever",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wfsv (WW, WIA/WAO, ZW premies)",
      "statement": "The employer shall pay premies werknemersverzekeringen (WW incl. Awf, WIA/Whk, ZW) over the wages of insured employees; these are employer-borne and not deducted from net pay.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0019057"
    },
    {
      "id": "nl-awf-laag-hoog-tarief",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wfsv (Wab) Awf low/high tariff",
      "statement": "The Algemeen werkloosheidsfonds (Awf) premium shall apply the low tariff for permanent written contracts and the high tariff (5 percentage points higher) for flexible/temporary contracts.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2020-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0019057"
    },
    {
      "id": "nl-zvw-werkgeversheffing",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Zvw art. 42-46 (werkgeversheffing)",
      "statement": "The employer shall pay the income-dependent Zvw contribution (werkgeversheffing) over the contribution wage up to the annual maximum bijdrageloon; for 2026 the werkgeversheffing rate is 6,10%.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/prive/werk_en_inkomen/zorgverzekeringswet/veranderingen-bijdrage-zvw/percentages-zvw"
    },
    {
      "id": "nl-zvw-inhouding",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Zvw (ingehouden bijdrage)",
      "statement": "Where the lower withheld Zvw rate applies (e.g. pensioners, directors-major-shareholders), the employer shall withhold the income-dependent Zvw contribution from the employee; for 2026 the withheld rate is 4,85%.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/bldcontentnl/belastingdienst/prive/werk_en_inkomen/zorgverzekeringswet/veranderingen-bijdrage-zvw/percentages-zvw"
    },
    {
      "id": "nl-loonaangifte-tijdvak",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 28 / AWR art. 19",
      "statement": "The employer shall file a loonaangifte and pay the loonheffingen for each wage period (typically monthly or four-weekly) electronically to the Belastingdienst.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-loonaangifte-termijn",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "AWR art. 19 (aangifte- en betaaltermijn)",
      "statement": "The loonaangifte must be filed and the loonheffingen paid no later than the last working day of the month following the wage period (e.g. the January 2026 period is due by the last working day of February 2026).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002320"
    },
    {
      "id": "nl-loonadministratie-voeren",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 28 / Uitv.reg. LB",
      "statement": "The employer shall keep a loonadministratie containing per employee a loonstaat, identification data, the loonheffingenverklaring, and supporting wage records.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-loonadministratie-bewaarplicht",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "AWR art. 52 lid 4 (bewaarplicht)",
      "statement": "Payroll administration records shall be retained for at least 7 years after the end of the relevant financial year.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002320"
    },
    {
      "id": "nl-id-bewaarplicht-5jaar",
      "domain": "ledger-integrity",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Handboek Loonheffingen (identiteitsbewijs)",
      "statement": "A copy of the employee's identity document shall be kept in the loonadministratie until at least 5 years after the end of the year in which employment ended.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/nl/personeel-en-loon/personeel-en-loon"
    },
    {
      "id": "nl-anoniementarief",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 26b",
      "statement": "Where the employee's identity, BSN, or required data is missing, the employer shall apply the anoniementarief of 52% to the wages.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-wkr-vrije-ruimte",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 31a lid 3 (werkkostenregeling)",
      "statement": "Under the werkkostenregeling the tax-free vrije ruimte for 2026 is 2,00% of the fiscal wage bill up to EUR 400.000 plus 1,18% of the excess. (verify percentage)",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-wkr-eindheffing-80",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 31a (eindheffing WKR)",
      "statement": "Where designated allowances exceed the vrije ruimte, the employer shall pay an eindheffing of 80% over the excess.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-wkr-gerichte-vrijstelling",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 31a lid 2 (gerichte vrijstellingen)",
      "statement": "Specific gerichte vrijstellingen (e.g. travel allowance, study costs, home-working allowance) shall not be charged against the vrije ruimte where statutory conditions and normbedragen are met.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-30-percent-regeling",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 31a (30%-regeling)",
      "statement": "For incoming employees with a granted 30%-beschikking the employer may pay up to 30% of wages tax-free for 2025-2026; the maximum percentage is reduced to 27% from 2027.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2027-01-01",
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/nl/personeel-en-loon/personeel-en-loon"
    },
    {
      "id": "nl-30-regeling-aftoppingsgrens",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 31a (aftopping WNT-norm)",
      "statement": "The 30%-regeling tax-free allowance is capped on wages up to the WNT-norm (Balkenende-norm), with the excess no longer eligible. (verify cap amount)",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": "2024-01-01",
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/nl/personeel-en-loon/personeel-en-loon"
    },
    {
      "id": "nl-minimumloon-2026",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "WML art. 8 / Besluit minimumloon",
      "statement": "From 1 January 2026 the statutory minimum wage shall be at least EUR 14,71 gross per hour for employees aged 21 and over (rising to EUR 14,99 from 1 July 2026).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.rijksoverheid.nl/themas/werk/minimumloon/bedragen-minimumloon/bedragen-minimumloon-2026"
    },
    {
      "id": "nl-minimumuurloon-wet",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet invoering minimumuurloon (WML)",
      "statement": "A single statutory minimum hourly wage shall apply regardless of the normal working week, so weekly/monthly minimums are derived from the hourly rate times hours worked.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2024-01-01",
      "sourceUrl": "https://www.rijksoverheid.nl/themas/werk/minimumloon"
    },
    {
      "id": "nl-vakantiebijslag-8procent",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "WML art. 15 (vakantiebijslag)",
      "statement": "The employer shall pay vakantiebijslag of at least 8% of the gross annual wage, normally paid out in May/June unless otherwise agreed.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002638"
    },
    {
      "id": "nl-loonstrook-verstrekken",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "BW 7:626",
      "statement": "The employer shall provide the employee a written or electronic payslip (loonstrook) at first payment and whenever the wage or deductions change.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0005290"
    },
    {
      "id": "nl-loonstrook-inhoud",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "BW 7:626 lid 1",
      "statement": "The payslip shall state the gross wage, the composition of the wage, the amount and basis of each deduction, the statutory minimum wage applicable, and employer/employee identification.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0005290"
    },
    {
      "id": "nl-jaaropgaaf",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Handboek Loonheffingen (jaaropgaaf)",
      "statement": "The employer shall provide each employee an annual statement (jaaropgaaf) of total wages, withheld loonheffing, and the applied arbeidskorting/loonheffingskorting.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.belastingdienst.nl/wps/wcm/connect/nl/personeel-en-loon/personeel-en-loon"
    },
    {
      "id": "nl-pensioen-bewaarloon",
      "domain": "tax",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 11 lid 1 (omkeerregel pensioen)",
      "statement": "Employee pension contributions to a qualifying scheme are deductible from taxable wage under the omkeerregel, and the pension benefit is taxed on payout.",
      "severity": "conditional",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "nl-werkgever-aanmelding",
      "domain": "reporting",
      "jurisdiction": "NL",
      "framework": "nl-loonheffingen",
      "source": "Wet LB 1964 art. 28 (aanmelding inhoudingsplichtige)",
      "statement": "A new employer shall register as inhoudingsplichtige with the Belastingdienst before the first wage payment and obtain a loonheffingennummer.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://wetten.overheid.nl/BWBR0002471"
    },
    {
      "id": "de-lohnsteuer-einbehalt",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §38",
      "statement": "The employer shall withhold Lohnsteuer from the employee's wages at each payment as a prepayment on the employee's income tax (Einkommensteuer).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__38.html"
    },
    {
      "id": "de-elstam-abruf",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §39e (ELStAM)",
      "statement": "The employer shall retrieve the employee's elektronische Lohnsteuerabzugsmerkmale (ELStAM) and apply the correct Steuerklasse and allowances to the Lohnsteuer calculation.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__39e.html"
    },
    {
      "id": "de-lohnsteuer-anmeldung",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §41a Abs. 1",
      "statement": "The employer shall electronically file a Lohnsteuer-Anmeldung and pay the withheld Lohnsteuer to the Finanzamt by the 10th day after the end of the Anmeldungszeitraum.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__41a.html"
    },
    {
      "id": "de-lohnsteuer-anmeldungszeitraum",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §41a Abs. 2",
      "statement": "The Anmeldungszeitraum is monthly if prior-year Lohnsteuer exceeded EUR 5.000, quarterly if between EUR 1.080 and EUR 5.000, and annual if EUR 1.080 or less.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__41a.html"
    },
    {
      "id": "de-lohnkonto-fuehren",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §41 / LStDV §4",
      "statement": "The employer shall maintain a Lohnkonto per employee at the Betriebsstätte recording the wage type, amounts, and Lohnsteuer-relevant data for each payment.",
      "severity": "mandatory",
      "machineCheckable": false,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__41.html"
    },
    {
      "id": "de-lohnkonto-aufbewahrung",
      "domain": "ledger-integrity",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "LStDV §4 Abs. 2 Nr. 8 / AO §147",
      "statement": "The Lohnkonto and supporting wage-tax records shall be retained until the end of the sixth calendar year following the last entry.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/lstdv/__4.html"
    },
    {
      "id": "de-lohnsteuerbescheinigung",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "EStG §41b",
      "statement": "After the end of the calendar year (or on termination) the employer shall transmit an elektronische Lohnsteuerbescheinigung for each employee to the tax authority.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__41b.html"
    },
    {
      "id": "de-solidaritaetszuschlag",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "SolzG 1995 §3-4",
      "statement": "The employer shall withhold Solidaritätszuschlag of 5,5% of the Lohnsteuer where the employee exceeds the Freigrenze.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/solzg_1995/__4.html"
    },
    {
      "id": "de-kirchensteuer",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-lohnsteuer",
      "source": "KiStG (Länder) / EStG §51a",
      "statement": "Where the employee is a member of a tax-collecting religious community, the employer shall withhold Kirchensteuer of 8% or 9% of the Lohnsteuer depending on the Bundesland.",
      "severity": "conditional",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/estg/__51a.html"
    },
    {
      "id": "de-sozialversicherung-meldepflicht",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB IV §28a (DEÜV-Meldung)",
      "statement": "The employer shall transmit DEÜV-Meldungen (registration, deregistration, annual and interruption notices) for each employee to the Einzugsstelle via the electronic reporting procedure.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_4/__28a.html"
    },
    {
      "id": "de-sv-gesamtbeitrag-abfuehren",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB IV §28e",
      "statement": "The employer shall pay the full Gesamtsozialversicherungsbeitrag (employer plus employee shares) to the Einzugsstelle (Krankenkasse).",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_4/__28e.html"
    },
    {
      "id": "de-sv-faelligkeit",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB IV §23 Abs. 1",
      "statement": "Social-security contributions fall due on the third-to-last bank working day of the month in which the employment giving rise to them is performed.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_4/__23.html"
    },
    {
      "id": "de-beitragsnachweis",
      "domain": "reporting",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB IV §28f Abs. 3 (Beitragsnachweis)",
      "statement": "The employer shall transmit a Beitragsnachweis to the Einzugsstelle by electronic means no later than two working days before contributions fall due.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": null,
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_4/__28f.html"
    },
    {
      "id": "de-rv-beitragssatz-2026",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB VI §158 (Rentenversicherung)",
      "statement": "The statutory pension-insurance contribution rate for 2026 is 18,6%, shared equally as 9,3% employer and 9,3% employee, up to the Beitragsbemessungsgrenze.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_6/__158.html"
    },
    {
      "id": "de-kv-beitragssatz-2026",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB V §241 (Krankenversicherung)",
      "statement": "The general health-insurance contribution rate is 14,6% (7,3% each), plus a fund-specific Zusatzbeitrag (average 2,9% for 2026) split between employer and employee.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_5/__241.html"
    },
    {
      "id": "de-av-beitragssatz-2026",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB III §341 (Arbeitslosenversicherung)",
      "statement": "The unemployment-insurance contribution rate for 2026 is 2,6%, shared as 1,3% employer and 1,3% employee, up to the Beitragsbemessungsgrenze.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_3/__341.html"
    },
    {
      "id": "de-pv-beitragssatz-2026",
      "domain": "tax",
      "jurisdiction": "DE",
      "framework": "de-sozialversicherung",
      "source": "SGB XI §55 (Pflegeversicherung)",
      "statement": "The long-term-care-insurance base rate for 2026 is 3,6%, with a childless surcharge (Beitragszuschlag) for employees aged 23+ and reductions per number of children.",
      "severity": "mandatory",
      "machineCheckable": true,
      "effectiveDate": "2026-01-01",
      "sourceUrl": "https://www.gesetze-im-internet.de/sgb_11/__55.html"
