			"title": "IV3-rapportages",
			"config": {
				"register": "shillinq",
				"schema": "Iv3Export",
				"visibility": {
					"field": "administrationType",
					"in": ["gemeente", "provincie", "waterschap"]
				},
				"columns": [
					{
						"key": "reportingYear",
						"label": "Jaar",
						"sortable": true
					},
					{
						"key": "reportingQuarter",
						"label": "Kwartaal",
						"sortable": true
					},
					{
						"key": "administrationId",
						"label": "Administratie",
						"sortable": true
					},
					{
						"key": "state",
						"label": "Status",
						"sortable": true
					},
					{
						"key": "submittedAt",
						"label": "Ingediend op",
						"sortable": true
					}
				],
				"defaultSort": "-reportingYear",
				"detailRoute": "Iv3RapportagesDetail"
			}
