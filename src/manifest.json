		{
			"id": "TrialBalance",
			"route": "/trial-balance",
			"type": "index",
			"title": "Trial Balance",
			"config": {
				"register": "shillinq",
				"schema": "GLLine",
				"aggregation": "trial-balance",
				"queryParams": {
					"periodId": "@activePeriod"
				},
				"columns": [
					{ "key": "accountNumber", "label": "Account", "sortable": true },
					{ "key": "openingDebit", "label": "Opening Debit" },
					{ "key": "openingCredit", "label": "Opening Credit" },
					{ "key": "movementDebit", "label": "Movement Debit" },
					{ "key": "movementCredit", "label": "Movement Credit" },
					{ "key": "closingDebit", "label": "Closing Debit" },
					{ "key": "closingCredit", "label": "Closing Credit" }
				],
				"drillThrough": {
					"route": "GeneralLedger",
					"params": { "periodId": "periodId", "accountNumber": "accountNumber" }
				}
			}
		},
		{
			"id": "PeriodClose",
