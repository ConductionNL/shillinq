{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Bookkeeping",
			"label": "Bookkeeping",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{
					"id": "ChartOfAccounts",
					"label": "Chart of Accounts",
					"icon": "LedgerOutline",
					"route": "ChartOfAccounts",
					"order": 10
				}
			]
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://conduction.nl",
			"section": "settings",
			"order": 90
		},
		{
			"id": "Settings",
			"label": "Settings",
			"icon": "icon-settings",
			"route": "Settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "ChartOfAccounts",
			"route": "/chart-of-accounts",
			"type": "index",
			"title": "Chart of Accounts",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"columns": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"sortable": true
					},
					{
						"key": "name",
						"label": "Name",
						"sortable": true
					},
					{
						"key": "accountType",
						"label": "Type",
						"sortable": true
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"sortable": true
					}
				],
				"defaultSort": "accountNumber",
				"detailRoute": "ChartOfAccountsDetail"
			}
		},
		{
			"id": "ChartOfAccountsDetail",
			"route": "/chart-of-accounts/:id",
			"type": "detail",
			"title": "Account",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"fields": [
					{
						"key": "accountNumber",
						"label": "Account Number"
					},
					{
						"key": "name",
						"label": "Name"
					},
					{
						"key": "accountType",
						"label": "Account Type"
					},
					{
						"key": "currency",
						"label": "Currency"
					},
					{
						"key": "parentAccountNumber",
						"label": "Parent Account"
					},
					{
						"key": "administrationId",
						"label": "Administration"
					},
					{
						"key": "lifecycleState",
						"label": "Status"
					},
					{
						"key": "isClosingAccount",
						"label": "Closing Account"
					},
					{
						"key": "vatApplicable",
						"label": "VAT Applicable"
					},
					{
						"key": "description",
						"label": "Description"
					}
				],
				"lifecycleActions": true,
				"indexRoute": "ChartOfAccounts"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {},
			"widgets": [
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"title": "Open items",
						"iconClass": "icon-folder",
						"props": {
							"count": 12,
							"countLabel": "sample",
							"variant": "primary"
						},
						"showTitle": true
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 3,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"title": "Due this week",
						"iconClass": "icon-calendar",
						"props": {
							"count": 5,
							"countLabel": "sample",
							"variant": "warning"
						},
						"showTitle": true
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 6,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"title": "Completed",
						"iconClass": "icon-checkmark",
						"props": {
							"count": 48,
							"countLabel": "sample",
							"variant": "success"
						},
						"showTitle": true
					}
				},
				{
					"widgetKey": "stats-block",
					"slot": "body",
					"gridX": 9,
					"gridY": 0,
					"gridWidth": 3,
					"gridHeight": 2,
					"props": {
						"title": "Team members",
						"iconClass": "icon-group",
						"props": {
							"count": 7,
							"countLabel": "sample",
							"variant": "default"
						},
						"showTitle": true
					}
				}
			]
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/shillinq/api/settings",
				"sections": [
					{
						"id": "configuration",
						"title": "Configuration",
						"fields": [
							{
								"key": "register",
								"label": "Register",
								"type": "string",
								"help": "OpenRegister register ID"
							}
						]
					}
				]
			},
			"widgets": [
				{
					"widgetKey": "version-info",
					"slot": "section:version",
					"gridX": 0,
					"gridY": 0,
					"gridWidth": 12,
					"gridHeight": 1
				}
			]
		}
	]
}
