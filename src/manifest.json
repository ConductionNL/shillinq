				"statementManifest": "statement_manifest_balance_sheet",
				"periodParam": "periodId",
				"comparativePeriods": 1,
				"previewBanner": "Voorlopige cijfers (niet definitief)",
				"actions": [
					{ "id": "export-xbrl", "label": "Export XBRL", "icon": "Download", "handler": "exportXbrl" },
					{ "id": "export-pdf", "label": "Export PDF", "icon": "FilePdfBox", "handler": "exportPdf" }
