		{
			"id": "TaxFilingPrep",
			"route": "/tax-filing-prep",
			"type": "report",
			"title": "Tax Filing Prep",
			"config": {
				"register": "shillinq",
				"schema": "TaxSummaryReport",
				"dashboard": {
					"kpis": [
						{
							"id": "estimated-liability",
							"label": "Estimated Annual Liability",
							"icon": "CalculatorOutline",
							"aggregation": "currentEstimateByYear",
							"field": "latestLiability",
							"format": "currency",
							"currency": "EUR"
						},
						{
							"id": "filing-deadline",
							"label": "Filing Deadline",
							"icon": "CalendarClockOutline",
							"source": "TaxRegimeConfiguration",
							"field": "filingDeadline",
							"format": "days-until"
						},
						{
							"id": "summaries-ready",
							"label": "Tax Summaries Ready",
							"icon": "FileCheckOutline",
							"aggregation": "finalizedSummaryCount",
							"field": "count",
							"format": "integer"
						},
						{
							"id": "gl-transaction-count",
							"label": "GL Transactions Included",
							"icon": "DatabaseOutline",
							"source": "TaxEstimate",
							"field": "glTransactionCount",
							"filter": {
								"status": "current"
							},
							"format": "integer"
						}
					],
					"table": {
						"schema": "TaxSummaryReport",
						"filter": {
							"fiscalYear": "@currentFiscalYear"
						},
						"columns": [
							{
								"key": "taxCategory",
								"label": "Tax Category",
								"sortable": true
							},
							{
								"key": "grossAmount",
								"label": "Gross Amount (EUR)",
								"sortable": true
							},
							{
								"key": "deductionsAmount",
								"label": "Deductions (EUR)",
								"sortable": true
							},
							{
								"key": "netAmount",
								"label": "Net Amount (EUR)",
								"sortable": true
							},
							{
								"key": "status",
								"label": "Status",
								"sortable": true
							},
							{
								"key": "snapshotDate",
								"label": "Snapshot Date",
								"sortable": true
							}
						],
						"defaultSort": "taxCategory"
					}
				}
			}
		},
