{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Bookkeeping",
			"label": "Bookkeeping",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{
					"id": "ChartOfAccounts",
					"label": "Chart of Accounts",
					"icon": "LedgerOutline",
					"route": "ChartOfAccounts",
					"order": 10
				}
			]
		},
		{
			"id": "Projecten",
			"label": "Projecten",
			"icon": "FolderOpenOutline",
			"order": 30,
			"visibilityPredicate": {
				"administrationType": ["mkb", "zzp"],
				"role": "project-administrator"
			},
			"children": [
				{
					"id": "ProjectenOverzicht",
					"label": "Overzicht",
					"icon": "TableLarge",
					"route": "ProjectenOverzicht",
					"order": 10
				},
				{
					"id": "Tarieven",
					"label": "Tarieven",
					"icon": "CurrencyEur",
					"route": "Tarieven",
					"order": 20
				},
				{
					"id": "Utilisatie",
					"label": "Utilisatie",
					"icon": "ChartLineVariant",
					"route": "Utilisatie",
					"order": 30
				}
			]
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 91
		},
		{
			"id": "Settings",
			"label": "Settings",
			"icon": "icon-settings",
			"route": "Settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://shillinq.conduction.nl"
			}
		},
		{
			"id": "ProjectenOverzicht",
			"route": "/projecten",
			"type": "index",
			"title": "Projecten — Overzicht",
			"visibilityPredicate": {
				"administrationType": ["mkb", "zzp"],
				"role": "project-administrator"
			},
			"config": {
				"register": "shillinq",
				"schema": "Project",
				"columns": [
					{
						"key": "projectNumber",
						"label": "Projectnummer",
						"sortable": true
					},
					{
						"key": "name",
						"label": "Naam",
						"sortable": true
					},
					{
						"key": "state",
						"label": "Status",
						"sortable": true
					},
					{
						"key": "recognitionStage",
						"label": "Fase",
						"sortable": true
					},
					{
						"key": "recognisedRevenue",
						"label": "Erkende omzet",
						"sortable": true
					},
					{
						"key": "wipBalance",
						"label": "WIP-saldo",
						"sortable": true
					}
				],
				"defaultSort": "projectNumber",
				"detailRoute": "ProjectDetail"
			}
		},
		{
			"id": "ProjectDetail",
			"route": "/projecten/:id",
			"type": "detail",
			"title": "Project",
			"visibilityPredicate": {
				"administrationType": ["mkb", "zzp"],
				"role": "project-administrator"
			},
			"config": {
				"register": "shillinq",
				"schema": "Project",
				"fields": [
					{
						"key": "projectNumber",
						"label": "Projectnummer",
						"type": "string"
					},
					{
						"key": "name",
						"label": "Naam",
						"type": "string"
					},
					{
						"key": "customerId",
						"label": "Klant",
						"type": "string"
					},
					{
						"key": "state",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "recognitionMethod",
						"label": "Verantwoordingsmethode",
						"type": "string"
					},
					{
						"key": "recognitionStage",
						"label": "Fase (RJ 270)",
						"type": "string"
					},
					{
						"key": "totalContractValue",
						"label": "Contractwaarde",
						"type": "number"
					},
					{
						"key": "totalEstimatedCosts",
						"label": "Geschatte kosten",
						"type": "number"
					},
					{
						"key": "costsIncurredToDate",
						"label": "Gemaakte kosten",
						"type": "number"
					},
					{
						"key": "recognisedRevenue",
						"label": "Erkende omzet",
						"type": "number"
					},
					{
						"key": "billedRevenue",
						"label": "Gefactureerde omzet",
						"type": "number"
					},
					{
						"key": "wipBalance",
						"label": "WIP-saldo",
						"type": "number"
					},
					{
						"key": "currency",
						"label": "Valuta",
						"type": "string"
					},
					{
						"key": "startDate",
						"label": "Startdatum",
						"type": "date"
					},
					{
						"key": "endDate",
						"label": "Einddatum",
						"type": "date"
					}
				],
				"lifecycleActions": true,
				"indexRoute": "ProjectenOverzicht",
				"relatedLists": [
					{
						"id": "assignments",
						"title": "Projectopdrachten",
						"schema": "ProjectAssignment",
						"foreignKey": "projectId"
					},
					{
						"id": "wip-history",
						"title": "WIP-historie",
						"schema": "WipBalance",
						"foreignKey": "projectId"
					}
				]
			}
		},
		{
			"id": "Tarieven",
			"route": "/tarieven",
			"type": "index",
			"title": "Tarieven",
			"visibilityPredicate": {
				"administrationType": ["mkb", "zzp"],
				"role": "project-administrator"
			},
			"config": {
				"register": "shillinq",
				"schema": "RateCard",
				"columns": [
					{
						"key": "level",
						"label": "Niveau",
						"sortable": true
					},
					{
						"key": "hourlyRate",
						"label": "Uurtarief",
						"sortable": true
					},
					{
						"key": "currency",
						"label": "Valuta",
						"sortable": false
					},
					{
						"key": "effectiveFrom",
						"label": "Geldig vanaf",
						"sortable": true
					},
					{
						"key": "effectiveTo",
						"label": "Geldig tot",
						"sortable": true
					}
				],
				"defaultSort": "level"
			}
		},
		{
			"id": "Utilisatie",
			"route": "/utilisatie",
			"type": "dashboard",
			"title": "Utilisatie",
			"visibilityPredicate": {
				"administrationType": ["mkb", "zzp"],
				"role": "project-administrator"
			},
			"config": {
				"widgets": [
					{
						"id": "utilisatie-widget",
						"title": "Utilisatie per persoon",
						"type": "utilisatie-chart",
						"iconClass": "ChartLineVariant",
						"schema": "ProjectAssignment",
						"calculation": "utilization",
						"bands": [
							{ "min": 0.8, "color": "success", "label": "Hoog (>80%)" },
							{ "min": 0.5, "color": "warning", "label": "Gemiddeld (50–80%)" },
							{ "min": 0, "color": "error", "label": "Laag (<50%)" }
						]
					}
				],
				"layout": [
					{
						"id": "layout-utilisatie",
						"widgetId": "utilisatie-widget",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 6
					}
				]
			}
		},
		{
			"id": "ChartOfAccounts",
			"route": "/chart-of-accounts",
			"type": "index",
			"title": "Chart of Accounts",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"columns": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"sortable": true
					},
					{
						"key": "name",
						"label": "Name",
						"sortable": true
					},
					{
						"key": "accountType",
						"label": "Type",
						"sortable": true
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"sortable": true
					}
				],
				"defaultSort": "accountNumber",
				"detailRoute": "ChartOfAccountsDetail"
			}
		},
		{
			"id": "ChartOfAccountsDetail",
			"route": "/chart-of-accounts/:id",
			"type": "detail",
			"title": "Account",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"fields": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"type": "string"
					},
					{
						"key": "name",
						"label": "Name",
						"type": "string"
					},
					{
						"key": "accountType",
						"label": "Account Type",
						"type": "string"
					},
					{
						"key": "currency",
						"label": "Currency",
						"type": "string"
					},
					{
						"key": "parentAccountNumber",
						"label": "Parent Account",
						"type": "string"
					},
					{
						"key": "administrationId",
						"label": "Administration",
						"type": "string"
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "isClosingAccount",
						"label": "Closing Account",
						"type": "boolean"
					},
					{
						"key": "vatApplicable",
						"label": "VAT Applicable",
						"type": "boolean"
					},
					{
						"key": "description",
						"label": "Description",
						"type": "string"
					}
				],
				"lifecycleActions": true,
				"indexRoute": "ChartOfAccounts"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "open-items",
						"title": "Open items",
						"type": "stats-block",
						"iconClass": "icon-folder",
						"props": {
							"count": 12,
							"countLabel": "sample",
							"variant": "primary"
						}
					},
					{
						"id": "due-this-week",
						"title": "Due this week",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": {
							"count": 5,
							"countLabel": "sample",
							"variant": "warning"
						}
					},
					{
						"id": "completed",
						"title": "Completed",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"props": {
							"count": 48,
							"countLabel": "sample",
							"variant": "success"
						}
					},
					{
						"id": "team-members",
						"title": "Team members",
						"type": "stats-block",
						"iconClass": "icon-group",
						"props": {
							"count": 7,
							"countLabel": "sample",
							"variant": "default"
						}
					}
				],
				"layout": [
					{
						"id": "layout-open-items",
						"widgetId": "open-items",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-due-this-week",
						"widgetId": "due-this-week",
						"gridX": 3,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-completed",
						"widgetId": "completed",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-team-members",
						"widgetId": "team-members",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					}
				]
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/shillinq/api/settings",
				"sections": [
					{
						"id": "configuration",
						"title": "Configuration",
						"fields": [
							{
								"key": "register",
								"label": "Register",
								"type": "string",
								"help": "OpenRegister register ID"
							}
						]
					},
					{
						"id": "version",
						"title": "Version",
						"widgets": [
							{
								"type": "version-info"
							}
						]
					}
				]
			}
		}
	]
}
