				"register": "shillinq",
				"schema": "BankConnection",
				"fields": [
					{
						"key": "connectionNumber",
						"label": "Connection Number",
						"type": "string"
					},
					{
						"key": "aggregator",
						"label": "Aggregator",
						"type": "string"
