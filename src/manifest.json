						"key": "state",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "buckets",
						"label": "IV3 Buckets",
						"type": "object"
					},
					{
						"key": "xmlAttachmentUri",
						"label": "XML Bijlage",
