{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Bookkeeping",
			"label": "Bookkeeping",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{
					"id": "ChartOfAccounts",
					"label": "Chart of Accounts",
					"icon": "LedgerOutline",
					"route": "ChartOfAccounts",
					"order": 10
				},
				{
					"id": "BankConnections",
					"label": "Bank Connections",
					"icon": "BankOutline",
					"route": "BankConnections",
					"order": 20
				}
			]
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 91
		},
		{
			"id": "Settings",
			"label": "Settings",
			"icon": "icon-settings",
			"route": "Settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://shillinq.conduction.nl"
			}
		},
		{
			"id": "BankConnections",
			"route": "/bank-connections",
			"type": "index",
			"title": "Bank Connections",
			"config": {
				"register": "shillinq",
				"schema": "BankConnection",
				"columns": [
					{
						"key": "connectionNumber",
						"label": "Connection",
						"sortable": true
					},
					{
						"key": "aggregator",
						"label": "Aggregator",
						"sortable": true
					},
					{
						"key": "bankAccountIban",
						"label": "IBAN",
						"sortable": true
					},
					{
						"key": "consentExpiresAt",
						"label": "Consent Expires",
						"sortable": true
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"sortable": true
					}
				],
				"defaultSort": "connectionNumber",
				"detailRoute": "BankConnectionDetail"
			}
		},
		{
			"id": "BankConnectionDetail",
			"route": "/bank-connections/:id",
			"type": "detail",
			"title": "Bank Connection",
			"config": {
				"register": "shillinq",
				"schema": "BankConnection",
				"fields": [
					{
						"key": "connectionNumber",
						"label": "Connection Number",
						"type": "string"
					},
					{
						"key": "aggregator",
						"label": "Aggregator",
						"type": "string"
					},
					{
						"key": "aggregatorSourceSlug",
						"label": "Aggregator Source",
						"type": "string"
					},
					{
						"key": "bankBic",
						"label": "BIC",
						"type": "string"
					},
					{
						"key": "bankCountry",
						"label": "Country",
						"type": "string"
					},
					{
						"key": "bankAccountIban",
						"label": "IBAN",
						"type": "string"
					},
					{
						"key": "consentReference",
						"label": "Consent Reference",
						"type": "string"
					},
					{
						"key": "consentGrantedAt",
						"label": "Consent Granted",
						"type": "string"
					},
					{
						"key": "consentExpiresAt",
						"label": "Consent Expires",
						"type": "string"
					},
					{
						"key": "consentRemainingDays",
						"label": "Days Until Expiry",
						"type": "calculated",
						"help": "Remaining days on the PSD2 consent. Negative when expired."
					},
					{
						"key": "lastSyncAt",
						"label": "Last Synced",
						"type": "string"
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "administrationId",
						"label": "Administration",
						"type": "string"
					}
				],
				"lifecycleActions": true,
				"actions": [
					{
						"id": "renew-consent",
						"label": "Renew consent",
						"icon": "Refresh",
						"visibleWhen": {
							"field": "lifecycleState",
							"in": ["expiring", "expired"]
						},
						"type": "lifecycle-transition",
						"transition": "renew",
						"description": "Trigger PSD2 SCA renewal via the openconnector source reauthorise action."
					}
				],
				"header": {
					"countdownField": "consentRemainingDays",
					"countdownLabel": "days until consent expires",
					"countdownVisibleWhen": {
						"field": "lifecycleState",
						"in": ["expiring"]
					}
				},
				"indexRoute": "BankConnections"
			}
		},
		{
			"id": "ChartOfAccounts",
			"route": "/chart-of-accounts",
			"type": "index",
			"title": "Chart of Accounts",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"columns": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"sortable": true
					},
					{
						"key": "name",
						"label": "Name",
						"sortable": true
					},
					{
						"key": "accountType",
						"label": "Type",
						"sortable": true
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"sortable": true
					}
				],
				"defaultSort": "accountNumber",
				"detailRoute": "ChartOfAccountsDetail"
			}
		},
		{
			"id": "ChartOfAccountsDetail",
			"route": "/chart-of-accounts/:id",
			"type": "detail",
			"title": "Account",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"fields": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"type": "string"
					},
					{
						"key": "name",
						"label": "Name",
						"type": "string"
					},
					{
						"key": "accountType",
						"label": "Account Type",
						"type": "string"
					},
					{
						"key": "currency",
						"label": "Currency",
						"type": "string"
					},
					{
						"key": "parentAccountNumber",
						"label": "Parent Account",
						"type": "string"
					},
					{
						"key": "administrationId",
						"label": "Administration",
						"type": "string"
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "isClosingAccount",
						"label": "Closing Account",
						"type": "boolean"
					},
					{
						"key": "vatApplicable",
						"label": "VAT Applicable",
						"type": "boolean"
					},
					{
						"key": "description",
						"label": "Description",
						"type": "string"
					}
				],
				"lifecycleActions": true,
				"indexRoute": "ChartOfAccounts"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "open-items",
						"title": "Open items",
						"type": "stats-block",
						"iconClass": "icon-folder",
						"props": {
							"count": 12,
							"countLabel": "sample",
							"variant": "primary"
						}
					},
					{
						"id": "due-this-week",
						"title": "Due this week",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": {
							"count": 5,
							"countLabel": "sample",
							"variant": "warning"
						}
					},
					{
						"id": "completed",
						"title": "Completed",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"props": {
							"count": 48,
							"countLabel": "sample",
							"variant": "success"
						}
					},
					{
						"id": "team-members",
						"title": "Team members",
						"type": "stats-block",
						"iconClass": "icon-group",
						"props": {
							"count": 7,
							"countLabel": "sample",
							"variant": "default"
						}
					}
				],
				"layout": [
					{
						"id": "layout-open-items",
						"widgetId": "open-items",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-due-this-week",
						"widgetId": "due-this-week",
						"gridX": 3,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-completed",
						"widgetId": "completed",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-team-members",
						"widgetId": "team-members",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					}
				]
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/shillinq/api/settings",
				"sections": [
					{
						"id": "configuration",
						"title": "Configuration",
						"fields": [
							{
								"key": "register",
								"label": "Register",
								"type": "string",
								"help": "OpenRegister register ID"
							}
						]
					},
					{
						"id": "version",
						"title": "Version",
						"widgets": [
							{
								"type": "version-info"
							}
						]
					}
				]
			}
		}
	]
}
