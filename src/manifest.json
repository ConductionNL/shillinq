{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest-v2.schema.json",
	"version": "1.0.0",
	"dependencies": [
		"openregister"
	],
	"menu": [
		{
			"id": "Dashboard",
			"label": "Dashboard",
			"icon": "icon-category-dashboard",
			"route": "Dashboard",
			"order": 10
		},
		{
			"id": "Bookkeeping",
			"label": "Bookkeeping",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{
					"id": "ChartOfAccounts",
					"label": "Chart of Accounts",
					"icon": "LedgerOutline",
					"route": "ChartOfAccounts",
					"order": 10
				},
				{
					"id": "Innovatiebox",
					"label": "Innovatiebox",
					"icon": "LightbulbOutline",
					"route": "InnovatieboxElections",
					"order": 80,
					"featureFlag": "mkb-innovatiebox"
				}
			]
		},
		{
			"id": "Documentation",
			"label": "Documentation",
			"icon": "icon-info",
			"href": "https://conduction.nl",
			"section": "footer",
			"order": 90
		},
		{
			"id": "FeaturesRoadmapMenu",
			"label": "Features & roadmap",
			"icon": "icon-toggle",
			"route": "FeaturesRoadmap",
			"section": "footer",
			"order": 91
		},
		{
			"id": "Settings",
			"label": "Settings",
			"icon": "icon-settings",
			"route": "Settings",
			"section": "settings",
			"order": 99
		}
	],
	"pages": [
		{
			"id": "FeaturesRoadmap",
			"route": "/features-roadmap",
			"type": "roadmap",
			"title": "Features & roadmap",
			"config": {
				"documentationUrl": "https://shillinq.conduction.nl"
			}
		},
		{
			"id": "ChartOfAccounts",
			"route": "/chart-of-accounts",
			"type": "index",
			"title": "Chart of Accounts",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"columns": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"sortable": true
					},
					{
						"key": "name",
						"label": "Name",
						"sortable": true
					},
					{
						"key": "accountType",
						"label": "Type",
						"sortable": true
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"sortable": true
					}
				],
				"defaultSort": "accountNumber",
				"detailRoute": "ChartOfAccountsDetail"
			}
		},
		{
			"id": "ChartOfAccountsDetail",
			"route": "/chart-of-accounts/:id",
			"type": "detail",
			"title": "Account",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"fields": [
					{
						"key": "accountNumber",
						"label": "Account Number",
						"type": "string"
					},
					{
						"key": "name",
						"label": "Name",
						"type": "string"
					},
					{
						"key": "accountType",
						"label": "Account Type",
						"type": "string"
					},
					{
						"key": "currency",
						"label": "Currency",
						"type": "string"
					},
					{
						"key": "parentAccountNumber",
						"label": "Parent Account",
						"type": "string"
					},
					{
						"key": "administrationId",
						"label": "Administration",
						"type": "string"
					},
					{
						"key": "lifecycleState",
						"label": "Status",
						"type": "string"
					},
					{
						"key": "isClosingAccount",
						"label": "Closing Account",
						"type": "boolean"
					},
					{
						"key": "vatApplicable",
						"label": "VAT Applicable",
						"type": "boolean"
					},
					{
						"key": "description",
						"label": "Description",
						"type": "string"
					}
				],
				"lifecycleActions": true,
				"indexRoute": "ChartOfAccounts"
			}
		},
		{
			"id": "InnovatieboxElections",
			"route": "/bookkeeping/innovatiebox",
			"type": "index",
			"title": "Innovatiebox",
			"featureFlag": "mkb-innovatiebox",
			"config": {
				"register": "shillinq",
				"schema": "InnovatieboxElection",
				"columns": [
					{
						"key": "administrationId",
						"label": "Administration",
						"sortable": true
					},
					{
						"key": "fiscalYear",
						"label": "Fiscal Year",
						"sortable": true
					},
					{
						"key": "route",
						"label": "Route",
						"sortable": true
					},
					{
						"key": "applicableTariff",
						"label": "Tariff",
						"sortable": false
					}
				],
				"defaultSort": "fiscalYear",
				"detailRoute": "InnovatieboxDetail"
			}
		},
		{
			"id": "InnovatieboxDetail",
			"route": "/bookkeeping/innovatiebox/:id",
			"type": "detail",
			"title": "Innovatiebox Election",
			"featureFlag": "mkb-innovatiebox",
			"config": {
				"register": "shillinq",
				"schema": "InnovatieboxElection",
				"fields": [
					{
						"key": "administrationId",
						"label": "Administration",
						"type": "string"
					},
					{
						"key": "fiscalYear",
						"label": "Fiscal Year",
						"type": "integer"
					},
					{
						"key": "route",
						"label": "Route",
						"type": "string"
					},
					{
						"key": "applicableTariff",
						"label": "Applicable Tariff",
						"type": "number"
					},
					{
						"key": "forfaitairCapBedrag",
						"label": "Forfaitair Cap (EUR)",
						"type": "number"
					},
					{
						"key": "forfaitairPercentage",
						"label": "Forfaitair Percentage",
						"type": "number"
					},
					{
						"key": "operatingProfit",
						"label": "Operating Profit (EUR)",
						"type": "number"
					},
					{
						"key": "notes",
						"label": "Notes",
						"type": "string"
					}
				],
				"relatedLists": [
					{
						"title": "IP Assets (afpelmethode)",
						"condition": "route == 'afpelmethode'",
						"schema": "IPAssetValuation",
						"filterField": "administrationId",
						"columns": [
							{"key": "assetNaam", "label": "Asset Name"},
							{"key": "assetType", "label": "Asset Type"},
							{"key": "valuationBedrag", "label": "Valuation (EUR)"},
							{"key": "applicableTariff", "label": "Tariff"},
							{"key": "wbsoVerklaringNummer", "label": "WBSO Nr."}
						],
						"detailRoute": "InnovatieboxIPAssetDetail"
					}
				],
				"indexRoute": "InnovatieboxElections"
			}
		},
		{
			"id": "InnovatieboxIPAssetDetail",
			"route": "/bookkeeping/innovatiebox/ip-asset/:id",
			"type": "detail",
			"title": "IP Asset Valuation",
			"featureFlag": "mkb-innovatiebox",
			"config": {
				"register": "shillinq",
				"schema": "IPAssetValuation",
				"fields": [
					{
						"key": "assetNaam",
						"label": "Asset Name",
						"type": "string"
					},
					{
						"key": "assetType",
						"label": "Asset Type",
						"type": "string"
					},
					{
						"key": "valuationBedrag",
						"label": "Valuation (EUR)",
						"type": "number"
					},
					{
						"key": "valuationDate",
						"label": "Valuation Date",
						"type": "date"
					},
					{
						"key": "applicableTariff",
						"label": "Applicable Tariff",
						"type": "number"
					},
					{
						"key": "wbsoVerklaringNummer",
						"label": "WBSO Verklaring Nr.",
						"type": "string"
					},
					{
						"key": "octrooiNummer",
						"label": "Octrooi Nr.",
						"type": "string"
					},
					{
						"key": "vpbBalansLinkId",
						"label": "Vpb Balans Link",
						"type": "string"
					},
					{
						"key": "fiscalYear",
						"label": "Fiscal Year",
						"type": "integer"
					}
				],
				"relatedLists": [
					{
						"title": "Winsttoerekening",
						"schema": "WinstToerekening",
						"filterField": "ipAssetId",
						"columns": [
							{"key": "periodId", "label": "Period"},
							{"key": "toegerekendeWinst", "label": "Toegewezen winst (EUR)"},
							{"key": "verdeelsleutel", "label": "Verdeelsleutel"},
							{"key": "vpbImpact", "label": "Vpb-impact (EUR)"}
						]
					}
				],
				"indexRoute": "InnovatieboxElections"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{
						"id": "open-items",
						"title": "Open items",
						"type": "stats-block",
						"iconClass": "icon-folder",
						"props": {
							"count": 12,
							"countLabel": "sample",
							"variant": "primary"
						}
					},
					{
						"id": "due-this-week",
						"title": "Due this week",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": {
							"count": 5,
							"countLabel": "sample",
							"variant": "warning"
						}
					},
					{
						"id": "completed",
						"title": "Completed",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"props": {
							"count": 48,
							"countLabel": "sample",
							"variant": "success"
						}
					},
					{
						"id": "team-members",
						"title": "Team members",
						"type": "stats-block",
						"iconClass": "icon-group",
						"props": {
							"count": 7,
							"countLabel": "sample",
							"variant": "default"
						}
					}
				],
				"layout": [
					{
						"id": "layout-open-items",
						"widgetId": "open-items",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-due-this-week",
						"widgetId": "due-this-week",
						"gridX": 3,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-completed",
						"widgetId": "completed",
						"gridX": 6,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					},
					{
						"id": "layout-team-members",
						"widgetId": "team-members",
						"gridX": 9,
						"gridY": 0,
						"gridWidth": 3,
						"gridHeight": 2
					}
				]
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/shillinq/api/settings",
				"sections": [
					{
						"id": "configuration",
						"title": "Configuration",
						"fields": [
							{
								"key": "register",
								"label": "Register",
								"type": "string",
								"help": "OpenRegister register ID"
							}
						]
					},
					{
						"id": "version",
						"title": "Version",
						"widgets": [
							{
								"type": "version-info"
							}
						]
					}
				]
			}
		}
	]
}
