{
	"$schema": "https://raw.githubusercontent.com/ConductionNL/nextcloud-vue/main/src/schemas/app-manifest.schema.json",
	"version": "1.0.0",
	"dependencies": ["openregister"],
	"menu": [
		{ "id": "Dashboard", "label": "Dashboard", "icon": "icon-category-dashboard", "route": "Dashboard", "order": 10 },
		{
			"id": "Bookkeeping",
			"label": "Bookkeeping",
			"icon": "icon-category-organization",
			"order": 20,
			"children": [
				{ "id": "ChartOfAccounts", "label": "Chart of Accounts", "icon": "LedgerOutline", "route": "ChartOfAccounts", "order": 10 },
				{ "id": "GeneralLedger", "label": "General Ledger", "icon": "BookOpenVariantOutline", "route": "GeneralLedger", "order": 20 }
			]
		},
		{ "id": "Documentation", "label": "Documentation", "icon": "icon-info", "href": "https://conduction.nl", "section": "settings", "order": 90 },
		{ "id": "Settings", "label": "Settings", "icon": "icon-settings", "route": "Settings", "section": "settings", "order": 99 }
	],
	"pages": [
		{
			"id": "ChartOfAccounts",
			"route": "/chart-of-accounts",
			"type": "index",
			"title": "Chart of Accounts",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"columns": [
					{ "key": "accountNumber", "label": "Account Number", "sortable": true },
					{ "key": "name", "label": "Name", "sortable": true },
					{ "key": "accountType", "label": "Type", "sortable": true },
					{ "key": "lifecycleState", "label": "Status", "sortable": true }
				],
				"defaultSort": "accountNumber",
				"detailRoute": "ChartOfAccountsDetail"
			}
		},
		{
			"id": "ChartOfAccountsDetail",
			"route": "/chart-of-accounts/:id",
			"type": "detail",
			"title": "Account",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"fields": [
					{ "key": "accountNumber", "label": "Account Number" },
					{ "key": "name", "label": "Name" },
					{ "key": "accountType", "label": "Account Type" },
					{ "key": "currency", "label": "Currency" },
					{ "key": "parentAccountNumber", "label": "Parent Account" },
					{ "key": "administrationId", "label": "Administration" },
					{ "key": "lifecycleState", "label": "Status" },
					{ "key": "isClosingAccount", "label": "Closing Account" },
					{ "key": "vatApplicable", "label": "VAT Applicable" },
					{ "key": "description", "label": "Description" }
				],
				"lifecycleActions": true,
				"indexRoute": "ChartOfAccounts"
			}
		},
		{
			"id": "GeneralLedger",
			"route": "/general-ledger",
			"type": "index",
			"title": "General Ledger",
			"config": {
				"register": "shillinq",
				"schema": "GLTransaction",
				"columns": [
					{ "key": "transactionNumber", "label": "Transaction Number", "sortable": true },
					{ "key": "postingDate", "label": "Posting Date", "sortable": true },
					{ "key": "description", "label": "Description", "sortable": true },
					{ "key": "state", "label": "Status", "sortable": true }
				],
				"defaultSort": "postingDate",
				"detailRoute": "GeneralLedgerDetail"
			}
		},
		{
			"id": "GeneralLedgerDetail",
			"route": "/general-ledger/:id",
			"type": "detail",
			"title": "GL Transaction",
			"config": {
				"register": "shillinq",
				"schema": "GLTransaction",
				"fields": [
					{ "key": "transactionNumber", "label": "Transaction Number" },
					{ "key": "postingDate", "label": "Posting Date" },
					{ "key": "periodId", "label": "Period" },
					{ "key": "currency", "label": "Currency" },
					{ "key": "description", "label": "Description" },
					{ "key": "sourceReference", "label": "Source Reference" },
					{ "key": "state", "label": "Status" },
					{ "key": "journalEntryId", "label": "Journal Entry" },
					{ "key": "administrationId", "label": "Administration" }
				],
				"relatedLists": [
					{
						"register": "shillinq",
						"schema": "GLLine",
						"parentField": "transactionId",
						"title": "Lines",
						"columns": [
							{ "key": "lineNumber", "label": "#", "sortable": true },
							{ "key": "accountNumber", "label": "Account", "sortable": true },
							{ "key": "side", "label": "D/C", "sortable": true },
							{ "key": "amount", "label": "Amount", "sortable": true },
							{ "key": "subLedgerRef", "label": "Sub-ledger" },
							{ "key": "costCenter", "label": "Cost Centre" }
						]
					}
				],
				"lifecycleActions": true,
				"indexRoute": "GeneralLedger"
			}
		},
		{
			"id": "Dashboard",
			"route": "/",
			"type": "dashboard",
			"title": "Dashboard",
			"config": {
				"widgets": [
					{ "id": "open-items", "title": "Open items", "type": "stats-block", "iconClass": "icon-folder", "props": { "count": 12, "countLabel": "sample", "variant": "primary" } },
					{ "id": "due-this-week", "title": "Due this week", "type": "stats-block", "iconClass": "icon-calendar", "props": { "count": 5, "countLabel": "sample", "variant": "warning" } },
					{ "id": "completed", "title": "Completed", "type": "stats-block", "iconClass": "icon-checkmark", "props": { "count": 48, "countLabel": "sample", "variant": "success" } },
					{ "id": "team-members", "title": "Team members", "type": "stats-block", "iconClass": "icon-group", "props": { "count": 7, "countLabel": "sample", "variant": "default" } }
				],
				"layout": [
					{ "id": "open-items",     "widgetId": "open-items",     "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": true },
					{ "id": "due-this-week",  "widgetId": "due-this-week",  "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": true },
					{ "id": "completed",      "widgetId": "completed",      "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": true },
					{ "id": "team-members",   "widgetId": "team-members",   "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2, "showTitle": true }
				]
			}
		},
		{
			"id": "Settings",
			"route": "/settings",
			"type": "settings",
			"title": "Settings",
			"config": {
				"saveEndpoint": "/index.php/apps/shillinq/api/settings",
				"sections": [
					{
						"id": "version",
						"title": "Version Information",
						"widgets": [
							{ "type": "version-info" }
						]
					},
					{
						"id": "configuration",
						"title": "Configuration",
						"fields": [
							{ "key": "register", "label": "Register", "type": "string", "help": "OpenRegister register ID" }
						]
					}
				]
			}
		}
	]
}
