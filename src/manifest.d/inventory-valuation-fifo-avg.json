									}
								}
							]
						}
					]
				}
			}
		},
		{"id": "InventoryValuationReport", "route": "/inventory/valuation-report", "type": "dashboard", "title": "Stock valuation", "config": {"widgets": [{"id": "valuation-date", "title": "Valuation date", "type": "workspace-filter", "content": {"label": "Valuation date", "style": "input", "writes": "@workspace.valuationDate", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "submitLabel": "Show valuation"}}, {"id": "valuation-total", "title": "Stock value", "type": "stat", "content": {"label": "Stock value", "icon": "ScaleBalance", "format": {"style": "currency", "currency": "EUR", "decimals": 2}, "endpointSource": {"url": "/apps/shillinq/api/inventory/valuation-report", "params": {"as_of": "@workspace.valuationDate"}}, "valueField": "valuation.totalValue", "emptyText": "Choose a date"}}, {"id": "valuation-lines", "title": "Value per product and location", "type": "object-table", "content": {"endpointSource": {"url": "/apps/shillinq/api/inventory/valuation-report", "params": {"as_of": "@workspace.valuationDate"}, "responsePath": "valuation.lines"}, "emptyText": "No stock on this date.", "columns": [{"key": "sku", "label": "Product"}, {"key": "warehouse", "label": "Location"}, {"key": "method", "label": "Valuation Method"}, {"key": "quantity", "label": "Quantity"}, {"key": "unitCost", "label": "Unit Cost", "formatter": "currency", "formatterOptions": {"currency": "EUR", "decimals": 4}}, {"key": "totalValue", "label": "Total Value", "formatter": "currency", "formatterOptions": {"currency": "EUR", "decimals": 2}}]}}], "layout": [{"id": "vr-date", "widgetId": "valuation-date", "gridX": 0, "gridY": 0, "gridWidth": 12, "gridHeight": 2}, {"id": "vr-total", "widgetId": "valuation-total", "gridX": 0, "gridY": 2, "gridWidth": 12, "gridHeight": 2}, {"id": "vr-lines", "widgetId": "valuation-lines", "gridX": 0, "gridY": 4, "gridWidth": 12, "gridHeight": 8}]}}
