			"config": {
				"register": "shillinq",
				"schema": "InventoryValuation",
				"_note": "VALUATION snapshot (the FIFO/AVG value of a product's stock at a warehouse on a date — the number that lands on the balance sheet and feeds COGS). The body foregrounds the valuation maths: quantity × unit cost = total value, the method that produced it, the date, warehouse, product and cost-center it books to, and the pending-COGS flag. A leaf snapshot with no child lines; no comms. The audit trail sidebar is the recalculation/method-change record, essential when a valuation is restated.",
				"fields": [
					{"key": "name", "label": "Name", "type": "string"},
					{"key": "quantity", "label": "Quantity", "type": "number"},
					{"key": "unitCost", "label": "Unit Cost", "type": "number"},
					{"key": "totalValue", "label": "Total Value", "type": "number"},
					{"key": "valuationMethod", "label": "Valuation Method", "type": "string"},
					{"key": "date", "label": "Date", "type": "string"},
					{"key": "warehouse", "label": "Warehouse", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "productId", "label": "Product", "type": "string"},
					{"key": "costCenterId", "label": "Cost Center", "type": "string"},
					{"key": "pendingCogs", "label": "Pending COGS", "type": "boolean"},
					{"key": "administrationId", "label": "Administration", "type": "string"}
				],
				"indexRoute": "InventoryValuations",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
