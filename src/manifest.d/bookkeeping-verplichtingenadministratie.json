					"order": 40
				}
			]
		}
	],
	"pages": [
		{
			"id": "Verplichtingenregister",
			"route": "/verplichtingen",
			"type": "index",
			"title": "Commitments register",
			"config": {
				"register": "shillinq",
				"schema": "Commitment",
				"columns": [
					{"key": "commitmentNumber", "label": "Number", "sortable": true},
					{"key": "commitmentType", "label": "Kind", "sortable": true},
					{"key": "status", "label": "Status", "sortable": true},
					{"key": "totalAmountExclVat", "label": "Amount (excl. BTW)", "sortable": true},
					{"key": "commitmentDate", "label": "Start date", "sortable": true},
					{"key": "mandateApplied", "label": "Mandate", "sortable": true}
				],
				"defaultSort": "commitmentNumber",
				"detailRoute": "VerplichtingDetail"
			}
		},
		{
			"id": "VerplichtingDetail",
			"route": "/verplichtingen/:id",
			"type": "detail",
			"title": "Commitment",
			"config": {
				"register": "shillinq",
				"schema": "Commitment",
				"_note": "COMMITMENT (the parent obligation an organisation enters into — a purchase order/contract encumbrance). The body pairs the commitment header (amounts, term, BTW, applied mandate) with its three child registers, all filtered on `commitment`: the budget lines (CommitmentLine) that break it down per GL/programme with delivered/invoiced/paid running balances, the movements (CommitmentMovement) that draw it down over time, and the approval steps (ApprovalStep) that authorise it. This is the encumbrance-tracking view. No comms leaves; audit trail sidebar records mandate overrides and amount changes.",
				"fields": [
					{"key": "commitmentNumber", "label": "Number", "type": "string"},
					{"key": "commitmentType", "label": "Kind", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "commitmentDate", "label": "Start date", "type": "string"},
					{"key": "termStart", "label": "Term from", "type": "string"},
					{"key": "termEnd", "label": "Term until", "type": "string"},
					{"key": "totalAmountExclVat", "label": "Total amount (excl. BTW)", "type": "number"},
					{"key": "totalAmountInclVat", "label": "Total amount (incl. BTW)", "type": "number"},
					{"key": "currency", "label": "Currency", "type": "string"},
					{"key": "vatRegime", "label": "BTW regime", "type": "string"},
					{"key": "mandateApplied", "label": "Mandate", "type": "string"},
					{"key": "overrideReason", "label": "Override reason", "type": "string"},
					{"key": "internalReference", "label": "Internal reference", "type": "string"},
					{"key": "sourceReference", "label": "Source reference", "type": "string"}
				],
				"relatedObjects": [
					{
						"id": "lines",
						"label": "Commitment lines",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "CommitmentLine",
							"filterField": "commitment",
							"columns": ["lineNumber", "description", "amountExclVat", "deliveredAmount", "invoicedAmount", "remainingCommitted"]
						}
					},
					{
						"id": "movements",
						"label": "Movements",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "CommitmentMovement",
							"filterField": "commitment",
							"columns": ["date", "movementType", "amount", "relatedInvoice", "journalEntry"]
						}
					},
					{
						"id": "approvals",
						"label": "Approvals",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "ApprovalStep",
							"filterField": "commitment",
							"columns": ["stepNumber", "rol_vereist", "toegewezen_aan", "status", "behandeld_op"]
						}
					}
				],
				"indexRoute": "Verplichtingenregister",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "BudgetLineCommitments",
			"route": "/verplichtingen/budget-lines",
			"type": "custom",
			"title": "Committed vs. realised",
			"component": "BudgetLineCommitments"
		},
		{
			"id": "Mandaten",
			"route": "/verplichtingen/mandaten",
			"type": "index",
			"title": "Mandates",
			"config": {
				"register": "shillinq",
				"schema": "Mandate",
				"columns": [
					{"key": "mandateCode", "label": "Code", "sortable": true},
					{"key": "name", "label": "Name", "sortable": true},
					{"key": "maximumAmount", "label": "Maximum amount", "sortable": true},
					{"key": "isOverride", "label": "Override", "sortable": true},
					{"key": "geldig_tot", "label": "Valid until", "sortable": true}
				],
				"defaultSort": "mandateCode",
				"detailRoute": "MandaatDetail"
			}
		},
		{
			"id": "MandaatDetail",
			"route": "/verplichtingen/mandaten/:id",
			"type": "detail",
			"title": "Mandate",
			"config": {
				"register": "shillinq",
				"schema": "Mandate",
				"_note": "MANDATE (the authority definition that governs who may enter commitments and up to what amount). The body is the rule: holder + holder type, maximum amount, whether it is an override mandate, the second-signature threshold, validity window and the decision that adopted it. A config record with no children of its own; no comms. The audit trail sidebar is critical — a mandate is a delegated-authority control, so every change to its limits or holder must be traceable.",
				"fields": [
					{"key": "mandateCode", "label": "Code", "type": "string"},
					{"key": "name", "label": "Name", "type": "string"},
					{"key": "houder", "label": "Holder", "type": "string"},
					{"key": "houder_type", "label": "Holder type", "type": "string"},
					{"key": "maximumAmount", "label": "Maximum amount", "type": "number"},
					{"key": "isOverride", "label": "Override mandate", "type": "boolean"},
					{"key": "secondSignatureRequiredAbove", "label": "Second signature above", "type": "number"},
					{"key": "geldig_van", "label": "Valid from", "type": "string"},
					{"key": "geldig_tot", "label": "Valid until", "type": "string"},
					{"key": "vastgesteld_bij", "label": "Adopted by", "type": "string"}
				],
				"indexRoute": "Mandaten",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "Goedkeuringsstappen",
			"route": "/verplichtingen/goedkeuringen",
			"type": "index",
			"title": "Approvals",
			"config": {
				"register": "shillinq",
				"schema": "ApprovalStep",
				"columns": [
					{"key": "commitment", "label": "Commitment", "sortable": true},
					{"key": "stepNumber", "label": "Step", "sortable": true},
					{"key": "rol_vereist", "label": "Role", "sortable": true},
					{"key": "toegewezen_aan", "label": "Assigned to", "sortable": true},
					{"key": "status", "label": "Status", "sortable": true}
				],
				"defaultSort": "commitment",
				"detailRoute": "GoedkeuringsstapDetail"
			}
		},
		{
			"id": "GoedkeuringsstapDetail",
			"route": "/verplichtingen/goedkeuringen/:id",
			"type": "detail",
			"title": "Approval step",
			"config": {
				"register": "shillinq",
				"schema": "ApprovalStep",
				"_note": "APPROVAL STEP (one node in a commitment's authorisation chain). The body is the step: which commitment, step number, required role, assignee, current status, when it was handled, the remark, and whether a signature is required. A single workflow item with no children; no comms. The audit trail sidebar is the sign-off evidence — approvals must be individually traceable for segregation-of-duties.",
				"fields": [
					{"key": "commitment", "label": "Commitment", "type": "string"},
					{"key": "stepNumber", "label": "Step", "type": "number"},
					{"key": "rol_vereist", "label": "Role required", "type": "string"},
					{"key": "toegewezen_aan", "label": "Assigned to", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "behandeld_op", "label": "Handled on", "type": "string"},
					{"key": "opmerking", "label": "Remark", "type": "string"},
					{"key": "vereist_handtekening", "label": "Signature required", "type": "boolean"}
				],
				"indexRoute": "Goedkeuringsstappen",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		}
	]
}
