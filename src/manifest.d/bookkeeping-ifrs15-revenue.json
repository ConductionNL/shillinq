	],
	"pages": [
		{
			"id": "Contracts",
			"route": "/ifrs-15/contracts",
			"type": "index",
			"title": "Contracts",
			"config": {
				"register": "shillinq",
				"schema": "Contract",
				"columns": [
					{ "key": "contractNumber", "label": "Contract Number", "sortable": true },
					{ "key": "customerId", "label": "Customer", "sortable": false },
					{ "key": "signedAt", "label": "Signed", "sortable": true },
					{ "key": "startDate", "label": "Start", "sortable": true },
					{ "key": "endDate", "label": "End", "sortable": true },
					{ "key": "fixedConsideration", "label": "Fixed Consideration", "sortable": true },
					{ "key": "currency", "label": "Currency", "sortable": true },
					{ "key": "lifecycleState", "label": "State", "sortable": true }
				],
				"defaultSort": "contractNumber",
				"detailRoute": "ContractDetail"
			}
		},
		{
			"id": "ContractDetail",
			"route": "/ifrs-15/contracts/:id",
			"type": "detail",
			"title": "Contract",
			"config": {
				"register": "shillinq",
				"schema": "Contract",
				"fields": [
					{ "key": "contractNumber", "label": "Contract Number", "type": "string" },
					{ "key": "customerId", "label": "Customer", "type": "string" },
					{ "key": "signedAt", "label": "Signed", "type": "string" },
					{ "key": "startDate", "label": "Start", "type": "string" },
					{ "key": "endDate", "label": "End", "type": "string" },
					{ "key": "fixedConsideration", "label": "Fixed Consideration", "type": "number" },
					{ "key": "variableConsideration", "label": "Variable Consideration", "type": "number" },
					{ "key": "currency", "label": "Currency", "type": "string" },
					{ "key": "quoteOrderReference", "label": "Sales Order", "type": "string" },
					{ "key": "contractGroupId", "label": "Contract Group", "type": "string" },
					{ "key": "lifecycleState", "label": "State", "type": "string" }
				]
			}
		},
		{
			"id": "PerformanceObligations",
			"route": "/ifrs-15/performance-obligations",
			"type": "index",
			"title": "Performance Obligations",
			"config": {
				"register": "shillinq",
				"schema": "PerformanceObligation",
				"columns": [
					{ "key": "contractId", "label": "Contract", "sortable": true },
					{ "key": "description", "label": "Description", "sortable": false },
					{ "key": "satisfactionPattern", "label": "Satisfaction Pattern", "sortable": true },
					{ "key": "outputMethod", "label": "Output Method", "sortable": true },
					{ "key": "inputMethod", "label": "Input Method", "sortable": true },
					{ "key": "sspAmount", "label": "SSP", "sortable": true },
					{ "key": "allocatedPrice", "label": "Allocated Price", "sortable": true },
					{ "key": "percentageComplete", "label": "% Complete", "sortable": true },
					{ "key": "statusAtPeriodEnd", "label": "Status", "sortable": true }
				],
				"defaultSort": "contractId"
			}
		},
		{
			"id": "RevenueWaterfall",
			"route": "/ifrs-15/revenue-waterfall",
			"type": "index",
			"title": "Revenue Waterfall",
			"config": {
				"register": "shillinq",
				"schema": "RevenueWaterfall",
				"columns": [
					{ "key": "contractId", "label": "Contract", "sortable": true },
					{ "key": "periodEnd", "label": "Period", "sortable": true },
					{ "key": "transactionPriceAllocated", "label": "Allocated", "sortable": true },
					{ "key": "periodRecognised", "label": "Recognised (period)", "sortable": true },
					{ "key": "cumulativeRecognised", "label": "Recognised (cumulative)", "sortable": true },
					{ "key": "remainingAmount", "label": "Remaining", "sortable": true },
					{ "key": "remainingMonths", "label": "Remaining Months", "sortable": true }
				],
				"defaultSort": "periodEnd"
			}
		},
		{
			"id": "ContractBalances",
			"route": "/ifrs-15/contract-balances",
			"type": "index",
			"title": "Contract Balances",
			"config": {
				"register": "shillinq",
				"schema": "ContractAsset",
				"columns": [
					{ "key": "contractId", "label": "Contract", "sortable": true },
					{ "key": "periodEnd", "label": "Period", "sortable": true },
					{ "key": "assetAmount", "label": "Contract Asset", "sortable": true },
					{ "key": "accrualAmount", "label": "Accrued Revenue", "sortable": true },
					{ "key": "currentPeriodMovement", "label": "Period Movement", "sortable": true }
				],
				"defaultSort": "periodEnd"
			}
		},
		{
			"id": "ContractModifications",
			"route": "/ifrs-15/contract-modifications",
			"type": "index",
			"title": "Contract Modifications",
			"config": {
				"register": "shillinq",
				"schema": "ContractModification",
				"columns": [
					{ "key": "parentContractId", "label": "Parent Contract", "sortable": true },
					{ "key": "modificationDate", "label": "Date", "sortable": true },
					{ "key": "modificationType", "label": "Type", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true },
					{ "key": "newTransactionPrice", "label": "New Price", "sortable": true }
				],
				"defaultSort": "modificationDate"
			}
		},
		{
			"id": "ContractCostAssets",
			"route": "/ifrs-15/contract-cost-assets",
			"type": "index",
			"title": "Contract Cost Assets",
			"config": {
				"register": "shillinq",
				"schema": "ContractCostAsset",
				"columns": [
					{ "key": "contractId", "label": "Contract", "sortable": true },
					{ "key": "costType", "label": "Cost Type", "sortable": true },
					{ "key": "description", "label": "Description", "sortable": false },
					{ "key": "initialCapitalisation", "label": "Capitalised", "sortable": true },
					{ "key": "amortisedToDate", "label": "Amortised", "sortable": true },
					{ "key": "carriedAmount", "label": "Carried Amount", "sortable": true }
				],
				"defaultSort": "contractId"
			}
		}
	]
}
