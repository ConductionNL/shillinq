						"label": "Structural revenue",
						"sortable": true
					},
					{
						"key": "revenueIncidental",
						"label": "Incidental revenue",
						"sortable": true
					},
					{
						"key": "expensesStructural",
						"label": "Structural expenses",
						"sortable": true
					},
					{
						"key": "expensesIncidental",
						"label": "Incidental expenses",
						"sortable": true
					},
					{
						"key": "balanceStructural",
						"label": "Structural balance",
						"sortable": true
					},
					{
						"key": "saldoReëel",
						"label": "Real balance",
						"sortable": true
					},
					{
						"key": "sluitend",
						"label": "Balanced",
						"sortable": true
					}
				],
				"defaultSort": "year",
				"detailRoute": "MeerjarenramingDetail"
			}
		},
		{
			"id": "MeerjarenramingDetail",
			"route": "/overheid/meerjarenramingen/:id",
			"type": "detail",
			"title": "Multi-year estimate year",
			"config": {
				"register": "shillinq",
				"schema": "Meerjarenraming",
				"indexRoute": "Meerjarenramingen",
				"auditTrail": true,
				"widgets": [
					{
						"id": "estimate",
						"type": "data",
						"title": "Estimate",
						"icon": "ChartTimelineVariant",
						"content": {
							"columns": 2,
							"include": [
								"year",
								"budgetId",
								"revenueStructural",
								"revenueIncidental",
								"expensesStructural",
								"expensesIncidental",
								"balanceStructural",
								"balanceIncidental",
								"saldoReëel",
								"sluitend"
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "estimate",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 5
					}
				]
			}
		},
		{
			"id": "MeerjarenBudgetten",
			"route": "/overheid/meerjarenbudgetten",
			"type": "index",
			"title": "Multi-year budget lines",
			"config": {
				"register": "shillinq",
				"schema": "MeerjarenBudget",
				"columns": [
					{
						"key": "financialYear",
						"label": "Fiscal year",
						"sortable": true
					},
					{
						"key": "meerjarenHorizon",
						"label": "Horizon",
						"sortable": true
					},
					{
						"key": "programme",
						"label": "Programme",
						"sortable": true
					},
					{
						"key": "taskField",
						"label": "Task field",
						"sortable": true
					},
					{
						"key": "revenueCents",
						"label": "Revenue (cents)",
						"sortable": true
					},
					{
						"key": "expensesCents",
						"label": "Expenses (cents)",
						"sortable": true
					},
					{
						"key": "version",
						"label": "Version",
						"sortable": true
					}
				],
				"defaultSort": "financialYear",
				"detailRoute": "MeerjarenBudgetDetail"
			}
		},
		{
			"id": "MeerjarenBudgetDetail",
			"route": "/overheid/meerjarenbudgetten/:id",
			"type": "detail",
			"title": "Multi-year budget line",
			"config": {
				"register": "shillinq",
				"schema": "MeerjarenBudget",
				"indexRoute": "MeerjarenBudgetten",
				"auditTrail": true,
				"widgets": [
					{
						"id": "line",
						"type": "data",
						"title": "Budget line",
						"icon": "CalendarRangeOutline",
						"content": {
							"columns": 2,
							"include": [
								"financialYear",
								"meerjarenHorizon",
								"programme",
								"taskField",
								"economicCategory",
								"revenueCents",
								"expensesCents",
								"incidentalRevenueCents",
								"incidentalExpensesCents",
								"movementReservesCents",
								"version",
								"budgetAmendment",
								"notes"
							]
						}
					}
				],
				"layout": [
					{
						"id": "1",
						"widgetId": "line",
						"gridX": 0,
						"gridY": 0,
						"gridWidth": 12,
						"gridHeight": 5
					}
				]
			}
		}
	]
}
