					{ "key": "ingangsDatum", "label": "Ingangs-datum", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in einde", "sortable": true },
					{ "key": "drempelJaar", "label": "Drempel (EUR)" }
				],
				"defaultSort": "-ingangsDatum",
				"detailRoute": "KorDrempelMonitor",
				"helpText": "Overzicht van alle KOR-registraties van deze administratie. Klik door naar Drempel Monitor om realtime drempel-benutting, maandprognose en alert-historie te bekijken (REQ-KOR-002, REQ-KOR-003)."
			}
		},
		{
