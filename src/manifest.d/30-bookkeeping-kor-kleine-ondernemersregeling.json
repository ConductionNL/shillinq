		"change": "bookkeeping-kor-kleine-ondernemersregeling",
		"adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
		"description": "Declarative manifest-v2 navigation for the Tier-2 KOR capability (Task 22). Adds four entries under the existing Belastingen menu: KorAanmelding (opt-in flow as an index of draft KORRegistrations), KorDashboard (drempel-benutting + alerts overview), KorDrempelMonitor (KORAnnualTurnover detail with monthly breakdown, prognose, alert-history), and KorOpzegging (opt-out flow as an index of ACTIEF KORRegistrations past their vroegsteOpzegDatum). All four are pure config rendered by the nc-vue manifest-v2 shell (createObjectStore against the shillinq register) — no Vue components, no router (ADR-024 / manifest-v2). The pre-existing KorStatus + KorStatusDetail entries (driven by the legacy KorRegime schema) are deliberately untouched and co-exist."
	},
	"menu": [
		{
			"id": "Belastingen",
			"children": [
				{
					"id": "KorAanmelding",
					"label": "KOR registration",
					"icon": "ShieldPlusOutline",
					"route": "KorAanmelding",
					"order": 11
				},
				{
					"id": "KorDashboard",
					"label": "KOR dashboard",
					"icon": "ViewDashboardOutline",
					"route": "KorDashboard",
					"order": 12
				},
				{
					"id": "KorDrempelMonitor",
					"label": "Threshold monitor",
					"icon": "GaugeFull",
					"route": "KorDrempelMonitor",
					"order": 13
				},
				{
					"id": "KorOpzegging",
					"label": "KOR cancellation",
					"icon": "ShieldRemoveOutline",
					"route": "KorOpzegging",
					"order": 14
				}
			]
		}
	],
	"pages": [
		{
			"id": "KorAanmelding",
			"route": "/belastingen/kor-aanmelding",
			"type": "index",
			"title": "KOR registration",
			"config": {
				"register": "shillinq",
				"schema": "KORRegistration",
				"visibility": {
					"field": "administrationType",
					"in": [
						"mkb",
						"zzp"
					]
				},
				"filters": [
					{
						"key": "status",
						"label": "Status",
						"type": "enum",
						"defaultValue": "draft",
						"options": [
							{ "value": "draft", "label": "Draft" },
							{ "value": "ACTIEF", "label": "Active" }
						]
					},
					{
						"key": "regime",
						"label": "Regime",
						"type": "enum",
						"options": [
							{ "value": "KOR_NL", "label": "NL-KOR (art. 25 OB)" },
							{ "value": "KOR_EU", "label": "KOR-EU (art. 25a-25d OB)" }
						]
					}
				],
				"columns": [
					{ "key": "ondernemingId", "label": "Business", "sortable": true },
					{ "key": "regime", "label": "Regime", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true },
					{ "key": "aanmeldDatum", "label": "Registration date", "sortable": true },
					{ "key": "ingangsDatum", "label": "Start date", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in end", "sortable": true },
					{ "key": "belastingdienstReferentie", "label": "BD reference" }
				],
				"defaultSort": "-aanmeldDatum",
				"lifecycleActions": true,
				"helpText": "Start a new KOR registration. A registration is a three-year commitment (lock-in). Confirm the scenario analysis, the historical turnover, the forecast and the threshold block before you submit to mijnbelastingdienst.nl/zakelijk."
			}
		},
		{
			"id": "KorDashboard",
			"route": "/belastingen/kor-dashboard",
			"type": "index",
			"title": "KOR dashboard",
			"config": {
				"register": "shillinq",
				"schema": "KORRegistration",
				"visibility": {
					"field": "administrationType",
					"in": [
						"mkb",
						"zzp"
					]
				},
				"filters": [
					{
						"key": "status",
						"label": "Status",
						"type": "enum",
						"defaultValue": "ACTIEF",
						"options": [
							{ "value": "ACTIEF", "label": "Active" },
							{ "value": "GEEINDIGD_OVERSCHRIJDING", "label": "Ended — exceedance" },
							{ "value": "GEEINDIGD_VRIJWILLIG", "label": "Ended — voluntary" }
						]
					}
				],
				"columns": [
					{ "key": "ondernemingId", "label": "Business", "sortable": true },
					{ "key": "regime", "label": "Regime" },
					{ "key": "status", "label": "Status", "sortable": true },
					{ "key": "ingangsDatum", "label": "Start date", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in end", "sortable": true },
					{ "key": "drempelJaar", "label": "Threshold (EUR)" }
				],
				"defaultSort": "-ingangsDatum",
				"detailRoute": "KorDrempelMonitor",
				"helpText": "Overview of all KOR registrations for this administration. Click through to the Threshold monitor to view real-time threshold utilization, monthly forecast and alert history (REQ-KOR-002, REQ-KOR-003)."
			}
		},
		{
			"id": "KorDrempelMonitor",
			"route": "/belastingen/kor-drempel/:id",
			"type": "detail",
			"title": "Threshold monitor",
			"config": {
				"register": "shillinq",
				"schema": "KORAnnualTurnover",
				"fields": [
					{ "key": "registrationId", "label": "Registration", "type": "string" },
					{ "key": "jaar", "label": "Calendar year", "type": "integer" },
					{ "key": "lopendeOmzet", "label": "Running turnover (EUR)", "type": "money" },
					{ "key": "drempel", "label": "Threshold (EUR)", "type": "money" },
					{ "key": "drempelBenutting", "label": "Utilization", "type": "number" },
					{ "key": "perMaand", "label": "Turnover per month", "type": "json" },
					{ "key": "uitgeslotenPosten", "label": "Excluded items", "type": "array" },
					{ "key": "prognoseEindeJaar", "label": "Year-end forecast (EUR)", "type": "money" },
					{ "key": "prognoseStatus", "label": "Forecast status", "type": "string" }
				],
				"sidebarProps": {
					"tabs": [
						{
							"id": "alerts",
							"label": "Alert history",
							"icon": "AlertOutline",
							"order": 10,
							"widgets": [
								{
									"id": "kor-alerts",
									"type": "list",
									"register": "shillinq",
									"schema": "KORThresholdAlert",
									"filter": {
										"field": "registrationId",
										"op": "eq",
										"valueFromField": "registrationId"
									},
									"columns": [
										{ "key": "uitgeloostOp", "label": "Timestamp" },
										{ "key": "trigger", "label": "Bracket" },
										{ "key": "ernst", "label": "Severity" },
										{ "key": "drempelBenutting", "label": "Utilization" }
									]
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "HistoryIcon",
							"order": 90
						}
					]
				}
			}
		},
		{
			"id": "KorOpzegging",
			"route": "/belastingen/kor-opzegging",
			"type": "index",
			"title": "KOR cancellation",
			"config": {
				"register": "shillinq",
				"schema": "KORRegistration",
				"visibility": {
					"field": "administrationType",
					"in": [
						"mkb",
						"zzp"
					]
				},
				"filters": [
					{
						"key": "status",
						"label": "Status",
						"type": "enum",
						"defaultValue": "ACTIEF",
						"options": [
							{ "value": "ACTIEF", "label": "Active" }
						]
					}
				],
				"columns": [
					{ "key": "ondernemingId", "label": "Business", "sortable": true },
					{ "key": "regime", "label": "Regime" },
					{ "key": "ingangsDatum", "label": "Start date", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in end", "sortable": true },
					{ "key": "vroegsteOpzegDatum", "label": "Earliest cancellation date", "sortable": true }
				],
				"defaultSort": "vroegsteOpzegDatum",
				"lifecycleActions": true,
				"helpText": "Voluntary cancellation of an ACTIVE KOR registration. Cancellation is blocked until lockInEindDatum (REQ-KOR-007); the earliest cancellation date is three months before the end of the lock-in. The effective end date is 1 January of the next calendar year. On approval a KORRevocation with type=VRIJWILLIG_NA_LOCKOUT is created automatically."
			}
		}
	]
}
