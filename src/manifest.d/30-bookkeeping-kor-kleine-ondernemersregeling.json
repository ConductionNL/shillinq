				],
				"columns": [
					{ "key": "ondernemingId", "label": "Onderneming", "sortable": true },
					{ "key": "regime", "label": "Regime" },
					{ "key": "ingangsDatum", "label": "Ingangs-datum", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in einde", "sortable": true },
					{ "key": "vroegsteOpzegDatum", "label": "Vroegste opzeg-datum", "sortable": true }
