										{ "key": "trigger", "label": "Schijf" },
										{ "key": "ernst", "label": "Ernst" },
										{ "key": "drempelBenutting", "label": "Benutting" }
									]
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "HistoryIcon",
							"order": 90
						}
					]
				}
			}
		},
		{
			"id": "KorOpzegging",
			"route": "/belastingen/kor-opzegging",
			"type": "index",
			"title": "KOR Opzegging",
			"config": {
				"register": "shillinq",
				"schema": "KORRegistration",
				"visibility": {
