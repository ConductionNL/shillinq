	"pages": [
		{
			"id": "KorAanmelding",
			"route": "/belastingen/kor-aanmelding",
			"type": "index",
			"title": "KOR Aanmelding",
			"config": {
				"register": "shillinq",
				"schema": "KORRegistration",
				"visibility": {
					"field": "administrationType",
					"in": [
						"mkb",
						"zzp"
					]
				},
				"filters": [
					{
						"key": "status",
						"label": "Status",
						"type": "enum",
						"defaultValue": "draft",
						"options": [
							{ "value": "draft", "label": "Concept" },
							{ "value": "ACTIEF", "label": "Actief" }
						]
					},
					{
						"key": "regime",
						"label": "Regime",
						"type": "enum",
						"options": [
							{ "value": "KOR_NL", "label": "NL-KOR (art. 25 OB)" },
							{ "value": "KOR_EU", "label": "KOR-EU (art. 25a-25d OB)" }
						]
					}
				],
				"columns": [
					{ "key": "ondernemingId", "label": "Onderneming", "sortable": true },
					{ "key": "regime", "label": "Regime", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true },
					{ "key": "aanmeldDatum", "label": "Aanmeld-datum", "sortable": true },
					{ "key": "ingangsDatum", "label": "Ingangs-datum", "sortable": true },
					{ "key": "lockInEindDatum", "label": "Lock-in einde", "sortable": true },
					{ "key": "belastingdienstReferentie", "label": "BD-referentie" }
				],
				"defaultSort": "-aanmeldDatum",
				"lifecycleActions": true,
				"helpText": "Begin een nieuwe KOR-aanmelding. Een aanmelding is een drie-jaars commitment (lock-in). Bevestig de scenario-analyse, de historische omzet, de prognose en de drempel-blokkade voor je submit naar mijnbelastingdienst.nl/zakelijk."
			}
		},
		{
			"id": "KorDashboard",
			"route": "/belastingen/kor-dashboard",
			"type": "index",
