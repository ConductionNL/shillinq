					{ "key": "lopendeOmzet", "label": "Lopende omzet (EUR)", "type": "money" },
					{ "key": "drempel", "label": "Drempel (EUR)", "type": "money" },
					{ "key": "drempelBenutting", "label": "Benutting", "type": "number" },
					{ "key": "perMaand", "label": "Omzet per maand", "type": "json" },
					{ "key": "uitgeslotenPosten", "label": "Uitgesloten posten", "type": "array" },
					{ "key": "prognoseEindeJaar", "label": "Prognose eind jaar (EUR)", "type": "money" },
					{ "key": "prognoseStatus", "label": "Prognose-status", "type": "string" }
				],
				"sidebarProps": {
