{
	"menu": [
		{
			"id": "Purchasing",
			"label": "Purchasing & Inventory",
			"icon": "CartArrowDownOutline",
			"order": 35,
			"children": [
				{
					"id": "TenderNedAanbestedingen",
					"label": "TenderNed tenders",
					"icon": "GavelOutline",
					"route": "TenderNedAanbestedingen",
					"order": 10
				},
				{
					"id": "Verplichtingen",
					"label": "Commitments",
					"icon": "FileSignOutline",
					"route": "Verplichtingen",
					"order": 20
				},
				{
					"id": "MijnContracten",
					"label": "My contracts",
					"icon": "BriefcaseCheckOutline",
					"route": "MijnContracten",
					"order": 30
				}
			]
		}
	],
	"pages": [
		{
			"id": "TenderNedAanbestedingen",
			"route": "/inkoop/tenderned",
			"type": "index",
			"title": "TenderNed tenders",
			"config": {
				"register": "shillinq",
				"schema": "TenderNedAanbesteding",
				"columns": [
					{ "key": "aanbestedingId", "label": "Tender", "sortable": true },
					{ "key": "titel", "label": "Title", "sortable": true },
					{ "key": "gunningsDatum", "label": "Award date", "sortable": true },
					{ "key": "contractWaarde", "label": "Contract value", "sortable": true },
					{ "key": "gegundeLeverancier", "label": "Awarded supplier", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "gunningsDatum",
				"detailRoute": "TenderNedAanbestedingDetail"
			}
		},
		{
			"id": "TenderNedAanbestedingDetail",
			"route": "/inkoop/tenderned/:id",
			"type": "detail",
			"title": "TenderNed file",
			"config": {
				"register": "shillinq",
				"schema": "TenderNedAanbesteding",
				"_note": "INTEGRATION archetype — a tender award imported from the TenderNed portal (title, CPV codes, contracting authority, award date, contract value, supplier, term, source URL). Body leads with a contract-value KPI, then a schema-driven Data widget beside a Related panel that surfaces the single outbound `verplichtingId` FK (the materialised commitment this tender feeds, null until import promotes the dossier) — a Related panel is correct here rather than an object-list because the relation is a scalar FK to ONE Verplichting, not a filtered collection. Tender documents move from the sidebar into a full-width Files leaf (a real content type for an imported dossier). No comms — an imported reference record, not a conversation. Audit trail moves to the sidebar per policy.",
				"widgets": [
					{
						"id": "tender-value",
						"type": "stat",
						"title": "Contract value",
						"content": {
							"label": "Contract value",
							"format": "currency",
							"source": { "register": "shillinq", "schema": "TenderNedAanbesteding", "metric": "sum", "field": "contractWaarde", "filter": { "id": "@objectId" } }
						}
					},
					{
						"id": "tender-data",
						"type": "data",
						"title": "Tender details",
						"content": { "columns": 2 }
					},
					{
						"id": "tender-related",
						"type": "related",
						"title": "Linked commitment"
					},
					{
						"id": "tender-files",
						"type": "integration",
						"integrationId": "files",
						"title": "Tender documents"
					}
				],
				"layout": [
					{ "id": "1", "widgetId": "tender-value", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "tender-data", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "3", "widgetId": "tender-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "4", "widgetId": "tender-files", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 4 }
				],
				"lifecycleActions": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "Verplichtingen",
			"route": "/inkoop/verplichtingen",
			"type": "index",
			"title": "Commitments",
			"config": {
				"register": "shillinq",
				"schema": "Verplichting",
				"columns": [
					{ "key": "verplichtingNummer", "label": "Number", "sortable": true },
					{ "key": "omschrijving", "label": "Description", "sortable": true },
					{ "key": "bron", "label": "Source", "sortable": true },
					{ "key": "bedrag", "label": "Amount", "sortable": true },
					{ "key": "kostenplaats", "label": "Cost center", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "verplichtingNummer",
				"detailRoute": "VerplichtingDetail"
			}
		},
		{
			"id": "VerplichtingDetail",
			"route": "/inkoop/verplichtingen/:id",
			"type": "detail",
			"title": "Commitment",
			"config": {
				"register": "shillinq",
				"schema": "Verplichting",
				"_note": "LEDGER archetype — a financial obligation (verplichting) booked against a cost centre and GL account, sourced from a tender or a manual contract, carrying a term and a milestone schedule (mijlpalen). Body leads with a committed-amount KPI, then a schema-driven Data widget beside a Related panel surfacing the outbound `kostenplaats` (FK to CostCenter.costCentreCode) and `grootboekrekening` (FK to Account.accountNumber) references. The tender(s) that generated it are the genuine inbound collection — TenderNedAanbesteding filtered verplichtingId=@objectId — so that stays an object-list, unlike the sibling page's outbound single-FK case. Contract documents move from the sidebar into a full-width Files leaf. No comms — an obligation ledger record. Audit trail moves to the sidebar per policy.",
				"widgets": [
					{
						"id": "verplichting-value",
						"type": "stat",
						"title": "Committed amount",
						"content": {
							"label": "Committed amount",
							"format": "currency",
							"source": { "register": "shillinq", "schema": "Verplichting", "metric": "sum", "field": "bedrag", "filter": { "id": "@objectId" } }
						}
					},
					{
						"id": "verplichting-data",
						"type": "data",
						"title": "Commitment details",
						"content": { "columns": 2 }
					},
					{
						"id": "verplichting-related",
						"type": "related",
						"title": "Cost centre & GL account"
					},
					{
						"id": "verplichting-tenders",
						"type": "object-list",
						"title": "Source tenders",
						"content": {
							"register": "shillinq",
							"schema": "TenderNedAanbesteding",
							"filter": { "verplichtingId": "@objectId" },
							"columns": [
								{ "key": "titel", "label": "Tender" },
								{ "key": "gegundeLeverancier", "label": "Supplier" },
								{ "key": "contractWaarde", "label": "Contract value" }
							],
							"limit": 20,
							"rowRoute": "TenderNedAanbestedingDetail"
						}
					},
					{
						"id": "verplichting-files",
						"type": "integration",
						"integrationId": "files",
						"title": "Contract documents"
					}
				],
				"layout": [
					{ "id": "1", "widgetId": "verplichting-value", "gridX": 0, "gridY": 0, "gridWidth": 4, "gridHeight": 2 },
					{ "id": "2", "widgetId": "verplichting-data", "gridX": 0, "gridY": 2, "gridWidth": 8, "gridHeight": 4 },
					{ "id": "3", "widgetId": "verplichting-related", "gridX": 8, "gridY": 2, "gridWidth": 4, "gridHeight": 4 },
					{ "id": "4", "widgetId": "verplichting-tenders", "gridX": 0, "gridY": 6, "gridWidth": 12, "gridHeight": 4 },
					{ "id": "5", "widgetId": "verplichting-files", "gridX": 0, "gridY": 10, "gridWidth": 12, "gridHeight": 4 }
				],
				"lifecycleActions": true,
				"sidebar": {
					"enabled": true,
					"showMetadata": true,
					"tabs": [
						{ "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
					]
				}
			}
		},
		{
			"id": "MijnContracten",
			"route": "/inkoop/mijn-contracten",
			"type": "index",
			"title": "My contracts",
			"config": {
				"register": "shillinq",
				"schema": "Verplichting",
				"filters": {
					"bron": "tenderned"
				},
				"columns": [
					{ "key": "verplichtingNummer", "label": "Number", "sortable": true },
					{ "key": "omschrijving", "label": "Description", "sortable": true },
					{ "key": "bedrag", "label": "Contract value", "sortable": true },
					{ "key": "looptijdStart", "label": "Term start", "sortable": true },
					{ "key": "looptijdEind", "label": "Term end", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "looptijdStart",
				"detailRoute": "VerplichtingDetail"
			}
		}
	]
}
