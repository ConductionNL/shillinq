	"pages": [
		{
			"id": "TenderNedAanbestedingen",
			"route": "/inkoop/tenderned",
			"type": "index",
			"title": "TenderNed tenders",
			"config": {
				"register": "shillinq",
				"schema": "TenderNedAanbesteding",
				"columns": [
					{ "key": "aanbestedingId", "label": "Tender", "sortable": true },
					{ "key": "titel", "label": "Title", "sortable": true },
					{ "key": "gunningsDatum", "label": "Award date", "sortable": true },
					{ "key": "contractWaarde", "label": "Contract value", "sortable": true },
					{ "key": "gegundeLeverancier", "label": "Awarded supplier", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "gunningsDatum",
				"detailRoute": "TenderNedAanbestedingDetail"
			}
		},
		{
			"id": "TenderNedAanbestedingDetail",
			"route": "/inkoop/tenderned/:id",
			"type": "detail",
			"title": "TenderNed file",
			"config": {
				"_note": "A TenderNed tender is an INTEGRATION record imported from the TenderNed portal: the award (title, CPV codes, contracting authority, award date, contract value, supplier, term) plus the source URL and the commitment it feeds. Body leads with the tender data and a contract-value KPI; the linked commitment(s) are listed as related so procurement can trace tender → obligation, and the tender documents + audit trail sit in the sidebar. No comms — an imported reference record, not a conversation.",
				"register": "shillinq",
				"schema": "TenderNedAanbesteding",
				"aggregations": [
					{"id": "contractValue", "title": "Contract value", "field": "contractWaarde", "metric": "value", "format": "currency"}
				],
				"fields": [
					{ "key": "aanbestedingId", "label": "Tender", "type": "string" },
					{ "key": "tenderNedUrl", "label": "TenderNed file", "type": "string" },
					{ "key": "titel", "label": "Title", "type": "string" },
					{ "key": "beschrijving", "label": "Description", "type": "string" },
					{ "key": "cpvCodes", "label": "CPV codes", "type": "array" },
					{ "key": "aanbestedendeDienst", "label": "Contracting authority", "type": "string" },
					{ "key": "gunningsDatum", "label": "Award date", "type": "string" },
					{ "key": "contractWaarde", "label": "Contract value", "type": "number" },
					{ "key": "looptijdStart", "label": "Term start", "type": "string" },
					{ "key": "looptijdEind", "label": "Term end", "type": "string" },
					{ "key": "gegundeLeverancier", "label": "Awarded supplier", "type": "string" },
					{ "key": "opdrachttype", "label": "Contract type", "type": "string" },
					{ "key": "verplichtingId", "label": "Commitment", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" }
				],
				"relatedLists": [
					{"id": "commitment", "title": "Linked commitment", "schema": "Verplichting", "foreignKey": "id", "join": "verplichtingId", "columns": [
						{"key": "verplichtingNummer", "label": "Number"},
						{"key": "bedrag", "label": "Amount"},
						{"key": "status", "label": "Status"}
					], "detailRoute": "VerplichtingDetail"}
				],
				"auditTrail": true,
				"sidebarProps": {
					"tabs": [
						{"id": "documents", "label": "Tender documents", "icon": "FileDocumentOutline", "order": 80, "widgets": [
							{"type": "data", "componentName": "openregister-file-references", "props": {"register": "shillinq", "schema": "TenderNedAanbesteding", "objectId": ":id"}}
						]},
						{"id": "audit", "label": "Audit Trail", "icon": "HistoryIcon", "order": 90, "widgets": [
							{"type": "data", "componentName": "openregister-audit-trail", "props": {"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true}}
						]}
					]
				}
			}
		},
		{
			"id": "Verplichtingen",
			"route": "/inkoop/verplichtingen",
			"type": "index",
			"title": "Commitments",
			"config": {
				"register": "shillinq",
				"schema": "Verplichting",
				"columns": [
					{ "key": "verplichtingNummer", "label": "Number", "sortable": true },
					{ "key": "omschrijving", "label": "Description", "sortable": true },
					{ "key": "bron", "label": "Source", "sortable": true },
					{ "key": "bedrag", "label": "Amount", "sortable": true },
					{ "key": "kostenplaats", "label": "Cost center", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "verplichtingNummer",
				"detailRoute": "VerplichtingDetail"
			}
		},
		{
			"id": "VerplichtingDetail",
			"route": "/inkoop/verplichtingen/:id",
			"type": "detail",
			"title": "Commitment",
			"config": {
				"_note": "A commitment (verplichting) is a FINANCIAL obligation booked against a cost centre and GL account, sourced from a tender or a contract, carrying a term and a milestone schedule (mijlpalen). Body leads with the obligation data and a committed-amount KPI; the tender(s) that generated it are listed as related so the amount is traceable to its award, and contract documents + audit trail sit in the sidebar. No comms — an obligation ledger record.",
				"register": "shillinq",
				"schema": "Verplichting",
				"aggregations": [
					{"id": "committedAmount", "title": "Committed amount", "field": "bedrag", "metric": "value", "format": "currency"}
				],
				"fields": [
					{ "key": "verplichtingNummer", "label": "Number", "type": "string" },
					{ "key": "omschrijving", "label": "Description", "type": "string" },
					{ "key": "bron", "label": "Source", "type": "string" },
					{ "key": "bronReferentie", "label": "TenderNed reference", "type": "string" },
					{ "key": "bedrag", "label": "Amount", "type": "number" },
					{ "key": "kostenplaats", "label": "Cost center", "type": "string" },
					{ "key": "grootboekrekening", "label": "GL account", "type": "string" },
					{ "key": "gegundeLeverancierKvk", "label": "Supplier KvK", "type": "string" },
					{ "key": "looptijdStart", "label": "Term start", "type": "string" },
					{ "key": "looptijdEind", "label": "Term end", "type": "string" },
					{ "key": "mijlpalen", "label": "Milestones", "type": "array" },
					{ "key": "status", "label": "Status", "type": "string" }
				],
				"relatedLists": [
					{"id": "tenders", "title": "Source tenders", "schema": "TenderNedAanbesteding", "foreignKey": "verplichtingId", "join": "verplichtingId", "columns": [
						{"key": "titel", "label": "Tender"},
						{"key": "gegundeLeverancier", "label": "Supplier"},
						{"key": "contractWaarde", "label": "Contract value"}
					], "detailRoute": "TenderNedAanbestedingDetail"}
				],
				"auditTrail": true,
				"sidebarProps": {
					"tabs": [
						{"id": "documents", "label": "Documents", "icon": "FileDocumentOutline", "order": 80, "widgets": [
							{"type": "data", "componentName": "openregister-file-references", "props": {"register": "shillinq", "schema": "Verplichting", "objectId": ":id"}}
						]},
						{"id": "audit", "label": "Audit Trail", "icon": "HistoryIcon", "order": 90, "widgets": [
							{"type": "data", "componentName": "openregister-audit-trail", "props": {"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true}}
						]}
					]
				}
			}
		},
		{
			"id": "MijnContracten",
			"route": "/inkoop/mijn-contracten",
			"type": "index",
			"title": "My contracts",
			"config": {
				"register": "shillinq",
				"schema": "Verplichting",
				"filters": {
					"bron": "tenderned"
				},
				"columns": [
					{ "key": "verplichtingNummer", "label": "Number", "sortable": true },
					{ "key": "omschrijving", "label": "Description", "sortable": true },
					{ "key": "bedrag", "label": "Contract value", "sortable": true },
					{ "key": "looptijdStart", "label": "Term start", "sortable": true },
					{ "key": "looptijdEind", "label": "Term end", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true }
				],
				"defaultSort": "looptijdStart",
				"detailRoute": "VerplichtingDetail"
			}
		}
	]
}
