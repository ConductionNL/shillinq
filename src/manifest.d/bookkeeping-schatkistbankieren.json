				"register": "shillinq",
				"schema": "TreasuryAccount",
				"fields": [
					{ "key": "accountNumber", "label": "Account #", "type": "string" },
					{ "key": "iban", "label": "IBAN", "type": "string" },
					{ "key": "bic", "label": "BIC", "type": "string" },
