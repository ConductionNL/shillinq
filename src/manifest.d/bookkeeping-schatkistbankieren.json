				"relatedObjects": [
					{
						"id": "compliance-reports",
						"label": "Compliance reports",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "ComplianceReport",
							"filterField": "treasuryAccountId",
							"columns": ["reportNumber", "reportPeriod", "complianceScore", "status", "generatedAt"],
							"detailRoute": "ComplianceReportDetail",
							"defaultSort": "generatedAt"
						}
					}
				],
				"sidebarProps": {
					"tabs": [
