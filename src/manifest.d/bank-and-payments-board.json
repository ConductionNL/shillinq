{
	"_meta": {
		"spdx-license": "EUPL-1.2",
		"spdx-copyright": "2026 Conduction B.V.",
		"change": "screens-bank-board",
		"adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
		"description": "Board ShBank: the Bank and payments page. The cash position and the counts of accounts, statements and unmatched bank lines, then a view switch over the accounts with their balances, the imported statements, the lines still waiting for a match and the exchange rates. The board navigation's Bank and payments entry opens it; the Banking & Cashflow cluster landing page keeps its own route and menu group."
	},
	"menu": [],
	"pages": [
		{
			"id": "BankAndPayments",
			"route": "/bank",
			"type": "dashboard",
			"title": "Bank and payments",
			"config": {
				"description": "Your accounts, statements and the bank lines still waiting for a match",
				"documentationUrl": "https://shillinq.conduction.nl/guides/import-bank-statements",
				"_boardNote": "Board ShBank. The four account cards read balances the register does not hold on an account (BankAccount has no balance): the Accounts view takes them from /api/v1/cash-position, the ledger balance per account and the closing balance of its latest statement. The Not matched view is the list of UnmatchedBankLines; matching by hand stays on that page's row menu, linked from the tab. The board's tab strip is the page's view switch: a `tabs` widget on a dashboard page finds no child widgets (CnDashboardPage hands it no availableWidgets), so each tab is a view with one table.",
				"headerActions": [
					{
						"id": "import-statement",
						"label": "Import statement",
						"type": "open-modal",
						"target": "BankStatementWizard",
						"icon": "BankTransferIn",
						"props": {
							"open": true
						}
					},
					{
						"id": "connect-bank",
						"label": "Connect a bank",
						"handler": "openIntegriqConnections",
						"icon": "Plus",
						"variant": "primary"
					}
				],
				"viewLinks": [
					{
						"label": "Payment runs",
						"route": "PaymentRuns"
					},
					{
						"label": "Reconciliations",
						"route": "Reconciliations"
					}
				],
				"kpiRow": [
					"cash-position",
					"accounts-count",
					"statements-count",
					"unmatched-count"
				],
				"widgets": [
					{
						"id": "cash-position",
						"title": "Cash position",
						"type": "stat",
						"content": {
							"label": "Cash position",
							"caption": "all accounts together",
							"icon": "Cash",
							"format": {
								"style": "currency",
								"currency": "EUR",
								"decimals": 2
							},
							"endpointSource": {
								"url": "/apps/shillinq/api/v1/cash-position"
							},
							"valueField": "total"
						}
					},
					{
						"id": "accounts-count",
						"title": "Accounts",
						"type": "stat",
						"content": {
							"label": "Accounts",
							"icon": "BankOutline",
							"source": {
								"register": "shillinq",
								"schema": "BankAccount",
								"metric": "count"
							},
							"clickRoute": "BankAccounts"
						}
					},
					{
						"id": "statements-count",
						"title": "Statements",
						"type": "stat",
						"content": {
							"label": "Statements",
							"icon": "FileDocumentOutline",
							"source": {
								"register": "shillinq",
								"schema": "BankStatement",
								"metric": "count"
							},
							"clickRoute": "BankReconciliation"
						}
					},
					{
						"id": "unmatched-count",
						"title": "Not matched",
						"type": "stat",
						"content": {
							"label": "Not matched",
							"icon": "LinkVariant",
							"source": {
								"register": "shillinq",
								"schema": "BankStatementLine",
								"metric": "count",
								"filter": {
									"status": "unmatched"
								}
							},
							"variantWhen": [
								{
									"op": "gt",
									"value": 0,
									"variant": "warning"
								}
							],
							"clickRoute": "UnmatchedBankLines"
						}
					}
				],
				"layout": [],
				"views": [
					{
						"id": "accounts",
						"label": "Accounts",
						"widgets": [
							{
								"id": "bank-accounts",
								"title": "Accounts",
								"type": "object-table",
								"content": {
									"endpointSource": {
										"url": "/apps/shillinq/api/v1/cash-position",
										"responsePath": "accounts"
									},
									"emptyText": "No bank accounts yet. Connect a bank or add an account.",
									"columns": [
										{
											"key": "accountName",
											"label": "Account"
										},
										{
											"key": "iban",
											"label": "IBAN"
										},
										{
											"key": "ledgerBalance",
											"label": "Ledger balance",
											"formatter": "currency",
											"formatterOptions": {
												"currency": "EUR",
												"decimals": 2
											}
										},
										{
											"key": "bankBalance",
											"label": "Bank balance",
											"formatter": "currency",
											"formatterOptions": {
												"currency": "EUR",
												"decimals": 2
											}
										},
										{
											"key": "bankBalanceDate",
											"label": "Last statement"
										}
									]
								},
								"headerLink": {
									"label": "All accounts",
									"route": "BankAccounts"
								}
							}
						],
						"layout": [
							{
								"id": "layout-bank-accounts",
								"widgetId": "bank-accounts",
								"gridX": 0,
								"gridY": 0,
								"gridWidth": 12,
								"gridHeight": 6
							}
						]
					},
					{
						"id": "statements",
						"label": "Statements",
						"widgets": [
							{
								"id": "bank-statements",
								"title": "Statements",
								"type": "object-table",
								"content": {
									"source": {
										"register": "shillinq",
										"schema": "BankStatement",
										"order": {
											"periodEnd": "desc"
										},
										"limit": 10
									},
									"rowRoute": "BankReconciliationDetail",
									"emptyText": "No statements imported yet",
									"columns": [
										{
											"key": "bankAccountIban",
											"label": "IBAN"
										},
										{
											"key": "periodStart",
											"label": "From"
										},
										{
											"key": "periodEnd",
											"label": "To"
										},
										{
											"key": "closingBalance",
											"label": "Closing balance",
											"formatter": "currency",
											"formatterOptions": {
												"currency": "EUR",
												"decimals": 2
											}
										},
										{
											"key": "transactionCount",
											"label": "Lines"
										},
										{
											"key": "importFormat",
											"label": "Format"
										}
									]
								}
							}
						],
						"layout": [
							{
								"id": "layout-bank-statements",
								"widgetId": "bank-statements",
								"gridX": 0,
								"gridY": 0,
								"gridWidth": 12,
								"gridHeight": 6
							}
						]
					},
					{
						"id": "unmatched",
						"label": "Not matched",
						"widgets": [
							{
								"id": "bank-unmatched",
								"title": "Not matched",
								"type": "object-table",
								"content": {
									"source": {
										"register": "shillinq",
										"schema": "BankStatementLine",
										"filter": {
											"status": "unmatched"
										},
										"order": {
											"valueDate": "desc"
										},
										"limit": 10
									},
									"emptyText": "Every bank line is matched",
									"columns": [
										{
											"key": "valueDate",
											"label": "Date"
										},
										{
											"key": "counterpartyName",
											"label": "Counterparty"
										},
										{
											"key": "remittanceInfo",
											"label": "Description"
										},
										{
											"key": "amount",
											"label": "Amount",
											"formatter": "currency",
											"formatterOptions": {
												"currency": "EUR",
												"decimals": 2
											}
										}
									]
								},
								"headerLink": {
									"label": "Match by hand",
									"route": "UnmatchedBankLines"
								}
							}
						],
						"layout": [
							{
								"id": "layout-bank-unmatched",
								"widgetId": "bank-unmatched",
								"gridX": 0,
								"gridY": 0,
								"gridWidth": 12,
								"gridHeight": 6
							}
						]
					},
					{
						"id": "fx-rates",
						"label": "Exchange rates",
						"widgets": [
							{
								"id": "bank-fx-rates",
								"title": "Exchange rates",
								"type": "object-table",
								"content": {
									"source": {
										"register": "shillinq",
										"schema": "FxRate",
										"order": {
											"date": "desc"
										},
										"limit": 10
									},
									"rowRoute": "FXRateDetail",
									"emptyText": "No exchange rates yet",
									"columns": [
										{
											"key": "date",
											"label": "Date"
										},
										{
											"key": "transactionCurrency",
											"label": "From currency"
										},
										{
											"key": "baseCurrency",
											"label": "To currency"
										},
										{
											"key": "rate",
											"label": "Rate"
										},
										{
											"key": "source",
											"label": "Source"
										}
									]
								}
							}
						],
						"layout": [
							{
								"id": "layout-bank-fx-rates",
								"widgetId": "bank-fx-rates",
								"gridX": 0,
								"gridY": 0,
								"gridWidth": 12,
								"gridHeight": 6
							}
						]
					}
				]
			}
		}
	]
}
