{
    "_meta": {
        "spdx-license": "EUPL-1.2",
        "spdx-copyright": "2026 Conduction B.V.",
        "change": "recurring-invoicing",
        "adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
        "description": "Recurring Invoicing (Periodieke Facturen) — navigation + index/detail pages for RecurringInvoiceProfile, plus the create/edit modal launched from the index. Generated invoices are ordinary ARInvoice records; the detail page lists them via the recurringProfileId provenance filter (REQ-RIN-008)."
    },
    "menu": [
        {
            "id": "RecurringInvoicing",
            "label": "Recurring Invoices",
            "icon": "ReceiptTextOutline",
            "route": "RecurringInvoiceProfiles",
            "order": 46
        }
    ],
    "pages": [
        {
            "id": "RecurringInvoiceProfiles",
            "route": "/bookkeeping/recurring-invoices",
            "type": "index",
            "title": "Recurring Invoices",
            "config": {
                "register": "shillinq",
                "schema": "RecurringInvoiceProfile",
                "columns": [
                    {
                        "key": "name",
                        "label": "Profile",
                        "sortable": true
                    },
                    {
                        "key": "customerReference",
                        "label": "Customer",
                        "sortable": true
                    },
                    {
                        "key": "frequency",
                        "label": "Frequency",
                        "sortable": true
                    },
                    {
                        "key": "nextRunDate",
                        "label": "Next run",
                        "sortable": true
                    },
                    {
                        "key": "perPeriodNetAmount",
                        "label": "Per period (net)",
                        "sortable": false
                    },
                    {
                        "key": "status",
                        "label": "Status",
                        "sortable": true
                    }
                ],
                "defaultSort": "nextRunDate",
                "detailRoute": "RecurringInvoiceProfileDetail",
                "_note_headerActions": "`headerActions`, NOT `actions`. CnPageRenderer forwards config.actions[] to CnIndexPage's `actions` prop, which its own docblock defines as ROW action definitions — they render in CnRowActions, one per row. On an empty profile list there are zero rows, so the ONLY affordance for creating the first recurring profile did not exist at all. `headerActions[]` at least surfaces it, in the actions overflow (CnActionsBar renders each entry as an NcActionButton in the ⋯ menu).",
                "_note_open_modal_gap": "KNOWN GAP, deliberately not papered over. The `type: \"open-modal\" / target / props` dispatcher vocabulary works on CnDashboardPage and CnDetailPage (which render actions through CnActionButtons — see the Dashboard page's `create-invoice` and PaymentRunDetail) but NOT on CnIndexPage: its `headerActions[]` contract is `{id, label, icon?, handler?, route?, disabled?}` and clicking an entry only EMITS `header-action`, which CnPageRenderer does not listen for. @conduction/nextcloud-vue 2.2.0-vue3.2 also ships no `actions` widget type for the page-level `header-actions` widget slot (builtInWidgets.js: banner|data|divider|header|integration|metadata|related|text). So there is currently NO declarative way to launch a registry modal from a visible page-level button on an index page, and RecurringInvoiceProfileModal is therefore unreachable through the UI. tests/e2e/recurring-invoicing.spec.ts stays RED on this on purpose — the assertion is correct and the product is not. Fixing it needs either an `open-modal` handler keyword on CnIndexPage upstream, or turning this page into a kind:page host that renders CnIndexPage plus the modal itself (the pattern src/views/bookings/CalendarPage.vue uses).",
                "headerActions": [
                    {
                        "id": "new-recurring-profile",
                        "label": "New recurring profile",
                        "icon": "CalendarSync",
                        "description": "Define a new recurring billing profile: customer, lines with period tokens, frequency, invoice day, issue mode and payment terms."
                    }
                ],
                "documentationUrl": "https://shillinq.conduction.nl/guides/recurring-invoices"
            }
        },
        {
            "id": "RecurringInvoiceProfileDetail",
            "route": "/bookkeeping/recurring-invoices/:id",
            "type": "detail",
            "title": "Recurring Invoice Profile",
            "config": {
                "register": "shillinq",
                "schema": "RecurringInvoiceProfile",
                "_note": "MASTER billing-profile archetype — the template that mints periodic AR invoices. Body leads with a schema-driven Data widget (schedule mechanics: customer, frequency/interval, invoice day, next-run, last-billed period, plus the issue/delivery/payment-terms + indexation policy and lastRunStatus for inline failure visibility) beside a Related panel; the full-width child list is the actual generated invoices (ARInvoice filtered recurringProfileId=@objectId, rowRoute ARInvoiceDetail) as provenance evidence, with a KPI strip of generated-invoice count and total billed. A profile schedules billing, it does not correspond — no comms leaves. Audit trail moves to the sidebar per policy.",
                "indexRoute": "RecurringInvoiceProfiles",
                "widgets": [
                    {
                        "id": "profile-schedule",
                        "type": "data",
                        "title": "Identity & schedule",
                        "icon": "Calendar",
                        "content": {
                            "columns": 2,
                            "include": [
                                "name",
                                "customerReference",
                                "frequency",
                                "interval",
                                "startDate",
                                "endCondition",
                                "invoiceDay",
                                "nextRunDate",
                                "lastBillingPeriod",
                                "remainingOccurrences",
                                "status"
                            ]
                        }
                    },
                    {
                        "id": "profile-stats",
                        "type": "stats-block",
                        "title": "Generation position",
                        "icon": "ChartBar",
                        "content": {
                            "entries": [
                                { "title": "Invoices generated", "register": "shillinq", "schema": "ARInvoice", "metric": "count", "filter": { "recurringProfileId": "@objectId" }, "route": "AccountsReceivable" },
                                { "title": "Total billed", "register": "shillinq", "schema": "ARInvoice", "metric": "sum", "field": "grossAmount", "filter": { "recurringProfileId": "@objectId" }, "format": "currency" }
                            ]
                        }
                    },
                    {
                        "id": "profile-billing",
                        "type": "data",
                        "title": "Billing & delivery",
                        "icon": "Cash",
                        "content": {
                            "columns": 2,
                            "include": [
                                "issueMode",
                                "deliveryChannel",
                                "paymentTermsDays",
                                "indexationPercent",
                                "sepaCollection",
                                "contractReference",
                                "currency",
                                "administrationId",
                                "lastRunStatus",
                                "lastRunError"
                            ]
                        }
                    },
                    {
                        "id": "profile-related",
                        "type": "related",
                        "title": "Links",
                        "icon": "LinkVariant"
                    },
                    {
                        "id": "profile-invoices",
                        "type": "object-list",
                        "title": "Generated invoices",
                        "icon": "FileDocument",
                        "content": {
                            "register": "shillinq",
                            "schema": "ARInvoice",
                            "filter": { "recurringProfileId": "@objectId" },
                            "sort": { "field": "invoiceDate", "dir": "desc" },
                            "limit": 20,
                            "columns": [
                                { "key": "invoiceNumber", "label": "Invoice #" },
                                { "key": "invoiceDate", "label": "Date" },
                                { "key": "grossAmount", "label": "Total (EUR)" },
                                { "key": "lifecycleState", "label": "Status" }
                            ],
                            "rowRoute": "ARInvoiceDetail",
                            "viewAllRoute": "AccountsReceivable",
                            "viewAllQuery": { "recurringProfileId": "@objectId" },
                            "emptyText": "No invoices generated yet from this profile.",
                            "allowCreate": false
                        }
                    }
                ],
                "layout": [
                    { "id": "1", "widgetId": "profile-schedule", "gridX": 0, "gridY": 0, "gridWidth": 8, "gridHeight": 6 },
                    { "id": "2", "widgetId": "profile-stats", "gridX": 8, "gridY": 0, "gridWidth": 4, "gridHeight": 6 },
                    { "id": "3", "widgetId": "profile-billing", "gridX": 0, "gridY": 6, "gridWidth": 8, "gridHeight": 5 },
                    { "id": "4", "widgetId": "profile-related", "gridX": 8, "gridY": 6, "gridWidth": 4, "gridHeight": 5 },
                    { "id": "5", "widgetId": "profile-invoices", "gridX": 0, "gridY": 11, "gridWidth": 12, "gridHeight": 5 }
                ],
                "lifecycleActions": true,
                "sidebar": {
                    "enabled": true,
                    "showMetadata": true,
                    "tabs": [
                        { "id": "audit", "label": "History", "icon": "History", "widgets": [ { "type": "audit" } ] }
                    ]
                }
            }
        }
    ]
}
