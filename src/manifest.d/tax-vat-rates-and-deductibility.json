{
  "_meta": {
    "spdx-license": "EUPL-1.2",
    "spdx-copyright": "2026 Conduction B.V.",
    "change": "tax-vat-rates-and-deductibility",
    "adr": "ADR-037 modular manifest fragment, never edit src/manifest.json",
    "description": "VAT tariff pages under Taxes (REQ-TVRD-001): VatTariffs lists the tariffs with their dates, VatTariffDetail shows one; the seeded statutory tariffs are read-only (VatTariffStatutoryLockListener refuses a person's change), an added tariff is the administrator's own. The deductible percentage and private-share account on the account detail page (REQ-TVRD-003). mergePages() replaces a page wholesale by id, so ChartOfAccountsDetail is a full copy of src/manifest.json with the two fields added after VAT Applicable: re-sync if the base page changes."
  },
  "pages": [
    {
      "id": "VatTariffs",
      "route": "/belastingen/btw-tarieven",
      "type": "index",
      "title": "VAT rates",
      "config": {
        "register": "shillinq",
        "schema": "VatTariff",
        "columns": [
          {
            "key": "code",
            "label": "Code",
            "sortable": true,
            "secondary": "{label}"
          },
          {
            "key": "ratePercentage",
            "label": "Rate (%)",
            "sortable": true
          },
          {
            "key": "section",
            "label": "Return box",
            "sortable": true
          },
          {
            "key": "effectiveFrom",
            "label": "Valid from",
            "sortable": true
          },
          {
            "key": "effectiveTo",
            "label": "Valid until",
            "sortable": true
          },
          {
            "key": "statutory",
            "label": "Statutory",
            "sortable": true
          }
        ],
        "defaultSort": "code",
        "detailRoute": "VatTariffDetail",
        "quickFilters": [
          {
            "label": "All rates",
            "filter": {},
            "default": true,
            "showCount": true
          },
          {
            "label": "Statutory",
            "filter": {
              "statutory": true
            },
            "showCount": true
          }
        ],
        "headerButtons": [
          {
            "action": "export"
          },
          {
            "action": "add",
            "variant": "primary",
            "label": "New VAT rate"
          }
        ],
        "documentationUrl": "https://shillinq.conduction.nl/user-guide/taxes/vat"
      }
    },
    {
      "id": "VatTariffDetail",
      "route": "/belastingen/btw-tarieven/:id",
      "type": "detail",
      "title": "VAT rate",
      "config": {
        "register": "shillinq",
        "schema": "VatTariff",
        "auditTrail": true,
        "_note": "One VAT tariff with its rate, return box and validity dates. A statutory tariff is the rate the law sets: a person's change to it is refused on the server (REQ-TVRD-001); add a tariff with its own code and dates instead.",
        "fields": [
          {
            "key": "code",
            "label": "Code",
            "type": "string"
          },
          {
            "key": "label",
            "label": "Name",
            "type": "string"
          },
          {
            "key": "ratePercentage",
            "label": "Rate (%)",
            "type": "number"
          },
          {
            "key": "category",
            "label": "Category",
            "type": "string"
          },
          {
            "key": "section",
            "label": "Return box",
            "type": "string"
          },
          {
            "key": "reverseCharge",
            "label": "Reverse charge",
            "type": "boolean"
          },
          {
            "key": "effectiveFrom",
            "label": "Valid from",
            "type": "date"
          },
          {
            "key": "effectiveTo",
            "label": "Valid until",
            "type": "date"
          },
          {
            "key": "legalBasis",
            "label": "Legal basis",
            "type": "string"
          },
          {
            "key": "rgsAccountHint",
            "label": "Suggested account (RGS)",
            "type": "string"
          },
          {
            "key": "statutory",
            "label": "Statutory",
            "type": "boolean",
            "readOnly": true
          },
          {
            "key": "description",
            "label": "Description",
            "type": "string"
          }
        ],
        "indexRoute": "VatTariffs",
        "sidebarProps": {
          "tabs": [
            {
              "id": "audit",
              "label": "Audit Trail",
              "icon": "History",
              "order": 90,
              "widgets": [
                {
                  "type": "data",
                  "componentName": "openregister-audit-trail",
                  "props": {
                    "source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
                    "collapsed": true
                  }
                }
              ]
            }
          ]
        },
        "documentationUrl": "https://shillinq.conduction.nl/user-guide/taxes/vat"
      }
    },
    {
      "id": "ChartOfAccountsDetail",
      "route": "/chart-of-accounts/:id",
      "type": "detail",
      "title": "Account",
      "config": {
        "register": "shillinq",
        "_note": "General-ledger account detail — a single Chart-of-Accounts line (number, type, VAT/Vpb flags, BBV variant, retention). GL posting lines list every movement booked to this account; audit trail evidences master-data changes for ledger integrity. tax-vat-rates-and-deductibility overlays this page from its own fragment to add the deductible percentage and the private-share account (REQ-TVRD-003).",
        "relatedCollections": [
          {
            "title": "GL postings",
            "register": "shillinq",
            "schema": "GLLine",
            "filter": {
              "accountNumber": "@object.accountNumber"
            },
            "columns": [
              {
                "key": "transactionId",
                "label": "Transaction"
              },
              {
                "key": "side",
                "label": "D/C"
              },
              {
                "key": "amount",
                "label": "Amount (EUR)"
              },
              {
                "key": "periodId",
                "label": "Period"
              },
              {
                "key": "description",
                "label": "Description"
              }
            ]
          }
        ],
        "aggregation": "accountBalance",
        "auditTrail": true,
        "schema": "Account",
        "fields": [
          {
            "key": "accountNumber",
            "label": "Account Number",
            "type": "string"
          },
          {
            "key": "name",
            "label": "Name",
            "type": "string"
          },
          {
            "key": "accountType",
            "label": "Account Type",
            "type": "string"
          },
          {
            "key": "currency",
            "label": "Currency",
            "type": "string"
          },
          {
            "key": "parentAccountNumber",
            "label": "Parent Account",
            "type": "string"
          },
          {
            "key": "administrationId",
            "label": "Administration",
            "type": "string"
          },
          {
            "key": "lifecycleState",
            "label": "Status",
            "type": "string"
          },
          {
            "key": "isClosingAccount",
            "label": "Closing Account",
            "type": "boolean"
          },
          {
            "key": "vatApplicable",
            "label": "VAT Applicable",
            "type": "boolean"
          },
          {
            "key": "deductiblePercentage",
            "label": "Deductible percentage",
            "type": "number"
          },
          {
            "key": "privateShareAccountNumber",
            "label": "Private-share account",
            "type": "string"
          },
          {
            "key": "description",
            "label": "Description",
            "type": "string"
          }
        ],
        "lifecycleActions": true,
        "indexRoute": "ChartOfAccounts",
        "sidebarProps": {
          "tabs": [
            {
              "id": "trend",
              "label": "Trend",
              "icon": "ChartLine",
              "order": 95,
              "widgets": [
                {
                  "type": "BudgetTrendChart",
                  "props": {
                    "scope": "account"
                  }
                }
              ]
            },
            {
              "id": "audit",
              "label": "Audit Trail",
              "icon": "History",
              "order": 90,
              "widgets": [
                {
                  "type": "data",
                  "componentName": "openregister-audit-trail",
                  "props": {
                    "source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
                    "collapsed": true
                  }
                }
              ]
            }
          ]
        },
        "documentationUrl": "https://shillinq.conduction.nl/user-guide/bookkeeping/chart-of-accounts"
      }
    }
  ],
  "menu": [
    {
      "id": "VatTariffs",
      "label": "VAT rates",
      "icon": "PercentOutline",
      "route": "VatTariffs",
      "order": 46
    }
  ]
}
