			"route": "/dba/portfolio/:id",
			"type": "detail",
			"title": "DBA Portfolio Risk",
			"config": {
				"_note": "DBA portfolio risk is a company-level REPORT: a dated snapshot of concentration, long-standing and exclusive relations, and the overall portfolio risk band across all DBA engagements of one company. Body leads with the snapshot data + KPIs (active engagements, exclusive relations), then lists the underlying assignments (DBAOpdracht for the same company) so the risk score is traceable to individual engagements. No comms; audit trail in a sidebar tab.",
				"register": "shillinq",
				"schema": "DBAPortfolioRisico",
				"aggregations": [
					{"id": "activeEngagements", "title": "Active engagements", "field": "activeAssignments", "metric": "value"},
					{"id": "exclusiveRelations", "title": "Exclusive relations", "field": "exclusiveRelationships", "metric": "value"}
				],
				"fields": [
					{"key": "enterpriseId", "label": "Company", "type": "string"},
					{"key": "levelDate", "label": "Reference date", "type": "string"},
					{"key": "activeAssignments", "label": "Active engagements", "type": "number"},
					{"key": "exclusiveRelationships", "label": "Exclusive relations", "type": "number"},
					{"key": "overallRisk", "label": "Portfolio risk", "type": "string"}
				],
				"relatedLists": [
					{"id": "engagements", "title": "Engagements in this portfolio", "schema": "DBAOpdracht", "foreignKey": "enterpriseId", "join": "enterpriseId", "columns": [
						{"key": "assignmentName", "label": "Assignment"},
						{"key": "customerId", "label": "Client"},
						{"key": "riskLevel", "label": "Risk band"},
						{"key": "openFlags", "label": "Open flags"}
