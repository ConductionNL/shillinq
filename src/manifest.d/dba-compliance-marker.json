		{
			"id": "DBAIntakeDetail",
			"route": "/dba/intakes/:id",
			"type": "detail",
			"title": "DBA Intake",
			"config": {
				"_note": "DBA intake is a scored assessment REPORT (gezag / persoonlijke arbeid / financieel risico / Deliveroo criteria) that produces the total risk score and interpretation for one assignment. Body leads with the score fields; KPI surfaces the total score and max, and the parent assignment is linked so the assessor can jump back to the engagement. No comms — a compliance record; audit trail in a sidebar tab.",
				"register": "shillinq",
				"schema": "DBAIntake",
				"aggregations": [
					{"id": "totalScore", "title": "Total score", "field": "totalScore", "metric": "value"},
					{"id": "maxScore", "title": "Max score", "field": "maxScore", "metric": "value"}
				],
				"fields": [
					{"key": "assignmentId", "label": "Assignment", "type": "string"},
					{"key": "filledOn", "label": "Filled in", "type": "string"},
					{"key": "gezagSubtotaal", "label": "Authority/control", "type": "number"},
					{"key": "arbeidSubtotaal", "label": "Personal service", "type": "number"},
					{"key": "financieelSubtotaal", "label": "Financial risk", "type": "number"},
					{"key": "deliverooSubtotaal", "label": "Deliveroo criteria", "type": "number"},
					{"key": "totalScore", "label": "Total score", "type": "number"},
					{"key": "interpretatie", "label": "Risk band", "type": "string"},
					{"key": "state", "label": "State", "type": "string"}
				],
				"relatedLists": [
					{"id": "flags", "title": "Risk flags on this assignment", "schema": "DBARisicoflag", "foreignKey": "assignmentId", "join": "assignmentId", "columns": [
						{"key": "type", "label": "Flag type"},
						{"key": "ernst", "label": "Severity"},
						{"key": "status", "label": "Status"}
					], "detailRoute": "DBARisicoflagDetail"}
				],
				"auditTrail": true,
				"indexRoute": "DBAIntakes",
				"sidebarProps": {
					"tabs": [
						{"id": "audit", "label": "Audit Trail", "icon": "History", "order": 90, "widgets": [
							{"type": "data", "componentName": "openregister-audit-trail", "props": {"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true}}
