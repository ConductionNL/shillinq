		{
			"id": "DBAEvidenceDossierDetail",
			"route": "/dba/evidence/:id",
			"type": "detail",
			"title": "Evidence Dossier",
			"config": {
				"_note": "Evidence dossier is the DOCUMENT store backing a DBA assignment: a bundle of supporting stukken with a completeness score, retention term and delete-eligible date. The attached documents are the point of the record, so Documents leads the sidebar; completeness is surfaced as a KPI. No comms — the email-archive opt-in here is a consent FLAG, not a live mailbox. Audit trail in a sidebar tab for retention defensibility.",
				"register": "shillinq",
				"schema": "DBAEvidenceDossier",
				"aggregations": [
					{"id": "completeness", "title": "Completeness score", "field": "completenessScore", "metric": "value", "format": "percent"}
				],
				"fields": [
					{"key": "assignmentId", "label": "Assignment", "type": "string"},
					{"key": "emailArchiveOptIn", "label": "Email archive opt-in", "type": "boolean"},
					{"key": "compleetheidScore", "label": "Completeness", "type": "number"},
					{"key": "retentionTerm", "label": "Retention period", "type": "string"},
					{"key": "archiveDate", "label": "Delete-eligible date", "type": "string"}
				],
				"auditTrail": true,
				"indexRoute": "DBAEvidenceDossiers",
				"sidebarProps": {
					"tabs": [
