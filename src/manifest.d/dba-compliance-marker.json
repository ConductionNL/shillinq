			"type": "detail",
			"title": "Risk Flag",
			"config": {
				"_note": "Risk flag is a single detected DBA-risk signal against an assignment — its type, severity, detection moment, legal basis (fiscaleBron), suggested action and resolution memo. A compact alert record: the body shows the flag detail and resolution, with a link back to the parent assignment. No comms; the audit trail sidebar tab records who acknowledged/resolved the flag.",
				"register": "shillinq",
				"schema": "DBARisicoflag",
				"fields": [
					{"key": "assignmentId", "label": "Assignment", "type": "string"},
					{"key": "type", "label": "Flag type", "type": "string"},
					{"key": "ernst", "label": "Severity", "type": "string"},
					{"key": "detectieMoment", "label": "Detected", "type": "string"},
					{"key": "fiscalSource", "label": "Legal basis", "type": "string"},
					{"key": "actionSuggestion", "label": "Suggested action", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "resolutieMemo", "label": "Resolution memo", "type": "string"}
				],
				"auditTrail": true,
				"indexRoute": "DBARisicoflags",
