	"pages": [
		{
			"id": "DBAOpdrachten",
			"route": "/dba/opdrachten",
			"type": "index",
			"title": "DBA assignments",
			"config": {
				"register": "shillinq",
				"schema": "DBAOpdracht",
				"columns": [
					{"key": "assignmentName", "label": "Assignment", "sortable": true},
					{"key": "customerId", "label": "Client", "sortable": true},
					{"key": "startDate", "label": "Start", "sortable": true},
					{"key": "actueleRisicoscore", "label": "Risk score", "sortable": true},
					{"key": "riskLevel", "label": "Risk band", "sortable": true},
					{"key": "openFlags", "label": "Open flags", "sortable": true},
					{"key": "state", "label": "State", "sortable": true}
				],
				"defaultSort": "startDate",
				"detailRoute": "DBAOpdrachtDetail"
			}
		},
		{
			"id": "DBAOpdrachtDetail",
			"route": "/dba/opdrachten/:id",
			"type": "detail",
			"title": "DBA assignment",
			"config": {
				"_note": "DBA assignment (opdracht) is the MASTER engagement record of the DBA-compliance dossier: it anchors intake scoring, the evidence dossier and every risk flag raised against this client relationship. Body leads with assignment/client data plus revenue KPIs (expected vs realised) and open-flag count, then the three FK child collections (intakes, evidence dossiers, risk flags on opdrachtId) so the whole compliance chain is visible in one place. No email/calendar — a compliance/ledger record, not a comms surface; the immutable audit trail sits in a sidebar tab alongside dossier documents.",
				"register": "shillinq",
				"schema": "DBAOpdracht",
				"aggregations": [
					{"id": "expectedRevenue", "title": "Expected revenue", "field": "expectedRevenue", "metric": "value", "format": "currency"},
					{"id": "realisedRevenue", "title": "Realised revenue", "field": "realisedRevenue", "metric": "value", "format": "currency"},
					{"id": "openFlags", "title": "Open risk flags", "field": "openFlags", "metric": "value"}
				],
				"fields": [
					{"key": "assignmentName", "label": "Assignment", "type": "string"},
					{"key": "enterpriseId", "label": "Company", "type": "string"},
					{"key": "customerId", "label": "Client", "type": "string"},
					{"key": "startDate", "label": "Start date", "type": "string"},
					{"key": "expectedEndDate", "label": "Expected end", "type": "string"},
					{"key": "actualEndDate", "label": "Actual end", "type": "string"},
					{"key": "expectedRevenue", "label": "Expected revenue", "type": "number"},
					{"key": "realisedRevenue", "label": "Realised revenue", "type": "number"},
					{"key": "modelOvereenkomstId", "label": "Model agreement", "type": "string"},
					{"key": "intakeStatus", "label": "Intake status", "type": "string"},
					{"key": "actueleRisicoscore", "label": "Risk score", "type": "number"},
					{"key": "riskLevel", "label": "Risk band", "type": "string"},
					{"key": "wbaAssessmentResult", "label": "WBA outcome", "type": "string"},
					{"key": "openFlags", "label": "Open flags", "type": "number"},
					{"key": "state", "label": "State", "type": "string"}
				],
				"relatedLists": [
					{"id": "intakes", "title": "Intake assessments", "schema": "DBAIntake", "foreignKey": "assignmentId", "columns": [
						{"key": "filledOn", "label": "Filled in"},
						{"key": "totalScore", "label": "Total score"},
						{"key": "interpretatie", "label": "Risk band"}
					], "detailRoute": "DBAIntakeDetail"},
					{"id": "evidence", "title": "Evidence dossiers", "schema": "DBAEvidenceDossier", "foreignKey": "assignmentId", "columns": [
						{"key": "compleetheidScore", "label": "Completeness"},
						{"key": "retentionTerm", "label": "Retention"},
						{"key": "archiveDate", "label": "Delete-eligible"}
					], "detailRoute": "DBAEvidenceDossierDetail"},
					{"id": "flags", "title": "Risk flags", "schema": "DBARisicoflag", "foreignKey": "assignmentId", "columns": [
						{"key": "type", "label": "Flag type"},
						{"key": "ernst", "label": "Severity"},
						{"key": "detectieMoment", "label": "Detected"},
						{"key": "status", "label": "Status"}
					], "detailRoute": "DBARisicoflagDetail"}
				],
				"auditTrail": true,
				"indexRoute": "DBAOpdrachten",
				"sidebarProps": {
					"tabs": [
						{"id": "documents", "label": "Documents", "icon": "FolderOutline", "order": 80, "widgets": [
							{"type": "data", "componentName": "openregister-file-references", "props": {"register": "shillinq", "schema": "DBAOpdracht", "objectId": ":id"}}
						]},
						{"id": "audit", "label": "Audit Trail", "icon": "History", "order": 90, "widgets": [
							{"type": "data", "componentName": "openregister-audit-trail", "props": {"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true}}
						]}
					]
				}
			}
		},
		{
			"id": "DBAIntakes",
			"route": "/dba/intakes",
			"type": "index",
