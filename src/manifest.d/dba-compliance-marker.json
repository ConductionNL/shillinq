		{
			"id": "DBAModelovereenkomstDetail",
			"route": "/dba/modelovereenkomsten/:id",
			"type": "detail",
			"title": "Model agreement",
			"config": {
				"_note": "Model agreement (modelovereenkomst) is a DOCUMENT record — an approved Belastingdienst/branch template with a publication URL, version, validity window and a stored file (fileRef + sha256 integrity hash). Body leads with the identifying/version data; the source document and its integrity hash matter most, so Documents sits on the body-adjacent sidebar with the audit trail. No comms — a reference document, not a conversation.",
				"register": "shillinq",
				"schema": "DBAModelovereenkomst",
				"fields": [
					{"key": "name", "label": "Model", "type": "string"},
					{"key": "source", "label": "Source", "type": "string"},
					{"key": "publicationURL", "label": "Publication URL", "type": "string"},
					{"key": "approvalDate", "label": "Approval date", "type": "string"},
					{"key": "validTo", "label": "Valid until", "type": "string"},
					{"key": "version", "label": "Version", "type": "string"},
					{"key": "currentVersion", "label": "Current version", "type": "boolean"},
					{"key": "fileRef", "label": "Stored file", "type": "string"},
					{"key": "sha256", "label": "SHA-256 integrity", "type": "string", "copyable": true}
				],
				"auditTrail": true,
				"indexRoute": "DBAModelovereenkomsten",
				"sidebarProps": {
					"tabs": [
						{"id": "documents", "label": "Document", "icon": "FileDocumentOutline", "order": 80, "widgets": [
							{"type": "data", "componentName": "openregister-file-references", "props": {"register": "shillinq", "schema": "DBAModelovereenkomst", "objectId": ":id"}}
