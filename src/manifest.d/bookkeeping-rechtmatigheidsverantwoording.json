			"title": "Lawfulness paragraph",
			"config": {
				"register": "shillinq",
				"schema": "Rechtmatigheidsparagraaf",
				"_note": "REPORT (the year-end lawfulness paragraph adopted by the executive and handled by the council — the formal statement that summed errors/uncertainties stayed within tolerance). The body is the roll-up: total expenses base, tolerance thresholds, total identified errors and uncertainties, the within-tolerance verdict, the executive statement text, and the adoption/handling dates. It is a computed summary of the findings, so no child object-list. No comms. The audit trail sidebar is the adoption record.",
				"fields": [
					{ "key": "financialYear", "label": "Financial year", "type": "string" },
					{ "key": "total_expenses_including_reserve_movements", "label": "Total expenses incl. reserve movements", "type": "string" },
