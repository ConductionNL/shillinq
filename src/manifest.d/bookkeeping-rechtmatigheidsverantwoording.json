					{ "key": "determined_by_college_on", "label": "Adopted by executive on", "type": "string" },
					{ "key": "behandeld_in_raad_op", "label": "Handled by council on", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" }
				],
