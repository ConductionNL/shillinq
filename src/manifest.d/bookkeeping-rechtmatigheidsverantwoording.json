			"type": "detail",
			"title": "Finding",
			"config": {
				"register": "shillinq",
				"schema": "Rechtmatigheidsbevinding",
				"_note": "FINDING (a booked error or uncertainty that rolls up into the lawfulness paragraph). The body quantifies the finding — error vs uncertainty amount, criterion, programme, financial year — and captures cause, measure and the responsible portfolio holder, plus the linked correction entry that resolves it. This is the remediation view. No comms leaves; the audit trail sidebar tracks status from open to resolved.",
				"fields": [
					{ "key": "bevindingsnummer", "label": "Finding number", "type": "string" },
					{ "key": "kind", "label": "Kind", "type": "string" },
					{ "key": "criterium", "label": "Criterion", "type": "string" },
					{ "key": "amount_error", "label": "Error amount", "type": "string" },
					{ "key": "amount_uncertainty", "label": "Uncertainty amount", "type": "string" },
					{ "key": "financialYear", "label": "Financial year", "type": "string" },
					{ "key": "programme", "label": "Programme", "type": "string" },
					{ "key": "description", "label": "Description", "type": "string" },
					{ "key": "oorzaak", "label": "Cause", "type": "string" },
					{ "key": "maatregel", "label": "Measure", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" },
					{ "key": "verantwoordelijke_portefeuillehouder", "label": "Portfolio holder", "type": "string" },
					{ "key": "correctieboeking_id", "label": "Linked correction entry", "type": "string" }
				],
				"indexRoute": "Bevindingen",
