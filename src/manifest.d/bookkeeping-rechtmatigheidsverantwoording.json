		{
			"id": "RechtmatigheidstoetsDetail",
			"route": "/rechtmatigheid/toetsing/:id",
			"type": "detail",
			"title": "Lawfulness assessment",
			"config": {
				"register": "shillinq",
				"schema": "Rechtmatigheidstoets",
				"_note": "ASSESSMENT record (a single lawfulness test against one journal entry/criterion). The body is the test itself — criterion, outcome, assessor, substantiation, the amount at stake, the rule reference and any finding it produced — everything a reviewer needs to defend the judgement, with the supporting-documents reference (bewijsstukken) inline. No comms leaves (a compliance test is not correspondence); the audit trail sidebar is the who-tested-what record that underpins the accountant's opinion.",
				"fields": [
					{ "key": "journaalpost", "label": "Journal entry", "type": "string" },
					{ "key": "criterium", "label": "Criterion", "type": "string" },
					{ "key": "uitkomst", "label": "Outcome", "type": "string" },
					{ "key": "toetstype", "label": "Assessment type", "type": "string" },
					{ "key": "toetsdatum", "label": "Assessment date", "type": "string" },
					{ "key": "toetser", "label": "Assessor", "type": "string" },
					{ "key": "onderbouwing", "label": "Substantiation", "type": "string" },
					{ "key": "amount_involved", "label": "Amount", "type": "string" },
					{ "key": "bewijsstukken", "label": "Supporting documents", "type": "string" },
					{ "key": "regelverwijzing", "label": "Rule reference", "type": "string" },
					{ "key": "rechtmatigheidsbevinding", "label": "Finding", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" }
				],
				"indexRoute": "Rechtmatigheidstoetsing",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
