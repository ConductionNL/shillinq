			"type": "detail",
			"title": "Tolerance threshold",
			"config": {
				"register": "shillinq",
				"schema": "Tolerantiegrens",
				"_note": "CONFIG threshold (the council-adopted error/uncertainty tolerance for a financial year — the pass/fail line for the whole lawfulness paragraph). The body is the definition: percentages, calculation basis, the council decision that adopted it and its validity window. No transactions, no comms. The audit trail sidebar matters because the threshold is politically adopted; changing it retroactively alters whether a year passes.",
				"fields": [
					{ "key": "financialYear", "label": "Financial year", "type": "string" },
					{ "key": "fout_percentage", "label": "Error %", "type": "string" },
