		"change": "receivables-object-request-refund-and-credit",
		"description": "Refunds to pay (task 3.2): payment requests in refund_requested, with Approve (POST /api/payment-requests/{id}/refund/approve) and Mark paid (RefundPaidModal, POST /refund/paid) as row handlers in src/utils/refundActions.js. The server gates both on payment.administer."
	},
	"menu": [
		{
			"id": "RefundsToPay",
			"label": "Refunds to pay",
			"icon": "CashRefund",
			"route": "RefundsToPay",
			"order": 25
		}
	],
	"pages": [
		{
			"id": "RefundsToPay",
			"route": "/bookkeeping/refunds-to-pay",
			"type": "index",
			"title": "Refunds to pay",
			"config": {
				"register": "shillinq",
				"schema": "PaymentRequest",
				"filter": {
					"state": "refund_requested"
				},
				"columns": [
					{"key": "paymentReference", "label": "Reference", "sortable": true},
					{"key": "description", "label": "Description", "sortable": false},
					{"key": "amount", "label": "Amount", "sortable": true},
					{"key": "settledAt", "label": "Paid on", "sortable": true}
				],
				"defaultSort": "settledAt",
				"detailRoute": "PaymentRequestDetail",
				"showAdd": false,
				"actions": [
					{
						"id": "approve-refund",
						"label": "Approve",
						"icon": "CheckCircleOutline",
						"handler": "approveRefund"
					},
					{
						"id": "mark-refund-paid",
						"label": "Mark paid",
						"icon": "BankTransferOut",
						"handler": "openRefundPaid"
					}
				]
			}
		}
	]
}
