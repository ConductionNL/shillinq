			"title": "Materiality Assessments",
			"config": {
				"register": "shillinq",
				"schema": "MaterialityAssessment",
				"columns": [
					{"key": "reportingPeriod", "label": "Period", "sortable": true},
					{"key": "assessmentScope", "label": "Scope", "sortable": true},
					{"key": "thresholdImpact", "label": "Impact threshold", "sortable": true},
					{"key": "thresholdFinancial", "label": "Financial threshold", "sortable": true},
					{"key": "state", "label": "State", "sortable": true}
				],
				"defaultSort": "reportingPeriod",
				"detailRoute": "MaterialityAssessmentDetail"
			}
		},
		{
			"id": "MaterialityAssessmentDetail",
			"route": "/sustainability/materiality-assessments/:id",
			"type": "detail",
			"title": "Materiality Assessment",
			"config": {
				"register": "shillinq",
				"schema": "MaterialityAssessment",
				"fields": [
					{"key": "reportingPeriod", "label": "Period", "type": "string"},
					{"key": "methodologyVersion", "label": "Methodology", "type": "string"},
					{"key": "assessmentScope", "label": "Scope", "type": "string"},
					{"key": "responsibleOwner", "label": "Owner", "type": "string"},
					{"key": "thresholdImpact", "label": "Impact threshold", "type": "number"},
					{"key": "thresholdFinancial", "label": "Financial threshold", "type": "number"},
					{"key": "approver", "label": "Approver", "type": "string"},
					{"key": "approvalDate", "label": "Approved", "type": "string"},
					{"key": "state", "label": "State", "type": "string"}
				],
				"_note": "GOVERNANCE report — the double-materiality assessment that gates the whole CSRD filing. Body shows period, methodology, the impact/financial thresholds and the approval chain; the supporting documents that evidence the stakeholder consultation sit in the sidebar alongside the immutable audit trail. A governance decision record, not correspondence — no comms leaves.",
				"indexRoute": "MaterialityAssessments",
				"sidebarProps": {
					"tabs": [
						{
							"id": "docs",
							"label": "Supporting documents",
							"icon": "FileDocumentMultipleOutline",
							"order": 10,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-file-references",
									"props": {
										"register": "shillinq",
										"schema": "MaterialityAssessment",
										"field": "supportingDocuments",
										"objectId": ":id",
										"description": "Stakeholder-consultation evidence referenced from NC Files."
									}
								}
							]
						},
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
