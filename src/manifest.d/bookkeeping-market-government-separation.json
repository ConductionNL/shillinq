		{
			"id": "CommercialActivityDetail",
			"route": "/wmo/commercial-activities/:id",
			"type": "detail",
			"title": "Commercial Activity",
			"config": {
				"register": "shillinq",
				"schema": "CommercialActivity",
				"_note": "FINANCIAL / MASTER archetype (native CnDetailPage). A commercial activity is the master record a municipality must ring-fence under the Wet Markt & Overheid. Native contract only: fields[] lead with the activity data (turnover, cost method, exemption). The compliance ledgers hanging off it are surfaced as relatedCollections — IntegralCostPrice, ActivityCostAllocation and AlertLog, all FK commercialActivityId=@object.code (see _relatedCollectionsNote) — so an officer walks from the master to its cost-recovery evidence. NO comms. Sidebar carries a file-references tab (the cost model and exemption ruling are real source documents) and an audit-trail tab for the immutable change log. lifecycleActions on because the activity moves through states (active / exempted / ended).",
				"fields": [
					{ "key": "code", "label": "Code", "type": "string" },
					{ "key": "name", "label": "Name", "type": "string" },
					{ "key": "governingBody", "label": "Bestuursorgaan", "type": "string" },
					{ "key": "organisatieonderdeel", "label": "Department", "type": "string" },
					{ "key": "description", "label": "Description", "type": "string" },
					{ "key": "marktsegment", "label": "Market Segment", "type": "string" },
					{ "key": "concurrenten", "label": "Competitors", "type": "array" },
					{ "key": "afnemers", "label": "Customers", "type": "array" },
					{ "key": "startDate", "label": "Start Date", "type": "string" },
					{ "key": "endDate", "label": "End Date", "type": "string" },
					{ "key": "costPriceMethod", "label": "Cost-Price Method", "type": "string" },
					{ "key": "costCentreCode", "label": "Cost Center", "type": "string" },
					{ "key": "costObjectCode", "label": "Cost Object", "type": "string" },
					{ "key": "isExempted", "label": "Is Exempted", "type": "boolean" },
					{ "key": "exemptionDecisionId", "label": "Exemption Decision", "type": "string" },
					{ "key": "annualRevenue", "label": "Annual Turnover", "type": "number" },
					{ "key": "acmReport", "label": "ACM Notification", "type": "object" },
					{ "key": "lastReviewedAt", "label": "Last Reviewed", "type": "string" },
					{ "key": "state", "label": "State", "type": "string" }
				],
				"lifecycleActions": true,
				"_relatedCollectionsNote": "KEY: the prop is `relatedCollections`; a `relatedLists` block is not a prop on any Cn page component, lands in $attrs and renders nothing while every gate stays green. TOKEN: `@object.code`, NOT `@objectId` — SEED-PROVEN. lib/Settings/seeds/commercial-activities/integral-cost-price-example-q1-2026.json stores `\"commercialActivityId\": \"MO-SP-015\"`, and the activity it points at is seeded in sportaccommodaties-gemeente.json with the flat payload field `\"code\": \"MO-SP-015\"`. So the children reference the activity by its flat `code` business key, and a UUID filter would match zero rows. Note the IntegralCostPrice schema's own `example` ('ca-mo-sp-014') is STALE and disagrees with the seeded data — the seed is authoritative here.",
				"relatedCollections": [
					{
						"title": "Integral cost prices",
						"register": "shillinq",
						"schema": "IntegralCostPrice",
						"filter": { "commercialActivityId": "@object.code" },
						"columns": [
							{ "key": "period", "label": "Period" },
							{ "key": "totalCost", "label": "Total cost" },
							{ "key": "costPricePerUnit", "label": "Cost / unit" },
							{ "key": "appliedRate", "label": "Applied tariff" },
							{ "key": "compliant", "label": "Compliant" },
							{ "key": "status", "label": "Status" }
						],
						"rowRoute": "IntegralCostPriceDetail"
					},
					{
						"title": "Cost allocations",
						"register": "shillinq",
						"schema": "ActivityCostAllocation",
						"filter": { "commercialActivityId": "@object.code" },
						"columns": [
							{ "key": "postingDate", "label": "Posting date" },
							{ "key": "journalEntryId", "label": "Journal entry" },
							{ "key": "originalAmount", "label": "Amount" },
							{ "key": "automaticApplied", "label": "Auto" },
							{ "key": "status", "label": "Status" }
						],
						"rowRoute": "ActivityCostAllocationDetail"
					},
					{
						"title": "Cross-subsidy alerts",
						"register": "shillinq",
						"schema": "AlertLog",
						"filter": { "commercialActivityId": "@object.code" },
						"columns": [
							{ "key": "alertType", "label": "Type" },
							{ "key": "severity", "label": "Severity" },
							{ "key": "generatedAt", "label": "Raised at" },
							{ "key": "assignedTo", "label": "Assigned to" },
							{ "key": "status", "label": "Status" }
						],
						"rowRoute": "CrossSubsidyAlertDetail"
					}
				],
				"indexRoute": "CommercialActivities",
				"sidebarProps": {
					"tabs": [
						{
							"id": "documents",
							"label": "Documents",
							"icon": "FileDocumentOutline",
							"order": 80,
							"widgets": [
								{ "type": "data", "componentName": "openregister-file-references", "props": { "register": "shillinq", "schema": "CommercialActivity", "objectId": ":id" } }
							]
						},
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{ "type": "data", "componentName": "openregister-audit-trail", "props": { "source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true } }
							]
						}
					]
				}
			}
		},
