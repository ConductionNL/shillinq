			"route": "/loonadministratie/loonstroken/:id",
			"type": "detail",
			"title": "Payslip",
			"config": {
				"register": "shillinq",
				"schema": "LoonStrook",
				"_note": "DOCUMENT (payslip) — a financial statement, not a correspondence: NO email/calendar even though it concerns a person. It is a leaf with no child schema, so the body is the full gross-to-net breakdown (taxable pay, SV base, payroll tax, net paid) that reconciles the payslip. Audit trail sidebar is the compliance record for a recalculated/corrected slip; a payslip is retained, not deleted, so history matters.",
				"fields": [
					{"key": "employeeId", "label": "Employee", "type": "string"},
					{"key": "periodId", "label": "Period", "type": "string"},
					{"key": "fiscalPay", "label": "Taxable pay", "type": "number"},
					{"key": "contribution_pay_sv", "label": "SV contribution base", "type": "number"},
					{"key": "payrollTax", "label": "Payroll tax", "type": "number"},
					{"key": "netPaid", "label": "Net paid", "type": "number"}
				],
				"indexRoute": "Loonstroken",
				"sidebarProps": {
