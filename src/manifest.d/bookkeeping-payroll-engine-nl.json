			"title": "Employer",
			"config": {
				"register": "shillinq",
				"schema": "Werkgever",
				"_note": "MASTER record (employer). The body pairs the employer's fiscal/sector data with its two operational child registers — the employees on its payroll and the pay periods run under it — so a payroll officer sees who is employed here and which periods have been processed, right under the sector/AWF/ZVW rates that drive every calculation. No comms leaves: Werkgever declares no email/calendar linkedType (payroll master, not a correspondent). Audit trail sidebar tracks rate/config changes.",
				"fields": [
					{"key": "name", "label": "Name", "type": "string"},
					{"key": "kvk", "label": "KvK", "type": "string"},
					{"key": "payrollTaxNumber", "label": "Payroll tax number", "type": "string"},
