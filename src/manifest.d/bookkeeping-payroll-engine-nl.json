			"type": "detail",
			"title": "LH remittance",
			"config": {
				"register": "shillinq",
				"schema": "LHAfdracht",
				"_note": "TAX REMITTANCE (aangifte loonheffingen) — the amount owed to the Belastingdienst for a period. It aggregates the period's payslips, so the body is the component breakdown (payroll tax, WKR final levies, SV contributions, ZVW, total) plus the due date and filing status — the exact figures submitted. It has no child schema of its own. No comms leaves. Audit trail sidebar is the filing/payment record.",
				"fields": [
					{"key": "periodId", "label": "Period", "type": "string"},
					{"key": "totalPayrollTax", "label": "Payroll tax", "type": "number"},
					{"key": "totalFinalLeviesWorkRelatedCosts", "label": "WKR final levies", "type": "number"},
					{"key": "totalSocialInsuranceContributions", "label": "SV contributions", "type": "number"},
					{"key": "totalHealthInsurance", "label": "ZVW", "type": "number"},
					{"key": "totalRemittance", "label": "Total remittance", "type": "number"},
					{"key": "dueDateRemittance", "label": "Due date", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"}
				],
				"indexRoute": "LHAfdrachten",
