					{"key": "zvwRate", "label": "ZVW rate", "type": "string"},
					{"key": "wkrBudget2026", "label": "WKR budget 2026", "type": "number"},
					{"key": "holidayAllowanceDisbursementMonth", "label": "Holiday pay month", "type": "number"}
				],
				"relatedObjects": [
