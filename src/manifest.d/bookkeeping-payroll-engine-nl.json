					{"key": "annualPayGross", "label": "Gross annual salary", "type": "number"},
					{"key": "vakantiegeldPct", "label": "Holiday pay %", "type": "number"},
					{"key": "pensionScheme", "label": "Pension scheme", "type": "string"},
					{"key": "thuiswerkdagenPerWeek", "label": "Home-working days/week", "type": "number"},
					{"key": "is_dga", "label": "DGA", "type": "boolean"},
					{"key": "expat30PctScheme", "label": "30% ruling", "type": "boolean"}
				],
				"relatedObjects": [
