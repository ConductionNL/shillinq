			"config": {
				"register": "shillinq",
				"schema": "LoonPeriode",
				"_note": "PERIOD run (the container that gets calculated + closed). The header totals (gross/net/LH) sit above the three things a period produces: the payslips generated in it, the LH remittance derived from it, and the payroll journal entries booked from it — each an object-list filtered on periodeId. This is the run-review view a payroll officer uses before closing/approving a period. No comms leaves. Audit trail sidebar records status transitions (open → calculated → closed).",
				"fields": [
					{"key": "periodType", "label": "Type", "type": "string"},
					{"key": "year", "label": "Year", "type": "number"},
					{"key": "periodNr", "label": "Period number", "type": "number"},
					{"key": "periodStart", "label": "Start", "type": "string"},
					{"key": "periodEnd", "label": "End", "type": "string"},
					{"key": "paymentDate", "label": "Payment date", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "payrollTaxTableVersion", "label": "Table version", "type": "string"},
					{"key": "totalGrossPay", "label": "Total gross", "type": "number"},
					{"key": "totalNetPaid", "label": "Total net", "type": "number"},
					{"key": "totalPayrollTaxRemittance", "label": "Total LH", "type": "number"}
				],
