					{"key": "initials", "label": "Initials", "type": "string"},
					{"key": "lastName", "label": "Surname", "type": "string"},
					{"key": "inDienstSinds", "label": "Employed since", "type": "string"},
					{"key": "outServicePer", "label": "Employment end", "type": "string"},
					{"key": "payrollTaxTable", "label": "Payroll tax table", "type": "string"},
					{"key": "payrollTaxTableDiscount", "label": "Tax credit applied", "type": "boolean"},
					{"key": "contractType", "label": "Contract type", "type": "string"},
					{"key": "hourlyPay", "label": "Hourly wage", "type": "number"},
