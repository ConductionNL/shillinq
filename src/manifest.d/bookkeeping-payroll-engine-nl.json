			"type": "detail",
			"title": "Payroll journal entry",
			"config": {
				"register": "shillinq",
				"schema": "Loonjournaalpost",
				"_note": "JOURNAL ENTRY (the GL booking that posts a period's payroll to the ledger). The body shows the entry header (period, date, whether debits equal credits) — the balanced flag is the one thing an accountant checks before posting. No child line schema is declared in this register, so lines live inside the entry; no comms leaves. Audit trail sidebar is the posting/reversal record.",
				"fields": [
					{"key": "periodId", "label": "Period", "type": "string"},
					{"key": "date", "label": "Date", "type": "string"},
					{"key": "balanced", "label": "Balanced", "type": "boolean"}
