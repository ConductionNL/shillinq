			"order": 77
		},
		{
			"id": "RetainerTrueUps",
			"label": "True-Ups",
			"icon": "ScaleBalance",
			"route": "RetainerTrueUps",
			"order": 78
		}
	],
	"pages": [
		{
			"id": "RetainerPools",
			"route": "/retainer-pools",
			"type": "index",
			"title": "Retainer Pools",
			"config": {
				"register": "shillinq",
				"schema": "RetainerPool",
				"columns": [
					{"key": "poolId", "label": "Pool", "sortable": true},
					{"key": "clientId", "label": "Client", "sortable": true},
					{"key": "projectId", "label": "Project", "sortable": true},
					{"key": "periodStart", "label": "Period start", "sortable": true},
					{"key": "periodEnd", "label": "Period end", "sortable": true},
					{"key": "poolAmount", "label": "Pool amount", "sortable": true, "type": "money"},
					{"key": "retainerRate", "label": "Retainer rate", "sortable": true, "type": "money"},
					{"key": "status", "label": "Status", "sortable": true}
				],
				"filters": [
					{"key": "status", "label": "Status", "type": "select", "options": ["draft", "active", "closed", "archived"]},
					{"key": "clientId", "label": "Client", "type": "string"},
					{"key": "periodStart", "label": "Period", "type": "date"}
				],
				"defaultSort": "periodStart",
				"detailRoute": "RetainerPoolDetail"
			}
		},
		{
			"id": "RetainerPoolDetail",
			"route": "/retainer-pools/:id",
			"type": "detail",
			"title": "Retainer Pool",
			"config": {
				"register": "shillinq",
				"schema": "RetainerPool",
				"_note": "FINANCIAL / MASTER archetype (native CnDetailPage). A retainer pool is a prepaid-hours account with three consumption/reconciliation ledgers hanging off it: drawdowns (RetainerDrawdown.poolId), true-ups (RetainerTrueUp.poolId) and rollovers (RetainerRollover.sourcePeriodPoolId) — surfaced as native relatedCollections (see _relatedCollectionsNote for the key and filter-token evidence) so the operator can drill from the pool into its full trail (REQ-RETN-010). Deliberately NO comms leaves and NO file-references tab — a pool declares no email/calendar linkedType and no source-document field on the schema; it is an accounting balance, not a conversation or a filing. The lifecycle action toolbar (activate/close/archive + manual true-up trigger) stays on `actions`; audit-trail lives in a sidebar tab as the correct home for a financial balance's immutable change log.",
				"fields": [
					{"key": "poolId", "label": "Pool ID", "type": "string"},
					{"key": "clientId", "label": "Client", "type": "string"},
					{"key": "projectId", "label": "Project", "type": "string"},
					{"key": "periodStart", "label": "Period start", "type": "string"},
					{"key": "periodEnd", "label": "Period end", "type": "string"},
					{"key": "poolAmount", "label": "Pool amount", "type": "number"},
					{"key": "currency", "label": "Currency", "type": "string"},
					{"key": "retainerRate", "label": "Retainer rate", "type": "number"},
					{"key": "retainerRateUnit", "label": "Rate unit", "type": "string"},
					{"key": "rolloverPolicy.resetBalance", "label": "Reset balance", "type": "boolean"},
					{"key": "rolloverPolicy.carryoverMaxAmount", "label": "Carryover cap (amount)", "type": "number"},
					{"key": "rolloverPolicy.carryoverMaxHours", "label": "Carryover cap (hours)", "type": "number"},
					{"key": "administrationId", "label": "Administration", "type": "string"},
					{"key": "status", "label": "Status", "type": "string"},
					{"key": "sourcePoolId", "label": "Source pool", "type": "string"},
					{"key": "description", "label": "Description", "type": "string"}
				],
				"lifecycleActions": true,
				"_relatedCollectionsNote": "KEY: the prop is `relatedCollections`; a `relatedLists` block is not a prop on any Cn page component, lands in $attrs and renders nothing while every gate stays green. TOKEN: `@object.poolId` — RetainerPool exposes a FLAT `poolId` business key (example 'RETN-2026-01-001'), and every child FK carries that same example value (RetainerDrawdown.poolId, RetainerTrueUp.poolId, RetainerRollover.sourcePeriodPoolId), i.e. the children reference the pool by its business key, not by UUID. ⚠️ MEDIUM CONFIDENCE — EVIDENCE CONFLICTS: OCA\\Shillinq\\Lifecycle\\RetainerGuard::canMaterializeDrawdown() resolves `$drawdown['poolId']` via ObjectIdentifier::findOne() with NO fallbackProperty, i.e. by OpenRegister UUID identity, which would imply `@objectId` instead. tests/Unit/Lifecycle/RetainerGuardTest.php makes the ambiguity explicit — its fixture sets id === poolId === 'RETN-2026-01-001' and its own comment notes the earlier fixture 'passed solely because this store's findAll() returns its rows whatever it is asked'. No seed and no writer settles it. The schema pair (flat parent key + matching child examples) is the stronger signal and matches the LedgerGroup precedent in PR #1011, so `@object.poolId` is used here; if these sections render empty against real data, the guard's identity resolution is the thing to reconcile, not this filter.",
				"relatedCollections": [
					{
						"title": "Drawdowns",
						"register": "shillinq",
						"schema": "RetainerDrawdown",
						"filter": { "poolId": "@object.poolId" },
						"columns": [
							{"key": "drawdownDate", "label": "Date"},
							{"key": "timeEntryId", "label": "Time entry"},
							{"key": "hoursOrAmount", "label": "Hours"},
							{"key": "drawdownAmount", "label": "Amount"},
							{"key": "status", "label": "Status"}
						],
						"rowRoute": "RetainerDrawdownDetail"
					},
					{
						"title": "True-Ups",
						"register": "shillinq",
						"schema": "RetainerTrueUp",
						"filter": { "poolId": "@object.poolId" },
						"columns": [
							{"key": "trueUpId", "label": "True-Up"},
							{"key": "generatedAt", "label": "Generated at"},
							{"key": "overageAmount", "label": "Overage"},
							{"key": "status", "label": "Status"}
						],
						"rowRoute": "RetainerTrueUpDetail"
					},
					{
						"title": "Rollovers",
						"register": "shillinq",
						"schema": "RetainerRollover",
						"filter": { "sourcePeriodPoolId": "@object.poolId" },
						"columns": [
							{"key": "rolloverId", "label": "Rollover"},
							{"key": "targetPeriodPoolId", "label": "Target pool"},
							{"key": "carryoverAmount", "label": "Carryover"},
							{"key": "status", "label": "Status"}
						],
						"rowRoute": "RetainerRolloverDetail"
					}
				],
				"indexRoute": "RetainerPools",
				"sidebarProps": { "tabs": [
					{ "id": "audit", "label": "Audit Trail", "icon": "History", "order": 90,
						"widgets": [ { "type": "data", "componentName": "openregister-audit-trail", "props": { "source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true } } ] }
				] }
			}
		},
		{
			"id": "RetainerDrawdowns",
			"route": "/retainer-drawdowns",
			"type": "index",
			"title": "Drawdowns",
			"config": {
				"register": "shillinq",
				"schema": "RetainerDrawdown",
				"columns": [
					{"key": "drawdownId", "label": "Drawdown", "sortable": true},
					{"key": "poolId", "label": "Pool", "sortable": true},
					{"key": "drawdownDate", "label": "Date", "sortable": true},
					{"key": "timeEntryId", "label": "Time entry", "sortable": true},
					{"key": "hoursOrAmount", "label": "Hours", "sortable": true},
					{"key": "drawdownRate", "label": "Rate", "sortable": true, "type": "money"},
					{"key": "drawdownAmount", "label": "Amount", "sortable": true, "type": "money"},
					{"key": "status", "label": "Status", "sortable": true}
				],
				"filters": [
					{"key": "poolId", "label": "Pool", "type": "string"},
					{"key": "status", "label": "Status", "type": "select", "options": ["pending", "materialized", "reversed", "adjusted"]},
					{"key": "drawdownDate", "label": "Date", "type": "date"}
				],
