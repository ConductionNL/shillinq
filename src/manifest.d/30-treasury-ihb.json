					},
					{
						"id": "liquidity-runway",
						"title": "Liquidity runway",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": { "count": 0, "countLabel": "weeks of cash", "variant": "success" }
					},
					{
						"id": "days-cash-on-hand",
						"title": "Days cash on hand",
						"type": "stats-block",
						"iconClass": "icon-checkmark",
						"props": { "count": 0, "countLabel": "days", "variant": "default" }
					},
					{
						"id": "fx-positions",
						"title": "FX positions by currency",
						"type": "list-block",
						"dataSource": {
							"register": "shillinq",
							"schema": "FXPosition",
							"sort": "foreignCurrency"
						}
					}
				],
				"layout": [
					{ "id": "lg-cash", "widgetId": "group-cash-position", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lg-fx", "widgetId": "fx-exposure", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lg-runway", "widgetId": "liquidity-runway", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lg-dcoh", "widgetId": "days-cash-on-hand", "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
