					},
					{
						"id": "forecast-downside",
						"title": "Downside scenario",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": { "count": 0, "countLabel": "EUR (week 13)", "variant": "warning" }
					},
					{
						"id": "forecast-stress",
						"title": "Stress scenario",
						"type": "stats-block",
						"iconClass": "icon-calendar",
						"props": { "count": 0, "countLabel": "EUR (week 13)", "variant": "error" }
					},
					{
						"id": "forecast-alerts",
						"title": "Variance alerts",
						"type": "stats-block",
						"iconClass": "icon-error",
						"props": { "count": 0, "countLabel": "weeks below policy", "variant": "default" }
					},
					{
						"id": "forecast-weeks",
						"title": "13-week rolling forecast",
						"type": "list-block",
						"dataSource": {
							"register": "shillinq",
							"schema": "CashForecast",
							"sort": "forecastWeek"
						}
					}
				],
				"layout": [
					{ "id": "lf-base", "widgetId": "forecast-base", "gridX": 0, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lf-downside", "widgetId": "forecast-downside", "gridX": 3, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lf-stress", "widgetId": "forecast-stress", "gridX": 6, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lf-alerts", "widgetId": "forecast-alerts", "gridX": 9, "gridY": 0, "gridWidth": 3, "gridHeight": 2 },
					{ "id": "lf-weeks", "widgetId": "forecast-weeks", "gridX": 0, "gridY": 2, "gridWidth": 12, "gridHeight": 4 }
				]
			}
		},
		{
			"id": "GroupLiquidityDashboard",
			"route": "/treasury/group-liquidity",
			"type": "dashboard",
			"title": "Group Liquidity Dashboard",
			"config": {
