	"pages": [
		{
			"id": "LeaseRegister",
			"route": "/ifrs-16/leases",
			"type": "index",
			"title": "Lease Register",
			"config": {
				"register": "shillinq",
				"schema": "LeaseContract",
				"columns": [
					{ "key": "leaseNumber", "label": "Lease Number", "sortable": true },
					{ "key": "description", "label": "Description", "sortable": false },
					{ "key": "assetClass", "label": "Asset Class", "sortable": true },
					{ "key": "commencementDate", "label": "Lease Commencement", "sortable": true },
					{ "key": "ibrPercent", "label": "Incremental Borrowing Rate", "sortable": true },
					{ "key": "classification", "label": "Classification", "sortable": true },
					{ "key": "status", "label": "State", "sortable": true }
				],
				"defaultSort": "leaseNumber",
				"detailRoute": "LeaseDetail"
			}
		},
		{
			"id": "LeaseDetail",
			"route": "/ifrs-16/leases/:id",
			"type": "detail",
			"title": "Lease Contract",
			"config": {
				"register": "shillinq",
				"schema": "LeaseContract",
				"_note": "FINANCIAL / LEASE-CONTRACT (master) archetype — native CnDetailPage. An IFRS 16 lease contract capitalises a right-of-use asset and a lease liability; the contract fields (lessor, term, payment, IBR, classification, status) are the primary record. Two related child schemas hang off leaseContract FK: the amortisation schedule (LeasePaymentSchedule, one row per period — opening/closing liability, interest, principal, depreciation) and reassessment/modification events (LeaseReassessmentEvent — remeasurements, IBR resets, terminations). Both surface as relatedLists so the accountant can drill from the master into either child list. The signed lease contract PDF (plus amortisation workpapers) is a real source document, so a Documents sidebar tab (openregister-file-references) is present. lifecycleActions surface the draft→active→modified→terminated/expired state machine (x-openregister-lifecycle on LeaseContract, REQ-LC-004); auditTrail records classification/remeasurement changes. NO comms leaves — a lease is an accounting instrument, not a conversation.",
				"lifecycleActions": true,
				"auditTrail": true,
				"relatedLists": [
					{
						"id": "paymentSchedule",
						"title": "Amortisation Schedule",
						"schema": "LeasePaymentSchedule",
						"foreignKey": "leaseContract",
						"columns": [
							{ "key": "periodSequence", "label": "Period" },
							{ "key": "periodEnd", "label": "Period End" },
							{ "key": "interestAccrued", "label": "Interest" },
							{ "key": "paymentPrincipalPortion", "label": "Principal" },
							{ "key": "closingLeaseLiability", "label": "Closing Liability" },
							{ "key": "depreciationCharge", "label": "Depreciation" }
						]
					},
					{
						"id": "reassessmentEvents",
						"title": "Reassessment Events",
						"schema": "LeaseReassessmentEvent",
						"foreignKey": "leaseContract",
						"columns": [
							{ "key": "reassessmentNumber", "label": "Event #" },
							{ "key": "eventType", "label": "Event type" },
							{ "key": "eventDate", "label": "Event date" },
							{ "key": "rouAssetAdjustment", "label": "RoU impact" },
							{ "key": "approvalStatus", "label": "Approval" }
						],
						"detailRoute": "LeaseReassessmentEvents"
					}
				],
				"sidebarProps": {
					"tabs": [
						{
							"id": "documents",
							"label": "Documents",
							"icon": "FileDocumentOutline",
							"order": 80,
							"widgets": [
								{ "type": "data", "componentName": "openregister-file-references", "props": { "register": "shillinq", "schema": "LeaseContract", "objectId": ":id" } }
							]
						},
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "HistoryIcon",
							"order": 90,
							"widgets": [
								{ "type": "data", "componentName": "openregister-audit-trail", "props": { "source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails", "collapsed": true } }
							]
						}
					]
				},
				"fields": [
					{ "key": "leaseNumber", "label": "Lease Number", "type": "string" },
					{ "key": "counterparty", "label": "Lessor", "type": "string" },
					{ "key": "description", "label": "Description", "type": "string" },
					{ "key": "assetClass", "label": "Asset Class", "type": "string" },
					{ "key": "commencementDate", "label": "Lease Commencement", "type": "string" },
					{ "key": "endDate", "label": "End Date", "type": "string" },
					{ "key": "nonCancellableTermMonths", "label": "Lease Term", "type": "number" },
					{ "key": "paymentFrequency", "label": "Payment Schedule", "type": "string" },
					{ "key": "basePaymentAmount", "label": "Payment Amount", "type": "number" },
					{ "key": "ibrPercent", "label": "Incremental Borrowing Rate", "type": "number" },
					{ "key": "classification", "label": "Classification", "type": "string" },
					{ "key": "status", "label": "State", "type": "string" }
				]
			}
		},
		{
			"id": "LeaseReassessmentEvents",
			"route": "/ifrs-16/reassessment-events",
			"type": "index",
			"title": "Reassessment Events",
			"config": {
				"register": "shillinq",
				"schema": "LeaseReassessmentEvent",
				"columns": [
					{ "key": "reassessmentNumber", "label": "Reassessment Event", "sortable": true },
					{ "key": "eventType", "label": "Event Type", "sortable": true },
					{ "key": "leaseContract", "label": "Lease Number", "sortable": true },
					{ "key": "eventDate", "label": "Event Date", "sortable": true },
					{ "key": "rouAssetAdjustment", "label": "RoU Impact", "sortable": true },
					{ "key": "approvalStatus", "label": "Approval", "sortable": true }
				],
				"defaultSort": "eventDate"
			}
		},
		{
			"id": "LeaseDisclosures",
			"route": "/ifrs-16/disclosures",
			"type": "index",
			"title": "IFRS 16 Disclosure",
			"config": {
				"register": "shillinq",
				"schema": "LeaseDisclosureTable",
				"columns": [
					{ "key": "fiscalPeriod", "label": "Period", "sortable": true },
					{ "key": "totalLeaseLiabilityCurrent", "label": "Lease Liability", "sortable": true },
					{ "key": "totalRouDepreciationInPeriod", "label": "Depreciation", "sortable": true },
					{ "key": "totalInterestExpense", "label": "Interest Accrued", "sortable": true }
				],
				"defaultSort": "fiscalPeriod"
			}
		},
		{
			"id": "LeaseExemptions",
			"route": "/ifrs-16/exemptions",
			"type": "index",
			"title": "Exemption",
			"config": {
				"register": "shillinq",
				"schema": "LeasePortfolioExemption",
				"columns": [
					{ "key": "policyEffectiveDate", "label": "Effective Date", "sortable": true },
					{ "key": "lowValueThreshold", "label": "Low-Value Lease", "sortable": true }
				],
				"defaultSort": "policyEffectiveDate"
			}
		}
	]
}
