					{ "key": "referenceSchema", "label": "Reference schema", "type": "string" },
					{ "key": "sortOrder", "label": "Sort order", "type": "integer" },
					{ "key": "lifecycleState", "label": "Status", "type": "string" },
					{ "key": "administrationId", "label": "Administration", "type": "string" }
				]
			}
		},
		{
			"id": "SegmentPnLDashboard",
			"route": "/bookkeeping/dimensions/segment-pnl",
			"type": "custom",
			"title": "Segment P&L",
			"component": "SegmentPnLDashboard"
