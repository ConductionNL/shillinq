			"children": [
				{
					"id": "AnalyticalDimensions",
					"label": "Analytical Dimensions",
					"icon": "ChartBoxOutline",
					"route": "AnalyticalDimensions",
					"order": 92
				},
				{
					"id": "SegmentPnLDashboard",
					"label": "Segment P&L",
					"icon": "PollOutline",
					"route": "SegmentPnLDashboard",
					"order": 93
				}
			]
		}
