			"title": "Analytical Dimensions",
			"config": {
				"register": "shillinq",
				"schema": "AnalyticalDimension",
				"columns": [
					{ "key": "code", "label": "Code", "sortable": true },
					{ "key": "name", "label": "Name", "sortable": true },
					{ "key": "dataType", "label": "Data type", "sortable": true },
					{ "key": "isHierarchical", "label": "Hierarchical", "sortable": true },
					{ "key": "lifecycleState", "label": "Status", "sortable": true }
				],
				"defaultSort": "sortOrder",
				"filters": [
					{ "key": "lifecycleState", "label": "Status" },
					{ "key": "dataType", "label": "Data type" }
				],
				"detailRoute": "AnalyticalDimensionDetail"
			}
		},
		{
			"id": "AnalyticalDimensionDetail",
			"route": "/bookkeeping/dimensions/analytical-dimensions/:id",
			"type": "detail",
			"title": "Analytical Dimension",
			"config": {
				"register": "shillinq",
				"schema": "AnalyticalDimension",
				"fields": [
					{ "key": "code", "label": "Code", "type": "string" },
					{ "key": "name", "label": "Name", "type": "string" },
