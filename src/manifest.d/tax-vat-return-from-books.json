		{
			"id": "VatFiscalUnities",
			"route": "/belastingen/btw-fiscale-eenheden",
			"type": "index",
			"title": "VAT fiscal unities",
			"config": {
				"register": "shillinq",
				"schema": "VatFiscalUnity",
				"columns": [
					{"key": "name", "label": "Name", "sortable": true},
					{"key": "vatNumber", "label": "VAT number", "sortable": true},
					{"key": "administrationId", "label": "Representative administration", "sortable": true},
					{"key": "startDate", "label": "Start date", "sortable": true},
					{"key": "endDate", "label": "End date", "sortable": true}
				],
				"defaultSort": "startDate",
				"detailRoute": "VatFiscalUnityDetail"
			}
		},
		{
			"id": "VatFiscalUnityDetail",
			"route": "/belastingen/btw-fiscale-eenheden/:id",
			"type": "detail",
			"title": "VAT fiscal unity",
			"config": {
				"_note": "A VAT fiscal unity: the representative administration files one return for itself and the members while the unity runs; a member's own return in that period is refused. The returns themselves are on the BTW returns page.",
				"register": "shillinq",
				"schema": "VatFiscalUnity",
				"auditTrail": true,
				"fields": [
					{"key": "name", "label": "Name", "type": "string"},
					{"key": "vatNumber", "label": "VAT number", "type": "string"},
					{"key": "administrationId", "label": "Representative administration", "type": "string"},
					{"key": "memberAdministrationIds", "label": "Member administrations", "type": "array"},
					{"key": "startDate", "label": "Start date", "type": "string"},
					{"key": "endDate", "label": "End date", "type": "string"},
					{"key": "notes", "label": "Notes", "type": "string"}
				]
			}
		},
