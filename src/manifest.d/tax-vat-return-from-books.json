		"adr": "ADR-037 modular manifest fragment — never edit src/manifest.json",
		"description": "Task 5.1 (REQ-TVRB-003): the index and detail page of a VAT fiscal unity. The representative administration prepares one return for the unity on the BTW returns page; that return shows a subtotal per administration, and a member preparing its own return in the unity's period is refused with the unity's name. Task 4.1 (REQ-TVRB-002): FiscalYearDetail and BtwCorrecties are carried whole (a fragment page replaces the base page of the same id) to add Check fiscal year and the grouping of corrections by fiscal year."
	},
	"menu": [
		{
			"id": "VatFiscalUnities",
			"label": "VAT fiscal unities",
			"icon": "OfficeBuildingOutline",
			"route": "VatFiscalUnities",
			"order": 72
		}
	],
