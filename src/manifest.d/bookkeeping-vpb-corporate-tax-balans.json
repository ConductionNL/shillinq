				}
			]
		}
	],
	"pages": [
		{
			"id": "VpbPligtigeAccounts",
			"route": "/bookkeeping/vpb-balans/accounts",
			"type": "index",
			"title": "Vpb-liable accounts",
			"featureFlag": "mkb-vpb",
			"config": {
				"register": "shillinq",
				"schema": "Account",
				"filter": {
					"vpbPligtig": { "equals": true }
				},
				"columns": [
					{ "key": "accountNumber", "label": "Account number", "sortable": true },
					{ "key": "name", "label": "Name", "sortable": true },
					{ "key": "accountType", "label": "Type", "sortable": true },
					{ "key": "vpbPligtig", "label": "Vpb-liable", "sortable": true }
				],
				"search": true,
				"filters": [
					{ "key": "accountType", "label": "Type" }
				],
				"defaultSort": "accountNumber",
				"warnings": [
					{
						"id": "orphanedVpbPligt",
						"source": "VpbBalansLink:orphanedVpbPligtigAccounts.warnings.orphanedVpbPligt",
						"render": "callout"
					}
				]
			}
		},
		{
			"id": "VpbBalansLinks",
			"route": "/bookkeeping/vpb-balans/links",
			"type": "index",
			"title": "Business activities (Vpb balance link)",
			"featureFlag": "mkb-vpb",
			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"columns": [
					{ "key": "costCenterId", "label": "Business activity", "sortable": true },
					{ "key": "vpbPligtigVanaf", "label": "Vpb-liable from", "sortable": true },
					{ "key": "vpbPligtigTotEnMet", "label": "Vpb-liable until", "sortable": true },
					{ "key": "accountNumbers", "label": "Number of accounts", "sortable": false }
				],
				"search": true,
				"defaultSort": "vpbPligtigVanaf",
				"detailRoute": "VpbBalansLinkDetail"
			}
		},
		{
			"id": "VpbBalansLinkDetail",
			"route": "/bookkeeping/vpb-balans/links/:id",
			"type": "detail",
			"title": "Vpb balance link",
			"featureFlag": "mkb-vpb",
			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"fields": [
					{ "key": "costCenterId", "label": "Business activity (cost-center)", "type": "string" },
					{ "key": "vpbPligtigVanaf", "label": "Vpb-liable from", "type": "date" },
					{ "key": "vpbPligtigTotEnMet", "label": "Vpb-liable until", "type": "date" },
					{ "key": "accountNumbers", "label": "Vpb-liable accounts", "type": "array" },
					{ "key": "toelichting", "label": "Explanation", "type": "string" }
				],
				"indexRoute": "VpbBalansLinks"
			}
		},
		{
			"id": "VpbBalansAangifte",
			"route": "/bookkeeping/vpb-balans/aangifte",
			"type": "detail",
			"title": "Vpb balance + return preparation",
			"featureFlag": "mkb-vpb",
			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"aggregation": "vpbBalansFiltered",
				"docudeskTemplate": "vpb-aangifte-voorbereiding",
				"groupBy": "costCenterId",
				"columns": [
					{ "key": "costCenterId", "label": "Business activity" },
					{ "key": "activaTotal", "label": "Assets (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "passivaTotal", "label": "Liabilities (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "resultaatTotal", "label": "Result (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "balansSluit", "label": "Balance reconciles", "type": "boolean" }
				],
				"warnings": [
					{
						"id": "unbalancedOndernemingsactiviteit",
						"source": "vpbBalansFiltered.warnings.unbalancedOndernemingsactiviteit",
						"render": "callout"
					},
					{
						"id": "orphanedVpbPligt",
						"source": "orphanedVpbPligtigAccounts.warnings.orphanedVpbPligt",
						"render": "list"
					}
				],
				"actions": [
					{
						"id": "generate-vpb-aangifte-voorbereiding",
						"label": "Generate Vpb return preparation",
						"docudeskTemplate": "vpb-aangifte-voorbereiding",
						"sbrEndpoint": "bookkeeping-sbr-xbrl-reporting"
					}
				]
			}
		}
	]
}
