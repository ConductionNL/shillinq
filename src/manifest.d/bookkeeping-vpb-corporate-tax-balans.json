{
	"menu": [
		{
			"id": "VennootschapsbelastingBalans",
			"label": "Corporate income tax (Vpb)",
			"icon": "PercentOutline",
			"order": 36,
			"children": [
				{
					"id": "VpbPligtigeAccounts",
					"label": "Vpb-liable accounts",
					"icon": "BookmarkCheckOutline",
					"route": "VpbPligtigeAccounts",
					"order": 10
				},
				{
					"id": "VpbBalansLinks",
					"label": "Business activities (Vpb balance link)",
					"icon": "LinkVariant",
					"route": "VpbBalansLinks",
					"order": 20
				},
				{
					"id": "VpbBalansAangifte",
					"label": "Vpb balance + return preparation",
					"icon": "FileDocumentMultipleOutline",
					"route": "VpbBalansAangifte",
					"order": 30
				}
			]
		}
	],
	"pages": [
		{
			"id": "VpbPligtigeAccounts",
			"route": "/bookkeeping/vpb-balans/accounts",
			"type": "index",
			"title": "Vpb-liable accounts",			"config": {
				"register": "shillinq",
				"schema": "Account",
				"filter": {
					"vpbPligtig": { "equals": true }
				},
				"columns": [
					{ "key": "accountNumber", "label": "Account number", "sortable": true },
					{ "key": "name", "label": "Name", "sortable": true },
					{ "key": "accountType", "label": "Type", "sortable": true },
					{ "key": "vpbPligtig", "label": "Vpb-liable", "sortable": true }
				],
				"search": true,
				"filters": [
					{ "key": "accountType", "label": "Type" }
				],
				"defaultSort": "accountNumber",
				"warnings": [
					{
						"id": "orphanedVpbPligt",
						"source": "VpbBalansLink:orphanedVpbPligtigAccounts.warnings.orphanedVpbPligt",
						"render": "callout"
					}
				]
			}
		},
		{
			"id": "VpbBalansLinks",
			"route": "/bookkeeping/vpb-balans/links",
			"type": "index",
			"title": "Business activities (Vpb balance link)",			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"columns": [
					{ "key": "costCenterId", "label": "Business activity", "sortable": true },
					{ "key": "vpbLiableFrom", "label": "Vpb-liable from", "sortable": true },
					{ "key": "vpbLiableToAndWith", "label": "Vpb-liable until", "sortable": true },
					{ "key": "accountNumbers", "label": "Number of accounts", "sortable": false }
				],
				"search": true,
				"defaultSort": "vpbLiableFrom",
				"detailRoute": "VpbBalansLinkDetail"
			}
		},
		{
			"id": "VpbBalansLinkDetail",
			"route": "/bookkeeping/vpb-balans/links/:id",
			"type": "detail",
			"title": "Vpb balance link",			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"_note": "CONFIG record (declares which business activity/cost-center is Vpb-liable, over which window, and exactly which GL accounts fall inside that liability). The body is that scoping definition — the liability period, the list of Vpb-liable account numbers and the explanation that substantiates the boundary — since this record IS the mapping that the Vpb balance report reads. No transactions of its own, no comms. The audit trail sidebar matters because moving an account in or out of the Vpb scope directly changes the taxable balance.",
				"fields": [
					{ "key": "costCenterId", "label": "Business activity (cost-center)", "type": "string" },
					{ "key": "vpbLiableFrom", "label": "Vpb-liable from", "type": "date" },
					{ "key": "vpbLiableToAndWith", "label": "Vpb-liable until", "type": "date" },
					{ "key": "accountNumbers", "label": "Vpb-liable accounts", "type": "array" },
					{ "key": "notes", "label": "Explanation", "type": "string" }
				],
				"indexRoute": "VpbBalansLinks",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
		{
			"id": "VpbBalansAangifte",
			"route": "/bookkeeping/vpb-balans/aangifte",
			"type": "detail",
			"title": "Vpb balance + return preparation",			"config": {
				"register": "shillinq",
				"schema": "VpbBalansLink",
				"_note": "REPORT (not a single-object detail): a computed Vpb balance grouped by business activity that prepares the corporate-tax return. It intentionally keeps its aggregation (vpbBalansFiltered), groupBy, currency columns, balance-reconciliation warnings and the generate-return docudesk/SBR action — that report machinery IS the page, so it is preserved rather than replaced with a data/relatedObjects layout. No comms leaves.",
				"aggregation": "vpbBalansFiltered",
				"docudeskTemplate": "vpb-aangifte-voorbereiding",
				"groupBy": "costCenterId",
				"columns": [
					{ "key": "costCenterId", "label": "Business activity" },
					{ "key": "activaTotal", "label": "Assets (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "passivaTotal", "label": "Liabilities (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "resultaatTotal", "label": "Result (EUR)", "type": "currency", "unit": "cents" },
					{ "key": "balansSluit", "label": "Balance reconciles", "type": "boolean" }
				],
				"warnings": [
					{
						"id": "unbalancedOndernemingsactiviteit",
						"source": "vpbBalansFiltered.warnings.unbalancedOndernemingsactiviteit",
						"render": "callout"
					},
					{
						"id": "orphanedVpbPligt",
						"source": "orphanedVpbPligtigAccounts.warnings.orphanedVpbPligt",
						"render": "list"
					}
				],
				"actions": [
					{
						"id": "generate-vpb-aangifte-voorbereiding",
						"label": "Generate Vpb return preparation",
						"docudeskTemplate": "vpb-aangifte-voorbereiding",
						"sbrEndpoint": "bookkeeping-sbr-xbrl-reporting"
					}
				]
			}
		}
	]
}
