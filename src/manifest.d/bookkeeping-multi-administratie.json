		{
			"id": "AdministratieLidmaatschapDetail",
			"route": "/administratie/lidmaatschappen/:id",
			"type": "detail",
			"title": "Access & role",
			"config": {
				"register": "shillinq",
				"schema": "AdministrationMembership",
				"_note": "ACCESS CONFIG row (who may do what in one administration). A pure authorization record — the body is the grant itself (user, role, ledger restriction, post/close rights, validity window). No children, no comms. Audit trail sidebar is essential here: a change to who may post journal entries or close a fiscal year is a segregation-of-duties event that must be traceable.",
				"fields": [
					{ "key": "userId", "label": "User", "type": "string" },
					{ "key": "administrationId", "label": "Administration", "type": "string" },
					{ "key": "role", "label": "Role", "type": "string" },
					{ "key": "ledgerAccessRestriction", "label": "Ledger restriction", "type": "array" },
					{ "key": "mayPostJournalEntries", "label": "May post journal entries", "type": "boolean" },
					{ "key": "mayCloseFiscalYear", "label": "May close fiscal year", "type": "boolean" },
					{ "key": "validFrom", "label": "Valid from", "type": "string" },
					{ "key": "validUntil", "label": "Valid until", "type": "string" }
				],
				"indexRoute": "AdministratieLidmaatschappen",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
