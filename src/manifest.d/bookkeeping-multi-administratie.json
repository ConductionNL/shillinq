	"pages": [
		{
			"id": "AdministrationSwitcher",
			"route": "/administratie/wisselen",
			"type": "custom",
			"component": "AdministrationSwitcherPage",
			"title": "Switch administration",
			"_note": "Session-scope switcher, not a record view. The page's whole job is to CHANGE the active administration for the session and reload the shell (AdministratieSwitcher, reload-after-switch); a single-membership user gets an explainer instead of a dropdown (REQ-MA-003). The Administrations themselves already have index/detail pages — this page writes session state rather than reading or editing an object, which no standard page type does. See src/views/AdministrationSwitcherPage.vue."
		},
		{
			"id": "Administraties",
			"route": "/administratie/administraties",
			"type": "index",
			"title": "Administrations",
			"config": {
				"register": "shillinq",
				"schema": "Administration",
				"columns": [
					{ "key": "administrationCode", "label": "Code", "sortable": true },
					{ "key": "name", "label": "Name", "sortable": true },
					{ "key": "legalForm", "label": "Legal form", "sortable": true },
					{ "key": "kvkNumber", "label": "KvK", "sortable": true },
					{ "key": "vatRegime", "label": "BTW regime", "sortable": true },
					{ "key": "status", "label": "Status", "sortable": true },
					{ "key": "backupSchedule", "label": "Backup", "sortable": true }
				],
				"defaultSort": "administrationCode",
				"detailRoute": "AdministratieDetail"
			}
		},
		{
			"id": "AdministratieDetail",
			"route": "/administratie/administraties/:id",
			"type": "detail",
			"title": "Administration",
			"config": {
				"register": "shillinq",
				"schema": "Administration",
				"_note": "MASTER record (the legal entity/administration that scopes every other object via administrationId). The body pairs the fiscal identity + consolidation settings with the two child registers most tied to this entity: who has access (AdministrationMembership) and the intercompany entries it participates in. This is the setup + governance view for one administration. No comms leaves (a company file is not a correspondent). Audit trail sidebar records fiscal-year/consolidation config changes.",
				"fields": [
					{ "key": "administrationCode", "label": "Administration code", "type": "string" },
					{ "key": "name", "label": "Name", "type": "string" },
					{ "key": "legalForm", "label": "Legal form", "type": "string" },
					{ "key": "kvkNumber", "label": "KvK number", "type": "string" },
					{ "key": "rsin", "label": "RSIN", "type": "string" },
					{ "key": "vatNumber", "label": "BTW number", "type": "string" },
					{ "key": "payrollTaxNumber", "label": "Payroll tax number", "type": "string" },
					{ "key": "parentAdministrationId", "label": "Parent administration", "type": "string" },
					{ "key": "childAdministrationIds", "label": "Child administrations", "type": "array" },
					{ "key": "consolidateIntoId", "label": "Consolidate into", "type": "string" },
					{ "key": "consolidationMethod", "label": "Consolidation method", "type": "string" },
					{ "key": "fiscalUnitVpbId", "label": "Fiscal unit (Vpb)", "type": "string" },
					{ "key": "fiscalUnitVatId", "label": "Fiscal unit (BTW)", "type": "string" },
					{ "key": "fiscalYearStartMonth", "label": "Fiscal year start month", "type": "number" },
					{ "key": "nonCalendarFiscalYear", "label": "Non-calendar fiscal year", "type": "boolean" },
					{ "key": "presentationCurrency", "label": "Presentation currency", "type": "string" },
					{ "key": "vatRegime", "label": "BTW regime", "type": "string" },
					{ "key": "vatFilingFrequency", "label": "BTW filing frequency", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" },
					{ "key": "backupSchedule", "label": "Backup schedule", "type": "string" },
					{ "key": "dataRetentionYears", "label": "Data retention (years)", "type": "number" },
					{ "key": "defaultLanguage", "label": "Default language", "type": "string" }
				],
				"relatedObjects": [
					{
						"id": "memberships",
						"label": "Access & roles",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "AdministrationMembership",
							"filterField": "administrationId",
							"columns": ["userId", "role", "mayPostJournalEntries", "mayCloseFiscalYear", "validUntil"]
						}
					},
					{
						"id": "intercompany",
						"label": "Intercompany entries (as source)",
						"componentName": "openregister-related-list",
						"componentProps": {
							"register": "shillinq",
							"schema": "IntercompanyJournalEntry",
							"filterField": "sourceAdministrationId",
							"columns": ["intercompanyNumber", "date", "kind", "destinationAdministrationId", "amount", "status"]
						}
					}
				],
				"indexRoute": "Administraties",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
