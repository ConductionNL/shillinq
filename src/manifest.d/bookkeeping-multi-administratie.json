		},
		{
			"id": "ConsolidatieMappingDetail",
			"route": "/administratie/consolidatie-mappings/:id",
			"type": "detail",
			"title": "Consolidation mapping",
			"config": {
				"register": "shillinq",
				"schema": "ConsolidationMapping",
				"_note": "CONFIG record (the ruleset that maps a subsidiary's accounts into the parent when consolidating). The body is the mapping definition — source/target administration, the rules array, the intercompany elimination account and the currency-translation method that governs FX on consolidation. No transactions of its own, no comms. Audit trail sidebar matters because a mapping change silently alters every future consolidation.",
				"fields": [
					{ "key": "name", "label": "Name", "type": "string" },
					{ "key": "sourceAdministrationId", "label": "Source administration", "type": "string" },
					{ "key": "destinationAdministrationId", "label": "Target administration", "type": "string" },
					{ "key": "rules", "label": "Mapping rules", "type": "array" },
					{ "key": "intercompanyEliminationAccount", "label": "IC elimination account", "type": "string" },
					{ "key": "currencyTranslationMethod", "label": "Currency translation method", "type": "string" },
					{ "key": "validFrom", "label": "Valid from", "type": "string" }
				],
				"indexRoute": "ConsolidatieMappings",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
