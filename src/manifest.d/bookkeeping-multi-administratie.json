		{
			"id": "AdministratieMigratieDetail",
			"route": "/administratie/migraties/:id",
			"type": "detail",
			"title": "Asset transfer",
			"config": {
				"register": "shillinq",
				"schema": "AdministrationMigration",
				"_note": "TRANSACTION with a paper trail (an asset transfer between administrations). The body shows both legs, the book/market values transferred, the result impact and the fiscal/legal basis that justifies the transfer. A Documents tab surfaces the underlying agreements/valuations (documentIds file references) because an asset transfer must be substantiated, and the audit trail sidebar records the posting. No comms leaves.",
				"fields": [
					{ "key": "migrationNumber", "label": "Number", "type": "string" },
					{ "key": "date", "label": "Date", "type": "string" },
					{ "key": "kind", "label": "Kind", "type": "string" },
					{ "key": "sourceAdministrationId", "label": "Source administration", "type": "string" },
					{ "key": "destinationAdministrationId", "label": "Target administration", "type": "string" },
					{ "key": "objectIds", "label": "Transferred objects", "type": "array" },
					{ "key": "bookValueTransferred", "label": "Book value", "type": "number" },
					{ "key": "marketValueTransferred", "label": "Market value", "type": "number" },
					{ "key": "resultImpact", "label": "Impact on result", "type": "number" },
					{ "key": "fiscalTreatment", "label": "Fiscal treatment", "type": "string" },
					{ "key": "legalBasis", "label": "Legal basis", "type": "string" },
					{ "key": "sourceJournalEntryId", "label": "Source journal entry", "type": "string" },
					{ "key": "destinationJournalEntryId", "label": "Target journal entry", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" }
				],
