		{
			"id": "IntercompanyBoekingDetail",
			"route": "/administratie/intercompany/:id",
			"type": "detail",
			"title": "Intercompany journal entry",
			"config": {
				"register": "shillinq",
				"schema": "IntercompanyJournalEntry",
				"_note": "TRANSACTION (a mirrored booking between two administrations). The body carries both legs — source/target administration and their journal-entry references — plus amount, BTW treatment and the elimination settings that drive consolidation. The variance field is the reconciliation check. It links to journal entries by id rather than owning child lines, so no object-list. No comms. Audit trail sidebar is the immutable posting record.",
				"fields": [
					{ "key": "intercompanyNumber", "label": "IC number", "type": "string" },
					{ "key": "date", "label": "Date", "type": "string" },
					{ "key": "kind", "label": "Kind", "type": "string" },
					{ "key": "sourceAdministrationId", "label": "Source administration", "type": "string" },
					{ "key": "destinationAdministrationId", "label": "Target administration", "type": "string" },
					{ "key": "sourceJournalEntryId", "label": "Source journal entry", "type": "string" },
					{ "key": "destinationJournalEntryId", "label": "Target journal entry", "type": "string" },
					{ "key": "amount", "label": "Amount", "type": "number" },
					{ "key": "currency", "label": "Currency", "type": "string" },
					{ "key": "vatTreatment", "label": "BTW treatment", "type": "string" },
					{ "key": "eliminateOnConsolidation", "label": "Eliminate on consolidation", "type": "boolean" },
					{ "key": "eliminationAccount", "label": "Elimination account", "type": "string" },
					{ "key": "status", "label": "Status", "type": "string" },
					{ "key": "varianceAmount", "label": "Variance", "type": "number" }
				],
				"indexRoute": "IntercompanyBoekingen",
				"sidebarProps": {
					"tabs": [
						{
							"id": "audit",
							"label": "Audit Trail",
							"icon": "History",
							"order": 90,
							"widgets": [
								{
									"type": "data",
									"componentName": "openregister-audit-trail",
									"props": {
										"source": "/index.php/apps/openregister/api/objects/shillinq/:schema/:id/audit-trails",
										"collapsed": true
									}
								}
							]
						}
					]
				}
			}
		},
		{
