<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/10.5/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheDirectory=".phpunit.cache"
         executionOrder="depends,defects"
         requireCoverageMetadata="false"
         beStrictAboutCoverageMetadata="true"
         beStrictAboutOutputDuringTests="true"
         failOnRisky="true"
         failOnWarning="false"
         failOnDeprecation="false">

    <!--
        Kept in step with phpunit-unit.xml. CI's shared quality workflow prefers
        phpunit.xml when it exists, while `composer test:unit` runs
        phpunit-unit.xml — so a testsuite that differs between the two means CI
        and the developer are measuring different things.
    -->
    <testsuites>
        <testsuite name="Unit Tests">
            <directory>tests/Unit</directory>
            <directory>tests/unit</directory>
            <!--
                tests/Integration/ as a whole is not wired into this suite yet
                (pre-existing gap). These two files are pure declarative
                (register-JSON + seed-fixture) tests with no OpenRegister
                runtime dependency.
            -->
            <file>tests/Integration/SalesOrderSeedDataIntegrationTest.php</file>
            <file>tests/Integration/ModelOrReferencesPilotSeedIntegrationTest.php</file>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory suffix=".php">lib/</directory>
        </include>
        <exclude>
            <directory>lib/Migration/</directory>
            <file>lib/AppInfo/Application.php</file>
        </exclude>
    </source>

    <coverage>
        <report>
            <clover outputFile="coverage/clover.xml"/>
            <html outputDirectory="coverage/html"/>
            <text outputFile="php://stdout" showUncoveredFiles="false"/>
        </report>
    </coverage>

    <php>
        <env name="PHPUNIT_RUN" value="1"/>
        <!--
            Hard memory cap for every PHPUnit run. The CLI php.ini on developer
            machines sets memory_limit=-1, so a runaway test has nothing to stop
            it: on 2026-09-08 one openregister test recursed inside the DI
            container and took 19 GB of RAM. The Unit suite of this app peaks at
            181 MB without coverage; 1G leaves room for coverage runs and
            still fails a leak within seconds. Raise it here, with the new
            measurement, never with -d memory_limit on the command line.

            The value predates the fleet cap: ~3960 tests exhausted PHP's stock
            128M CLI limit at roughly 89% through, dying with a fatal "Allowed
            memory size exhausted", and a fatal mid-run never prints the summary
            line, so nothing reported how many tests actually ran. Keep this in
            sync with phpunit-unit.xml.
        -->
        <ini name="memory_limit" value="1G"/>
    </php>
</phpunit>
