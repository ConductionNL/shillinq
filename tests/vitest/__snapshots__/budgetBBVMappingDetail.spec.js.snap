exports[`BudgetBBVMappingDetail refreshAllocationProjection > bare list on create counts the own id 1`] = `
{
  "calls": [
    [
      "/index.php/apps/openregister/api/objects/shillinq/BudgetBBVMapping",
      {
        "params": {
          "glAccountNumber": "4000",
          "status": "active",
        },
      },
    ],
  ],
