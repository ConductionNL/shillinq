{
	"ShillinqContractPanel.vue": [
		".shillinq-contract-panel { padding: 8px;",
		".shillinq-leaf__description, .shillinq-leaf__due, .shillinq-leaf__empty { color: var(--color-text-maxcontrast); margin: 4px 0;",
		".shillinq-leaf__error { color: var(--color-error);",
		".shillinq-leaf__list { list-style: none; margin: 0; padding: 0;",
		".shillinq-leaf__notice { margin-top: 8px;",
		".shillinq-leaf__row { border-bottom: 1px solid var(--color-border); padding: 8px 0;",
		".shillinq-leaf__row-head { display: flex; justify-content: space-between; gap: 8px; font-weight: bold;",
		".shillinq-leaf__state { color: var(--color-text-maxcontrast); font-weight: normal;",
		".shillinq-leaf__state--attention { color: var(--color-warning-text, var(--color-warning));"
	],
	"ShillinqFinancialDocumentsPanel.vue": [
		".shillinq-financial-documents-panel { padding: 8px;",
		".shillinq-leaf__actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;",
		".shillinq-leaf__error { color: var(--color-error);",
		".shillinq-leaf__form input, .shillinq-leaf__form select { width: 100%;",
		".shillinq-leaf__form { display: flex; flex-direction: column; gap: 4px; margin-top: 8px;",
		".shillinq-leaf__list { list-style: none; margin: 0; padding: 0;",
		".shillinq-leaf__notice { margin-top: 8px;",
		".shillinq-leaf__row { border-bottom: 1px solid var(--color-border); padding: 8px 0;",
		".shillinq-leaf__row-head { display: flex; justify-content: space-between; gap: 8px; font-weight: bold;",
		".shillinq-leaf__state, .shillinq-leaf__description, .shillinq-leaf__due, .shillinq-leaf__empty { color: var(--color-text-maxcontrast); font-weight: normal; margin: 4px 0;"
	],
	"ShillinqPaymentRequestsPanel.vue": [
		".shillinq-leaf__actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap;",
		".shillinq-leaf__description, .shillinq-leaf__due, .shillinq-leaf__fee, .shillinq-leaf__empty { color: var(--color-text-maxcontrast); margin: 4px 0;",
		".shillinq-leaf__error { color: var(--color-error);",
		".shillinq-leaf__list { list-style: none; margin: 0; padding: 0;",
		".shillinq-leaf__notice { margin-top: 8px;",
		".shillinq-leaf__row { border-bottom: 1px solid var(--color-border); padding: 8px 0;",
		".shillinq-leaf__row-head { display: flex; justify-content: space-between; gap: 8px; font-weight: bold;",
		".shillinq-leaf__settle input, .shillinq-leaf__settle select { width: 100%;",
		".shillinq-leaf__settle { display: flex; flex-direction: column; gap: 4px; margin-top: 8px;",
		".shillinq-leaf__state { color: var(--color-text-maxcontrast); font-weight: normal;",
		".shillinq-payment-requests-panel { padding: 8px;"
	]
}
