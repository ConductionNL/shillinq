{
	"info": {
		"_postman_id": "shillinq-bookkeeping-tenderned-integratie",
		"name": "Shillinq Bookkeeping TenderNed Integratie",
		"description": "Newman integration tests for bookkeeping-tenderned-integratie. Exercises the four REQ-NNN flows end-to-end against a live Nextcloud + OpenRegister instance:\n\n- REQ-001 — import a TenderNed dossier into a concept Commitment (POST /objects/.../TenderNedProcurement, POST /objects/.../Commitment source=tenderned/status=concept).\n- REQ-002 — auto-promote an awarded dossier (PATCH the aanbesteding to status=gegund and observe the linked Commitment becoming active via OR lifecycle / shillinq listeners).\n- REQ-004 — block OrderFulfilment completion without a bewijsstuk (POST without supportingDocuments should 4xx or remain in 'in-progress').\n- REQ-006 — buyer-only completion gate: a vendor cannot mark the eindoplevering as completed (PATCH with vendor-user 4xx).\n\nThere are NO bespoke shillinq HTTP controllers for this change (Task 9: declarative OR CRUD + lifecycle transitions only); the collection therefore drives the OR /api/objects surface and asserts the schema's lifecycle/guard behaviour. The Guard preconditions are also unit-tested via PHPUnit — this Newman run is the live end-to-end smoke.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Nextcloud rejects API requests without the OCS-APIRequest header",
					"// (or a CSRF requesttoken) with 412 'CSRF check failed'. Inject it on",
					"// every request from this collection so individual requests need not",
					"// each declare it. upsert() overrides any per-request value.",
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });"
				]
			}
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{admin_user}}", "type": "string" },
			{ "key": "password", "value": "{{admin_password}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "admin_user", "value": "admin", "type": "string" },
		{ "key": "admin_password", "value": "admin", "type": "string" },
		{ "key": "register_slug", "value": "shillinq", "type": "string" },
		{ "key": "tender_aanbesteding_id", "value": "TN-NEWMAN-0001", "type": "string" },
		{ "key": "tender_aanbestedende_dienst", "value": "30280353 Gemeente Utrecht (Newman)", "type": "string" },
		{ "key": "tender_supplier", "value": "30280353 Gemeente Utrecht (Newman)", "type": "string" },
		{ "key": "administration_id", "value": "newman-adm", "type": "string" },
		{ "key": "aanbesteding_uuid", "value": "", "type": "string" },
		{ "key": "verplichting_uuid", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "REQ-001 — Import a concept TenderNed dossier",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/TenderNedProcurement",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "TenderNedProcurement"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"tenderId\": \"{{tender_aanbesteding_id}}\",\n  \"title\": \"Newman test tender — schoonmaak Utrecht\",\n  \"contractingService\": \"{{tender_aanbestedende_dienst}}\",\n  \"awardedSupplier\": \"{{tender_supplier}}\",\n  \"contractValue\": 50000.0,\n  \"assignmentType\": \"delivery-in-phases\",\n  \"termStart\": \"2026-07-01\",\n  \"termEnd\": \"2027-06-30\",\n  \"administrationId\": \"{{administration_id}}\",\n  \"status\": \"open\",\n  \"tenderNedUrl\": \"https://www.tenderned.nl/aankondigingen/overzicht/{{tender_aanbesteding_id}}\"\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('TenderNedProcurement created (200/201)', function () {",
						"    pm.expect([200, 201]).to.include(pm.response.code);",
						"    const body = pm.response.json();",
						"    const uuid = body.uuid || body['@self']?.uuid || body.id;",
						"    pm.expect(uuid).to.be.a('string').and.not.equal('');",
						"    pm.collectionVariables.set('aanbesteding_uuid', String(uuid));",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-001 — Create the linked concept Commitment",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/Commitment",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "Commitment"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"commitmentNumber\": \"V-NEWMAN-0001\",\n  \"description\": \"Newman concept obligation\",\n  \"kind\": \"inkooporder\",\n  \"source\": \"tenderned\",\n  \"sourceReference\": \"{{tender_aanbesteding_id}}\",\n  \"amount\": 50000.0,\n  \"termStart\": \"2026-07-01\",\n  \"termEnd\": \"2027-06-30\",\n  \"status\": \"draft\",\n  \"administrationId\": \"{{administration_id}}\",\n  \"milestones\": []\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Commitment created in concept state', function () {",
						"    pm.expect([200, 201]).to.include(pm.response.code);",
						"    const body = pm.response.json();",
						"    pm.expect(body.source || body.object?.source).to.equal('tenderned');",
						"    pm.expect(body.sourceReference || body.object?.sourceReference).to.equal(pm.collectionVariables.get('tender_aanbesteding_id'));",
						"    const uuid = body.uuid || body['@self']?.uuid || body.id;",
						"    pm.collectionVariables.set('verplichtingen_uuid', String(uuid));",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-008 — Mijn Contracten filter returns the tenderned-sourced row",
			"request": {
				"method": "GET",
				"description": "Property filters on the OpenRegister objects endpoint are BARE property names (`?source=…&sourceReference=…`). ObjectsController::getConfig() assigns the WHOLE request parameter bag to `filters`, so `filters[source]=…` arrives as a filter on a property literally named `filters` — which no schema declares, so it matches nothing and the endpoint answers `200` with `total: 0`. A filter on a non-property fails silently; it does not error. Reserved parameters are underscore-prefixed (`_limit`, `_page`, `_search`, `_order`, `_extend`, `_fields`). Measured live against openregister on 2026-08-17 with one seeded row: `filters[source]=tenderned&filters[sourceReference]=TN-PROBE-0001` → total 0; `source=tenderned&sourceReference=TN-PROBE-0001` → total 1.",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/Commitment?source=tenderned&sourceReference={{tender_aanbesteding_id}}",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "Commitment"],
					"query": [
						{ "key": "source", "value": "tenderned" },
						{ "key": "sourceReference", "value": "{{tender_aanbesteding_id}}" }
					]
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('200 with the filtered Commitment present', function () {",
						"    pm.expect(pm.response.code).to.equal(200);",
						"    const body = pm.response.json();",
						"    const rows = body.results || body.objects || body;",
						"    pm.expect(Array.isArray(rows)).to.be.true;",
						"    pm.expect(rows.length).to.be.at.least(1);",
						"    const found = rows.find(r => (r.sourceReference || r.object?.sourceReference) === pm.collectionVariables.get('tender_aanbesteding_id'));",
						"    pm.expect(found, 'Commitment with the expected sourceReference').to.not.be.undefined;",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-004 — Bewijsstuk-required gate: completion attempt without proof",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/OrderFulfilment",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "OrderFulfilment"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"commitmentId\": \"V-NEWMAN-0001\",\n  \"milestoneId\": \"MS-001\",\n  \"deliveryType\": \"deeloplevering\",\n  \"deliveryDate\": \"2026-10-01\",\n  \"approved\": false,\n  \"status\": \"completed\",\n  \"supportingDocuments\": [],\n  \"administrationId\": \"{{administration_id}}\"\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Guard gate either rejects (4xx) or persists with status != completed', function () {",
						"    if (pm.response.code >= 400) {",
						"        // Hard 4xx from the lifecycle guard is the strict contract.",
						"        pm.expect(pm.response.code).to.be.within(400, 499);",
						"        return;",
						"    }",
						"    // OR may also accept the write but reject the lifecycle transition, in which",
						"    // case the persisted status MUST NOT be 'completed' (the bewijsstuk-required",
						"    // OrderFulfilmentGuard denies it).",
						"    const body = pm.response.json();",
						"    const status = body.status || body.object?.status;",
						"    pm.expect(status).to.not.equal('completed');",
						"});"
					]
				}
			}]
		},
		{
			"name": "Cleanup — delete the Newman aanbesteding",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/TenderNedProcurement/{{aanbesteding_uuid}}",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "TenderNedProcurement", "{{aanbesteding_uuid}}"]
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Cleanup status is 2xx or 404 (already absent)', function () {",
						"    pm.expect(pm.response.code === 404 || (pm.response.code >= 200 && pm.response.code < 300)).to.be.true;",
						"});"
					]
				}
			}]
		}
	]
}
