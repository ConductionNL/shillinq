{
	"info": {
		"_postman_id": "shillinq-bookkeeping-tenderned-integratie",
		"name": "Shillinq Bookkeeping TenderNed Integratie",
		"description": "Newman integration tests for bookkeeping-tenderned-integratie. Exercises the four REQ-NNN flows end-to-end against a live Nextcloud + OpenRegister instance:\n\n- REQ-001 — import a TenderNed dossier into a concept Verplichting (POST /objects/.../TenderNedAanbesteding, POST /objects/.../Verplichting bron=tenderned/status=concept).\n- REQ-002 — auto-promote an awarded dossier (PATCH the aanbesteding to status=gegund and observe the linked Verplichting becoming active via OR lifecycle / shillinq listeners).\n- REQ-004 — block OpdrachtUitvoering completion without a bewijsstuk (POST without bewijsstukken should 4xx or remain in 'in-progress').\n- REQ-006 — buyer-only completion gate: a vendor cannot mark the eindoplevering as completed (PATCH with vendor-user 4xx).\n\nThere are NO bespoke shillinq HTTP controllers for this change (Task 9: declarative OR CRUD + lifecycle transitions only); the collection therefore drives the OR /api/objects surface and asserts the schema's lifecycle/guard behaviour. The Guard preconditions are also unit-tested via PHPUnit — this Newman run is the live end-to-end smoke.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Nextcloud rejects API requests without the OCS-APIRequest header",
					"// (or a CSRF requesttoken) with 412 'CSRF check failed'. Inject it on",
					"// every request from this collection so individual requests need not",
					"// each declare it. upsert() overrides any per-request value.",
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });"
				]
			}
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{ "key": "username", "value": "{{admin_user}}", "type": "string" },
			{ "key": "password", "value": "{{admin_password}}", "type": "string" }
		]
	},
	"variable": [
		{ "key": "base_url", "value": "http://localhost:8080", "type": "string" },
		{ "key": "admin_user", "value": "admin", "type": "string" },
		{ "key": "admin_password", "value": "admin", "type": "string" },
		{ "key": "register_slug", "value": "shillinq", "type": "string" },
		{ "key": "tender_aanbesteding_id", "value": "TN-NEWMAN-0001", "type": "string" },
		{ "key": "tender_aanbestedende_dienst", "value": "30280353 Gemeente Utrecht (Newman)", "type": "string" },
		{ "key": "tender_supplier", "value": "30280353 Gemeente Utrecht (Newman)", "type": "string" },
		{ "key": "administration_id", "value": "newman-adm", "type": "string" },
		{ "key": "aanbesteding_uuid", "value": "", "type": "string" },
		{ "key": "verplichting_uuid", "value": "", "type": "string" }
	],
	"item": [
		{
			"name": "REQ-001 — Import a concept TenderNed dossier",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/TenderNedAanbesteding",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "TenderNedAanbesteding"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"aanbestedingId\": \"{{tender_aanbesteding_id}}\",\n  \"titel\": \"Newman test tender — schoonmaak Utrecht\",\n  \"aanbestedendeDienst\": \"{{tender_aanbestedende_dienst}}\",\n  \"gegundeLeverancier\": \"{{tender_supplier}}\",\n  \"contractWaarde\": 50000.0,\n  \"opdrachttype\": \"levering-in-fases\",\n  \"looptijdStart\": \"2026-07-01\",\n  \"looptijdEind\": \"2027-06-30\",\n  \"administrationId\": \"{{administration_id}}\",\n  \"status\": \"open\",\n  \"tenderNedUrl\": \"https://www.tenderned.nl/aankondigingen/overzicht/{{tender_aanbesteding_id}}\"\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('TenderNedAanbesteding created (200/201)', function () {",
						"    pm.expect([200, 201]).to.include(pm.response.code);",
						"    const body = pm.response.json();",
						"    const uuid = body.uuid || body['@self']?.uuid || body.id;",
						"    pm.expect(uuid).to.be.a('string').and.not.equal('');",
						"    pm.collectionVariables.set('aanbesteding_uuid', String(uuid));",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-001 — Create the linked concept Verplichting",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/Verplichting",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "Verplichting"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"verplichtingsnummer\": \"V-NEWMAN-0001\",\n  \"soort\": \"inkooporder\",\n  \"omschrijving\": \"Newman concept obligation\",\n  \"bron\": \"tenderned\",\n  \"bronReferentie\": \"{{tender_aanbesteding_id}}\",\n  \"bedrag\": 50000.0,\n  \"looptijdStart\": \"2026-07-01\",\n  \"looptijdEind\": \"2027-06-30\",\n  \"status\": \"concept\",\n  \"administrationId\": \"{{administration_id}}\",\n  \"mijlpalen\": []\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Verplichting created in concept state', function () {",
						"    pm.expect([200, 201]).to.include(pm.response.code);",
						"    const body = pm.response.json();",
						"    pm.expect(body.bron || body.object?.bron).to.equal('tenderned');",
						"    pm.expect(body.bronReferentie || body.object?.bronReferentie).to.equal(pm.collectionVariables.get('tender_aanbesteding_id'));",
						"    const uuid = body.uuid || body['@self']?.uuid || body.id;",
						"    pm.collectionVariables.set('verplichtingen_uuid', String(uuid));",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-008 — Mijn Contracten filter returns the tenderned-sourced row",
			"request": {
				"method": "GET",
				"header": [
					{ "key": "Accept", "value": "application/json" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/Verplichting?filters[bron]=tenderned&filters[bronReferentie]={{tender_aanbesteding_id}}",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "Verplichting"],
					"query": [
						{ "key": "filters[bron]", "value": "tenderned" },
						{ "key": "filters[bronReferentie]", "value": "{{tender_aanbesteding_id}}" }
					]
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('200 with the filtered Verplichting present', function () {",
						"    pm.expect(pm.response.code).to.equal(200);",
						"    const body = pm.response.json();",
						"    const rows = body.results || body.objects || body;",
						"    pm.expect(Array.isArray(rows)).to.be.true;",
						"    pm.expect(rows.length).to.be.at.least(1);",
						"    const found = rows.find(r => (r.bronReferentie || r.object?.bronReferentie) === pm.collectionVariables.get('tender_aanbesteding_id'));",
						"    pm.expect(found, 'Verplichting with the expected bronReferentie').to.not.be.undefined;",
						"});"
					]
				}
			}]
		},
		{
			"name": "REQ-004 — Bewijsstuk-required gate: completion attempt without proof",
			"request": {
				"method": "POST",
				"header": [
					{ "key": "Content-Type", "value": "application/json" },
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/OpdrachtUitvoering",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "OpdrachtUitvoering"]
				},
				"body": {
					"mode": "raw",
					"raw": "{\n  \"verplichtingId\": \"V-NEWMAN-0001\",\n  \"mijlpaalId\": \"MS-001\",\n  \"opleveringsType\": \"deeloplevering\",\n  \"opleveringsDatum\": \"2026-10-01\",\n  \"goedgekeurd\": false,\n  \"status\": \"completed\",\n  \"bewijsstukken\": [],\n  \"administrationId\": \"{{administration_id}}\"\n}"
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Guard gate either rejects (4xx) or persists with status != completed', function () {",
						"    if (pm.response.code >= 400) {",
						"        // Hard 4xx from the lifecycle guard is the strict contract.",
						"        pm.expect(pm.response.code).to.be.within(400, 499);",
						"        return;",
						"    }",
						"    // OR may also accept the write but reject the lifecycle transition, in which",
						"    // case the persisted status MUST NOT be 'completed' (the bewijsstuk-required",
						"    // OpdrachtUitvoeringGuard denies it).",
						"    const body = pm.response.json();",
						"    const status = body.status || body.object?.status;",
						"    pm.expect(status).to.not.equal('completed');",
						"});"
					]
				}
			}]
		},
		{
			"name": "Cleanup — delete the Newman aanbesteding",
			"request": {
				"method": "DELETE",
				"header": [
					{ "key": "Accept", "value": "application/json" },
					{ "key": "OCS-APIRequest", "value": "true" }
				],
				"url": {
					"raw": "{{base_url}}/index.php/apps/openregister/api/objects/{{register_slug}}/TenderNedAanbesteding/{{aanbesteding_uuid}}",
					"host": ["{{base_url}}"],
					"path": ["index.php", "apps", "openregister", "api", "objects", "{{register_slug}}", "TenderNedAanbesteding", "{{aanbesteding_uuid}}"]
				}
			},
			"event": [{
				"listen": "test",
				"script": {
					"type": "text/javascript",
					"exec": [
						"pm.test('Cleanup status is 2xx or 404 (already absent)', function () {",
						"    pm.expect(pm.response.code === 404 || (pm.response.code >= 200 && pm.response.code < 300)).to.be.true;",
						"});"
					]
				}
			}]
		}
	]
}
