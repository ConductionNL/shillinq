{
	"info": {
		"_postman_id": "shillinq-collection",
		"name": "Shillinq Integration Tests",
		"description": "Integration test collection for the shillinq Nextcloud app.\nReplace this with your actual API tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Nextcloud rejects API requests without the OCS-APIRequest header",
					"// (or a CSRF requesttoken) with 412 'CSRF check failed'. Inject it on",
					"// every request from this collection so individual requests need not",
					"// each declare it. upsert() overrides any per-request value.",
					"pm.request.headers.upsert({ key: 'OCS-APIRequest', value: 'true' });"
				]
			}
		}
	],
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_user",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "admin_password",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "administration_id",
			"value": "adm-smb-1",
			"type": "string"
		},
		{
			"key": "period_id_open",
			"value": "2026-04",
			"type": "string"
		},
		{
			"key": "period_id_closed",
			"value": "2026-02",
			"type": "string"
		},
		{
			"key": "period_id_locked",
			"value": "2026-01",
			"type": "string"
		},
		{
			"key": "calendar_id",
			"value": "cal-001",
			"type": "string"
		},
		{
			"key": "resource_id",
			"value": "res-001",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Period Close",
			"description": "bookkeeping-period-close (T2): guided close lifecycle + AI close-assistant flags. Requires the period-close register fragment seeded (adm-smb-1 periods 2026-01..2026-04) and the acting user in the period-closer / auditor group for the privileged transitions.",
			"item": [
				{
					"name": "GET period detail + AI flags",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}?administration_id={{administration_id}}",
						"description": "REQ-PC-005: fetch the period detail with freshly-computed close-assistant flags."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 with period data', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.data).to.have.property('periodId');",
									"    pm.expect(json.data).to.have.property('aiFlags');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET AI flags",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/ai-flags?administration_id={{administration_id}}",
						"description": "REQ-PC-004: fetch only the close-assistant flags for the period."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 with flags array', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data).to.be.an('array');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET missing administration_id → 400",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}",
						"description": "ADR-005: administration scope is required."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('400 bad request', function () {",
									"    pm.response.to.have.status(400);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST start-close (open → closing)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/start-close",
						"description": "REQ-PC-002: begin the guided close (period-closer role)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to closing', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('closing');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST close (closing → closed)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/close",
						"description": "REQ-PC-002: freeze the period after mandatory checklist items resolve."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to closed', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('closed');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST reopen without reason → 422",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\",\"closeReason\":\"\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_closed}}/reopen",
						"description": "REQ-PC-006: a non-empty close reason is required to reopen."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 validation error', function () {",
									"    pm.response.to.have.status(422);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST reopen with reason (closed → open)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\",\"closeReason\":\"Posted correction for invoice #2026-0042\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_closed}}/reopen",
						"description": "REQ-PC-006: reopen a closed period with an audit-trailed reason."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to open', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('open');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST lock-audit on audit-locked → 409",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_locked}}/lock-audit",
						"description": "REQ-PC-002: an already audit-locked period rejects further transitions (terminal state)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('409 invalid state', function () {",
									"    pm.response.to.have.status(409);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "AR E-Invoicing (Peppol)",
			"item": [
				{
					"name": "Send e-invoice without administrationId is rejected",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/ar-invoices/2026-0042/send-einvoice",
						"description": "REQ-EINV-005: the send action requires an explicit administration scope — a body without administrationId is a 400, and nothing is transmitted."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('400 administrationId required', function () {",
									"    pm.response.to.have.status(400);",
									"    const json = pm.response.json();",
									"    pm.expect(json.error).to.include('administrationId');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "Send e-invoice for unknown invoice is an IDOR-safe 404",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"administrationId\": \"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/ar-invoices/NO-SUCH-INVOICE-9999/send-einvoice",
						"description": "REQ-EINV-005: an invoice that does not exist in the caller's administration (or belongs to another tenant) is masked as 404 — the endpoint never discloses cross-tenant existence (ADR-005, no IDOR)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('404 not found (IDOR-safe mask)', function () {",
									"    pm.response.to.have.status(404);",
									"    const json = pm.response.json();",
									"    pm.expect(json.error).to.include('not found');",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Nextcloud status",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/status.php",
						"description": "Verify Nextcloud is running."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Nextcloud is running', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.installed).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Bookings Resource Calendar",
			"description": "bookings-resource-calendar (REQ-005): calendar listing, single-calendar lookup, bookings range query, and conflict-aware POST. Tolerant of seed-absent dev containers — assertions accept 200 OR 404 on read paths so the Newman run is green on a fresh install while still verifying the route shape and JSON contract.",
			"item": [
				{
					"name": "GET /api/v2/calendars (list)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/shillinq/api/v2/calendars",
						"description": "REQ-005: list all calendars. Returns 200 with a JSON array (possibly empty when no seed data is loaded)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 or 503 (register absent on fresh container)', function () {",
									"    pm.expect([200, 503]).to.include(pm.response.code);",
									"    if (pm.response.code !== 200) { return; }",
									"    const body = pm.response.json();",
									"    const list = body.data ?? body;",
									"    pm.expect(list).to.be.an('array');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET /api/v2/calendars?resource=res-001 (filter)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/shillinq/api/v2/calendars?resource={{resource_id}}",
						"description": "REQ-005: filter calendars by resource. Empty array is a valid response on a fresh container."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 or 503 (register absent on fresh container)', function () {",
									"    pm.expect([200, 503]).to.include(pm.response.code);",
									"    if (pm.response.code !== 200) { return; }",
									"    const body = pm.response.json();",
									"    const list = body.data ?? body;",
									"    pm.expect(list).to.be.an('array');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET /api/v2/calendars/{id} (detail)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/shillinq/api/v2/calendars/{{calendar_id}}",
						"description": "REQ-005: fetch a single calendar by id. 200 when seeded, 404 on a fresh container — both are accepted."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 or 404 (seed-dependent)', function () {",
									"    pm.expect([200, 404, 503]).to.include(pm.response.code);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET /api/v2/calendars/{id}/bookings?start=...&end=... (range)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/shillinq/api/v2/calendars/{{calendar_id}}/bookings?start=2026-05-21&end=2026-05-31",
						"description": "REQ-005: list bookings for a calendar in a date range, sorted by startTime."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 or 404 (seed-dependent)', function () {",
									"    pm.expect([200, 404, 503]).to.include(pm.response.code);",
									"    if (pm.response.code === 200) {",
									"        const body = pm.response.json();",
									"        const list = body.data ?? body;",
									"        pm.expect(list).to.be.an('array');",
									"    }",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST /api/v2/calendars/{id}/bookings (create)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"title\":\"Newman integration test booking\",\"startTime\":\"2030-01-01T10:00:00Z\",\"endTime\":\"2030-01-01T10:30:00Z\",\"attendee\":\"newman@example.com\",\"status\":\"pending\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/v2/calendars/{{calendar_id}}/bookings",
						"description": "REQ-005 + REQ-004: create a booking. Returns 201 on success, 409 on overlap with an existing booking, 404 when the calendar is absent on a fresh container."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('201, 409 or 404 (seed-dependent)', function () {",
									"    pm.expect([201, 409, 404, 503]).to.include(pm.response.code);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Payroll Webhook",
			"item": [
				{
					"name": "GET webhook returns 501",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/payroll/webhook",
						"description": "REQ-PAY-009: the webhook endpoint accepts POST only; GET returns 501 Not Implemented."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('GET webhook returns 501', function () {",
									"    pm.response.to.have.status(501);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Unsigned POST is rejected",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"specversion\":\"1.0\",\"type\":\"nl.conduction.payroll.calculated\",\"id\":\"ext-1\",\"data\":{\"payrollId\":\"payroll-2026-05-emp-001\",\"deductions\":[]}}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/payroll/webhook",
						"description": "ADR-005: a POST without a valid X-Shillinq-Signature HMAC is rejected fail-closed before any object is touched."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Unsigned webhook POST is rejected', function () {",
									"    pm.expect([401, 412]).to.include(pm.response.code);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
		{
			"name": "Deadline Calendar Settings",
			"description": "compliance-deadline-calendar REQ-CDC-006: per-user category toggles + reminder lead times. Strictly current-user scoped (the acting user comes from the session; no user id parameter exists). Idempotent: the suite saves a change and restores the defaults.",
			"item": [
				{
					"name": "GET settings returns the four categories",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							}
						],
						"url": "{{base_url}}/index.php/apps/shillinq/api/deadline-calendar/settings",
						"description": "REQ-CDC-006: fetch the current user's deadline-calendar category toggles."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 with the four categories', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json).to.have.property('categories');",
									"    ['filing', 'payment-run', 'ar-due', 'contract'].forEach(function (category) {",
									"        pm.expect(json.categories).to.have.property(category);",
									"        pm.expect(json.categories[category]).to.have.property('enabled');",
									"        pm.expect(json.categories[category]).to.have.property('leadDays');",
									"    });",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST toggles the payment-run category off",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "OCS-APIRequest",
								"value": "true"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"categories\": {\"payment-run\": {\"enabled\": false, \"leadDays\": 5}}}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/deadline-calendar/settings",
						"description": "REQ-CDC-006: disable one category; the response echoes the saved state and reports the (fail-soft) publication status."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 and payment-run saved as disabled', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.categories['payment-run'].enabled).to.eql(false);",
