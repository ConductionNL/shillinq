		{
			"name": "Payroll Webhook",
			"item": [
				{
					"name": "GET webhook returns 501",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/webhooks/payroll",
						"description": "REQ-PAY-009: the webhook endpoint accepts POST only; GET returns 501 Not Implemented."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('GET webhook returns 501', function () {",
									"    pm.response.to.have.status(501);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				},
				{
					"name": "Unsigned POST is rejected",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\"specversion\":\"1.0\",\"type\":\"nl.conduction.payroll.calculated\",\"id\":\"ext-1\",\"data\":{\"payrollId\":\"payroll-2026-05-emp-001\",\"deductions\":[]}}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/webhooks/payroll",
						"description": "ADR-005: a POST without a valid X-Shillinq-Signature HMAC is rejected fail-closed before any object is touched."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Unsigned webhook POST is rejected', function () {",
									"    // ADR-005: the signature is part of the PAYLOAD, not caller auth, and",
									"    // this is a #[PublicPage] route, so PayrollWebhookController::receive()",
									"    // surfaces a missing/mismatching HMAC as 400 (untrusted payload) rather",
									"    // than 401 (which would contradict the route's public posture and trip",
									"    // hydra gate-9 semantic-auth). Assert the exact code AND the rejection",
									"    // message: a bare status check would also be satisfied by the guard",
									"    // 400ing on its own malformed body, which proves nothing about the",
									"    // signature check. Before this was fixed the request went to an",
									"    // UNROUTED url (/api/payroll/webhook) and got 405 — the rejection this",
									"    // test claims to prove was not happening at all.",
									"    pm.response.to.have.status(400);",
									"    pm.expect(pm.response.json().message).to.match(/signature/i);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		},
