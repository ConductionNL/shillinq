{
	"info": {
		"_postman_id": "shillinq-collection",
		"name": "Shillinq Integration Tests",
		"description": "Integration test collection for the shillinq Nextcloud app.\nReplace this with your actual API tests.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "basic",
		"basic": [
			{
				"key": "username",
				"value": "{{admin_user}}",
				"type": "string"
			},
			{
				"key": "password",
				"value": "{{admin_password}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "admin_user",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "admin_password",
			"value": "admin",
			"type": "string"
		},
		{
			"key": "administration_id",
			"value": "adm-smb-1",
			"type": "string"
		},
		{
			"key": "period_id_open",
			"value": "2026-04",
			"type": "string"
		},
		{
			"key": "period_id_closed",
			"value": "2026-02",
			"type": "string"
		},
		{
			"key": "period_id_locked",
			"value": "2026-01",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Period Close",
			"description": "bookkeeping-period-close (T2): guided close lifecycle + AI close-assistant flags. Requires the period-close register fragment seeded (adm-smb-1 periods 2026-01..2026-04) and the acting user in the period-closer / auditor group for the privileged transitions.",
			"item": [
				{
					"name": "GET period detail + AI flags",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}?administration_id={{administration_id}}",
						"description": "REQ-PC-005: fetch the period detail with freshly-computed close-assistant flags."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 with period data', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.data).to.have.property('periodId');",
									"    pm.expect(json.data).to.have.property('aiFlags');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET AI flags",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/ai-flags?administration_id={{administration_id}}",
						"description": "REQ-PC-004: fetch only the close-assistant flags for the period."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 with flags array', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data).to.be.an('array');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "GET missing administration_id → 400",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}",
						"description": "ADR-005: administration scope is required."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('400 bad request', function () {",
									"    pm.response.to.have.status(400);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST start-close (open → closing)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/start-close",
						"description": "REQ-PC-002: begin the guided close (period-closer role)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to closing', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('closing');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST close (closing → closed)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_open}}/close",
						"description": "REQ-PC-002: freeze the period after mandatory checklist items resolve."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to closed', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('closed');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST reopen without reason → 422",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\",\"closeReason\":\"\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_closed}}/reopen",
						"description": "REQ-PC-006: a non-empty close reason is required to reopen."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('422 validation error', function () {",
									"    pm.response.to.have.status(422);",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST reopen with reason (closed → open)",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\",\"closeReason\":\"Posted correction for invoice #2026-0042\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_closed}}/reopen",
						"description": "REQ-PC-006: reopen a closed period with an audit-trailed reason."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('200 transitions to open', function () {",
									"    pm.response.to.have.status(200);",
									"    pm.expect(pm.response.json().data.state).to.eql('open');",
									"});"
								]
							}
						}
					]
				},
				{
					"name": "POST lock-audit on audit-locked → 409",
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\"administration_id\":\"{{administration_id}}\"}"
						},
						"url": "{{base_url}}/index.php/apps/shillinq/api/period-close/{{period_id_locked}}/lock-audit",
						"description": "REQ-PC-002: an already audit-locked period rejects further transitions (terminal state)."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test('409 invalid state', function () {",
									"    pm.response.to.have.status(409);",
									"});"
								]
							}
						}
					]
				}
			]
		},
		{
			"name": "Health Check",
			"item": [
				{
					"name": "Nextcloud status",
					"request": {
						"method": "GET",
						"url": "{{base_url}}/status.php",
						"description": "Verify Nextcloud is running."
					},
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Nextcloud is running', function () {",
									"    pm.response.to.have.status(200);",
									"    const json = pm.response.json();",
									"    pm.expect(json.installed).to.be.true;",
									"});"
								],
								"type": "text/javascript"
							}
						}
					]
				}
			]
		}
	]
}
