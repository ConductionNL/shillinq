    "bootstrap-vue": "^2.23.1",
    "pinia": "^2.1.7",
    "vue": "^2.7.14",
    "vue-frag": "^1.4.3",
    "vue-material-design-icons": "^5.3.0",
    "vue-router": "^3.6.5"
