{
  "name": "shillinq",
  "version": "0.2.1",
  "license": "EUPL-1.2",
  "engines": {
    "node": "^20.0.0",
    "npm": "^10.0.0"
  },
  "scripts": {
    "prebuild": "node scripts/generate-manifest-shell.js",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "postbuild": "[ -d ../openregister/custom_apps/shillinq/js ] && cp -r js/. ../openregister/custom_apps/shillinq/js/ || true",
    "predev": "node scripts/generate-manifest-shell.js",
    "dev": "NODE_ENV=development webpack --config webpack.config.js --progress",
    "postdev": "[ -d ../openregister/custom_apps/shillinq/js ] && cp -r js/. ../openregister/custom_apps/shillinq/js/ || true",
    "prewatch": "node scripts/generate-manifest-shell.js",
    "watch": "NODE_ENV=development webpack --config webpack.config.js --progress --watch",
    "lint": "eslint src",
    "lint-fix": "npm run lint -- --fix",
    "test:l10n": "node tests/l10n/check-l10n.js",
    "pretest:unit": "node scripts/generate-manifest-shell.js",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.provider=v8 --coverage.reporter=json-summary --coverage.reporter=text-summary --coverage.include=src/** --coverage.reportsDirectory=coverage-vitest",
    "test:coverage-ratchet": "npm run test:coverage && bash tests/coverage-ratchet.sh vitest coverage-vitest/coverage-summary.json",
    "check:manifest": "node tests/validate-manifest.js",
    "check:manifest-budget": "node tests/check-manifest-budget.js",
    "check:registers": "node tests/validate-registers.js",
    "check:seeds": "node tests/validate-seeds.js",
    "check:markers": "node tests/validate-semantic-markers.js",
    "test:e2e": "playwright test",
    "test:e2e:docs": "playwright test --project docs-capture",
    "test:e2e:install": "playwright install chromium",
    "stylelint": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\"",
    "stylelint-fix": "stylelint \"src/**/*.vue\" \"src/**/*.scss\" \"src/**/*.css\" --fix",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "browserslist": [
    "extends @nextcloud/browserslist-config"
  ],
  "dependencies": {
    "@conduction/nextcloud-vue": "2.2.0-vue3.2",
    "@nextcloud/auth": "^2.6.0",
    "@nextcloud/axios": "~2.5.2",
    "@nextcloud/capabilities": "^1.2.1",
    "@nextcloud/dialogs": "^7.4.1",
    "@nextcloud/event-bus": "^3.3.3",
    "@nextcloud/files": "^3.12.2",
    "@nextcloud/initial-state": "^2.2.0",
    "@nextcloud/l10n": "^3.4.1",
    "@nextcloud/password-confirmation": "^6.1.0",
    "@nextcloud/router": "^3.1.0",
    "@nextcloud/vue": "^9.9.0",
    "@vueuse/core": "^14.4.0",
    "dexie": "^4.4.4",
    "dompurify": "^3.4.12",
    "gridstack": "^12.6.0",
    "marked": "^12.0.0",
    "path-browserify": "^1.0.1",
    "pinia": "^3.0.3",
    "terser-webpack-plugin": "^5.6.1",
    "vue": "^3.5.40",
    "vue-material-design-icons": "^5.3.1",
    "vue-router": "^4.5.1"
  },
  "overrides": {
    "libxmljs2": "^0.37.0",
    "apexcharts": "4.7.0",
    "@nextcloud/axios": "~2.5.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.9",
    "@babel/eslint-parser": "^7.16.5",
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@eslint/config-helpers": "^0.4.2",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.39.1",
    "@nextcloud/browserslist-config": "^3.0.1",
    "@nextcloud/eslint-config": "^8.4.1",
    "@nextcloud/eslint-plugin": "^2.0.0",
    "@nextcloud/stylelint-config": "^2.4.0",
    "@nextcloud/webpack-vue-config": "^7.0.2",
    "@playwright/test": "^1.49.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@vue/compiler-sfc": "^3.5.40",
    "@vue/eslint-config-typescript": "^13.0.0",
    "@vue/test-utils": "^2.4.6",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "axe-core": "^4.12.1",
    "babel-loader": "^10.1.1",
    "css-loader": "~7.1.1",
    "eslint": "^8.56.0",
    "eslint-config-standard": "^17.1.0",
    "eslint-import-resolver-alias": "^1.1.2",
    "eslint-import-resolver-exports": "^1.0.0-beta.5",
    "eslint-import-resolver-typescript": "^3.8.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsdoc": "^62.9.0",
    "eslint-plugin-n": "^16.6.2",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-vue": "^9.21.1",
    "node-polyfill-webpack-plugin": "^4.0.0",
    "postcss-html": "^1.8.1",
    "sass": "^1.99.0",
    "sass-loader": "^16.0.8",
    "style-loader": "~4.0.0",
    "stylelint": "^15.11.0",
    "stylelint-config-recommended-scss": "^13.1.0",
    "stylelint-config-recommended-vue": "^1.1.0",
    "ts-loader": "^9.6.0",
    "typescript": "^5.0.2",
    "vitest": "^3.2.7",
    "vue-eslint-parser": "^9.4.3",
    "vue-loader": "^17.4.2",
    "webpack": "^5.94.0",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.4"
  }
}
