# Shillinq — Conduction PHPStan config.
#
# The shared base is the single source of truth. Everything here is either the
# app's own tracked debt or an ignore naming a symbol that exists in no other
# fleet app. Anything you are tempted to add that another app would also need
# belongs in the base, not here.
includes:
    - vendor/conduction/hydra-gates/quality-config/phpstan-base.neon
    # Per-app tracked lint debt (auto-generated via `phpstan --generate-baseline`).
    - phpstan-baseline.neon

parameters:
    # App-specific only. The base already sets level, paths, bootstrapFiles,
    # excludePaths, scanDirectories and every fleet-wide ignore.

    # OpenRegister's contract, which lib/ typehints in 174 places but does not own.
    #
    # This app already SHIPS the stubs, at tests/stubs/OpenRegister/Contract/ —
    # but phpstan refuses to autoload them and says so:
    #
    #   Class OCA\OpenRegister\Contract\ObjectServiceInterface located in
    #   ./tests/stubs/OpenRegister/Contract/ObjectServiceInterface.php does not
    #   comply with psr-4 autoloading standard (rule: OCA\Shillinq\Tests\ =>
    #   ./tests). Skipping.
    #
    # It resolved anyway until now, because conduction/hydra-gates declared
    # `OCA\OpenRegister\Contract\` as a runtime psr-4 prefix. That was a bug —
    # the prefix is longer than openregister's own, so a vendored copy in ANY app
    # defined the contract for the whole process — and v1.9.0 removed it
    # (ConductionNL/.github#531). The skip notice was always there; the removal is
    # what made it matter.
    #
    # scanDirectories loads the files for ANALYSIS without going through psr-4,
    # which is exactly the seam needed: the class must be visible to phpstan and
    # must NOT go back into the runtime autoloader.
    scanDirectories:
        - %currentWorkingDirectory%/tests/stubs/OpenRegister/Contract
        # ADR-078 listener-deferral contract (#1198). TenderNedAwardPromotionJob
        # EXTENDS OCA\OpenRegister\BackgroundJob\ActorForwardedJob, and phpstan
        # refuses to ignore an "extends unknown class" error — it says
        # "cannot be ignored, use excludePaths instead". excludePaths is what the
        # cross-app *interface* implementors below had to do, but it drops the
        # file from analysis entirely; scanDirectories makes the base class
        # visible instead, so the new job stays analysed.
        - %currentWorkingDirectory%/tests/stubs/OpenRegister/BackgroundJob
        # Covers Service/Deferral too — scanDirectories recurses, so listing the
        # subdirectory separately would be redundant, not additive.
        - %currentWorkingDirectory%/tests/stubs/OpenRegister/Service

    # PHPDoc @return bool / @return array types are often intentionally broader than the
    # inferred type (e.g. SimpleXMLElement methods, third-party SDKs). Treating PHPDoc
    # types as certain causes spurious `=== true/false` / `=== null` "always false" errors.
    treatPhpDocTypesAsCertain: false

    excludePaths:
        # CustomerBridgeMetricsService implements OCA\OpenRegister\AppHost\IMetricsProvider which is
        # unavailable at analysis time (cross-app interface, present only at runtime). PHPStan requires
        # excludePaths for this class of error (not suppressible via ignoreErrors or baseline).
        - lib/Service/Pipelinq/CustomerBridgeMetricsService.php
        # shillinq#425: RegisterRequiresGuardAdapter implements
        # OCA\OpenRegister\Lifecycle\LifecycleGuardInterface, a cross-app interface present only at
        # runtime — same class of error as CustomerBridgeMetricsService above.
        - lib/Lifecycle/RegisterRequiresGuardAdapter.php
        # FourEyesPaymentRunGuard + PaymentRunDuplicateGuard implement the same cross-app
        # OCA\OpenRegister\Lifecycle\LifecycleGuardInterface — non-ignorable "implements unknown
        # interface" error at analysis time; only resolvable via excludePaths.
        - lib/Lifecycle/FourEyesPaymentRunGuard.php
        - lib/Lifecycle/PaymentRunDuplicateGuard.php
        # RoleFallbackResolver implements the cross-app
        # OCA\OpenRegister\Service\Notification\RecipientResolverInterface — same
        # non-ignorable "implements unknown interface" class as the guards above.
        - lib/Notification/RoleFallbackResolver.php
        # AppendReopenHistoryAction implements the cross-app
        # OCA\OpenRegister\Lifecycle\LifecycleActionInterface — same non-ignorable
        # "implements unknown interface" class as the guards above.
        - lib/Lifecycle/Action/AppendReopenHistoryAction.php

    ignoreErrors:
        # OCA\Decidesk (decision module) — cross-app dep, present only at runtime
        - '#unknown class OCA\\Decidesk\\#'
        - '#OCA\\Decidesk\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\Decidesk\\#'
        - '#has invalid type OCA\\Decidesk\\#'
        - '#Class OCA\\Decidesk\\[a-zA-Z\\]+.*not found#'
        # Cross-app events that extend OCP\EventDispatcher\Event at runtime but PHPStan cannot verify
        - '#expects OCP\\EventDispatcher\\Event, OCA\\Decidesk\\#'
        # OCA\DocuDesk (document signing) — cross-app dep, present only at runtime
        - '#unknown class OCA\\DocuDesk\\#'
        - '#OCA\\DocuDesk\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\DocuDesk\\#'
        - '#has invalid type OCA\\DocuDesk\\#'
        - '#Class OCA\\DocuDesk\\[a-zA-Z\\]+.*not found#'
        # Cross-app events that extend OCP\EventDispatcher\Event at runtime but PHPStan cannot verify
        - '#expects OCP\\EventDispatcher\\Event, OCA\\DocuDesk\\#'
        # OCA\Pipelinq (POS) — cross-app dep, present only at runtime.
        # Change inventory-pos-decrement (shillinq#504): PosStockDecrementListener
        # consumes pipelinq's PosStockMovedEvent.
        - '#unknown class OCA\\Pipelinq\\Event\\#'
        - '#OCA\\Pipelinq\\Event\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class OCA\\Pipelinq\\Event\\#'
        - '#has invalid type OCA\\Pipelinq\\Event\\#'
        - '#Class OCA\\Pipelinq\\Event\\[a-zA-Z\\]+.*not found#'
        - '#expects OCP\\EventDispatcher\\Event, OCA\\Pipelinq\\#'
        # PhpOffice\PhpWord — word-processor library available at runtime via NC app deps;
        # not declared in composer.json to avoid version conflicts with NC's own phpword.
        - '#unknown class PhpOffice\\#'
        - '#PhpOffice\\[a-zA-Z\\]+.*not found#'
        - '#on an unknown class PhpOffice\\#'
        - '#has invalid return type PhpOffice\\#'
        - '#has invalid type PhpOffice\\#'
        - '#Instantiated class PhpOffice\\#'
        - '#Call to method .+ on an unknown class PhpOffice\\#'
        - '#Call to static method .+ on an unknown class PhpOffice\\#'
        # AuthorizedAdminSetting attribute — NC allows passing the app-id string (e.g. Application::APP_ID)
        # at runtime; PHPStan's attribute ctor type is stricter (class-string<IDelegatedSettings>).
        # This is intentional: all controllers use the fleet-canonical app-id pattern.
        - '#Parameter (\#\d+ )?\$settings of attribute class OCP\\AppFramework\\Http\\Attribute\\AuthorizedAdminSetting#'
        # DataResponse body type — NC31's DataResponseType generic is `array<int|string,mixed>|string|int|bool|float|null`
        # but PHPStan infers stricter union types for complex nested arrays and string bodies (e.g. markdown/PDF).
        # At runtime DataResponse accepts any serialisable value; the mismatch is a PHPStan generic inference gap.
        - '#Parameter (\#\d+ )?\$data of class OCP\\AppFramework\\Http\\DataResponse constructor expects#'
        # Dompdf ReflectionClass: $domPdfClass is verified by class_exists above, but PHPStan
        # cannot narrow from string to class-string<\Dompdf\Dompdf> through a variable.
        - '#Parameter (\#\d+ )?\$objectOrClass of class ReflectionClass constructor expects.*string given#'
        # RuleEngine::providerSeedObjects narrows via class_implements, but PHPStan still sees
        # CheckProvider (the base type) which does not declare seedObjects().
        - '#Call to an undefined static method OCA\\Shillinq\\Standards\\Checks\\CheckProvider::seedObjects#'
        # OpenRegister's stoppable pre-save events (ObjectCreatingEvent /
        # ObjectUpdatingEvent) declare setErrors(); they are cross-app classes
        # absent at analysis time, so PHPStan only sees the OCP base Event and
        # cannot narrow the instanceof. The call is valid at runtime — it is the
        # documented veto contract MagicMapper turns into a HookStoppedException.
        - '#Call to an undefined method OCP\\EventDispatcher\\Event::setErrors\(\)#'
